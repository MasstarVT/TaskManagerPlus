{"nodes": [{"id": "readme_task_manager_plus", "label": "Task Manager Plus (README Overview)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cpu_clock_derivation", "label": "CPU Clock Speed Derivation (README note)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_startup_approved_flag", "label": "Startup Enable/Disable via StartupApproved (README note)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_librehardwaremonitorlib", "label": "LibreHardwareMonitorLib Dependency (README note)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_smart_app_control", "label": "Smart App Control Troubleshooting", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the app suddenly won't launch, Smart App Control is likely blocking the locally-built unsigned exe; turning it off is one-way without a full OS reset, and signing helps only with the 'Unknown Publisher' label, not with SAC's reputation-based block."}, {"id": "readme_six_tab_groups", "label": "Six Tab Groups / Chip-Bar Sections", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eighteen tabs grouped into six (Summary, Hardware, Activity, System, Diagnostics, Security); deeper tabs split into named sections by a chip bar rather than one long scroll \u2014 Stability alone had 91 stacked cards. Ctrl+1..9, Ctrl+K and --tab all address tabs by their own name regardless of group."}, {"id": "readme_dev_signing_scripts", "label": "Dev Certificate Signing Scripts", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New-DevCertificate.ps1 creates and trusts a self-signed cert for the current user; Sign-Release.ps1 signs each Release build \u2014 removes the 'Unknown Publisher' label but does not satisfy Smart App Control."}], "edges": [{"source": "readme_task_manager_plus", "target": "claude_task_manager_plus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_cpu_clock_derivation", "target": "claude_cpu_clock_derivation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_startup_approved_flag", "target": "claude_startup_approved_flag", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_librehardwaremonitorlib", "target": "claude_sensors_librehardwaremonitor", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_smart_app_control", "target": "claude_smart_app_control_note", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_six_tab_groups", "target": "claude_three_level_navigation", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {