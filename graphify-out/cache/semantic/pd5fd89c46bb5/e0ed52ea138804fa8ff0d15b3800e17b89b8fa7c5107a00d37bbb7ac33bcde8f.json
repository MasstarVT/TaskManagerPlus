{"nodes": [{"id": "_claude_skills_run_skill_run_skill", "label": "Run Skill (Launch, Drive, Screenshot)", "file_type": "document", "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_run_skill_real_run_mode", "label": "Real Run Mode (Elevated)", "file_type": "concept", "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-facing run: elevated build with full data, one UAC prompt; an elevated instance cannot be killed or automated from a non-elevated shell, so it is reserved for when the user wants to see or use the app."}, {"id": "_claude_skills_run_skill_verification_loop", "label": "Verification Loop (asInvoker, no UAC)", "file_type": "concept", "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mode split exists because the app manifest is requireAdministrator: an elevated instance can't be killed or sent input from a non-elevated shell and every launch costs a UAC click. The asInvoker variant is layout/theming-identical (just shows 'Not elevated' and loads less data on a few tabs), so automated UI verification uses it."}, {"id": "_claude_skills_run_skill_build_asinvoker_script", "label": "build-asinvoker.ps1", "file_type": "code", "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds to %TEMP%, never the repo tree. Never pass -p:BaseIntermediateOutputPath \u2014 the WPF temp project then double-includes generated *.g.cs from both obj roots (~1600 CS0111 errors); overriding only BaseOutputPath and sharing obj/ is correct."}, {"id": "_claude_skills_run_skill_screenshot_tabs_script", "label": "screenshot-tabs.ps1", "file_type": "code", "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each tab gets a fresh launch (--tab), a settle wait, a PrintWindow (PW_RENDERFULLCONTENT) capture and a kill \u2014 captures stay clean when other windows overlap and the sweep never steals focus. Needs SetProcessDPIAware before reading window rects on DPI-scaled displays. OK only means a window existed; the screenshots must actually be read since the target failures are visual."}, {"id": "_claude_skills_run_skill_tab_addresses", "label": "Tab Addresses (--tab header matching)", "file_type": "concept", "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--tab matches leaf-tab header text (same resolver as Ctrl+1..9 and the Ctrl+K palette) across the 18 leaves; the System group's leaf is literally 'System', so 'System Specs' resolves nothing."}], "edges": [{"source": "_claude_skills_run_skill_run_skill", "target": "_claude_skills_run_skill_real_run_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_run_skill", "target": "_claude_skills_run_skill_verification_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_verification_loop", "target": "_claude_skills_run_skill_build_asinvoker_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_verification_loop", "target": "_claude_skills_run_skill_screenshot_tabs_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_screenshot_tabs_script", "target": "_claude_skills_run_skill_tab_addresses", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_elevation_requireadministrator", "target": "_claude_skills_run_skill_verification_loop", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_verification_loop", "target": "claude_smart_app_control_note", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_tab_addresses", "target": "claude_selecttabbyname_resolver", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_run_skill_tab_addresses", "target": "claude_three_level_navigation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/run/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "app_verification_workflow", "label": "App Verification Workflow (asInvoker build + tab screenshot sweep)", "nodes": ["_claude_skills_run_skill_run_skill", "_claude_skills_run_skill_verification_loop", "_claude_skills_run_skill_build_asinvoker_script", "_claude_skills_run_skill_screenshot_tabs_script", "_claude_skills_run_skill_tab_addresses"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/run/SKILL.md"}]}