{"nodes": [{"id": "src_taskmanagerplus_resources_pooltag_pool_tag_dictionary", "label": "Curated Kernel Pool Tag Dictionary", "file_type": "document", "source_file": "src/TaskManagerPlus/Resources/pooltag.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small, hand-curated subset \u2014 the full WDK pooltag.txt runs to several thousand entries and isn't always redistributable \u2014 covering the most common kernel pool tags a home/dev machine is likely to see. A match is a helpful pointer, not a guaranteed-authoritative identification (some tags are reused by multiple components); a tag with no entry shows no description in the grid, never a guessed one. Format: 'TAG=Description (Component)', tags exactly 4 characters with spaces significant."}, {"id": "src_taskmanagerplus_resources_pooltag_kernel_pool_by_tag_grid", "label": "Kernel Pool by Tag Grid (#416)", "file_type": "concept", "source_file": "src/TaskManagerPlus/Resources/pooltag.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_taskmanagerplus_resources_pooltag_pool_tag_dictionary", "target": "src_taskmanagerplus_resources_pooltag_kernel_pool_by_tag_grid", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/TaskManagerPlus/Resources/pooltag.txt", "source_location": null, "weight": 1.0}, {"source": "src_taskmanagerplus_resources_pooltag_pool_tag_dictionary", "target": "claude_quick_flag_not_verdict", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "src/TaskManagerPlus/Resources/pooltag.txt", "source_location": null, "weight": 1.0}, {"source": "src_taskmanagerplus_resources_pooltag_pool_tag_dictionary", "target": "claude_degrade_never_fabricate", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_