<UserControl x:Class="TaskManagerPlus.Views.SystemSpecsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SystemSpecsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- SpecLabel/SpecValue now live in Themes/Dark.xaml (shared app-wide) - see the comment
             there. Kept only the view-specific SecondaryLine style here. -->
        <Style x:Key="SecondaryLine" TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Secondary}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One row in the Memory / Graphics / Storage lists: name + subtext on the left, size on the right. -->
        <DataTemplate x:Key="SpecRowTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <!-- Disk health badge (SMART / WMI status) - empty and collapsed for
                             rows that don't carry a health concept (memory, GPU). -->
                        <Border CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHealthWarning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding HealthText}" FontSize="10" FontWeight="SemiBold" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Secondary}" Style="{StaticResource SecondaryLine}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <!-- One row in the Volumes list: drive letter + label on the left, free/total on the
             right, with a thin percent-used bar underneath color-coded by PercentToBrushConverter
             (the same green/amber/red thresholds used everywhere else in the app). -->
        <DataTemplate x:Key="VolumeRowTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" />
                        <!-- #29: dirty-bit badge - reuses the disk health badge's visual (colored
                             pill) but keyed off IsDirty instead of HealthText. -->
                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Needs chkdsk" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <!-- Round 9, #37: BitLocker badge - only shown for a confirmed "On" status,
                             not "Off"/"Unknown"/"Not applicable" (a permission gap or an
                             unencryptable volume isn't the same as a real finding). -->
                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BitLockerOn}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="BitLocker" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Secondary}" Style="{StaticResource SecondaryLine}" />
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" Height="6"
                             Value="{Binding PercentUsed, Mode=OneWay}" Maximum="100"
                             Foreground="{Binding PercentUsed, Converter={StaticResource PercentToBrushConverter}}" />
                <!-- Round 9, #40/#42/#44: Recycle Bin size, VSS shadow copy usage, TRIM status -
                     pre-joined into one line by SystemSpecsViewModel (ExtraFactsText is already
                     blank-filtered), hidden entirely when none of the three have anything to show. -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ExtraFactsText}" Margin="0,4,0,0" Opacity="0.85">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExtraFactsText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TrimWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="0,0,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="Hardware and software detected on this PC."
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- #64: one-click "copy hardware IDs" (system product + CPU + GPU
                         identifiers) for pasting into a support ticket. -->
                    <Button Content="Copy hardware IDs" Command="{Binding CopyHardwareIdsCommand}" Padding="10,4" Margin="0,0,8,16" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" />
                </StackPanel>
            </Grid>

            <!-- Summary tiles -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Operating System" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding OsName}" Style="{StaticResource SpecValue}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OsDetails}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0,4,16">
                    <StackPanel>
                        <TextBlock Text="Processor" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource SpecValue}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CpuDetails}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding RamTotal}" Style="{StaticResource SpecValue}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RamDetails}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- System / motherboard -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource CardTitle}" />
                    <UniformGrid Columns="2" Rows="4">
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="Computer name" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding ComputerName}" Style="{StaticResource SpecValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Model" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding SystemModel}" Style="{StaticResource SpecValue}" />
                        </StackPanel>
                        <!-- #57: chassis/form-factor readout. -->
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="Chassis" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding ChassisType}" Style="{StaticResource SpecValue}" />
                        </StackPanel>
                        <!-- #58: Windows edition (see OsName above) & activation status - informational
                             only, no product key is ever read or shown. -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Activation" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding ActivationStatus}" Style="{StaticResource SpecValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="Motherboard" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding Motherboard}" Style="{StaticResource SpecValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="BIOS version" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding BiosVersion}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BiosAgeWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- #61: motherboard chipset driver version - best-effort, see
                             SystemSpecsService.ReadChipsetDriverInfo. -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Chipset driver" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding ChipsetDriverText}" Style="{StaticResource SpecValue}" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- #62: longest-uptime records this month/year, derived from the boot-history
                             trend the Startup tab already persists - no new sampling. -->
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="Longest uptime (month / year)" Style="{StaticResource SpecLabel}" />
                            <TextBlock Style="{StaticResource SpecValue}">
                                <Run Text="{Binding LongestUptimeThisMonthText, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding LongestUptimeThisYearText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Memory modules -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Memory modules" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding MemoryModules}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                    <TextBlock Text="No memory modules detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MemoryModules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Graphics -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Graphics" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Gpus}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                    <TextBlock Text="No graphics adapters detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Gpus.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Storage" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                    <TextBlock Text="No disks detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- #70: page file location vs. the boot drive's media type - a page file left
                         on a slower secondary HDD (or the reverse) is a common, silent slowdown
                         cause on multi-drive systems, easy to miss since this tab otherwise only
                         shows aggregate disk activity. -->
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Page file: " Style="{StaticResource SpecLabel}" Margin="0" />
                            <TextBlock Text="{Binding PageFileLocationText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PageFileLocationWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- #60: active display inventory - resolution/refresh rate from the GPU's current
                 output mode, connection type (best-effort) from root\wmi's monitor classes. HDR
                 support is deliberately not shown - see MonitorInfo's remarks for why. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Displays" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Monitors}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                    <TextBlock Text="No displays detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Monitors.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #59: installed .NET runtime versions, from the shared-framework directory layout
                 dotnet.exe itself uses. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Installed .NET runtimes" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding DotNetRuntimes}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No .NET shared-framework installation found on this PC.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DotNetRuntimes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #63: Windows Defender exclusion list, read-only - "Unknown/inaccessible" (Tamper
                 Protection can deny this even elevated) is shown distinctly from a confirmed empty
                 list. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Windows Defender exclusions" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding DefenderExclusionsStatusText}" Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DefenderExclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12.5" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- USB devices (#69): flags a Windows-reported enumeration/driver problem - helps
                 catch a misbehaving peripheral or a failing USB controller/hub. Per-device power
                 draw isn't shown - see UsbDeviceInfo's remarks for why. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="USB devices" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding UsbDevices}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                    <TextBlock Text="No USB devices detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsbDevices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Volumes: per-drive-letter free space, color-coded so a nearly-full volume - a
                 common, easy-to-miss slowdown/crash cause - stands out at a glance. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Text="Volumes" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource VolumeRowTemplate}" />
                    <TextBlock Text="No volumes detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Volumes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Security posture: Secure Boot / TPM / VBS - each individually nullable (see
                 SecurityInfo's remarks), rendered as a warning color only on a confirmed "off"/
                 "not present", never on "Unknown" (a permission gap isn't the same as a real
                 finding). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Security" Style="{StaticResource CardTitle}" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Secure Boot" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding SecureBootText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SecureBootWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="8,0,8,0">
                            <TextBlock Text="TPM" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding TpmText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TpmWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Virtualization-based security" Style="{StaticResource SpecLabel}" />
                            <TextBlock Text="{Binding VbsText}" Style="{StaticResource SpecValue}" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Round 11, #73: Windows Update/servicing reboot-pending flag - see
                             SystemSpecsService.ReadRebootPending. -->
                        <StackPanel Margin="0,10,8,0">
                            <TextBlock Text="Reboot pending" Style="{StaticResource SpecLabel}" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                        <Setter Property="Text" Value="No" />
                                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RebootPending}" Value="True">
                                                <Setter Property="Text" Value="Yes" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                    <!-- Round 18, #878/#879: pointer to the richer HVCI/VBS-prerequisite/LSA-
                         protection/Secure-Boot-setup-mode/TPM-detail reads on the Security tab's
                         Platform security section - plain text, not a live navigation link (this
                         app has no cross-tab navigation plumbing yet), so this stays a small,
                         honest deviation from a literal clickable "link" per the item's own text. -->
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="More detail - HVCI/VBS prerequisites, LSA protection, Secure Boot setup mode, extended TPM info, and more - is on the Security tab's Platform security section." />
                </StackPanel>
            </Border>

            <!-- Security software (#63): registered AV/security products, via the
                 SecurityCenter2 WMI namespace. A best-effort "looks enabled" heuristic, not a
                 verified fact - see SystemSpecsService.ReadAntivirusProducts. Warning-colored
                 when more than one product looks active at once (conflicting real-time scanners
                 are a classic, often-invisible perf killer). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MultipleActiveAvWarning}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Security software" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="More than one product looks actively enabled - conflicting real-time scanners commonly hurt performance."
                               Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MultipleActiveAvWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding AntivirusProducts}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                    <TextBlock Text="No antivirus product reported (or the check isn't supported on this system).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AntivirusProducts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Outdated third-party drivers: a curated, conservative list - see
                 SystemSpecsService.ReadOutdatedDrivers for the filtering rules. Collapsed entirely
                 when empty rather than showing a "no drivers detected" line, since an empty list
                 here (unlike Memory/Graphics/Storage) is the expected common case. -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OutdatedDrivers.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Drivers that may be worth updating" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Third-party drivers older than 2 years, in device categories where a stale driver commonly causes problems (display, network, storage, audio/video peripherals)."
                               Style="{StaticResource SubStat}" Margin="0,-8,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding OutdatedDrivers}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- Recent Windows updates (#57): a common "PC got slow/broke after X" correlation
                 aid. Collapsed entirely when empty (same as Outdated Drivers) - Win32_QuickFixEngineering
                 can legitimately return nothing on some builds even with updates installed. -->
            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentUpdates.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Recent Windows updates" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding RecentUpdates}" ItemTemplate="{StaticResource SpecRowTemplate}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- #68: recently installed third-party software - correlates with "when did the
                 problem start". Collapsed entirely when empty (same as Outdated Drivers/Recent
                 Windows updates) - install-only, see InstalledSoftwareInfo's remarks. -->
            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentlyInstalledSoftware.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Recently installed software" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Third-party software installed in the last 6 months, oldest at the bottom - Windows keeps no equivalent log of uninstalls."
                               Style="{StaticResource SubStat}" Margin="0,-8,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RecentlyInstalledSoftware}" ItemTemplate="{StaticResource SpecRowTemplate}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
