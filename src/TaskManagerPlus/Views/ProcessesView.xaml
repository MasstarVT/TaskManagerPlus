<UserControl x:Class="TaskManagerPlus.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar row 1: search/filters + destructive actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Height="32">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Grid.Column="0" Text="Search processes, PID, or user" Foreground="{DynamicResource TextSecondaryBrush}"
                       IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <CheckBox Grid.Column="1" Content="Recently started" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding RecentlyStartedOnly}"
                      ToolTip="Show only processes started in the last 5 minutes" />

            <!-- Round 7 #1: process tree/hierarchy view toggle. -->
            <CheckBox Grid.Column="2" Content="Tree view" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding ShowTree}"
                      ToolTip="Show processes indented under their parent instead of a flat list" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding ProcessCount, Mode=OneWay}" /><Run Text=" processes" />
            </TextBlock>

            <Button Grid.Column="4" Content="End process tree" Margin="0,0,8,0" Command="{Binding EndProcessTreeCommand}" />
            <Button Grid.Column="5" Content="End task" Command="{Binding EndTaskCommand}" Style="{StaticResource DangerButton}" />
        </Grid>

        <!-- Toolbar row 2: on-demand inspectors + process-control actions for the selected process. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="View modules" Margin="0,0,8,8" Command="{Binding ViewModulesCommand}" />
            <!-- Round 7 #3 -->
            <Button Content="View environment" Margin="0,0,8,8" Command="{Binding ViewEnvironmentCommand}" />
            <!-- Round 7 #12 -->
            <Button Content="View handle types" Margin="0,0,8,8" Command="{Binding ViewHandleTypesCommand}" />
            <!-- Round 7 #17 - only meaningful for a svchost.exe row, see IsSvchostSelected. -->
            <Button Content="Hosted services" Margin="0,0,8,8" Command="{Binding ViewHostedServicesCommand}"
                    ToolTip="Which service names live inside this svchost.exe process" />
            <!-- Round 7 #4 -->
            <Button Content="Trim working set" Margin="0,0,8,8" Command="{Binding TrimWorkingSetCommand}"
                    ToolTip="Ask Windows to release the process's resident memory back to the system (EmptyWorkingSet)" />
            <!-- Round 7 #8 -->
            <Button Content="Suspend" Margin="0,0,8,8" Command="{Binding SuspendCommand}" Style="{StaticResource DangerButton}" />
            <Button Content="Resume" Margin="0,0,16,8" Command="{Binding ResumeCommand}" Style="{StaticResource SuccessButton}" />

            <!-- Round 15 #846-#848/#851: on-demand red-flag inspectors - detection only, "quick flag
                 not a verdict" per each service's own remarks. -->
            <Button Content="Scan unbacked memory" Margin="0,0,8,8" Command="{Binding ViewUnbackedMemoryCommand}"
                    ToolTip="Look for executable memory not backed by any loaded image/mapped file - see UnbackedExecutableMemoryService" />
            <Button Content="Check image integrity" Margin="0,0,8,8" Command="{Binding ViewHollowingCheckCommand}"
                    ToolTip="Compare the process's reported main-module path against what's actually mapped in memory - a process-hollowing indicator" />
            <Button Content="Scan thread origins" Margin="0,0,8,8" Command="{Binding ViewForeignThreadsCommand}"
                    ToolTip="Look for threads whose start address falls outside every loaded module - a code-injection indicator" />
            <Button Content="View mitigations" Margin="0,0,16,8" Command="{Binding ViewMitigationsCommand}"
                    ToolTip="DEP/ASLR/CFG/ACG/CET and other exploit-mitigation policy flags for this process" />

            <!-- Round 7 #6: priority class picker. -->
            <TextBlock Text="Priority:" VerticalAlignment="Center" Margin="0,0,4,8" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding PriorityOptionNames}" SelectedItem="{Binding SelectedPriorityName}"
                      Width="120" Margin="0,0,4,8" />
            <Button Content="Set priority" Margin="0,0,0,8" Command="{Binding SetPriorityCommand}" />
        </WrapPanel>

        <!-- Flat grid (default) -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ProcessesView}"
                  SelectedItem="{Binding SelectedProcess}">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTree}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.RowStyle>
                <!-- High-privilege (SYSTEM/LOCAL SERVICE/NETWORK SERVICE) rows get a tinted
                     background so they stand out when scanning for something unexpected -
                     same idea as the existing "Not responding" red status text below. -->
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding CommandLine}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighPrivilege}" Value="True">
                            <Setter Property="Background" Value="#142A2A00" />
                        </DataTrigger>
                        <!-- #2: a process stuck "Not responding" gets a visible red row tint on
                             top of the colored Status text below - "make it more prominent"
                             beyond a plain text flag, since window ghosting is easy to miss in a
                             long scrolling grid. -->
                        <DataTrigger Binding="{Binding Status}" Value="Not responding">
                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                        </DataTrigger>
                        <!-- Round 7 #8: a suspended process is dimmed, the same "faded, not hidden"
                             treatment the CPU tab already gives a parked core tile. -->
                        <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <!-- Round 7 #11: an exe path running an unusually high number of times. -->
                        <DataTrigger Binding="{Binding IsDuplicateInstanceOutlier}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                <DataGridTemplateColumn Header="CPU" Width="90" SortMemberPath="CpuPercent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                       Foreground="{Binding CpuPercent, Converter={StaticResource PercentToBrushConverter}}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <!-- Round 8 #38: working set (above) vs. private bytes vs. virtual size, side by
                     side - see ProcessRow's remarks for why virtual size fills the third slot
                     instead of a redundant "commit" duplicate of private bytes. -->
                <DataGridTextColumn Header="Private bytes" Binding="{Binding PrivateBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <DataGridTextColumn Header="Virtual size" Binding="{Binding VirtualBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <!-- #14: possible memory leak - working set has grown without ever giving memory
                     back over the whole tracked history window. See ProcessMonitorService.ComputeLeakSuspect. -->
                <DataGridTemplateColumn Header="Mem trend" Width="90" SortMemberPath="IsLeakSuspect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Possible leak" Foreground="{DynamicResource WarningBrush}" FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeakSuspect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #36: per-process GPU engine utilization, via the "GPU Engine" perf-counter
                     category (the same source Task Manager's own GPU column reads). -->
                <DataGridTemplateColumn Header="GPU" Width="80" SortMemberPath="GpuPercent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GpuPercent, StringFormat={}{0:0.0}%}"
                                       Foreground="{Binding GpuPercent, Converter={StaticResource PercentToBrushConverter}}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #26: per-process disk I/O rate, via GetProcessIoCounters - see ProcessMonitorService.ReadIoBytes. -->
                <DataGridTextColumn Header="Disk" Binding="{Binding DiskBytesPerSec, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Width="90" />
                <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="80" />
                <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" Width="80" />
                <!-- Round 7 #7: GDI/USER object handle counts, matching Task Manager's optional
                     Details columns - see ProcessControlService.ReadGuiResourceCounts. -->
                <DataGridTextColumn Header="GDI" Binding="{Binding GdiHandleCount}" Width="60" />
                <DataGridTextColumn Header="USER" Binding="{Binding UserHandleCount}" Width="60" />
                <!-- Round 7 #6: scheduling priority class. -->
                <DataGridTextColumn Header="Priority" Binding="{Binding PriorityClassName}" Width="100" />
                <!-- Round 15, #852(a)/(c)/(b): integrity level, AppContainer, and protection level -
                     all cheap per-tick token/process reads, see ProcessTokenInspectionService. -->
                <DataGridTemplateColumn Header="Integrity" Width="80" SortMemberPath="IntegrityLevel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IntegrityLevel}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IntegrityLevel}" Value="System">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IntegrityLevel}" Value="Protected">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Protection" Width="110" SortMemberPath="ProtectionLevel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProtectionLevel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProtectionLevel}" Value="None">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="AppContainer" Binding="{Binding IsAppContainer, Mode=OneWay}" Width="90" IsReadOnly="True" />
                <!-- Round 7 #2/#11: spawn-group size and duplicate-instance count badges. -->
                <DataGridTemplateColumn Header="Group" Width="70" SortMemberPath="SpawnGroupSize">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                       ToolTip="Processes sharing the same parent and executable, spawned within a few seconds of each other - a best-effort proxy for job-object/process-group membership.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SpawnGroupSize, StringFormat=x{0}}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SpawnGroupSize}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="150" SortMemberPath="NotRespondingSeconds">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- #2: "Not responding (12s)" - a running duration is a much more
                                 prominent, actionable signal than a flat "Not responding" label,
                                 since it distinguishes a window that's about to recover from one
                                 that's genuinely hung. -->
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Status}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Not responding">
                                                <Setter Property="Text" Value="{Binding NotRespondingSeconds, StringFormat=Not responding ({0}s)}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                <Setter Property="Text" Value="Suspended" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #837: signing certificate's subject CN (falls back to issuer CN, then
                     "Unknown") - self-signed certs are called out separately since a self-signed
                     "Microsoft"-looking name would otherwise look legitimate at a glance. -->
                <DataGridTemplateColumn Header="Publisher" Width="140" SortMemberPath="Publisher">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Publisher, Mode=OneWay}" />
                                <Run Text=" (self-signed)" Foreground="{DynamicResource WarningBrush}" FontSize="11">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelfSigned}" Value="True">
                                                    <Setter Property="Text" Value=" (self-signed)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #840: expected-Microsoft-binary / near-miss-name flag - same "collapsed
                     unless set" badge pattern as the "Mem trend" possible-leak column above. -->
                <DataGridTemplateColumn Header="Trust" Width="90" SortMemberPath="TrustWarning">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Check this" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" ToolTip="{Binding TrustWarning}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrustWarning}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140" />
                <!-- #52: parent process, so an orphaned/unexpectedly-spawned process (e.g. a
                     process masquerading as a child of explorer.exe) stands out. -->
                <DataGridTemplateColumn Header="Parent" Width="160" SortMemberPath="ParentName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ParentName, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding ParentPid, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Started" Width="140" SortMemberPath="StartTime">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartTime, StringFormat={}{0:g}}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="3*" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="End task" Command="{Binding EndTaskCommand}" />
                    <MenuItem Header="End process tree" Command="{Binding EndProcessTreeCommand}" />
                    <Separator />
                    <MenuItem Header="Suspend" Command="{Binding SuspendCommand}" />
                    <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                    <MenuItem Header="Trim working set" Command="{Binding TrimWorkingSetCommand}" />
                    <Separator />
                    <MenuItem Header="View modules" Command="{Binding ViewModulesCommand}" />
                    <MenuItem Header="View environment" Command="{Binding ViewEnvironmentCommand}" />
                    <MenuItem Header="View handle types" Command="{Binding ViewHandleTypesCommand}" />
                    <MenuItem Header="Hosted services (svchost)" Command="{Binding ViewHostedServicesCommand}" />
                    <Separator />
                    <MenuItem Header="Scan unbacked memory" Command="{Binding ViewUnbackedMemoryCommand}" />
                    <MenuItem Header="Check image integrity" Command="{Binding ViewHollowingCheckCommand}" />
                    <MenuItem Header="Scan thread origins" Command="{Binding ViewForeignThreadsCommand}" />
                    <MenuItem Header="View mitigations" Command="{Binding ViewMitigationsCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Round 7 #1: tree view (only shown when ShowTree is on). Selection is wired in
             ProcessesView.xaml.cs since TreeView has no built-in two-way SelectedItem binding. -->
        <TreeView Grid.Row="2" x:Name="ProcessTreeView" ItemsSource="{Binding ProcessTree}"
                  SelectedItemChanged="ProcessTreeView_SelectedItemChanged">
            <TreeView.Style>
                <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTree}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.Style>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Row.Pid, StringFormat=  (PID {0})}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0">
                            <Run Text="{Binding Row.CpuPercent, Mode=OneWay, StringFormat={}{0:0.0}% CPU}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Row.MemoryBytes, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Row.SpawnGroupSize, StringFormat= · group of {0}}" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="11" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Row.SpawnGroupSize}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- On-demand inspector results for the selected process (#39/#3/#12/#17) - each section
             independently collapses when empty, the same pattern the original modules-only panel
             established. -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- #39, extended by Round 15 #849 with signature/publisher/user-writable-location trust
                 columns - a real (sortable) DataGrid now instead of a plain string list, so "show me
                 every unsigned DLL loaded here" is one click on the Signature column header. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessModules.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Loaded modules" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <!-- Round 15, #850: the process's own application directory being user-writable. -->
                    <TextBlock Text="{Binding SelectedProcessAppDirWarning}" Foreground="{DynamicResource WarningBrush}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessAppDirWarning}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding SelectedProcessModules}" MaxHeight="220" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="1.3*" />
                            <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1*" />
                            <DataGridTemplateColumn Header="Writable loc." Width="90" SortMemberPath="IsUserWritableLocation">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="User-writable" Foreground="{DynamicResource WarningBrush}" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUserWritableLocation}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Side-load risk" Width="90" SortMemberPath="IsSideLoadSuspect">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Check this" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSideLoadSuspect}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 15, #850: DLL side-loading findings - a same-named file also exists directly
                 under System32, but this module was actually loaded from somewhere else. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SideLoadFindings.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Side-loading risk" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SideLoadFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                        <Run Text="{Binding ModuleName, Mode=OneWay}" />
                                        <Run Text=" - a same-named file exists in System32 but this wasn't loaded from there" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="System32: " /><Run Text="{Binding System32CounterpartPath, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="Actually loaded from: " /><Run Text="{Binding FilePath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #846: unbacked executable memory scan. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessUnbackedMemory.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Unbacked executable memory" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessUnbackedMemory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #847: hollowed-image indicator for the main module. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessHollowingCheck.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Image integrity check (main module)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessHollowingCheck}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #848: foreign (unbacked) thread start-address findings. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessForeignThreads.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Thread origin scan" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessForeignThreads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #851: mitigation-policy badge row. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessMitigations.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Mitigation policies" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessMitigations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                    <TextBlock FontSize="11.5">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding StateText, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 7 #3 -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessEnvironment.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Environment variables" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedProcessEnvironment}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Round 7 #12 -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessHandleTypes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Open handles by type (best-effort)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessHandleTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,0,16,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 7 #17 -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessHostedServices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Hosted services" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessHostedServices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Round 7 #5/#9: CPU affinity editor + "what has this file open" lookup. -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AffinityCores.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="CPU affinity" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding AffinityCores}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Index}" IsChecked="{Binding IsSelected}" Margin="0,0,10,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Apply affinity" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ApplyAffinityCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="What has this file open?" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0" Command="{Binding LookupFileLockCommand}" />
                        <TextBox Text="{Binding FileLockPath, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding FileLockResults}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</UserControl>
