<UserControl x:Class="TaskManagerPlus.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar row 1: search/filters + destructive actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Height="32">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Grid.Column="0" Text="Search processes, PID, or user" Foreground="{DynamicResource TextSecondaryBrush}"
                       IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <CheckBox Grid.Column="1" Content="Recently started" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding RecentlyStartedOnly}"
                      ToolTip="Show only processes started in the last 5 minutes" />

            <!-- Round 7 #1: process tree/hierarchy view toggle. -->
            <CheckBox Grid.Column="2" Content="Tree view" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding ShowTree}"
                      ToolTip="Show processes indented under their parent instead of a flat list" />

            <!-- Item 67: opt-in (default off) response-time probe - off by default so an ordinary
                 poll tick never pays for it, see ProcessMonitorService.Sample's own remarks. -->
            <CheckBox Grid.Column="3" Content="Measure response time" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding MeasureResponseTime}"
                      ToolTip="SendMessageTimeout probe (bounded, ~250ms) against every windowed process each tick - turns 'Not responding' into an actual millisecond figure, catching apps that are sluggish but not yet flagged hung." />

            <!-- #266: EcoQoS filter - "this app is slow because Windows classified it as
                 background" is otherwise undiagnosable in a long process list. -->
            <CheckBox Grid.Column="4" Content="Power-throttled only" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding OnlyPowerThrottled}"
                      ToolTip="Show only processes Windows has classified as background via EcoQoS power throttling" />

            <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding ProcessCount, Mode=OneWay}" /><Run Text=" processes" />
            </TextBlock>

            <Button Grid.Column="6" Content="End process tree" Margin="0,0,8,0" Command="{Binding EndProcessTreeCommand}" />
            <Button Grid.Column="7" Content="End task" Command="{Binding EndTaskCommand}" Style="{StaticResource DangerButton}" />
        </Grid>

        <!-- Toolbar row 2: on-demand inspectors + process-control actions for the selected process. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="View modules" Margin="0,0,8,8" Command="{Binding ViewModulesCommand}" />
            <!-- Round 7 #3 -->
            <Button Content="View environment" Margin="0,0,8,8" Command="{Binding ViewEnvironmentCommand}" />
            <!-- Round 7 #12 -->
            <Button Content="View handle types" Margin="0,0,8,8" Command="{Binding ViewHandleTypesCommand}" />
            <!-- #408: single-process, on-demand VirtualQueryEx address-space walk. -->
            <Button Content="Address space" Margin="0,0,8,8" Command="{Binding ViewAddressSpaceCommand}"
                    ToolTip="Walk this process's virtual address space and bucket it by private/image/mapped-file, committed/reserved/free - never run automatically, only on request" />
            <!-- Round 7 #17 - only meaningful for a svchost.exe row, see IsSvchostSelected. -->
            <Button Content="Hosted services" Margin="0,0,8,8" Command="{Binding ViewHostedServicesCommand}"
                    ToolTip="Which service names live inside this svchost.exe process" />
            <!-- #761 - cross-links to the Services tab's svchost group breakdown, see ProcessesView.xaml.cs. -->
            <Button Content="svchost groups" Margin="0,0,8,8" IsEnabled="{Binding IsSvchostRowSelected}"
                    Click="ViewSvchostGroupsInServices_Click"
                    ToolTip="Open the Services tab's svchost group breakdown (CPU/working set/handles/threads per -k group)" />
            <!-- Round 7 #4 -->
            <Button Content="Trim working set" Margin="0,0,8,8" Command="{Binding TrimWorkingSetCommand}"
                    ToolTip="Ask Windows to release the process's resident memory back to the system (EmptyWorkingSet)" />
            <!-- Round 7 #8 -->
            <Button Content="Suspend" Margin="0,0,8,8" Command="{Binding SuspendCommand}" Style="{StaticResource DangerButton}" />
            <Button Content="Resume" Margin="0,0,16,8" Command="{Binding ResumeCommand}" Style="{StaticResource SuccessButton}" />

            <!-- Round 15 #846-#848/#851: on-demand red-flag inspectors - detection only, "quick flag
                 not a verdict" per each service's own remarks. -->
            <Button Content="Scan unbacked memory" Margin="0,0,8,8" Command="{Binding ViewUnbackedMemoryCommand}"
                    ToolTip="Look for executable memory not backed by any loaded image/mapped file - see UnbackedExecutableMemoryService" />
            <Button Content="Check image integrity" Margin="0,0,8,8" Command="{Binding ViewHollowingCheckCommand}"
                    ToolTip="Compare the process's reported main-module path against what's actually mapped in memory - a process-hollowing indicator" />
            <Button Content="Scan thread origins" Margin="0,0,8,8" Command="{Binding ViewForeignThreadsCommand}"
                    ToolTip="Look for threads whose start address falls outside every loaded module - a code-injection indicator" />
            <Button Content="View mitigations" Margin="0,0,8,8" Command="{Binding ViewMitigationsCommand}"
                    ToolTip="DEP/ASLR/CFG/ACG/CET and other exploit-mitigation policy flags for this process" />
            <!-- Round 16, #853 -->
            <Button Content="View privileges" Margin="0,0,8,8" Command="{Binding ViewPrivilegesCommand}"
                    ToolTip="Lists this process's token privileges (SeDebugPrivilege, SeBackupPrivilege, ...) and flags the dangerous-if-unexpected ones when held by a non-Microsoft-signed process" />
            <!-- Round 16, #856 -->
            <Button Content="Decode -enc argument" Margin="0,0,16,8" Command="{Binding DecodeEncodedCommandCommand}"
                    ToolTip="Decodes this process's PowerShell -EncodedCommand argument (UTF-16LE base64) into plain text - enabled only when one is detected" />
            <!-- Item 64: Wait Chain Traversal - only meaningful (and only enabled) for a currently
                 not-responding process. -->
            <Button Content="Analyse wait chain" Margin="0,0,8,8" Command="{Binding AnalyzeWaitChainCommand}"
                    ToolTip="Wait Chain Traversal (the same API Resource Monitor's own 'Analyze Wait Chain' uses): which thread is this not-responding process blocked on, and who's holding it - flags a cycle as a deadlock." />
            <!-- Item 65: on-demand mini/full dump, same call Task Manager's own 'Create dump file' makes. -->
            <Button Content="Create mini dump…" Margin="0,0,8,8" Command="{Binding CreateMiniDumpCommand}" />
            <Button Content="Create full dump…" Margin="0,0,16,8" Command="{Binding CreateFullDumpCommand}"
                    ToolTip="Includes the process' entire address space - large, but captures everything a debugger could need to inspect heap state at the moment of the freeze." />

            <!-- Round 7 #6: priority class picker. -->
            <TextBlock Text="Priority:" VerticalAlignment="Center" Margin="0,0,4,8" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding PriorityOptionNames}" SelectedItem="{Binding SelectedPriorityName}"
                      Width="120" Margin="0,0,4,8" />
            <Button Content="Set priority" Margin="0,0,0,8" Command="{Binding SetPriorityCommand}" />
        </WrapPanel>

        <!-- Flat grid (default) -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ProcessesView}"
                  SelectedItem="{Binding SelectedProcess}">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTree}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.RowStyle>
                <!-- High-privilege (SYSTEM/LOCAL SERVICE/NETWORK SERVICE) rows get a tinted
                     background so they stand out when scanning for something unexpected -
                     same idea as the existing "Not responding" red status text below. -->
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding CommandLine}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHighPrivilege}" Value="True">
                            <Setter Property="Background" Value="#142A2A00" />
                        </DataTrigger>
                        <!-- #2: a process stuck "Not responding" gets a visible red row tint on
                             top of the colored Status text below - "make it more prominent"
                             beyond a plain text flag, since window ghosting is easy to miss in a
                             long scrolling grid. -->
                        <DataTrigger Binding="{Binding Status}" Value="Not responding">
                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                        </DataTrigger>
                        <!-- Round 7 #8: a suspended process is dimmed, the same "faded, not hidden"
                             treatment the CPU tab already gives a parked core tile. -->
                        <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <!-- Round 7 #11: an exe path running an unusually high number of times. -->
                        <DataTrigger Binding="{Binding IsDuplicateInstanceOutlier}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                        </DataTrigger>
                        <!-- #270: a process stuck in background I/O priority mode. -->
                        <DataTrigger Binding="{Binding IsBackgroundIoPriority}" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- Fixed widths, not stars: this grid's ~40 fixed columns are far wider than the
                     viewport, and a DataGrid with ANY star column responds to that by compressing
                     every column toward MinWidth to avoid horizontal scrolling - the whole grid
                     rendered as ~28px single-letter columns. All-fixed widths overflow into a
                     normal horizontal scrollbar instead. -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource CellTextTrim}" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                <DataGridTemplateColumn Header="CPU" Width="90" SortMemberPath="CpuPercent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                       Foreground="{Binding CpuPercent, Converter={StaticResource PercentToBrushConverter}}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #294: composite 0-100 responsiveness score - a colour dot (same visual idiom
                     as ServiceStatusToBrushConverter's status dot) plus the number, sortable so a
                     user can find "which app is actually making this PC feel bad" instead of just
                     sorting by CPU%. Deliberately a composite heuristic - the header and per-row
                     tooltip both say so plainly. -->
                <DataGridTemplateColumn Width="110" SortMemberPath="ResponsivenessScore">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Resp. score"
                                   ToolTip="Composite 0-100 heuristic (not a verdict): message-pump latency, hung-window time, thread scheduling pressure, page-fault rate, and GC pause time (managed processes only). Higher is better - lower means more signal that this process is contributing to system lag." />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ResponsivenessScoreTooltip}">
                                <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding ResponsivenessScore, Converter={StaticResource ResponsivenessScoreToBrushConverter}}" />
                                <TextBlock Text="{Binding ResponsivenessScoreText}" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <!-- Round 8 #38: working set (above) vs. private bytes vs. virtual size, side by
                     side - see ProcessRow's remarks for why virtual size fills the third slot
                     instead of a redundant "commit" duplicate of private bytes. -->
                <DataGridTextColumn Header="Private bytes" Binding="{Binding PrivateBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <DataGridTextColumn Header="Virtual size" Binding="{Binding VirtualBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <!-- #412: resident, non-shared memory only - a shared-DLL-heavy process's total
                     working set (above) can look large even though most of it is pages shared
                     with other processes. -->
                <DataGridTextColumn Header="Private WS" Binding="{Binding PrivateWorkingSetBytes, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                <!-- #410: per-process page-fault rate - identifies which process is actually
                     causing paging pressure, rather than only the system-wide figure. -->
                <DataGridTextColumn Header="Page faults" Binding="{Binding PageFaultsPerSec, StringFormat={}{0:0.0}/s}" Width="90" />
                <!-- #409: private bytes ahead of working set by a wide margin means a meaningful
                     chunk of this process's committed memory has been paged/trimmed out of
                     physical RAM - not genuinely small, just not currently resident. -->
                <DataGridTemplateColumn Header="WS/Priv gap" Width="100" SortMemberPath="WorkingSetPrivateGapBytes">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding WorkingSetPrivateGapBytes, Converter={StaticResource BytesToReadableConverter}}"
                                       VerticalAlignment="Center"
                                       ToolTip="Private bytes minus working set - a large gap means this much of the process's committed memory has been paged/trimmed out of physical RAM.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkingSetDivergent}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #14: possible memory leak - working set has grown without ever giving memory
                     back over the whole tracked history window. See ProcessMonitorService.ComputeLeakSuspect. -->
                <DataGridTemplateColumn Header="Mem trend" Width="90" SortMemberPath="IsLeakSuspect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Possible leak" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLeakSuspect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #283: working-set trim detector - a large, sudden working-set drop (>30% and
                     >50MB in one tick) typically precedes a burst of hard faults as the process
                     pages everything back in on its next touch. Blank until a trim is observed. -->
                <DataGridTextColumn Header="Last trim" Binding="{Binding LastTrimmedText}" Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="ToolTip" Value="A large, sudden working-set drop (more than 30% and more than 50MB in one tick) - typically a working-set trim, which precedes a burst of hard faults as the process pages everything back in on its next touch. See the Responsiveness tab's hard-fault rate monitor for the system-wide signal this feeds into." />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- #401: recent private-bytes trend as a tiny inline sparkline - see
                     ProcessHistoryService (persistent, cross-restart per-image-name history) and
                     SparklinePointsConverter. -->
                <DataGridTemplateColumn Header="Mem history" Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding MemorySparkline, Converter={StaticResource SparklinePointsConverter}}"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                      Width="56" Height="20" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #402: least-squares slope (MB/hour) and R² of the private-bytes history above -
                     a magnitude and a confidence, distinguishing a steady climb from a sawtooth
                     allocate/free pattern, on top of the plain "Possible leak" dot. -->
                <DataGridTextColumn Header="Leak slope" Binding="{Binding LeakSlopeMbPerHour, StringFormat={}{0:0.00} MB/hr}" Width="100" />
                <DataGridTextColumn Header="Leak R²" Binding="{Binding LeakRSquared, StringFormat={}{0:0.00}}" Width="70" />
                <!-- #403: handle count climbing steadily while private bytes stay flat - the
                     classic kernel-object-leak signature, distinct from an ordinary memory leak. -->
                <DataGridTemplateColumn Header="Handle leak" Width="90" SortMemberPath="IsHandleLeakSuspect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Handle leak" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                       ToolTip="Handle count has grown steadily while private bytes stayed roughly flat - a quick flag, not a verdict.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHandleLeakSuspect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #405: thread count climbing steadily with no plateau - a thread-pool leak or
                     unbounded worker creation. -->
                <DataGridTemplateColumn Header="Thread runaway" Width="105" SortMemberPath="IsThreadRunawaySuspect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Thread runaway" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                       ToolTip="Thread count has grown steadily with no plateau - a quick flag, not a verdict.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThreadRunawaySuspect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #36: per-process GPU engine utilization, via the "GPU Engine" perf-counter
                     category (the same source Task Manager's own GPU column reads). -->
                <DataGridTemplateColumn Header="GPU" Width="80" SortMemberPath="GpuPercent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GpuPercent, StringFormat={}{0:0.0}%}"
                                       Foreground="{Binding GpuPercent, Converter={StaticResource PercentToBrushConverter}}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #26: per-process disk I/O rate, via GetProcessIoCounters - see ProcessMonitorService.ReadIoBytes. -->
                <DataGridTextColumn Header="Disk" Binding="{Binding DiskBytesPerSec, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Width="90" />
                <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="80" />
                <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" Width="80" />
                <!-- Round 7 #7: GDI/USER object handle counts, matching Task Manager's optional
                     Details columns - see ProcessControlService.ReadGuiResourceCounts. -->
                <DataGridTextColumn Header="GDI" Binding="{Binding GdiHandleCount}" Width="60" />
                <DataGridTextColumn Header="USER" Binding="{Binding UserHandleCount}" Width="60" />
                <!-- Round 7 #6: scheduling priority class. -->
                <DataGridTextColumn Header="Priority" Binding="{Binding PriorityClassName}" Width="100" />
                <!-- Round 15, #852(a)/(c)/(b): integrity level, AppContainer, and protection level -
                     all cheap per-tick token/process reads, see ProcessTokenInspectionService. -->
                <DataGridTemplateColumn Header="Integrity" Width="80" SortMemberPath="IntegrityLevel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IntegrityLevel}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IntegrityLevel}" Value="System">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IntegrityLevel}" Value="Protected">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #266: EcoQoS power-throttling status - "this app is slow because Windows
                     classified it as background" is otherwise undiagnosable. -->
                <DataGridTemplateColumn Header="Power" Width="110" SortMemberPath="PowerThrottleText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PowerThrottleText}" VerticalAlignment="Center" FontSize="{StaticResource FontBody}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPowerThrottled}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Protection" Width="110" SortMemberPath="ProtectionLevel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProtectionLevel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProtectionLevel}" Value="None">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #270: I/O and memory priority - a process stuck in Very Low/Low I/O priority
                     ("background mode") otherwise presents only as unexplainably slow disk access. -->
                <DataGridTemplateColumn Header="I/O priority" Width="100" SortMemberPath="IoPriorityText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IoPriorityText}" VerticalAlignment="Center" FontSize="{StaticResource FontBody}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBackgroundIoPriority}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="AppContainer" Binding="{Binding IsAppContainer, Mode=OneWay}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Memory priority" Binding="{Binding MemoryPriorityText}" Width="110" />
                <!-- #274: .NET lock contention, managed processes only - blank for a native
                     process (a null DotNetContentionRatePerSec/DotNetQueueLength renders as an
                     empty cell, no converter needed). -->
                <DataGridTextColumn Header="Lock contention/sec" Binding="{Binding DotNetContentionRatePerSec, StringFormat={}{0:0.0}}" Width="130" />
                <DataGridTextColumn Header="Lock queue" Binding="{Binding DotNetQueueLength}" Width="90" />
                <!-- #276: GC mode via environment variables - a heuristic, not a certainty; see the
                     tooltip and ProcessRow.GcModeText's own remarks. -->
                <DataGridTextColumn Header="GC mode" Binding="{Binding GcModeText}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="Read from the process's environment variables (DOTNET_gcServer/COMPlus_gcServer) via a PEB memory walk - a process configured through its runtimeconfig.json instead may not show correctly here." />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- #277: thread-pool-starvation hint - a rising logical-thread count alongside an
                     elevated queue/contention signal over several ticks. Explicitly a hint. -->
                <DataGridTemplateColumn Header="TP hint" Width="90" SortMemberPath="IsThreadPoolStarvationSuspect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Starving?" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                       ToolTip="Thread-pool-starvation hint: the .NET CLR logical-thread count has climbed steadily over the last several samples while the queue/contention signal stayed elevated - the outward signature of blocking calls starving the thread pool. A sampled hint, not a diagnosis.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThreadPoolStarvationSuspect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #272: "looks stuck" flag from the shared scheduler sweep, with a one-click
                     shortcut into #271's real wait-chain analysis to actually confirm it. -->
                <DataGridTemplateColumn Header="Stuck?" Width="150" SortMemberPath="IsStuckThreadSuspect">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding StuckThreadHintText}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStuckThreadSuspect}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Possibly stuck" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Content="Analyze" FontSize="{StaticResource FontCaption}" Padding="6,0"
                                        Command="{Binding DataContext.AnalyzeWaitChainDetailedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Round 7 #2/#11: spawn-group size and duplicate-instance count badges. -->
                <DataGridTemplateColumn Header="Group" Width="70" SortMemberPath="SpawnGroupSize">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontBody}"
                                       ToolTip="Processes sharing the same parent and executable, spawned within a few seconds of each other - a best-effort proxy for job-object/process-group membership.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SpawnGroupSize, StringFormat=x{0}}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SpawnGroupSize}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Item 67: measured UI responsiveness - null (shown as "—", TargetNullValue,
                     matching TdrSettings' own nullable-int-column convention elsewhere on this
                     tab) whenever MeasureResponseTime is off, the row has no window, or the probe
                     itself timed out (SMTO_ABORTIFHUNG aborted the call) - never a fabricated
                     number. -->
                <DataGridTextColumn Header="Response" Width="90" SortMemberPath="ResponseTimeMs"
                                     Binding="{Binding ResponseTimeMs, TargetNullValue='—', StringFormat={}{0}ms}" />
                <DataGridTemplateColumn Header="Status" Width="150" SortMemberPath="NotRespondingSeconds">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- #2: "Not responding (12s)" - a running duration is a much more
                                 prominent, actionable signal than a flat "Not responding" label,
                                 since it distinguishes a window that's about to recover from one
                                 that's genuinely hung. -->
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Status}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Not responding">
                                                <Setter Property="Text" Value="{Binding NotRespondingSeconds, StringFormat=Not responding ({0}s)}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                <Setter Property="Text" Value="Suspended" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #837: signing certificate's subject CN (falls back to issuer CN, then
                     "Unknown") - self-signed certs are called out separately since a self-signed
                     "Microsoft"-looking name would otherwise look legitimate at a glance. -->
                <DataGridTemplateColumn Header="Publisher" Width="140" SortMemberPath="Publisher">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Publisher, Mode=OneWay}" />
                                <Run Text=" (self-signed)" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelfSigned}" Value="True">
                                                    <Setter Property="Text" Value=" (self-signed)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #840: expected-Microsoft-binary / near-miss-name flag - same "collapsed
                     unless set" badge pattern as the "Mem trend" possible-leak column above. -->
                <DataGridTemplateColumn Header="Trust" Width="90" SortMemberPath="TrustWarning">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Check this" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" ToolTip="{Binding TrustWarning}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrustWarning}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Round 16, #854/#855/#856: combined suspicious-location / parent-child-anomaly /
                     living-off-the-land badge - same "collapsed unless set" pattern as the Trust
                     column above, for visual consistency. -->
                <DataGridTemplateColumn Header="Security" Width="90" SortMemberPath="SecurityFlagReason">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="Check this" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" ToolTip="{Binding SecurityFlagReason}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SecurityFlagReason}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140" />
                <!-- #52: parent process, so an orphaned/unexpectedly-spawned process (e.g. a
                     process masquerading as a child of explorer.exe) stands out. -->
                <DataGridTemplateColumn Header="Parent" Width="160" SortMemberPath="ParentName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ParentName, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding ParentPid, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Started" Width="140" SortMemberPath="StartTime">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartTime, StringFormat={}{0:g}}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="320" ElementStyle="{StaticResource CellTextTrim}" />
                <!-- Round 17, item 60: crashes/hangs for this executable in the last 30 days -
                     from CrashHistoryCacheService's own cheap cache, not a per-tick query. -->
                <DataGridTemplateColumn Header="Crashes (30d)" Width="100" SortMemberPath="CrashCount30d">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CrashCount30d}" VerticalAlignment="Center"
                                       ToolTip="Application Error (1000) / Application Hang (1002) events logged for this executable in the last 30 days">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CrashCount30d}" Value="0">
                                                <Setter Property="Text" Value="—" />
                                            </DataTrigger>
                                            <Trigger Property="Text" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="End task" Command="{Binding EndTaskCommand}" />
                    <MenuItem Header="End process tree" Command="{Binding EndProcessTreeCommand}" />
                    <Separator />
                    <MenuItem Header="Suspend" Command="{Binding SuspendCommand}" />
                    <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                    <MenuItem Header="Trim working set" Command="{Binding TrimWorkingSetCommand}" />
                    <Separator />
                    <MenuItem Header="View modules" Command="{Binding ViewModulesCommand}" />
                    <MenuItem Header="View environment" Command="{Binding ViewEnvironmentCommand}" />
                    <MenuItem Header="View handle types" Command="{Binding ViewHandleTypesCommand}" />
                    <MenuItem Header="Address space" Command="{Binding ViewAddressSpaceCommand}" />
                    <MenuItem Header="Hosted services (svchost)" Command="{Binding ViewHostedServicesCommand}" />
                    <Separator />
                    <MenuItem Header="Scan unbacked memory" Command="{Binding ViewUnbackedMemoryCommand}" />
                    <MenuItem Header="Check image integrity" Command="{Binding ViewHollowingCheckCommand}" />
                    <MenuItem Header="Scan thread origins" Command="{Binding ViewForeignThreadsCommand}" />
                    <MenuItem Header="View mitigations" Command="{Binding ViewMitigationsCommand}" />
                    <MenuItem Header="View privileges" Command="{Binding ViewPrivilegesCommand}" />
                    <MenuItem Header="Decode -enc argument" Command="{Binding DecodeEncodedCommandCommand}" />
                    <Separator />
                    <!-- Round 17, #864: shells to MpCmdRun.exe -Scan -ScanType 3 -File <image path>. -->
                    <MenuItem Header="Scan with Windows Defender" Command="{Binding ScanWithDefenderCommand}" />
                    <Separator />
                    <!-- Item 64: enabled only for a currently not-responding process. -->
                    <MenuItem Header="Analyse wait chain" Command="{Binding AnalyzeWaitChainCommand}" />
                    <!-- Item 65 -->
                    <MenuItem Header="Create mini dump…" Command="{Binding CreateMiniDumpCommand}" />
                    <MenuItem Header="Create full dump…" Command="{Binding CreateFullDumpCommand}" />
                    <!-- #271: Wait Chain Traversal - the same in-box API Resource Monitor's own
                         "Analyze Wait Chain" action uses, against this process's main thread. A
                         second, independently-built wait-chain view (richer node/status detail via
                         AnalyzeWaitChainDetailedCommand) alongside item 64's simpler one above. -->
                    <MenuItem Header="Analyze wait chain (detailed)..." Command="{Binding AnalyzeWaitChainDetailedCommand}" />
                    <!-- #406: pinned leak-watch list - see LeakWatchViewModel and the Memory
                         tab's "Leak watch list" panel. -->
                    <MenuItem Header="Watch for leaks" Command="{Binding ToggleLeakWatchCommand}"
                              ToolTip="Add or remove this process (by name) from the Memory tab's pinned leak-watch list, sampled every 5 seconds" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Round 7 #1: tree view (only shown when ShowTree is on). Selection is wired in
             ProcessesView.xaml.cs since TreeView has no built-in two-way SelectedItem binding. -->
        <TreeView Grid.Row="2" x:Name="ProcessTreeView" ItemsSource="{Binding ProcessTree}"
                  SelectedItemChanged="ProcessTreeView_SelectedItemChanged">
            <TreeView.Style>
                <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowTree}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.Style>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Row.Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Row.Pid, StringFormat=  (PID {0})}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0">
                            <Run Text="{Binding Row.CpuPercent, Mode=OneWay, StringFormat={}{0:0.0}% CPU}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Row.MemoryBytes, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Row.SpawnGroupSize, StringFormat= · group of {0}}" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="{StaticResource FontBody}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Row.SpawnGroupSize}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- On-demand inspector results for the selected process (#39/#3/#12/#17) - each section
             independently collapses when empty, the same pattern the original modules-only panel
             established. -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- #39, extended by Round 15 #849 with signature/publisher/user-writable-location trust
                 columns - a real (sortable) DataGrid now instead of a plain string list, so "show me
                 every unsigned DLL loaded here" is one click on the Signature column header. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessModules.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Loaded modules" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <!-- Round 15, #850: the process's own application directory being user-writable. -->
                    <TextBlock Text="{Binding SelectedProcessAppDirWarning}" Foreground="{DynamicResource WarningBrush}"
                               FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessAppDirWarning}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding SelectedProcessModules}" MaxHeight="220" IsReadOnly="True"
                              AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="1.3*" />
                            <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1*" />
                            <DataGridTemplateColumn Header="Writable loc." Width="90" SortMemberPath="IsUserWritableLocation">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="User-writable" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUserWritableLocation}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Side-load risk" Width="90" SortMemberPath="IsSideLoadSuspect">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Check this" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSideLoadSuspect}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 15, #850: DLL side-loading findings - a same-named file also exists directly
                 under System32, but this module was actually loaded from somewhere else. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SideLoadFindings.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Side-loading risk" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SideLoadFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                        <Run Text="{Binding ModuleName, Mode=OneWay}" />
                                        <Run Text=" - a same-named file exists in System32 but this wasn't loaded from there" />
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="System32: " /><Run Text="{Binding System32CounterpartPath, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="Actually loaded from: " /><Run Text="{Binding FilePath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #846: unbacked executable memory scan. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessUnbackedMemory.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Unbacked executable memory" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessUnbackedMemory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #847: hollowed-image indicator for the main module. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessHollowingCheck.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Image integrity check (main module)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessHollowingCheck}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #848: foreign (unbacked) thread start-address findings. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessForeignThreads.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Thread origin scan" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessForeignThreads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #851: mitigation-policy badge row. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessMitigations.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Mitigation policies" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessMitigations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                    <TextBlock FontSize="{StaticResource FontBody}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding StateText, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 16, #853: token privilege audit results. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessPrivileges.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Token privileges" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"
                               Text="Highlighted entries are on the dangerous-if-unexpected watch list, currently enabled, and held by a process that isn't Microsoft-signed. Quick flag, not a verdict - plenty of legitimate system processes hold these." />
                    <ItemsControl ItemsSource="{Binding SelectedProcessPrivileges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                    <TextBlock FontSize="{StaticResource FontBody}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding StateText, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 16, #856: decoded -EncodedCommand text. -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DecodedCommandLineText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Decoded -EncodedCommand" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock FontFamily="Consolas" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding DecodedCommandLineText}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Round 7 #3 -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessEnvironment.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Environment variables" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedProcessEnvironment}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- #799: whether this process's own PATH/TEMP has drifted from the current
                         machine+user environment - computed alongside the dump above, no extra query. -->
                    <Border CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                            Visibility="{Binding SelectedProcessEnvironmentDrift, Converter={StaticResource NullToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessEnvironmentDrift.HasDrift}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding SelectedProcessEnvironmentDrift.Detail}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProcessEnvironmentDrift.HasDrift}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 7 #12 -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessHandleTypes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Open handles by type (best-effort)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessHandleTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" Margin="0,0,16,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 7 #17 -->
            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessHostedServices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Hosted services" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessHostedServices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessWaitBreakdown.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Thread state / wait-reason breakdown" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SelectedProcessWaitBreakdown}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,16,2">
                                    <Run Text="{Binding BucketName, Mode=OneWay}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding ThreadCount, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProcessAddressSpace}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,6">
                        <Run Text="Address space — " />
                        <Run Text="{Binding SelectedProcessAddressSpace.ProcessName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" (PID " /><Run Text="{Binding SelectedProcessAddressSpace.Pid, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedProcessAddressSpace.Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessAddressSpace.Error}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding SelectedProcessAddressSpace.Buckets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,6">
                                    <TextBlock FontSize="{StaticResource FontBody}">
                                        <Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=": " />
                                        <Run Text="{Binding TotalBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" (" /><Run Text="{Binding RegionCount, Mode=OneWay}" /><Run Text=" regions)" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="{StaticResource FontBody}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Largest contiguous free block: " />
                        <Run Text="{Binding SelectedProcessAddressSpace.LargestFreeBlockBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" — a small largest-block figure despite a large total free figure above points to fragmentation, not a leak." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Round 7 #5/#9: CPU affinity editor + "what has this file open" lookup. -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AffinityCores.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="CPU affinity" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding AffinityCores}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Index}" IsChecked="{Binding IsSelected}" Margin="0,0,10,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Apply affinity" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ApplyAffinityCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="What has this file open?" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Check" Margin="8,0,0,0" Command="{Binding LookupFileLockCommand}" />
                        <TextBox Text="{Binding FileLockPath, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding FileLockResults}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Round 17, item 63: processes seen in a previous poll tick and gone in the current one -
             "my app closed itself" turned into "exit code 0xC0000005" wherever a code was
             actually captured. Collapsed entirely when nothing has exited yet this session. -->
        <Border Grid.Row="5" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecentlyExited.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Recently exited" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentlyExited}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontBody}">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" (PID " /><Run Text="{Binding Pid, Mode=OneWay}" /><Run Text=") — " />
                                        <Run Text="{Binding ExitCodeText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding ExitTime, StringFormat={}{0:T}}" FontSize="{StaticResource FontBody}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</UserControl>
