<UserControl x:Class="TaskManagerPlus.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SecurityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- #801/#804: header - plain statement that everything on this tab is a quick flag
                 for a human to judge, never a claim of certainty about malware. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Every item below is a quick flag for a human to judge, not a verdict that something is malicious. Persistence locations, unusual signatures, and unexpected configuration are common on a perfectly clean machine too - use this to spot what's worth a closer look, not as an automatic diagnosis." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <CheckBox Content="Redact when exporting" VerticalAlignment="Center" Margin="0,0,10,0"
                              IsChecked="{Binding RedactReport}"
                              ToolTip="Blanks usernames, machine name, and serial-like strings in the exported report." />
                    <Button Content="Export report..." Command="{Binding ExportReportCommand}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,12"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- #802/#803/#804: Persistence section - AutorunsService's RunOnce/RunOnceEx/
                 RunServices/RunServicesOnce/policy Run keys, Winlogon shell chain, Winlogon
                 Notify, AppInit_DLLs, AppCertDlls, all in one sortable/filterable grid. -->
            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Persistence - places apps and DLLs can make themselves run automatically, beyond the plain Run key already shown on the Startup tab."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="Save baseline"
                                Command="{Binding SaveBaselineCommand}" />
                        <Button Grid.Column="2" Margin="0,0,8,0" Content="Compare to baseline"
                                Command="{Binding CompareToBaselineCommand}" />
                        <!-- #845: separate on-demand pass - see AutorunsService.CheckWritePermissions's
                             remarks on why this spawns icacls per path and isn't part of the main Scan. -->
                        <Button Grid.Column="3" Margin="0,0,8,0" Command="{Binding CheckWritePermissionsCommand}"
                                ToolTip="Shells out to icacls.exe for every persistence target and its containing folder - can take a while on a system with many entries.">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Check write permissions" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingWritePermissions}" Value="True">
                                                <Setter Property="Text" Value="Checking..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding ScanAutorunsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Scan" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <Setter Property="Text" Value="Scanning..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: the persistence entries themselves. -->
                        <DataGrid Grid.Column="0" Height="360" IsReadOnly="True"
                                  ItemsSource="{Binding AutorunEntries}"
                                  SelectedItem="{Binding SelectedAutorunEntry}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.4*" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" />
                                <DataGridTextColumn Header="Path" Binding="{Binding ResolvedPath}" Width="2.4*" />
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1*" />
                                <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2.6*" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Right: findings detail pane (#804). -->
                        <Border Grid.Column="2" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="12">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Text="Findings" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedFinding.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding SelectedFinding.Severity, StringFormat=Severity: {0}}" Foreground="{DynamicResource WarningBrush}" />
                                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedFinding.Reason}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="11.5"
                                                       Text="{Binding SelectedFinding.Path}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding SelectedFinding.WhatDisablingDoes, StringFormat=What disabling this does: {0}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"
                                         Background="Transparent" BorderThickness="0" MaxHeight="220">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3">
                                                <TextBlock TextWrapping="Wrap" FontSize="12.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" - " />
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Row-level actions for the selected persistence entry. -->
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Copy registry path" Command="{Binding CopyRegistryPathCommand}" CommandParameter="{Binding SelectedAutorunEntry}" Margin="0,0,8,8" />
                        <Button Content="Open containing folder" Command="{Binding OpenContainingFolderCommand}" CommandParameter="{Binding SelectedAutorunEntry}" Margin="0,0,8,8" />
                        <!-- #841: on-demand hashing - computed only on click, never during a scan. -->
                        <Button Command="{Binding HashSelectedCommand}" CommandParameter="{Binding SelectedAutorunEntry}" Margin="0,0,8,8">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Hash" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHashing}" Value="True">
                                                <Setter Property="Text" Value="Hashing..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <!-- #841: hashes every current finding's related file in one pass. -->
                        <Button Content="Hash all flagged items" Command="{Binding HashAllFlaggedCommand}" Margin="0,0,8,8" />
                        <!-- #843: Mark of the Web / Zone.Identifier for the selected entry. -->
                        <Button Content="Check Mark of the Web" Command="{Binding CheckMarkOfTheWebCommand}" CommandParameter="{Binding SelectedAutorunEntry}" Margin="0,0,8,8" />
                        <!-- #838: on-demand, offline-tolerant revocation check - makes an online
                             call, so it's a separate explicit click, not part of the main Scan. -->
                        <Button Command="{Binding CheckRevocationCommand}" CommandParameter="{Binding SelectedAutorunEntry}" Margin="0,0,8,8"
                                ToolTip="Makes an online revocation check for the selected entry's certificate - not run automatically during Scan.">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Check revocation" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingRevocation}" Value="True">
                                                <Setter Property="Text" Value="Checking..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </WrapPanel>

                    <!-- #841/#842: hash result - collapsed until a hash has actually been computed. -->
                    <Border Margin="0,4,0,0" Padding="10,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HashResultSha256}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding HashResultPath}" Margin="0,0,0,4" />
                            <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap">
                                <Run Text="SHA-256: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding HashResultSha256, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Text="SHA-1: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding HashResultSha1, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Text="MD5: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding HashResultMd5, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Copy" Command="{Binding CopyHashResultCommand}" Margin="0,0,8,0" />
                                <!-- #842: opens a browser search for the already-computed hash only
                                     on explicit click - never uploads the file, never auto-contacts anything. -->
                                <Button Content="Look up this hash" Command="{Binding LookUpHashCommand}"
                                        ToolTip="Opens a VirusTotal hash search in your default browser - only the hash is sent, and only when you click this." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- #841: "hash all flagged items" result block. -->
                    <Border Margin="0,4,0,0" Padding="10,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HashAllFlaggedResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Hash all flagged items - result" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="{Binding HashAllFlaggedResult}" />
                            </ScrollViewer>
                            <Button Content="Copy" Command="{Binding CopyHashAllFlaggedCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- #843: Mark of the Web result. -->
                    <Border Margin="0,4,0,0" Padding="10,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MotwResultText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Mark of the Web" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding MotwResultText}" />
                        </StackPanel>
                    </Border>

                    <!-- #803: baseline diff - hidden until a compare has actually produced rows. -->
                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding BaselineAdded.Count}" Value="0" />
                                            <Condition Binding="{Binding BaselineRemoved.Count}" Value="0" />
                                            <Condition Binding="{Binding BaselineChanged.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Changes since baseline" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding BaselineAdded.Count, StringFormat=Added ({0})}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding BaselineAdded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" ToolTip="{Binding Location}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="{Binding BaselineRemoved.Count, StringFormat=Removed ({0})}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding BaselineRemoved}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" ToolTip="{Binding Location}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding BaselineChanged.Count, StringFormat=Changed ({0})}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding BaselineChanged}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" ToolTip="{Binding Location}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 16, #857/#858: "Process activity" - two short, on-demand, "eyeball this list"
                 scans that are process-focused rather than persistence-focused, so they get their
                 own section rather than folding into the Persistence grid above. -->
            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Process activity" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"
                               Text="Two short, on-demand scans - a list to eyeball, not an alert. Legitimate holders/activity (antivirus, EDR, Defender, other system processes, in-house or open-source tools) are common and expected." />

                    <!-- #857: lsass.exe handle watch. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="lsass.exe handle watch - which processes currently hold an open handle to lsass.exe, and what access they were granted."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding ScanLsassHandlesCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Scan" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanningLsassHandles}" Value="True">
                                                <Setter Property="Text" Value="Scanning..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding LsassHandleScanStatus}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <DataGrid IsReadOnly="True" MaxHeight="220" ItemsSource="{Binding LsassHandleFindings}" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding HolderProcessName}" Width="1.2*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding HolderPid}" Width="70" />
                            <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="HolderSignatureStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HolderSignatureStatus}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HolderSignatureStatus}" Value="Unsigned">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" Width="70" />
                            <DataGridTextColumn Header="Granted access" Binding="{Binding GrantedAccessText}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #858: unsigned processes with network activity. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Unsigned processes with network activity - unsigned/non-Microsoft-signed processes that are listening on every interface or hold an established outbound connection (TCP only)."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding ScanUnsignedNetworkActivityCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Scan" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanningNetworkActivity}" Value="True">
                                                <Setter Property="Text" Value="Scanning..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding NetworkActivityScanStatus}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <DataGrid IsReadOnly="True" MaxHeight="220" ItemsSource="{Binding UnsignedNetworkFindings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80" />
                            <DataGridTextColumn Header="Local" Width="140">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}:{1}">
                                        <Binding Path="LocalAddress" />
                                        <Binding Path="LocalPort" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Remote" Width="160">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}:{1}">
                                        <Binding Path="RemoteAddress" />
                                        <Binding Path="RemotePort" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                            <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 17, #859-870: "Protection status" - Windows Defender / third-party AV /
                 Attack Surface Reduction posture. See DefenderService for the read logic. Cheap
                 registry/WMI reads share one "Refresh protection status" button; event-log
                 timelines, the quarantine list, and running a scan each stay behind their own
                 button since those are genuinely slow/long-running. -->
            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Protection status" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Windows Defender's own state, signature freshness, exclusions, Tamper Protection, Attack Surface Reduction rules, and third-party antivirus cross-checks - all on-demand, all read-only unless you explicitly click Restore/Purge/Scan below." />
                        </StackPanel>
                        <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshProtectionStatusCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Refresh protection status" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshingProtectionStatus}" Value="True">
                                                <Setter Property="Text" Value="Refreshing..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ProtectionStatusMessage}" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />

                    <!-- #866: Tamper Protection - shown prominently near the top since it explains
                         why other reads below might come back empty/denied; the UI text says so
                         explicitly rather than a bare "Unknown". -->
                    <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6"
                            Visibility="{Binding TamperProtection, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Tamper Protection: " FontWeight="SemiBold" />
                                <Run Text="{Binding TamperProtection.State, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" (source: " /><Run Text="{Binding TamperProtection.SourceText, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding TamperProtection.DisclaimerText}" />
                        </StackPanel>
                    </Border>

                    <!-- #859/#860: Defender status card + signature/platform freshness. -->
                    <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6"
                            Visibility="{Binding DefenderStatus, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Windows Defender status" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                                <Run Text="Running mode: " /><Run Text="{Binding DefenderStatus.AmRunningMode, Mode=OneWay}" />
                            </TextBlock>
                            <UniformGrid Columns="3" Rows="2">
                                <TextBlock Margin="0,0,8,4"><Run Text="Real-time protection: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.RealTimeProtectionText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Behavior monitor: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.BehaviorMonitorText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="On-access protection: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.OnAccessProtectionText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Antispyware: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.AntispywareEnabledText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Antivirus: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.AntivirusEnabledText, Mode=OneWay}" /></TextBlock>
                            </UniformGrid>
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Signature / platform freshness" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap"><Run Text="Antivirus signatures: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.AntivirusSignatureVersion, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding DefenderStatus.AntivirusSignatureAgeDays, Mode=OneWay, StringFormat={}{0} day(s) old}" /><Run Text=")" /></TextBlock>
                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="Antispyware signatures: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.AntispywareSignatureVersion, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding DefenderStatus.AntispywareSignatureAgeDays, Mode=OneWay, StringFormat={}{0} day(s) old}" /><Run Text=")" /></TextBlock>
                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="Engine / product version: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.AmEngineVersion, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DefenderStatus.AmProductVersion, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="Last quick scan ended: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.QuickScanEndedText, Mode=OneWay}" /><Run Text=" (source: " /><Run Text="{Binding DefenderStatus.LastQuickScanSource, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="Last full scan ended: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DefenderStatus.FullScanEndedText, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- #868: extra feature toggles, PUA protection called out prominently. -->
                    <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6"
                            Visibility="{Binding FeatureToggles, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Feature toggles" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <Border Padding="8" Margin="0,0,0,8" CornerRadius="4" Background="{DynamicResource BgPanelBrush}"
                                    Visibility="{Binding FeatureToggles.PuaProtectionOff, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                           Text="Potentially Unwanted Application (PUA) protection is OFF - Windows' own default, but the single most relevant Defender setting for the bloatware/adware/bundleware problem this tab is about. Consider turning it on under Windows Security &gt; App &amp; browser control." />
                            </Border>
                            <UniformGrid Columns="2" Rows="3">
                                <TextBlock Margin="0,0,8,4"><Run Text="Controlled folder access: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding FeatureToggles.ControlledFolderAccessText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Network protection: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding FeatureToggles.NetworkProtectionText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="PUA protection: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding FeatureToggles.PuaProtectionText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Cloud-delivered protection: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding FeatureToggles.MapsReportingText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Sample submission: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding FeatureToggles.SubmitSamplesConsentText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,0,8,4"><Run Text="Cloud block level: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding FeatureToggles.CloudBlockLevelText, Mode=OneWay}" /></TextBlock>
                            </UniformGrid>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Controlled folder access allowed apps: " />
                                <Run Text="{Binding FeatureToggles.ControlledFolderAllowedApps, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- #869: policy/service diagnosis. -->
                    <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6"
                            Visibility="{Binding PolicyDiagnosis, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Policy / service diagnosis" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding PolicyDiagnosis.Verdict}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PolicyDiagnosis.Detail}" />
                        </StackPanel>
                    </Border>

                    <!-- #865: exclusion audit, extended. -->
                    <TextBlock Text="Defender exclusions (Paths/Extensions/Processes/IP addresses/Temporary paths - local + policy + WMI, deduped)"
                               TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <DataGrid IsReadOnly="True" MaxHeight="220" Margin="0,0,0,16" ItemsSource="{Binding ExclusionAudit}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2.4*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.6*" />
                            <DataGridTemplateColumn Header="Risk" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RiskReason}" TextWrapping="Wrap" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighRisk}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #867: per-rule ASR status + block/audit event timeline. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Attack Surface Reduction rules - configured status per rule (populated by Refresh above), plus what each rule actually blocked/audited recently."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding LoadAsrEventsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load ASR block/audit events" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingAsrEvents}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <DataGrid IsReadOnly="True" MaxHeight="200" Margin="0,0,0,8" ItemsSource="{Binding AsrRules}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Binding="{Binding FriendlyName}" Width="3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding ActionText}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding AsrEventStatus}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ListBox ItemsSource="{Binding AsrEventTimeline}" MaxHeight="140" Margin="0,0,0,16" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat=g}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text=" - " /><Run Text="{Binding EventType, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" - " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- #861: scan history. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Scan history - Defender Operational log events 1000 (started)/1001/1002 (completed variants), last 90 days."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding LoadScanHistoryCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load scan history" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingScanHistory}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ScanHistoryStatus}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ListBox ItemsSource="{Binding ScanHistoryTimeline}" MaxHeight="160" Margin="0,0,0,16" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat=g}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text=" - " /><Run Text="{Binding EventType, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- #862: threat detection history. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Threat detection history - MSFT_MpThreatDetection/MSFT_MpThreat plus Operational events 1116/1117, last 90 days."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding LoadThreatHistoryCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load threat history" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingThreatHistory}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding ThreatHistoryStatus}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <DataGrid IsReadOnly="True" MaxHeight="180" Margin="0,0,0,8" ItemsSource="{Binding ThreatDetections}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Detected" Binding="{Binding DetectionTime, StringFormat=g}" Width="1.2*" />
                            <DataGridTextColumn Header="Threat" Binding="{Binding ThreatName}" Width="2*" />
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="0.8*" />
                            <DataGridTextColumn Header="Action succeeded" Binding="{Binding ActionSuccess}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox ItemsSource="{Binding ThreatEventTimeline}" MaxHeight="140" Margin="0,0,0,16" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="12" TextWrapping="Wrap">
                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat=g}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text=" - " /><Run Text="{Binding EventType, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" - " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- #863: quarantine browser - owner-initiated Restore/Purge per row only. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Quarantine - items Defender has already quarantined (MpCmdRun.exe -Restore -ListAll). Restore/Purge never run automatically."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding LoadQuarantineCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load quarantine items" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingQuarantine}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding QuarantineStatus}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <DataGrid IsReadOnly="True" MaxHeight="220" Margin="0,0,0,16" ItemsSource="{Binding QuarantineItems}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Threat" Binding="{Binding ThreatName}" Width="1.6*" />
                            <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2.4*" />
                            <DataGridTextColumn Header="Detected" Binding="{Binding DetectionTimeText}" Width="1.2*" />
                            <DataGridTemplateColumn Header="Actions" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Restore" Margin="0,2,6,2" Padding="6,2"
                                                    Command="{Binding DataContext.RestoreQuarantineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Purge" Margin="0,2,0,2" Padding="6,2" Style="{StaticResource DangerButton}"
                                                    Command="{Binding DataContext.PurgeQuarantineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #864: run a scan - Quick/Full/folder/offline, streamed output, Cancel. -->
                    <TextBlock Text="Run a scan" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Quick scan" Margin="0,0,8,8" Command="{Binding RunQuickScanCommand}" />
                        <Button Content="Full scan" Margin="0,0,8,8" Command="{Binding RunFullScanCommand}" />
                        <Button Content="Scan this folder..." Margin="0,0,8,8" Command="{Binding RunFolderScanCommand}" />
                        <Button Content="Defender Offline scan..." Margin="0,0,8,8" Command="{Binding RunOfflineScanCommand}"
                                ToolTip="Runs Start-MpWDOScan - restarts the PC immediately. A prominent confirmation appears before this runs." />
                        <Button Content="Cancel" Margin="0,0,8,8" Style="{StaticResource DangerButton}" Command="{Binding CancelScanCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ScanRunStatus}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="8">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanOutputLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 18, #871-880: "Platform security" - HVCI/VBS detail/LSA protection (RunAsPPL)/
                 Kernel DMA Protection/vulnerable-driver blocklist/boot integrity switches (bcdedit)/
                 app control policy presence (WDAC/AppLocker/Smart App Control)/extended TPM detail/
                 Secure Boot detail/UAC configuration audit. See PlatformSecurityService for the read
                 logic - one Refresh button, one IsLoading flag, one StatusMessage, per this section's
                 own framing. -->
            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Platform security" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="HVCI/memory integrity, virtualization-based security detail, LSA protection, Kernel DMA Protection, the vulnerable-driver blocklist, boot integrity switches, app control policy (WDAC/AppLocker/Smart App Control), extended TPM detail, Secure Boot detail, and a UAC configuration audit - all read-only, on-demand." />
                        </StackPanel>
                        <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshPlatformSecurityCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Refresh platform security" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingPlatformSecurity}" Value="True">
                                                <Setter Property="Text" Value="Refreshing..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding PlatformSecurityStatus}" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />

                    <StackPanel Visibility="{Binding PlatformSecurity, Converter={StaticResource NullToVisibilityConverter}}">

                        <!-- #871: HVCI / memory integrity. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="HVCI / memory integrity" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap"><Run Text="Running: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Hvci.RunningText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   Configured: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Hvci.ConfiguredText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding PlatformSecurity.Hvci.ReasonText}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity: " />
                                    <Run Text="{Binding PlatformSecurity.Hvci.RegistryValuesText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- #872: VBS detail beyond the plain running flag. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Virtualization-based security detail" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding PlatformSecurity.VbsDetail.ExplanationText}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="Credential Guard running: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.VbsDetail.CredentialGuardRunningText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <TextBlock Margin="0,0,8,4" FontSize="11.5"><Run Text="Required: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.VbsDetail.RequiredPropertiesText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,4" FontSize="11.5"><Run Text="Available: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.VbsDetail.AvailablePropertiesText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,0" FontSize="11.5"><Run Text="Configured services: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.VbsDetail.ConfiguredServicesText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,0" FontSize="11.5"><Run Text="Running services: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.VbsDetail.RunningServicesText, Mode=OneWay}" /></TextBlock>
                                </UniformGrid>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Prerequisites - hypervisor active: " /><Run Text="{Binding PlatformSecurity.VbsDetail.HypervisorPresentText, Mode=OneWay}" />
                                    <Run Text=", firmware virtualization: " /><Run Text="{Binding PlatformSecurity.VbsDetail.VirtualizationFirmwareEnabledText, Mode=OneWay}" />
                                    <Run Text=", UEFI (via Secure Boot key): " /><Run Text="{Binding PlatformSecurity.VbsDetail.UefiSecureBootKeyPresentText, Mode=OneWay}" />
                                    <Run Text=", Secure Boot: " /><Run Text="{Binding PlatformSecurity.VbsDetail.SecureBootEnabledText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- #873: LSA protection (RunAsPPL) - display-only, no toggle. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="LSA protection (RunAsPPL)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap"><Run Text="RunAsPPL: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.LsaProtection.RunAsPPLText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   RunAsPPLBoot: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.LsaProtection.RunAsPPLBootText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Turning this on prevents unsigned/untrusted code from loading into lsass.exe, blocking a common credential-theft technique. It can also break legitimate LSA plugins, some third-party antivirus/EDR drivers, or other software that intentionally loads into lsass.exe - test before enabling broadly. Not a toggle here; change it via Windows Security &gt; Device security &gt; Core isolation, or the registry value directly." />
                                <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Related Microsoft-Windows-CodeIntegrity/Operational events (3065/3033 - what was blocked from loading into lsass), last 180 days:" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding PlatformSecurity.LsaProtection.EventLogUnavailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="Couldn't read the CodeIntegrity Operational event log (unavailable, access denied, or the channel isn't enabled)." />
                                </TextBlock>
                                <ListBox ItemsSource="{Binding PlatformSecurity.LsaProtection.RelatedEvents}" MaxHeight="100" Margin="0,2,0,0" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=g}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Run Text=" - Event " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                <Run Text=" - " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- #874: Kernel DMA Protection / IOMMU - honest "Unknown" is the expected
                             common outcome here, per the item's own explicit permission. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Kernel DMA Protection / IOMMU" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding PlatformSecurity.KernelDma.StatusText}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="IOMMU/VT-d: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.KernelDma.IommuText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- #875: vulnerable-driver blocklist state, cross-referenced against the
                             Persistence section's Kernel Driver entries. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Vulnerable driver blocklist" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap"><Run Text="VulnerableDriverBlocklistEnable: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.DriverBlocklist.EnabledText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Other values under HKLM\SYSTEM\CurrentControlSet\Control\CI\Config: " />
                                    <Run Text="{Binding PlatformSecurity.DriverBlocklist.OtherConfigValuesText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Checked against a small curated list of publicly reported vulnerable/abused (BYOVD) driver names - see Microsoft's published vulnerable driver blocklist for the authoritative list." />
                                <ItemsControl ItemsSource="{Binding PlatformSecurity.DriverBlocklist.PossibleMatches}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap">
                                                <Run Text="⚠ " /><Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" (" /><Run Text="{Binding ServiceName, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- #876: boot integrity switches, via bcdedit /enum {current}. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Boot configuration integrity switches" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding PlatformSecurity.BootIntegrity.RawFieldsText}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="testsigning/nointegritychecks/debug/safeboot/flightsigning, parsed from bcdedit /enum {current}. Any of these left ON after a driver-install workaround is a real, findable exposure - see the finding above if one is currently on." />
                            </StackPanel>
                        </Border>

                        <!-- #877: app control policy presence - WDAC/AppLocker/Smart App Control. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="App control policy presence" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap"><Run Text="WDAC enforcement (CodeIntegrityPolicyEnforcementStatus): " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.AppControl.CodeIntegrityEnforcementText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="WDAC policy files (CodeIntegrity\CiPolicies\Active\*.cip): " />
                                    <Run Text="{Binding PlatformSecurity.AppControl.WdacPolicyFilesText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="AppIDSvc (AppLocker): " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.AppControl.AppIdSvcStatusText, Mode=OneWay}" /></TextBlock>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding PlatformSecurity.AppControl.AppLockerRulesText}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="Smart App Control: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.AppControl.SmartAppControlText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Smart App Control blocks based on reputation, not just signature validity - a locally-built, unsigned executable is blocked outright while it's On. In Evaluation mode it watches your usage and can turn itself OFF permanently if certain apps/drivers trigger it; once off, re-enabling it requires a full OS reset." />
                            </StackPanel>
                        </Border>

                        <!-- #878: extended TPM detail, complementing the System Specs tab's own
                             (smaller) TPM card rather than replacing it. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="TPM detail" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Complements the TPM summary on the System Specs tab's Security card with a few extra Win32_Tpm fields." />
                                <UniformGrid Columns="3">
                                    <TextBlock Margin="0,0,8,4"><Run Text="Present: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.TpmDetail.PresentText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,4"><Run Text="Owned: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.TpmDetail.IsOwnedText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,4"><Run Text="Activated: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.TpmDetail.IsActivatedText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,0"><Run Text="Enabled: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.TpmDetail.IsEnabledText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,0"><Run Text="Spec version: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.TpmDetail.SpecVersion, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,0"><Run Text="Manufacturer: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.TpmDetail.ManufacturerIdText, Mode=OneWay}" /></TextBlock>
                                </UniformGrid>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Manufacturer version: " /><Run Text="{Binding PlatformSecurity.TpmDetail.ManufacturerVersion, Mode=OneWay}" />
                                    <Run Text="  Version info: " /><Run Text="{Binding PlatformSecurity.TpmDetail.ManufacturerVersionInfo, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Lockout count: " /><Run Text="{Binding PlatformSecurity.TpmDetail.LockoutCountText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource WarningBrush}"
                                           Visibility="{Binding PlatformSecurity.TpmDetail.ShowAdvisoryCaveat, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Worth a manual check against your TPM vendor's published advisories for this firmware version - this app has no live advisory database to check against automatically." />
                            </StackPanel>
                        </Border>

                        <!-- #879: Secure Boot detail - setup mode + DBX recency, or one clear legacy-
                             BIOS message in place of several confusing per-field Unknowns. -->
                        <Border Padding="10,8" Margin="0,0,0,12" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Secure Boot detail" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap"
                                           Visibility="{Binding PlatformSecurity.SecureBootDetail.KeyMissing, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Legacy BIOS boot - Secure Boot not applicable." />
                                <StackPanel Visibility="{Binding PlatformSecurity.SecureBootDetail.KeyPresent, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock TextWrapping="Wrap"><Run Text="Enabled: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.SecureBootDetail.EnabledText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   Setup mode: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.SecureBootDetail.SetupModeText, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Setup mode means Secure Boot policy isn't fully enforced - itself a red flag if seen outside an active firmware update/reconfiguration." />
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="DBX (revocation list) last updated: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.SecureBootDetail.DbxRecencyText, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- #880: UAC configuration audit. -->
                        <Border Padding="10,8" Margin="0,0,0,0" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="UAC configuration audit" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding PlatformSecurity.Uac.SliderPositionText}" />
                                <UniformGrid Columns="3" Margin="0,6,0,0">
                                    <TextBlock Margin="0,0,8,4" FontSize="11.5"><Run Text="EnableLUA: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Uac.EnableLUA, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,4" FontSize="11.5"><Run Text="ConsentPromptBehaviorAdmin: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Uac.ConsentPromptBehaviorAdmin, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,4" FontSize="11.5"><Run Text="ConsentPromptBehaviorUser: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Uac.ConsentPromptBehaviorUser, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,0" FontSize="11.5"><Run Text="PromptOnSecureDesktop: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Uac.PromptOnSecureDesktop, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,8,0" FontSize="11.5"><Run Text="FilterAdministratorToken: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Uac.FilterAdministratorToken, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Margin="0,0,0,0" FontSize="11.5"><Run Text="EnableInstallerDetection: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding PlatformSecurity.Uac.EnableInstallerDetection, Mode=OneWay}" /></TextBlock>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
