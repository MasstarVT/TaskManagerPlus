<UserControl x:Class="TaskManagerPlus.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- #707: "this boot was Nx your normal" quick flag - a flag, not a verdict, sitting
                 at the very top of the tab. Collapsed whenever there's no meaningful regression
                 (or not enough same-boot-type history yet to judge against) - see
                 BootPerformanceService.ComputeRegressionFlag. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RegressionFlag}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"
                               Text="{Binding RegressionFlag.Message}" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Text="Quick flag, not a verdict - a one-off slow boot (e.g. an update finishing up) can look identical to a persistent slowdown." />
                    <ItemsControl ItemsSource="{Binding RegressionFlag.DegradationRows}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                    <TextBlock FontSize="11.5">
                                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Run Text=" — " /><Run Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text=": " /><Run Text="{Binding ImpactMs, Converter={StaticResource BootMsToSecondsConverter}}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="Apps that launch automatically when you sign in."
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>

            <DataGrid Height="280"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceDescription}" Width="1.5*" />
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="3*" />
                    <!-- #18: signed/unsigned trust badge, reusing SignatureCheckService's shared
                         per-file-path cache (extracted from ProcessMonitorService in Round 2). -->
                    <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- #21: file size and last-modified time of the target executable. -->
                    <DataGridTextColumn Header="Size" Binding="{Binding FileSizeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" Width="90" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedUtc, StringFormat={}{0:d}, TargetNullValue=Unknown}" Width="90" />
                    <!-- #91: measured (not estimated) delay since boot, for whichever items are
                         still running - see StartupDelayService's remarks. -->
                    <DataGridTextColumn Header="Measured delay" Binding="{Binding MeasuredDelayText}" Width="1.3*" />
                    <!-- #22: combined startup-impact score, blending the measured delay above with
                         a quick CPU/memory footprint sample of the running process. -->
                    <DataGridTemplateColumn Header="Impact" Width="110" SortMemberPath="ImpactText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ImpactText}" VerticalAlignment="Center" ToolTip="{Binding ImpactDetailText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactText}" Value="Medium impact">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactText}" Value="High impact">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding IsEnabled, Converter={StaticResource BoolToEnableDisableTextConverter}}"
                                        Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,3">
                                    <Button.Style>
                                        <!-- A Style can't swap its own element's Style via a Setter (WPF throws
                                             "Style object is not allowed to affect the Style property of the object
                                             to which it applies" the moment the row is virtualized/realized), so the
                                             Danger/Success looks are inlined here instead of swapped in wholesale. -->
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- #89/#90: boot time breakdown for the most recent boot (adaptive field list - see
                 BootPerformanceService's remarks on why field names/count aren't fixed) plus a
                 small self-recorded trend across sessions. Hidden entirely when the event log has
                 no boot-100 entry to read (an unusual, but possible, condition). -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BootBreakdown}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Boot performance" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap">
                        <Run Text="Last boot: " /><Run Text="{Binding BootBreakdown.BootTime, StringFormat={}{0:g}, Mode=OneWay}" />
                        <Run Text=" · Total " /><Run Text="{Binding BootBreakdown.TotalMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding BootBreakdown.Type, Converter={StaticResource BootTypeToLabelConverter}, Mode=OneWay}" />
                    </TextBlock>

                    <!-- #704: firmware POST time from the ACPI FPDT - realistically "Unknown" on
                         most systems, with SubText explaining why (see FirmwareBootTime's remarks). -->
                    <views:VfdMeter Title="Last BIOS time" Glow="False" Margin="0,0,0,14" HorizontalAlignment="Left" Width="220"
                                     ValueText="{Binding FirmwareBootTime.Milliseconds, Converter={StaticResource BootMsToSecondsConverter}}"
                                     SubText="{Binding FirmwareBootTime.UnavailableReason}" AccentBrush="{DynamicResource AccentBrush}" />

                    <!-- #703: main-path/post-boot/other phases as a stacked bar rather than a
                         plain sorted list, with fixed reference markers at Microsoft's own
                         "healthy boot" guidance - main path under ~20s (150px here), post-boot
                         under ~10s more (225px cumulative) - see BootPhaseMsToWidthConverter's
                         remarks for the 40s/300px scale these marker positions are computed from. -->
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootBreakdown.MainPathBootMs}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Boot phases vs. healthy-boot reference" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <Grid Height="26" Width="300" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="4" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4,0,0,4"
                                        Width="{Binding BootBreakdown.MainPathBootMs, Converter={StaticResource BootPhaseMsToWidthConverter}}" />
                                <Border Background="{DynamicResource WarningBrush}"
                                        Width="{Binding BootBreakdown.PostBootMs, Converter={StaticResource BootPhaseMsToWidthConverter}}" />
                                <Border Background="{DynamicResource BorderBrush2}" CornerRadius="0,4,4,0"
                                        Width="{Binding BootBreakdown.OtherMs, Converter={StaticResource BootPhaseMsToWidthConverter}}" />
                            </StackPanel>
                            <Rectangle Width="2" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="150,0,0,0" ToolTip="~20s healthy-boot target for main path" />
                            <Rectangle Width="2" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="225,0,0,0" ToolTip="~10s more healthy-boot target for post-boot (30s cumulative)" />
                        </Grid>
                        <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Main path " /><Run Text="{Binding BootBreakdown.MainPathBootMs, Converter={StaticResource BootMsToSecondsConverter}}" FontWeight="SemiBold" />
                            <Run Text=" · Post-boot " /><Run Text="{Binding BootBreakdown.PostBootMs, Converter={StaticResource BootMsToSecondsConverter}}" FontWeight="SemiBold" />
                            <Run Text=" · red lines mark Microsoft's healthy-boot reference" />
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding BootBreakdown.Components}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                    <TextBlock FontSize="11.5">
                                        <Run Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Milliseconds, Converter={StaticResource BootMsToSecondsConverter}}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #701: sibling degradation events (101/102/103/106/109/110) that belong to
                         this specific boot - "what slowed this boot down". Collapsed when the
                         channel has nothing for this boot (a genuinely clean boot, or the channel
                         isn't available). -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThisBootDegradations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="What slowed this boot down" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ThisBootDegradations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8" MaxWidth="260">
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Category}" />
                                                <Run Text=" · " /><Run Text="{Binding ImpactMs, Converter={StaticResource BootMsToSecondsConverter}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- #90: boot time trend, one point per session this app has been run in -
                         collapsed until there are at least two recorded boots to compare. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootHistoryMs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BootHistoryMs.Count}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Trend across sessions" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <lvc:CartesianChart Series="{Binding BootHistorySeries}" XAxes="{Binding BootHistoryXAxes}" YAxes="{Binding BootHistoryYAxes}"
                                             Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                        <!-- #706: median boot time split by boot type - the single most common
                             reason a user's perceived boot time swings wildly (a Fast Startup
                             resume vs. a full restart). Collapsed until at least one boot has a
                             known type. -->
                        <TextBlock Text="{Binding BootTypeStatsText}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BootTypeStatsText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #702: slow-boot culprit board - the 101/102/103/109 rows from above, grouped by
                 name across every boot the channel still retains and ranked by summed
                 degradation time, so a driver that costs a few seconds on every boot outranks a
                 one-off long stall. Collapsed when the channel has nothing to rank. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SlowBootCulprits.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Slow-boot culprit board" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Ranked by total time cost across every boot still retained in the event log - a repeat offender outranks a one-off stall." />
                    <ItemsControl ItemsSource="{Binding SlowBootCulprits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AppearedText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                                                    Text="{Binding TotalDegradationMs, Converter={StaticResource BootMsToSecondsConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #79/#80: Scheduled Tasks - a huge, often-overlooked source of background
                 slowdowns and unwanted auto-launches the registry-Run/Startup-folder scan above
                 doesn't cover at all. Loaded on demand (a couple of seconds on a system with
                 hundreds of tasks), not up front. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Scheduled Tasks - a second, often-larger source of background auto-launches."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="Check logon delay"
                                Command="{Binding CheckLogonDelayCommand}" />
                        <Button Grid.Column="2" Margin="0,0,8,0" Content="Enable/Disable"
                                Command="{Binding ToggleScheduledTaskCommand}" CommandParameter="{Binding SelectedScheduledTask}" />
                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadScheduledTasksCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load scheduled tasks" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingScheduledTasks}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <DataGrid Height="280" ItemsSource="{Binding ScheduledTasks}" SelectedItem="{Binding SelectedScheduledTask}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.5*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Next run" Binding="{Binding NextRunTime}" Width="150" />
                            <DataGridTextColumn Header="Last result" Binding="{Binding LastResult}" Width="90" />
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="140" />
                            <!-- #80: logon-trigger delay - blank until "Check logon delay" is
                                 clicked for the selected row, see StartupViewModel.CheckLogonDelayAsync. -->
                            <DataGridTextColumn Header="Logon delay" Binding="{Binding DelayText}" Width="150" />
                            <!-- #23 (Round 8): "Only when logged on" vs. "Whether or not logged
                                 on" - a distinct startup-impact category, since the latter can run
                                 work even at the lock screen. Populated by the same "Check logon
                                 delay" click as the column above. -->
                            <DataGridTemplateColumn Header="Runs" Width="170" SortMemberPath="RunModeText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RunModeText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RunModeText}" Value="Whether or not user is logged on">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Task to run" Binding="{Binding TaskToRun}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #19: browser extension inventory (Chrome/Edge/Firefox) - a common, currently
                 invisible source of "slow startup"/"slow browsing" complaints, since extensions
                 load with the browser rather than through any Windows startup mechanism. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Browser extensions - Chrome, Edge, and Firefox."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadBrowserExtensionsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load browser extensions" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingBrowserExtensions}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <DataGrid Height="220" ItemsSource="{Binding BrowserExtensions}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="100" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #20: registered Explorer shell extensions (context-menu handlers / icon-overlay
                 COM add-ins) - a classic cause of a slow right-click menu. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Explorer shell extensions - context-menu handlers and icon overlays."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadShellExtensionsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load shell extensions" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingShellExtensions}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <DataGrid Height="220" ItemsSource="{Binding ShellExtensions}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="2*" />
                            <DataGridTextColumn Header="Approved" Binding="{Binding ApprovedText}" Width="90" />
                            <DataGridTextColumn Header="DLL" Binding="{Binding DllPath}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
