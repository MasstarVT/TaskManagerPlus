<UserControl x:Class="TaskManagerPlus.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- #725: boot-mode/driver-signature-integrity flag banner - a quick flag, not a
                 verdict (see BootModeFlag's remarks: testsigning/debug/safeboot flags are all
                 routinely on deliberately), sitting at the very top of the tab. Collapsed
                 whenever the current boot entry has none of these set (the common case). Each
                 flag can be cleared below with a one-click action that confirms the exact
                 bcdedit command first. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BootModeFlags.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"
                               Text="This boot entry has one or more boot-mode/driver-signature flags set." />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Text="Quick flag, not a verdict - these are routinely on deliberately (driver development, troubleshooting a boot failure). Each can be cleared below, with confirmation." />
                    <ItemsControl ItemsSource="{Binding BootModeFlags}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding OptionName}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Message}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Clear this flag" Padding="8,3" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ClearBootModeFlagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #707: "this boot was Nx your normal" quick flag - a flag, not a verdict.
                 Collapsed whenever there's no meaningful regression (or not enough same-boot-type
                 history yet to judge against) - see BootPerformanceService.ComputeRegressionFlag. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RegressionFlag}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"
                               Text="{Binding RegressionFlag.Message}" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Text="Quick flag, not a verdict - a one-off slow boot (e.g. an update finishing up) can look identical to a persistent slowdown." />
                    <ItemsControl ItemsSource="{Binding RegressionFlag.DegradationRows}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                    <TextBlock FontSize="11.5">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" — " /><Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text=": " /><Run Text="{Binding ImpactMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="Apps that launch automatically when you sign in."
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>

            <DataGrid Height="280"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding SourceDescription}" Width="1.5*" />
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="3*" />
                    <!-- #837: signing certificate's subject CN (falls back to issuer CN, then
                         "Unknown"); self-signed called out separately. -->
                    <DataGridTemplateColumn Header="Publisher" Width="140" SortMemberPath="Publisher">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Publisher, Mode=OneWay}" />
                                    <Run Text=" (self-signed)" Foreground="{DynamicResource WarningBrush}" FontSize="11">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Text" Value="" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelfSigned}" Value="True">
                                                        <Setter Property="Text" Value=" (self-signed)" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- #18: signed/unsigned trust badge, reusing SignatureCheckService's shared
                         per-file-path cache (extracted from ProcessMonitorService in Round 2). -->
                    <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- #21: file size and last-modified time of the target executable. -->
                    <DataGridTextColumn Header="Size" Binding="{Binding FileSizeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" Width="90" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedUtc, StringFormat={}{0:d}, TargetNullValue=Unknown}" Width="90" />
                    <!-- #91: measured (not estimated) delay since boot, for whichever items are
                         still running - see StartupDelayService's remarks. -->
                    <DataGridTextColumn Header="Measured delay" Binding="{Binding MeasuredDelayText}" Width="1.3*" />
                    <!-- #748: median across this item's persisted startup-history.json sample
                         history, plus a small trend sparkline, instead of trusting the single
                         (volatile) scan above on its own - see StartupHistoryService. -->
                    <DataGridTextColumn Header="Median delay" Binding="{Binding MedianDelayText}" Width="1.2*" />
                    <DataGridTemplateColumn Header="Trend" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Viewbox Width="56" Height="16" Stretch="Fill" HorizontalAlignment="Left" ToolTip="{Binding DelayTrendFlag}">
                                    <Canvas Width="60" Height="18">
                                        <Polyline Points="{Binding SparklinePointsText}" StrokeThickness="1.6">
                                            <Polyline.Style>
                                                <Style TargetType="Polyline">
                                                    <!-- #748: red when the growth flag fired (see StartupHistoryService.BuildStats),
                                                         muted otherwise - default assumes flagged so the x:Null trigger only has to
                                                         cover the (far more common) "no flag" case. -->
                                                    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DelayTrendFlag}" Value="{x:Null}">
                                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Polyline.Style>
                                        </Polyline>
                                    </Canvas>
                                </Viewbox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- #22: combined startup-impact score, blending the measured delay above with
                         a quick CPU/memory footprint sample of the running process. -->
                    <DataGridTemplateColumn Header="Impact" Width="110" SortMemberPath="ImpactText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ImpactText}" VerticalAlignment="Center" ToolTip="{Binding ImpactDetailText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImpactText}" Value="Medium impact">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ImpactText}" Value="High impact">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- #742: disabled (not hidden) for a location with no StartupApproved
                                     equivalent - see StartupItem.SupportsToggle - so it's still obvious
                                     the row exists and why it can't be toggled here. -->
                                <Button Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding SupportsToggle}"
                                        ToolTip="No approval flag exists for this autorun location - it can be seen here but not toggled."
                                        Padding="10,3">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding IsEnabled, Converter={StaticResource BoolToEnableDisableTextConverter}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SupportsToggle}" Value="False">
                                                        <Setter Property="Text" Value="No toggle" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button.Style>
                                        <!-- A Style can't swap its own element's Style via a Setter (WPF throws
                                             "Style object is not allowed to affect the Style property of the object
                                             to which it applies" the moment the row is virtualized/realized), so the
                                             Danger/Success looks are inlined here instead of swapped in wholesale. -->
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SupportsToggle}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <!-- #712: boot-data availability explainer - shown in place of the boot performance
                 card below whenever BootPerformanceService.ReadLatest() came back null, so the
                 tab explains *why* rather than just going quiet. See BootDataAvailability's
                 remarks for what each case means. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BootBreakdown}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BootDataAvailability}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Boot performance data unavailable" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding BootDataAvailability.ExplanationText}" />
                    <Button Content="Enable diagnostics channel" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding EnableDiagnosticsChannelCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootDataAvailability.CanOfferEnable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- #89/#90: boot time breakdown for the most recent boot (adaptive field list - see
                 BootPerformanceService's remarks on why field names/count aren't fixed) plus a
                 small self-recorded trend across sessions. Hidden entirely when the event log has
                 no boot-100 entry to read (an unusual, but possible, condition). -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BootBreakdown}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Boot performance" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <!-- #713: cross-link over to the Stability tab's "Power & boot timeline" -
                             see StartupView.xaml.cs's ViewPowerTimeline_Click. -->
                        <Button Grid.Column="1" Content="View power &amp; boot timeline" Padding="8,3" FontSize="11.5"
                                Click="ViewPowerTimeline_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap">
                        <Run Text="Last boot: " /><Run Text="{Binding BootBreakdown.BootTime, StringFormat={}{0:g}, Mode=OneWay}" />
                        <Run Text=" · Total " /><Run Text="{Binding BootBreakdown.TotalMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding BootBreakdown.Type, Converter={StaticResource BootTypeToLabelConverter}, Mode=OneWay}" />
                    </TextBlock>

                    <!-- #704: firmware POST time from the ACPI FPDT - realistically "Unknown" on
                         most systems, with SubText explaining why (see FirmwareBootTime's remarks). -->
                    <views:VfdMeter Title="Last BIOS time" Glow="False" Margin="0,0,0,14" HorizontalAlignment="Left" Width="220"
                                     ValueText="{Binding FirmwareBootTime.Milliseconds, Converter={StaticResource BootMsToSecondsConverter}}"
                                     SubText="{Binding FirmwareBootTime.UnavailableReason}" AccentBrush="{DynamicResource AccentBrush}" />

                    <!-- #703: main-path/post-boot/other phases as a stacked bar rather than a
                         plain sorted list, with fixed reference markers at Microsoft's own
                         "healthy boot" guidance - main path under ~20s (150px here), post-boot
                         under ~10s more (225px cumulative) - see BootPhaseMsToWidthConverter's
                         remarks for the 40s/300px scale these marker positions are computed from. -->
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootBreakdown.MainPathBootMs}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Boot phases vs. healthy-boot reference" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <Grid Height="26" Width="300" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="4" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4,0,0,4"
                                        Width="{Binding BootBreakdown.MainPathBootMs, Converter={StaticResource BootPhaseMsToWidthConverter}}" />
                                <Border Background="{DynamicResource WarningBrush}"
                                        Width="{Binding BootBreakdown.PostBootMs, Converter={StaticResource BootPhaseMsToWidthConverter}}" />
                                <Border Background="{DynamicResource BorderBrush2}" CornerRadius="0,4,4,0"
                                        Width="{Binding BootBreakdown.OtherMs, Converter={StaticResource BootPhaseMsToWidthConverter}}" />
                            </StackPanel>
                            <Rectangle Width="2" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="150,0,0,0" ToolTip="~20s healthy-boot target for main path" />
                            <Rectangle Width="2" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="225,0,0,0" ToolTip="~10s more healthy-boot target for post-boot (30s cumulative)" />
                        </Grid>
                        <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Main path " /><Run Text="{Binding BootBreakdown.MainPathBootMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · Post-boot " /><Run Text="{Binding BootBreakdown.PostBootMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · red lines mark Microsoft's healthy-boot reference" />
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding BootBreakdown.Components}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                    <TextBlock FontSize="11.5">
                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Milliseconds, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #701: sibling degradation events (101/102/103/106/109/110) that belong to
                         this specific boot - "what slowed this boot down". Collapsed when the
                         channel has nothing for this boot (a genuinely clean boot, or the channel
                         isn't available). -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThisBootDegradations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="What slowed this boot down" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ThisBootDegradations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8" MaxWidth="260">
                                        <StackPanel>
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Category, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding ImpactMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- #90: boot time trend, one point per session this app has been run in -
                         collapsed until there are at least two recorded boots to compare. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootHistoryMs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BootHistoryMs.Count}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Trend across sessions" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <lvc:CartesianChart Series="{Binding BootHistorySeries}" XAxes="{Binding BootHistoryXAxes}" YAxes="{Binding BootHistoryYAxes}"
                                             Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                        <!-- #706: median boot time split by boot type - the single most common
                             reason a user's perceived boot time swings wildly (a Fast Startup
                             resume vs. a full restart). Collapsed until at least one boot has a
                             known type. -->
                        <TextBlock Text="{Binding BootTypeStatsText}" Margin="0,8,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BootTypeStatsText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #715/#716/#717: Sign-in breakdown - Winlogon notification-subscriber timing,
                 Group Policy total processing time charted per boot, and the ranked slowest
                 client-side-extension list. See LogonDiagnosticsService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Sign-in breakdown" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Who Windows spent time waiting on during the last sign-in: Winlogon notification subscribers (GPClient, Profiles, TermSrv, Sens, ...) plus Group Policy processing time." />

                    <!-- #715 -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SignInSubscriberTimings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Winlogon notification subscribers" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding SignInSubscriberTimings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock FontSize="11.5">
                                            <Run Text="{Binding SubscriberName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=": " /><Run Text="{Binding DurationMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- #716 -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding GpComputerPolicyMs.Count}" Value="0" />
                                            <Condition Binding="{Binding GpUserPolicyMs.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Group Policy total processing time (per boot/sign-in)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <lvc:CartesianChart Series="{Binding GroupPolicyProcessingSeries}" XAxes="{Binding GroupPolicyProcessingXAxes}" YAxes="{Binding GroupPolicyProcessingYAxes}"
                                             Height="120" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                    </StackPanel>

                    <!-- #717 -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SlowestGroupPolicyExtensions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Slowest Group Policy client-side extensions" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding SlowestGroupPolicyExtensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ExtensionName}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}" Text=" (slow/warned)" Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WasSlowOrWarned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"
                                                       Text="{Binding ElapsedMs, Converter={StaticResource BootMsToSecondsConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #718: synchronous foreground policy audit - read-only, each value explained in
                 plain language. See SyncForegroundPolicyAudit's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SyncForegroundAudit}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Synchronous foreground policy" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="These policy values, when configured by a domain administrator, force the desktop to wait for policy/scripts to finish before sign-in completes - a classic 'domain PC takes 3 minutes to sign in' cause." />
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SyncForegroundAudit.AnyForcesSynchronousWait}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="Quick flag, not a verdict - at least one policy below forces sign-in to wait synchronously. This is often intentional on a domain-managed PC, but is a common cause of a slow sign-in." />
                    </Border>
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="SyncForegroundPolicy" />
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding SyncForegroundAudit.SyncForegroundPolicyText}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="GpNetworkStartTimeoutPolicyValue" />
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding SyncForegroundAudit.GpNetworkStartTimeoutText}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="RunLogonScriptSync" />
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding SyncForegroundAudit.RunLogonScriptSyncText}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="DelayedDesktopSwitchTimeout" />
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding SyncForegroundAudit.DelayedDesktopSwitchTimeoutText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #719: logon/startup/logoff/shutdown script inventory, plus the legacy
                 UserInitMprLogonScript value - each script's existence/last-modified time, with an
                 unresolvable (configured but missing) path flagged. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogonScripts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Logon &amp; startup scripts" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Local Group Policy scripts and the legacy per-user logon script value - each runs (or is supposed to run) as part of sign-in." />
                    <ItemsControl ItemsSource="{Binding LogonScripts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Category, Mode=OneWay}" /><Run Text="  " />
                                            <Run Text="{Binding StatusText, Mode=OneWay}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Exists}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                            <Run Text="{Binding Path, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding LastModifiedUtc, StringFormat={}{0:g}, TargetNullValue=Unknown, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #720/#721/#722/#723: Profile health - load duration, on-demand size walk, temp/
                 corrupt profile detection, roaming profile audit, and registry-handle-leak
                 (slow-logoff) detection, all correlated off the same ProfileList registry scan
                 and User Profile Service event reads. See ProfileDiagnosticsService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfileListEntries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Profile health" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Profile load time, every profile Windows knows about on this machine (temp/corrupt/roaming flags), and registry hives still held open by another process after sign-out." />

                    <!-- #720: profile load duration -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileLoadTimings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Profile load duration" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ProfileLoadTimings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock FontSize="11.5">
                                            <Run Text="{Binding LoadStart, StringFormat={}{0:g}, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text=": " /><Run Text="{Binding DurationMs, Converter={StaticResource BootMsToSecondsConverter}, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- #721/#722: every SID this machine's ProfileList knows about, with a
                         per-row "Measure size" button (#720) and a flag summary
                         (.bak/state/refcount/missing-path/roaming). -->
                    <ItemsControl ItemsSource="{Binding ProfileListEntries}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LooksLikeTempOrCorrupt}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ProfileImagePath, TargetNullValue=(unknown path), Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding Sid, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Padding="8,2" FontSize="11" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.MeasureProfileSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Measure size" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMeasuringSize}" Value="True">
                                                                    <Setter Property="Text" Value="Measuring..." />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LooksLikeTempOrCorrupt}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding FlagSummary, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SizeInfo}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding SizeInfo.SummaryText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #722: roaming-profile-only subset - collapses entirely on a machine with
                         no roaming profiles configured. -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RoamingProfiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Roaming profiles" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding RoamingProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                            <Run Text="{Binding Sid, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" → " /><Run Text="{Binding CentralProfile, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Related roaming-profile events (copy/sync errors) appear below, under &quot;Registry &amp; roaming profile events.&quot;"
                                   Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- #721/#722: correlated User Profile Service events (1500/1502/1511/1515
                         temp/corrupt family, 1509/1521 roaming copy/sync errors). -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileServiceEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Registry &amp; roaming profile events" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ProfileServiceEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <Run Text="{Binding CategoryText, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text=")" />
                                                <Run Text="  " /><Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Message}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- #723: registry-handle-leak / slow-logoff detection (event 1530), each
                         offending process name cross-linked to the Processes tab. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegistryHandleLeaks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Registry handle leaks (slow sign-out/shutdown)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding RegistryHandleLeaks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,6" Text="{Binding Message}" />
                                            <ItemsControl ItemsSource="{Binding LeakedProcessNames}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}" Tag="{Binding}" Padding="8,3" FontSize="11" Margin="0,0,6,6"
                                                                Click="ViewLeakedProcessInProcesses_Click"
                                                                ToolTip="View this process on the Processes tab" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #708: boot-start/system-start driver and service load failures (Service Control
                 Manager 7026/7000/7001) - cross-linked to the Services tab's driver list. Collapsed
                 when nothing failed to load this boot (the common case). -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DriverLoadFailures.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Drivers that failed to load at boot" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="View drivers in Services tab" Padding="8,3" FontSize="11.5"
                                Click="ViewDriversInServices_Click" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DriverLoadFailures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding CategoryText, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #714: BootExecute audit (autochk/chkdsk-at-boot detection) - the raw registry
                 value plus a plain-language reading, a flag not a verdict (see BootExecuteInfo's
                 remarks). Styled as a warning card only when it differs from the stock entry. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BootExecuteInfo}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Boot-time tasks (BootExecute)" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                        <Run Text="Raw value: " /><Run Text="{Binding BootExecuteInfo.RawValueText, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootExecuteInfo.IsStock}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding BootExecuteInfo.Explanation, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #711: Prefetcher/ReadyBoot configuration audit - flags the common "a debloat guide
                 told me to disable this" case (boot prefetching off on a spinning disk), see
                 PrefetchAuditResult.LooksLikeMistake's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PrefetchAudit}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Prefetcher / ReadyBoot configuration" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding PrefetchAudit.SummaryText}" />
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrefetchAudit.LooksLikeMistake}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="Quick flag, not a verdict - boot prefetching looks disabled on a spinning (HDD) system drive, a common side effect of a &quot;debloat guide&quot;. Prefetch/Superfetch generally help on an HDD; this is usually worth turning back on." />
                    </Border>
                    <Button Content="Restore Windows defaults" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding RestorePrefetchDefaultsCommand}" />
                </StackPanel>
            </Border>

            <!-- #709: "Capture a boot log" - a two-step, opt-in workflow (bcdedit bootlog + ntbtlog.txt
                 parse), never armed silently - see BootLogCaptureService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Capture a boot log" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Turns on Windows boot logging, then parses %windir%\ntbtlog.txt for every &quot;Did not load driver&quot; line (plus load ordering) after you restart and reopen this app." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Capture a boot log" Command="{Binding ArmBootLogCaptureCommand}" Margin="0,0,8,0" />
                        <Button Content="Turn boot logging off" Command="{Binding DisarmBootLogCaptureCommand}" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" FontSize="11.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBootLogCaptureArmed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Armed - restart your PC, then reopen this app." />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NtbtlogResult}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,6">
                            <Run Text="Captured " /><Run Text="{Binding NtbtlogResult.CapturedAtUtc, StringFormat={}{0:g}, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding NtbtlogResult.FailedDrivers.Count, Mode=OneWay}" /><Run Text=" driver(s) did not load" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding NtbtlogResult.FailedDrivers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8" MaxWidth="320">
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                            <Run Text="{Binding Order, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text=". " /><Run Text="{Binding DriverPath, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #710: one-click boot ETW trace via the Windows Performance Recorder - hidden
                 entirely when wpr.exe isn't present. Same two-step, opt-in shape as boot log
                 capture above - see BootEtwTraceService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBootEtwTraceAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Boot ETW trace (deep dive)" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Arms a Windows Performance Recorder boot trace; after you restart and reopen this app, the trace is collected automatically and can be opened in WPA." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Arm boot trace" Command="{Binding ArmBootEtwTraceCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding DisarmBootEtwTraceCommand}" Margin="0,0,8,0" />
                        <Button Content="Open in WPA" Command="{Binding OpenEtlInWpaCommand}" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}" FontSize="11.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBootEtwTraceArmed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Armed - restart your PC, then reopen this app." />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastEtlPath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Last collected trace: " /><Run Text="{Binding LastEtlPath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #702: slow-boot culprit board - the 101/102/103/109 rows from above, grouped by
                 name across every boot the channel still retains and ranked by summed
                 degradation time, so a driver that costs a few seconds on every boot outranks a
                 one-off long stall. Collapsed when the channel has nothing to rank. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SlowBootCulprits.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Slow-boot culprit board" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Ranked by total time cost across every boot still retained in the event log - a repeat offender outranks a one-off stall." />
                    <ItemsControl ItemsSource="{Binding SlowBootCulprits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AppearedText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                                                    Text="{Binding TotalDegradationMs, Converter={StaticResource BootMsToSecondsConverter}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #724-731: Boot configuration (BCD inspector) - one shared BcdInspectorService
                 snapshot behind every one of these; see StartupViewModel's #724-731 region and
                 BcdInspectorService's remarks. Read-only by default; every mutating action shows
                 the exact bcdedit command first and asks for confirmation. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Boot configuration" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Everything Windows' Boot Configuration Data (BCD) store controls about how this PC starts. Read-only by default - every change here shows the exact bcdedit command and asks for confirmation first." />

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBcdAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Boot configuration data isn't available: " /><Run Text="{Binding BcdUnavailableReason, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBcdAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- #727: performance-trap BCD options - collapsed when the current boot
                             entry has none of these set (the common case). -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PerformanceTrapOptions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Performance-limiting boot options" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                                           Text="Quick flag, not a verdict - these BCD options cap what hardware Windows will actually use at boot, which can look exactly like a hardware problem." />
                            </Border>
                            <ItemsControl ItemsSource="{Binding PerformanceTrapOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                    <Run Text="{Binding OptionName, Mode=OneWay}" /><Run Text="  " />
                                                    <Run Text="{Binding RawValue, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                           Text="{Binding ObservedEffect}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- #728: boot status policy / auto-repair audit. -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BootStatusPolicy}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Boot status policy &amp; auto-repair" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <Border CornerRadius="6" Padding="10,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BootStatusPolicy.DisablesStartupRepair}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="bootstatuspolicy: " FontWeight="SemiBold" /><Run Text="{Binding BootStatusPolicy.PolicyText, Mode=OneWay}" />
                                        <Run Text="   ·   recoveryenabled: " FontWeight="SemiBold" /><Run Text="{Binding BootStatusPolicy.RecoveryText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BootStatusPolicy.DisablesStartupRepair}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding BootStatusPolicy.SummaryText, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="Restore to Windows defaults" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding RestoreBootStatusPolicyCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BootStatusPolicy.DisablesStartupRepair}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- #729: boot menu / multi-OS entry list. -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BootMenuInfo}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Boot menu" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="Show boot menu: " FontWeight="SemiBold" /><Run Text="{Binding BootMenuInfo.DisplayBootMenuText, Mode=OneWay}" />
                                <Run Text="   ·   Timeout: " FontWeight="SemiBold" /><Run Text="{Binding BootMenuInfo.TimeoutText, Mode=OneWay}" />
                                <Run Text="   ·   Default: " FontWeight="SemiBold" /><Run Text="{Binding BootMenuInfo.DefaultDescription, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="70" Text="{Binding BootTimeoutInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Boot menu timeout, in seconds" />
                                <Button Content="Set timeout" Command="{Binding SetBootTimeoutCommand}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BootMenuInfo.DisplayOrder}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Identifier}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Padding="8,3" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.SetDefaultEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Content" Value="Set as default" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="Content" Value="Default" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- #730: UEFI firmware boot order - read-only listing plus a copyable
                             fix command (never run automatically). -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FirmwareBootOrder.DisplayOrder.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="UEFI firmware boot order" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirmwareBootOrder.WindowsBootManagerFirst}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                                               Text="Windows Boot Manager isn't first in the UEFI firmware boot order - another entry (another OS, a network/PXE boot, a USB device) will be tried first at power-on." />
                                    <TextBlock FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding FirmwareBootOrder.SuggestedFixCommand}" />
                                    <Button Content="Copy fix command" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding CopyFirmwareDisplayOrderFixCommand}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FirmwareBootOrder.DisplayOrder}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LooksStale}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Description, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding Identifier, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- #731: BCD backup and export - restore is never automated, only the
                             matching `bcdedit /import` command is shown. -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="BCD backups" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Every mutating action above exports a full copy of the BCD store first, automatically. Restore is never automated - copy the import command and run it yourself, from an elevated command prompt, if you ever need to roll back." />
                            <Button Content="Back up BCD now" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding ExportBcdBackupCommand}" />
                            <ItemsControl ItemsSource="{Binding BcdBackups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding CreatedUtc, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                           Text="{Binding ImportCommandText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- #724: BCD inspector panel - a structured, read-only tree of every
                             entry bcdedit knows about (Windows Boot Manager, each OS loader
                             entry). -->
                        <StackPanel>
                            <TextBlock Text="All boot entries (read-only)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding BcdStore.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                    <Run Text="{Binding Header, Mode=OneWay}" /><Run Text="  " />
                                                    <Run Text="{Binding Identifier, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding DisplayLines}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                                                <TextBlock Text="{Binding}" FontSize="10.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #734-737: Fast Startup, hibernation, and the recovery path - see
                 StartupViewModel's #734-737 region and FastStartupService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Fast Startup &amp; hibernation" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Fast Startup hibernates the kernel session instead of doing a full shutdown, which can leave Environment.TickCount64/WMI's uptime and your last genuine full restart telling two very different stories." />

                    <!-- #735: "you haven't fully restarted in N days" actionable card - dismissible
                         for 7 days. -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFullRestartPrompt}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                <Run Text="You haven't fully restarted in " /><Run Text="{Binding FastStartupInfo.DaysSinceFullRestart, Mode=OneWay}" /><Run Text=" days." />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Under Fast Startup, the regular Shut Down/Restart path doesn't do a full boot - drivers, firmware updates, and a queued chkdsk can all silently not apply. A full restart clears that." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Full restart now" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding FullRestartCommand}" />
                                <Button Content="Remind me in 7 days" Command="{Binding DismissFullRestartPromptCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- #734: uptime-clock reconciliation. -->
                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                <Run Text="Fast Startup: " FontWeight="SemiBold" /><Run Text="{Binding FastStartupInfo.HiberbootEnabledText, Mode=OneWay}" />
                                <Run Text="   ·   Last full restart: " FontWeight="SemiBold" /><Run Text="{Binding FastStartupInfo.LastFullBootText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="Tick-count uptime (this session): " /><Run Text="{Binding Performance.Uptime, Mode=OneWay}" />
                                <Run Text="   ·   WMI LastBootUpTime: " /><Run Text="{Binding FastStartupInfo.LastBootUpTimeWmiText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- #737: Fast Startup side-effect flags - collapsed when Fast Startup is off. -->
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FastStartupSideEffects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fast Startup side effects" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Turn off Fast Startup" Padding="8,4" FontSize="11" Command="{Binding DisableFastStartupCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding FastStartupSideEffects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Detail}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- #736: hibernation / sleep-state inventory. -->
                    <StackPanel>
                        <TextBlock Text="Sleep states &amp; hibernation" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding SleepStates}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Margin="0,3,8,0" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Available}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding UnavailableReason}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UnavailableReason}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock FontSize="12" Text="{Binding HiberFileInfo.SizeText}" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,10" Text="C:\hiberfil.sys" />
                                <WrapPanel>
                                    <Button Content="Turn off hibernation" Margin="0,0,8,8" Command="{Binding DisableHibernationCommand}" />
                                    <Button Content="Turn on hibernation" Margin="0,0,8,8" Command="{Binding EnableHibernationCommand}" />
                                    <Button Content="Reduce hiberfile type" Margin="0,0,8,8" Command="{Binding ReduceHiberFileTypeCommand}" />
                                    <TextBox Width="60" Margin="0,0,6,8" ToolTip="Hiberfile size, percent of RAM"
                                             Text="{Binding HiberFileSizePercentInput, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Set hiberfile size %" Margin="0,0,0,8" Command="{Binding SetHiberFileSizeCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #738-740: System partitions - ESP health, WinRE status, and the recovery-partition
                 layout map. See StartupViewModel's #738-740 region and SystemPartitionService's
                 remarks. Cross-linked from Energy &amp; Thermals' "Power plan &amp; sleep support" card. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="System partitions" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10">
                        <Run Text="The system disk's boot-relevant partitions" /><Run Text=" ("/><Run Text="{Binding PartitionLayout.DiskFriendlyName, Mode=OneWay}" /><Run Text=")." />
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PartitionLayout.Available}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="System partition data isn't available: " /><Run Text="{Binding PartitionLayout.Error, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PartitionLayout.Available}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- #740: partition layout map. -->
                        <ItemsControl ItemsSource="{Binding PartitionLayout.Partitions}" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding RoleLabel}" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="Partition " /><Run Text="{Binding PartitionNumber, Mode=OneWay}" />
                                                    <Run Text="   ·   " /><Run Text="{Binding GptType, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding SizeText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- #738: EFI System Partition health. -->
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EspHealth}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EFI System Partition health" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Measure free space" Padding="8,4" FontSize="11" Command="{Binding MeasureEspFreeSpaceCommand}" />
                            </Grid>
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run Text="Size: " FontWeight="SemiBold" /><Run Text="{Binding EspHealth.Partition.SizeText, Mode=OneWay}" />
                                <Run Text="   ·   Free: " FontWeight="SemiBold" /><Run Text="{Binding EspHealth.FreeText, Mode=OneWay}" />
                            </TextBlock>
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EspHealth.NearFullWarning}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Text="{Binding EspHealth.NearFullWarning}" />
                            </Border>
                        </StackPanel>

                        <!-- #739: WinRE status. -->
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WinReStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Windows Recovery Environment (WinRE)" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Enable WinRE" Padding="8,4" FontSize="11" Command="{Binding EnableWinReCommand}" />
                            </Grid>
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run Text="Status: " FontWeight="SemiBold" /><Run Text="{Binding WinReStatus.StatusText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="Location: " /><Run Text="{Binding WinReStatus.Location, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="BCD identifier: " /><Run Text="{Binding WinReStatus.BcdIdentifier, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="Recovery image: " /><Run Text="{Binding WinReStatus.RecoveryImageLocation, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="{Binding WinReStatus.Error, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- #740: recovery-partition-too-small-for-servicing flag - guidance text
                             only, this app never repartitions. -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecoveryPartitionFlag}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recovery partition" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Measure free space" Padding="8,4" FontSize="11" Command="{Binding MeasureRecoveryFreeSpaceCommand}" />
                            </Grid>
                            <Border CornerRadius="8" Padding="10,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecoveryPartitionFlag.TooSmallForServicing}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecoveryPartitionFlag.TooSmallForServicing}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding RecoveryPartitionFlag.Message, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #79/#80: Scheduled Tasks - a huge, often-overlooked source of background
                 slowdowns and unwanted auto-launches the registry-Run/Startup-folder scan above
                 doesn't cover at all. Loaded on demand (a couple of seconds on a system with
                 hundreds of tasks), not up front. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Scheduled Tasks - a second, often-larger source of background auto-launches."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <!-- #80/#767: now also loads the full plain-language trigger summary below,
                             reusing the same XML fetch - see ScheduledTaskService.ReadLogonTriggerInfoAsync. -->
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="Trigger details"
                                Command="{Binding CheckLogonDelayCommand}"
                                ToolTip="Logon-trigger delay, run mode, and a full plain-language trigger summary for the selected task" />
                        <!-- #765: certutil fallback for a Last Result code not in the small known-codes table. -->
                        <Button Grid.Column="2" Margin="0,0,8,0" Content="Decode result"
                                Command="{Binding DecodeLastResultCommand}"
                                ToolTip="Decode the selected task's Last Result code via certutil -error" />
                        <Button Grid.Column="3" Margin="0,0,8,0" Content="Enable/Disable"
                                Command="{Binding ToggleScheduledTaskCommand}" CommandParameter="{Binding SelectedScheduledTask}" />
                        <Button Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadScheduledTasksCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load scheduled tasks" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingScheduledTasks}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <DataGrid Height="280" ItemsSource="{Binding ScheduledTasks}" SelectedItem="{Binding SelectedScheduledTask}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                    <!-- #766: task's resolved target file doesn't exist. -->
                                    <DataTrigger Binding="{Binding HasMissingTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding MissingTargetReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.2*" />
                            <!-- #766: flag column - blank for a task whose target resolved fine. -->
                            <DataGridTemplateColumn Header="Flag" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Missing target" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DangerBrush}" ToolTip="{Binding MissingTargetReason}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingTarget}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Next run" Binding="{Binding NextRunTime}" Width="140" />
                            <DataGridTextColumn Header="Last result" Binding="{Binding LastResult}" Width="90" />
                            <!-- #765: plain-language meaning of Last Result - a known code decodes
                                 instantly; an unmapped code stays blank until "Decode result" runs. -->
                            <DataGridTextColumn Header="Result meaning" Binding="{Binding LastResultDecodedText}" Width="1.3*" />
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120" />
                            <!-- #80: logon-trigger delay - blank until "Trigger details" is
                                 clicked for the selected row, see StartupViewModel.CheckLogonDelayAsync. -->
                            <DataGridTextColumn Header="Logon delay" Binding="{Binding DelayText}" Width="130" />
                            <!-- #23 (Round 8): "Only when logged on" vs. "Whether or not logged
                                 on" - a distinct startup-impact category, since the latter can run
                                 work even at the lock screen. Populated by the same "Trigger
                                 details" click as the column above. -->
                            <DataGridTemplateColumn Header="Runs" Width="160" SortMemberPath="RunModeText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RunModeText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RunModeText}" Value="Whether or not user is logged on">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Task to run" Binding="{Binding TaskToRun}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #767: full plain-language trigger summary for the selected task, populated
                         by the same "Trigger details" click as the Logon delay/Runs columns above. -->
                    <Border Margin="0,8,0,0" Padding="10,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedScheduledTask.TriggerSummaryText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedScheduledTask}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Trigger summary" Style="{StaticResource SubStat}" />
                            <TextBlock Text="{Binding SelectedScheduledTask.TriggerSummaryText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- #764/#768: Task Scheduler operational log - disabled by default, so this
                         offers a one-click enable (never silent) before there's anything to read. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Task failures - Microsoft-Windows-TaskScheduler/Operational (start/action failures, timeouts, credential problems)."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="Enable operational log…"
                                Command="{Binding EnableTaskFailureLogCommand}"
                                ToolTip="Runs wevtutil sl &quot;Microsoft-Windows-TaskScheduler/Operational&quot; /e:true, after confirmation">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTaskSchedulerLogEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Load task failures"
                                Command="{Binding LoadTaskFailuresCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding TaskFailuresStatus}" Margin="0,4,0,8" FontSize="11.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                    <DataGrid Height="180" ItemsSource="{Binding TaskFailures}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding TimeCreated, StringFormat=g}" Width="1.2*" />
                            <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="2*" />
                            <DataGridTextColumn Header="What happened" Binding="{Binding EventLabel}" Width="1.6*" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #768: worst-offender run-duration chart, under the Task failures grid. -->
                    <TextBlock Text="Slowest tasks (max observed run duration)" Style="{StaticResource SubStat}" Margin="0,12,0,4" />
                    <lvc:CartesianChart Height="180" Background="Transparent" TooltipPosition="Top" LegendPosition="Hidden"
                                        Series="{Binding WorstTaskDurationsSeries}"
                                        XAxes="{Binding WorstTaskDurationsXAxes}"
                                        YAxes="{Binding WorstTaskDurationsYAxes}" />
                </StackPanel>
            </Border>

            <!-- #19: browser extension inventory (Chrome/Edge/Firefox) - a common, currently
                 invisible source of "slow startup"/"slow browsing" complaints, since extensions
                 load with the browser rather than through any Windows startup mechanism. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Browser extensions - Chrome, Edge, and Firefox."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadBrowserExtensionsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load browser extensions" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingBrowserExtensions}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <!-- #898: permission-surface columns, sortable - "which extensions can read
                         every page I visit" is sorting by "All URLs" descending. -->
                    <DataGrid Height="240" ItemsSource="{Binding BrowserExtensions}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="90" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.2*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                            <DataGridTemplateColumn Header="All URLs" Width="70" SortMemberPath="HasAllUrlsAccess">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding HasAllUrlsAccess, StringFormat={}{0}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAllUrlsAccess}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Sensitive permissions" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                   Text="{Binding SensitivePermissionsText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Install source" Binding="{Binding InstallSource}" Width="1.6*" />
                            <DataGridTextColumn Header="State" Binding="{Binding InstallSourceOrEnabledSummary}" Width="80" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #20: registered Explorer shell extensions (context-menu handlers / icon-overlay
                 COM add-ins) - a classic cause of a slow right-click menu. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Explorer shell extensions - context menu, property sheet, copy hook, drag-drop, and column handlers, plus icon overlays."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Content="Approve/Block"
                                Command="{Binding ToggleShellExtensionApprovedCommand}" CommandParameter="{Binding SelectedShellExtension}" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding LoadShellExtensionsCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Load shell extensions" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingShellExtensions}" Value="True">
                                                <Setter Property="Text" Value="Loading..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <DataGrid Height="240" ItemsSource="{Binding ShellExtensions}" IsReadOnly="True"
                              SelectedItem="{Binding SelectedShellExtension, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="2*" />
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="120" />
                            <DataGridTextColumn Header="Signature" Binding="{Binding SignatureStatus}" Width="90" />
                            <DataGridTextColumn Header="Approved" Binding="{Binding ApprovedText}" Width="90" />
                            <DataGridTextColumn Header="DLL" Binding="{Binding DllPath}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #743: Active Setup component inventory - StubPath commands that run once per user
                 at their next sign-in, tracked by comparing HKLM's "should run" Version against
                 each user's HKCU copy of the same value - see ActiveSetupService. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveSetupComponents.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Active Setup components" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap"
                               Text="StubPath commands that run once per user, the first time that user signs in after the component's version changes." />
                    <DataGrid Height="180" Margin="0,8,0,0" ItemsSource="{Binding ActiveSetupComponents}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Component" Binding="{Binding DisplayName}" Width="2*" />
                            <DataGridTextColumn Header="View" Binding="{Binding ViewLabel}" Width="70" />
                            <DataGridTemplateColumn Header="State" Width="220" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding State}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Pending - will run at this user's next sign-in">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="HKLM version" Binding="{Binding HklmVersion}" Width="120" />
                            <DataGridTextColumn Header="HKCU version" Binding="{Binding HkcuVersion}" Width="150" />
                            <DataGridTextColumn Header="StubPath" Binding="{Binding StubPath}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #744: Winlogon shell chain integrity check - Shell/Userinit/Taskman/AppSetup/
                 GinaDLL vs. Windows' own defaults. Quick flag, not a verdict - see
                 WinlogonIntegrityService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WinlogonChecks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Winlogon shell chain integrity" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap"
                               Text="Quick flag, not a verdict - Shell/Userinit control what launches at sign-in below even the Run keys/Startup folders above; Taskman/AppSetup/GinaDLL are normally unset entirely." />
                    <ItemsControl ItemsSource="{Binding WinlogonChecks}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,8,8" Width="260">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding ValueName, Mode=OneWay}" /><Run Text=" — " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding Scope, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="Expected: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding ExpectedText, Mode=OneWay}" FontFamily="Consolas" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap">
                                            <Run Text="Actual: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text="{Binding ActualText, Mode=OneWay}" FontFamily="Consolas">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #745: Image File Execution Options hijack audit - a Debugger value redirects every
                 launch of that executable, and SilentProcessExit\MonitorProcess fires silently on
                 exit. Quick flag, not a verdict - see ImageFileExecutionOptionsService's remarks.
                 Cross-linked to the Processes tab (filtered to that exe name) when it's currently
                 running - same #708/#723 SelectTabByName pattern (StartupView.xaml.cs). -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImageFileExecutionOptionsEntries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Image File Execution Options hijack audit" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap"
                               Text="Quick flag, not a verdict - a Debugger redirect is also how real debuggers and compatibility shims attach. Only executables with a Debugger, GlobalFlag, or SilentProcessExit monitor set are listed." />
                    <DataGrid Height="200" Margin="0,8,0,0" ItemsSource="{Binding ImageFileExecutionOptionsEntries}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Executable" Binding="{Binding ExecutableName}" Width="1.5*" />
                            <DataGridTemplateColumn Header="Debugger" Width="2*" SortMemberPath="DebuggerText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DebuggerText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDebugger}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GlobalFlag" Binding="{Binding GlobalFlagText}" Width="100" />
                            <DataGridTextColumn Header="Silent-exit monitor" Binding="{Binding MonitorProcessText}" Width="2*" />
                            <DataGridTemplateColumn Header="" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View in Processes" Padding="8,3" FontSize="11" Tag="{Binding ProcessNameForFilter}"
                                                Click="ViewIfeoExeInProcesses_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentlyRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #746: global DLL injection audit - AppInit_DLLs (both registry views), AppCertDlls,
                 LSA security/authentication packages, and KnownDLLs anomalies, each with a
                 signature status. Quick flag, not a verdict - see DllInjectionAuditService's remarks. -->
            <Border Margin="0,20,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DllInjectionAudit}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Global DLL injection audit" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap"
                               Text="AppInit_DLLs, AppCertDlls, LSA security/authentication packages, and KnownDLLs anomalies - the locations that load a DLL into many/every process rather than one specific app." />
                    <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap">
                        <Run Text="AppInit_DLLs (64-bit): " Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Run Text="{Binding DllInjectionAudit.AppInitEnabled64Text, Mode=OneWay}" />
                        <Run Text="   ·   AppInit_DLLs (32-bit): " Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Run Text="{Binding DllInjectionAudit.AppInitEnabled32Text, Mode=OneWay}" />
                    </TextBlock>
                    <DataGrid Height="220" Margin="0,8,0,0" ItemsSource="{Binding DllInjectionAudit.Entries}" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.8*" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" />
                            <DataGridTextColumn Header="Resolved path" Binding="{Binding ResolvedPath}" Width="2.5*" />
                            <DataGridTemplateColumn Header="Signature" Width="90" SortMemberPath="SignatureStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SignatureStatus}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SignatureStatus}" Value="Unsigned">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
