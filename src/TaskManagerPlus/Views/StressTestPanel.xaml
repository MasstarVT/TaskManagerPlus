<UserControl x:Class="TaskManagerPlus.Views.StressTestPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             d:DataContext="{d:DesignInstance Type=vm:StressTestViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- #695-#700: Stress test panel. Every test type here is started ONLY by the explicit "Start"
         button below (StressTestViewModel.StartCommand) and is safely abortable (StopCommand, plus
         StressTestSafetyMonitor's own always-active temperature/WHEA/TDR guard) - never a
         background timer, per this chunk's most important convention. -->
    <UserControl.Resources>
        <!-- #697: the GPU-load render-loop animation - a resource (not a Style.Triggers
             EnterActions/BeginStoryboard) because Storyboard.TargetName can only resolve named
             elements within a real NameScope (a ControlTemplate/DataTemplate, or - as used here -
             this UserControl's own root NameScope via code-behind's Storyboard.Begin(this, ...));
             a plain Style.Triggers Storyboard has no NameScope to resolve GpuShape1..6 against
             (MC4011). Started/stopped from StressTestPanel.xaml.cs in response to
             IsGpuRenderActive changing, not a XAML trigger. -->
        <Storyboard x:Key="GpuLoadStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GpuShape1" Storyboard.TargetProperty="(Canvas.Left)" From="20" To="480" Duration="0:0:1.7" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape1" Storyboard.TargetProperty="Opacity" From="0.25" To="0.75" Duration="0:0:0.6" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape2" Storyboard.TargetProperty="(Canvas.Top)" From="10" To="90" Duration="0:0:1.1" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape2" Storyboard.TargetProperty="Opacity" From="0.2" To="0.7" Duration="0:0:0.8" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape3" Storyboard.TargetProperty="(Canvas.Left)" From="300" To="80" Duration="0:0:2.1" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape3" Storyboard.TargetProperty="Opacity" From="0.2" To="0.65" Duration="0:0:0.7" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape4" Storyboard.TargetProperty="(Canvas.Top)" From="20" To="100" Duration="0:0:1.4" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape4" Storyboard.TargetProperty="Opacity" From="0.25" To="0.7" Duration="0:0:0.9" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape5" Storyboard.TargetProperty="(Canvas.Left)" From="90" To="550" Duration="0:0:2.5" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape5" Storyboard.TargetProperty="Opacity" From="0.15" To="0.55" Duration="0:0:1.0" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape6" Storyboard.TargetProperty="(Canvas.Top)" From="20" To="-20" Duration="0:0:1.3" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="GpuShape6" Storyboard.TargetProperty="Opacity" From="0.2" To="0.65" Duration="0:0:0.5" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>
    <StackPanel>

        <!-- #695-#699: test selection, run settings, and the always-on safety-abort criteria. -->
        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Stress test" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                           Text="On-demand only - a test never starts itself and can be stopped at any time. A safety-abort guard checks temperature every sample during ANY test type below and stops the run immediately if the ceiling is reached, regardless of the configured duration; that check cannot be turned off, only where the ceiling and the WHEA/TDR delta checks sit is adjustable." />

                <TextBlock Text="Test type" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton GroupName="StressTestType" Content="CPU torture" Margin="0,0,14,0"
                                 IsChecked="{Binding SelectedTestType, Converter={StaticResource StressTestTypeEqualsConverter}, ConverterParameter=CpuTorture}" />
                    <RadioButton GroupName="StressTestType" Content="Memory verify" Margin="0,0,14,0"
                                 IsChecked="{Binding SelectedTestType, Converter={StaticResource StressTestTypeEqualsConverter}, ConverterParameter=MemoryVerify}" />
                    <RadioButton GroupName="StressTestType" Content="GPU load" Margin="0,0,14,0"
                                 IsChecked="{Binding SelectedTestType, Converter={StaticResource StressTestTypeEqualsConverter}, ConverterParameter=GpuLoad}" />
                    <RadioButton GroupName="StressTestType" Content="Combined soak"
                                 IsChecked="{Binding SelectedTestType, Converter={StaticResource StressTestTypeEqualsConverter}, ConverterParameter=CombinedSoak}" />
                </StackPanel>

                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Duration (s)" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                    <StackPanel Margin="3,0,3,0">
                        <TextBlock Text="CPU threads" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CpuThreadCount, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                    <StackPanel Margin="3,0,3,0">
                        <TextBlock Text="Memory share (% free)" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding MemoryTestShareOfFreePercent, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Temp ceiling override (°C, 0=auto)" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding TempCeilingC, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                    <Run Text="Effective safety-abort temperature ceiling: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    <Run Text="{Binding EffectiveTempCeilingText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox Content="Also abort on a new WHEA hardware-error event" IsChecked="{Binding AbortOnWheaDelta}" Margin="0,0,20,0" />
                    <CheckBox Content="Also abort on a GPU driver reset (TDR)" IsChecked="{Binding AbortOnTdr}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Start" Padding="16,6" Margin="0,0,10,0" Command="{Binding StartCommand}" />
                    <Button Content="Stop" Padding="16,6" Margin="0,0,16,0" Command="{Binding StopCommand}" />
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- #697: GPU load - drives load through WPF's own hardware-accelerated compositor
             (continuously animated, blurred, semi-transparent shapes) while the safety loop watches
             for TDR events - a best-effort load generator, not a calibrated benchmark, since this
             app takes no raw Direct3D/D3DImage dependency. Only visible while a GPU-load-driving
             test type is selected or running. -->
        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="GPU load render" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                           Text="Active only during a GPU load or combined-load soak run - animates while IsGpuRenderActive is true, idle otherwise." />
                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" ClipToBounds="True" Height="160">
                    <Canvas x:Name="GpuLoadCanvas">
                        <Canvas.Resources>
                            <BlurEffect x:Key="StressBlur" Radius="16" />
                        </Canvas.Resources>
                        <Ellipse x:Name="GpuShape1" Width="140" Height="140" Canvas.Left="20" Canvas.Top="10" Opacity="0.55" Effect="{StaticResource StressBlur}" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse x:Name="GpuShape2" Width="120" Height="120" Canvas.Left="160" Canvas.Top="30" Opacity="0.5" Effect="{StaticResource StressBlur}" Fill="{DynamicResource SuccessBrush}" />
                        <Ellipse x:Name="GpuShape3" Width="160" Height="160" Canvas.Left="300" Canvas.Top="0" Opacity="0.45" Effect="{StaticResource StressBlur}" Fill="{DynamicResource WarningBrush}" />
                        <Ellipse x:Name="GpuShape4" Width="110" Height="110" Canvas.Left="470" Canvas.Top="20" Opacity="0.5" Effect="{StaticResource StressBlur}" Fill="{DynamicResource DangerBrush}" />
                        <Ellipse x:Name="GpuShape5" Width="150" Height="150" Canvas.Left="90" Canvas.Top="-10" Opacity="0.4" Effect="{StaticResource StressBlur}" Fill="{DynamicResource AccentBrush}" />
                        <Ellipse x:Name="GpuShape6" Width="130" Height="130" Canvas.Left="400" Canvas.Top="20" Opacity="0.45" Effect="{StaticResource StressBlur}" Fill="{DynamicResource SuccessBrush}" />
                    </Canvas>
                </Border>
            </StackPanel>
        </Border>

        <!-- #699/#700: last run's pass/fail criteria breakdown + summary figures. Hidden until at
             least one run has completed. -->
        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LastResult}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Last run result" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding LastResult.TestType, Converter={StaticResource StressTestTypeDisplayNameConverter}}" Style="{StaticResource SubStat}" Margin="0,-4,0,10" />

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <views:VfdMeter Title="Peak temperature" Glow="False" Margin="0,0,6,0"
                                    ValueText="{Binding LastResult.PeakTempC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                    AccentBrush="{DynamicResource DangerBrush}" />
                    <views:VfdMeter Title="Average clock" Glow="False" Margin="3,0,3,0"
                                    ValueText="{Binding LastResult.AvgClockGhz, StringFormat={}{0:0.00}, TargetNullValue=–}" Unit="GHz"
                                    AccentBrush="{DynamicResource AccentBrush}" />
                    <views:VfdMeter Title="Peak power" Glow="False" Margin="3,0,3,0"
                                    ValueText="{Binding LastResult.PeakPowerW, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                    AccentBrush="{DynamicResource AccentBrush}" />
                    <views:VfdMeter Title="Peak fan speed" Glow="False" Margin="6,0,0,0"
                                    ValueText="{Binding LastResult.PeakFanRpm, StringFormat={}{0:0}, TargetNullValue=–}" Unit="RPM"
                                    AccentBrush="{DynamicResource AccentBrush}" />
                </UniformGrid>

                <!-- #699: the explicit pass/fail criteria breakdown - each row's *ResultText comes
                     straight off StressTestCriteria (Pass/Fail/"N/A (not applicable...)"). -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Computation correct (no checksum mismatch)" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastResult.Criteria.ComputationResultText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="No WHEA corrected-error delta" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastResult.Criteria.WheaResultText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="No display-driver reset (TDR)" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastResult.Criteria.TdrResultText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sustained clock at/above rated base" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastResult.Criteria.ClockResultText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Peak temperature below throttle point" FontSize="12" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastResult.Criteria.TempResultText}" FontSize="12" FontWeight="SemiBold" />
                </Grid>

                <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,0,0,3">
                    <Run Text="Result: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                    <Run FontWeight="Bold">
                        <Run.Style>
                            <Style TargetType="Run">
                                <Setter Property="Text" Value="FAIL" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastResult.Passed}" Value="True">
                                        <Setter Property="Text" Value="PASS" />
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Run.Style>
                    </Run>
                </TextBlock>
                <TextBlock Text="{Binding LastComparisonText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Export Markdown" Padding="10,5" Margin="0,0,8,0" Command="{Binding ExportMarkdownCommand}" />
                    <Button Content="Export HTML" Padding="10,5" Margin="0,0,8,0" Command="{Binding ExportHtmlCommand}" />
                    <Button Content="Export trace CSV" Padding="10,5" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ReportStatusText, Mode=OneWay}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- #700: run-to-run history - a small persisted summary row per run. -->
        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RunHistory.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Run history" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Most recent runs, newest first - the direct comparison record behind &quot;same test, hotter/cooler and higher/lower clocked than a previous run.&quot;"
                           Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding RunHistory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:g}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{Binding TestType, Converter={StaticResource StressTestTypeDisplayNameConverter}}" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding PeakTempC, StringFormat={}{0:0.#}°C, TargetNullValue=Unknown}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding AvgClockGhz, StringFormat={}{0:0.00}GHz, TargetNullValue=Unknown}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="FAIL" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Text" Value="PASS" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
