<UserControl x:Class="TaskManagerPlus.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ThemeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="280">
    <UserControl.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                     Stroke="{DynamicResource BorderBrush2}" StrokeThickness="1" />
                            <Ellipse x:Name="ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                     Margin="-3" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorRowLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="HexBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style x:Key="ThemeModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">

                <TextBlock Text="Colors" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="Pick a swatch or type a hex code. Changes apply instantly and are remembered."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <!-- Theme family -->
                <TextBlock Text="Theme" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding ThemeModeNames}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource ThemeModeButton}"
                                    Command="{Binding DataContext.SetThemeModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Background>
                                    <MultiBinding Converter="{StaticResource ThemeModeSelectedBrushConverter}">
                                        <Binding Path="." />
                                        <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </Button.Background>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Saturation" Style="{StaticResource ColorRowLabel}" Margin="0,4,0,8" />
                <Slider Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="False"
                        Value="{Binding Saturation}" Margin="0,0,0,22" />

                <!-- #76: swaps the Success/Warning/Danger status colors for a color-blind-safe
                     set - a separate toggle from the theme family above, since it targets
                     specifically the status/alert colors this app's diagnostic UI leans on. -->
                <CheckBox Content="Color-blind-safe alert colors" IsChecked="{Binding ColorBlindSafeAlerts}" Margin="0,0,0,22" />

                <!-- Accent -->
                <TextBlock Text="Accent" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,22"
                         Text="{Binding Accent, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <TextBlock Text="PERFORMANCE CHARTS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- CPU -->
                <TextBlock Text="CPU" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetCpuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,22"
                         Text="{Binding Cpu, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- RAM -->
                <TextBlock Text="Memory" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetRamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,22"
                         Text="{Binding Ram, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- Disk -->
                <TextBlock Text="Disk" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,22"
                         Text="{Binding Disk, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- Network receive -->
                <TextBlock Text="Network — download" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetNetworkReceiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,22"
                         Text="{Binding NetworkReceive, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- Network send -->
                <TextBlock Text="Network — upload" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetNetworkSendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,22"
                         Text="{Binding NetworkSend, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <Button Content="Reset to defaults" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />

                <!-- Round 11, #82: export/import just the accent/family/saturation subset of
                     theme.json as its own small shareable file. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Export palette..." Command="{Binding ExportPaletteCommand}" Margin="0,0,8,0" />
                    <Button Content="Import palette..." Command="{Binding ImportPaletteCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding PaletteStatusText}" TextWrapping="Wrap" Margin="0,0,0,22">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaletteStatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="DISPLAY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- #78: dense/compact DataGrid rows - fit more rows on screen at once. -->
                <CheckBox Content="Compact table rows" IsChecked="{Binding CompactRows}" Margin="0,0,0,16" />

                <!-- #79: independent UI scale, separate from Windows' own display scaling - see
                     ThemeViewModel.FontScale's remarks. -->
                <TextBlock Text="UI scale" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding FontScale, StringFormat={}{0:0%}}" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                <Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding FontScale}" Margin="0,0,0,16" />

                <!-- #81: pins the main window above every other window - the same Topmost
                     behavior the mini dashboard/toast windows already use. -->
                <CheckBox Content="Always on top"
                          IsChecked="{Binding DataContext.AlwaysOnTop, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,22" />

                <!-- #80: Ctrl+1..Ctrl+9 jump straight to a tab - the mapping defaults to this
                     app's first nine tabs and is configurable via ui-preferences.json's
                     TabShortcuts list (no in-app remapping UI, same tradeoff a couple of this
                     app's other advanced options already take). -->
                <TextBlock Text="Ctrl+1 through Ctrl+9 jump to a tab (first nine, by default). Customize the order in %AppData%\TaskManagerPlus\ui-preferences.json."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,22" />

                <TextBlock Text="LOGGING" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- #95: auto-start a rolling in-memory buffer on launch, so a crash can be
                     diagnosed retroactively even if "Start Logging" was never clicked. Runs only
                     while manual logging (the footer's Start/Stop Logging button) isn't active -
                     see LoggingViewModel.Tick. -->
                <CheckBox Content="Auto-start rolling log buffer on launch"
                          IsChecked="{Binding DataContext.Logging.AutoStartRollingBufferEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Keeps the last 15 minutes of every metric written to a fixed file, even if you never click Start Logging."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,16" />

                <!-- #76: configurable sample interval - trades resolution for a smaller file/less
                     disk I/O on a long unattended session. Applies to both manual logging and the
                     rolling buffer above. -->
                <TextBlock Text="Sample interval" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton GroupName="SampleInterval" Content="1s" Margin="0,0,14,0"
                                 IsChecked="{Binding DataContext.Logging.SampleIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />
                    <RadioButton GroupName="SampleInterval" Content="5s" Margin="0,0,14,0"
                                 IsChecked="{Binding DataContext.Logging.SampleIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}" />
                    <RadioButton GroupName="SampleInterval" Content="10s"
                                 IsChecked="{Binding DataContext.Logging.SampleIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntEqualsConverter}, ConverterParameter=10}" />
                </StackPanel>

                <!-- #77: automatic cleanup of old rotated log parts (see LoggingService.CleanupOldRotatedParts) -
                     never touches the file currently being written to. -->
                <CheckBox Content="Automatically delete old rotated log parts"
                          IsChecked="{Binding DataContext.Logging.AutoCleanupEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <TextBlock Text="Older than" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="50" Text="{Binding DataContext.Logging.AutoCleanupDays, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>

                <TextBlock Text="REMOTE MONITORING" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- #101: read-only metrics endpoint for a second device on the LAN - see
                     RemoteMonitorService's remarks. Off by default; the warning below is
                     deliberately blunt since HttpListener has no built-in authentication. -->
                <CheckBox Content="Enable remote monitoring (LAN)"
                          IsChecked="{Binding DataContext.IsRemoteMonitorEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Unauthenticated by default - anyone on your network can view (read-only) CPU/RAM/Disk/Network/temp while this is on. Only enable on a trusted network."
                           Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />

                <!-- #97: optional shared-token step up from the fully-open default above - still
                     not real authentication (a plain-text query-string token over unencrypted
                     HTTP), just a minimal "not literally anyone who finds the port" bar. -->
                <TextBlock Text="Optional access token" Style="{StaticResource ColorRowLabel}" Margin="0,4,0,4" />
                <TextBox Width="180" HorizontalAlignment="Left"
                         Text="{Binding DataContext.RemoteMonitorToken, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="When set, every request needs a matching ?token=... in the URL or gets rejected - still not real security (visible in the URL, no encryption), just a minimal step up from fully open."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="{Binding DataContext.RemoteMonitorStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,22" />

                <TextBlock Text="APP" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- #85: minimize-to-tray - see UiPreferences.MinimizeToTray's remarks. -->
                <CheckBox Content="Minimize to system tray"
                          IsChecked="{Binding DataContext.MinimizeToTray, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,16" />

                <!-- #86: Ctrl+Alt+T global "bring to front" hotkey - see GlobalHotkeyService's
                     remarks for why this isn't literally Ctrl+Shift+Esc. Takes effect on next
                     launch (registration happens once at startup). -->
                <CheckBox Content="Global hotkey: Ctrl+Alt+T brings this window to the front"
                          IsChecked="{Binding DataContext.GlobalHotkeyEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Takes effect after restarting the app. Not the literal Ctrl+Shift+Esc combination - Windows itself intercepts that one for the real Task Manager before it would ever reach this app."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,16" />

                <!-- #87: portable mode is a launch-time decision (the "portable" launch flag or
                     a portable.marker file next to the exe), not a live toggle - shown here as a
                     read-only status line so it's at least visible where settings are currently
                     being written. -->
                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,22">
                    <Run Text="Settings storage: " />
                    <Run Text="{Binding DataContext.AppPathsModeText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneTime}" FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Text="LEAK ALERTS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Fires a toast the first time a process crosses one of these, edge-triggered the same way the CPU/Memory/temperature thresholds on the Summary tab work. Both are 'quick flag, not a verdict' - see the Memory tab's Leak growth summary and Processes tab's Leak slope/Handles columns for the underlying figures."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <!-- #414: "any process grows more than X MB over Y minutes" -->
                <CheckBox Content="Alert on rapid private-bytes growth"
                          IsChecked="{Binding DataContext.Summary.LeakGrowthAlertEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="More than" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="60" Text="{Binding DataContext.Summary.LeakGrowthAlertMb, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="MB over" VerticalAlignment="Center" Margin="6,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="50" Text="{Binding DataContext.Summary.LeakGrowthAlertMinutes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>

                <!-- #414: "any process exceeds N handles" -->
                <CheckBox Content="Alert on high handle count"
                          IsChecked="{Binding DataContext.Summary.LeakHandleCountAlertEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <TextBlock Text="More than" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="70" Text="{Binding DataContext.Summary.LeakHandleCountAlertThreshold, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="handles" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>

                <TextBlock Text="POLLING INTERVALS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Lower = more responsive, higher = lighter background load (useful on battery). Defaults match every prior release."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="{Binding DataContext.Processes.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Processes — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                        Value="{Binding DataContext.Processes.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="{Binding DataContext.Performance.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=CPU / Memory / Storage / Network — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                        Value="{Binding DataContext.Performance.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="{Binding DataContext.Services.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Services — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                        Value="{Binding DataContext.Services.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="{Binding DataContext.EnergyThermals.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Energy &amp; Thermals — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,4"
                        Value="{Binding DataContext.EnergyThermals.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
