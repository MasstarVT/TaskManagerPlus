<UserControl x:Class="TaskManagerPlus.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ThemeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="280">
    <UserControl.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{Binding Converter={StaticResource ColorToBrushConverter}}"
                                     Stroke="{DynamicResource BorderBrush2}" StrokeThickness="1" />
                            <Ellipse x:Name="ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                     Margin="-3" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ColorRowLabel now lives in Themes/Dark.xaml: StabilityView.xaml references it too,
             and could not see it while it was scoped to this UserControl. -->

        <Style x:Key="HexBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="{StaticResource FontBody}" />
            <Setter Property="Width" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style x:Key="ThemeModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <TextBlock Text="Colors" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="Pick a swatch or type a hex code. Changes apply instantly and are remembered."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <!-- Theme family -->
                <TextBlock Text="Theme" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding ThemeModeNames}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource ThemeModeButton}"
                                    Command="{Binding DataContext.SetThemeModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Background>
                                    <MultiBinding Converter="{StaticResource ThemeModeSelectedBrushConverter}">
                                        <Binding Path="." />
                                        <Binding Path="DataContext.ThemeMode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </Button.Background>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Saturation" Style="{StaticResource ColorRowLabel}" Margin="0,4,0,8" />
                <Slider Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="False"
                        Value="{Binding Saturation}" Margin="0,0,0,20" />

                <!-- #76: swaps the Success/Warning/Danger status colors for a color-blind-safe
                     set - a separate toggle from the theme family above, since it targets
                     specifically the status/alert colors this app's diagnostic UI leans on. -->
                <CheckBox Content="Color-blind-safe alert colors" IsChecked="{Binding ColorBlindSafeAlerts}" Margin="0,0,0,20" />

                <!-- Accent -->
                <TextBlock Text="Accent" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,20"
                         Text="{Binding Accent, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <TextBlock Text="PERFORMANCE CHARTS" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- CPU -->
                <TextBlock Text="CPU" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetCpuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,20"
                         Text="{Binding Cpu, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- RAM -->
                <TextBlock Text="Memory" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetRamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,20"
                         Text="{Binding Ram, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- Disk -->
                <TextBlock Text="Disk" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,20"
                         Text="{Binding Disk, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- Network receive -->
                <TextBlock Text="Network — download" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetNetworkReceiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,20"
                         Text="{Binding NetworkReceive, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <!-- Network send -->
                <TextBlock Text="Network — upload" Style="{StaticResource ColorRowLabel}" />
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}"
                                    Command="{Binding DataContext.SetNetworkSendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Style="{StaticResource HexBox}" Margin="0,0,0,20"
                         Text="{Binding NetworkSend, Converter={StaticResource ColorToHexConverter}, UpdateSourceTrigger=LostFocus}" />

                <Button Content="Reset to defaults" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />

                <!-- Round 11, #82: export/import just the accent/family/saturation subset of
                     theme.json as its own small shareable file. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Export palette..." Command="{Binding ExportPaletteCommand}" Margin="0,0,8,0" />
                    <Button Content="Import palette..." Command="{Binding ImportPaletteCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding PaletteStatusText}" TextWrapping="Wrap" Margin="0,0,0,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaletteStatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="SAFETY" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- #980: app-wide read-only switch - disables every mutating command (end
                     process, service start/stop/restart, startup/scheduled-task toggle,
                     remediation Run/Queue, priority/affinity/suspend/resume/trim, power plan
                     changes). Preview/dry-run and every read-only lookup still work. -->
                <CheckBox Content="Read-only mode" IsChecked="{Binding IsReadOnlyMode}" Margin="0,0,0,6" />
                <TextBlock Text="Disables every action that changes something on this PC - end process, service/startup/scheduled-task toggles, remediation fixes, priority/affinity/suspend/trim, power plan changes. Useful for diagnosing someone else's machine, or a technician's initial assessment pass. Previewing/dry-running a fix still works."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="DISPLAY" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- #78: dense/compact DataGrid rows - fit more rows on screen at once. -->
                <CheckBox Content="Compact table rows" IsChecked="{Binding CompactRows}" Margin="0,0,0,16" />

                <!-- #79: independent UI scale, separate from Windows' own display scaling - see
                     ThemeViewModel.FontScale's remarks. -->
                <TextBlock Text="UI scale" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding FontScale, StringFormat={}{0:0%}}" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                <Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Value="{Binding FontScale}" Margin="0,0,0,16" />

                <!-- #81: pins the main window above every other window - the same Topmost
                     behavior the mini dashboard/toast windows already use. -->
                <CheckBox Content="Always on top"
                          IsChecked="{Binding DataContext.AlwaysOnTop, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,20" />

                <!-- #80: Ctrl+1..Ctrl+9 jump straight to a tab - the mapping defaults to this
                     app's first nine tabs and is configurable via ui-preferences.json's
                     TabShortcuts list (no in-app remapping UI, same tradeoff a couple of this
                     app's other advanced options already take). -->
                <TextBlock Text="Ctrl+1 through Ctrl+9 jump to a tab (first nine, by default). Customize the order in %AppData%\TaskManagerPlus\ui-preferences.json."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="LOGGING" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- #95: auto-start a rolling in-memory buffer on launch, so a crash can be
                     diagnosed retroactively even if "Start Logging" was never clicked. Runs only
                     while manual logging (the footer's Start/Stop Logging button) isn't active -
                     see LoggingViewModel.Tick. -->
                <CheckBox Content="Auto-start rolling log buffer on launch"
                          IsChecked="{Binding DataContext.Logging.AutoStartRollingBufferEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Keeps the last 15 minutes of every metric written to a fixed file, even if you never click Start Logging."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,16" />

                <!-- #76: configurable sample interval - trades resolution for a smaller file/less
                     disk I/O on a long unattended session. Applies to both manual logging and the
                     rolling buffer above. -->
                <TextBlock Text="Sample interval" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton GroupName="SampleInterval" Content="1s" Margin="0,0,14,0"
                                 IsChecked="{Binding DataContext.Logging.SampleIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />
                    <RadioButton GroupName="SampleInterval" Content="5s" Margin="0,0,14,0"
                                 IsChecked="{Binding DataContext.Logging.SampleIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntEqualsConverter}, ConverterParameter=5}" />
                    <RadioButton GroupName="SampleInterval" Content="10s"
                                 IsChecked="{Binding DataContext.Logging.SampleIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntEqualsConverter}, ConverterParameter=10}" />
                </StackPanel>

                <!-- #77: automatic cleanup of old rotated log parts (see LoggingService.CleanupOldRotatedParts) -
                     never touches the file currently being written to. -->
                <CheckBox Content="Automatically delete old rotated log parts"
                          IsChecked="{Binding DataContext.Logging.AutoCleanupEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Older than" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="50" Text="{Binding DataContext.Logging.AutoCleanupDays, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>

                <TextBlock Text="PERFORMANCE BASELINES" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- #952: opt-in automatic weekly baseline capture (WinSAT scores, boot duration,
                     idle CPU/RAM/disk-latency) - only fires once this PC has been idle for a few
                     minutes. Same toggle also lives in the Troubleshoot tab's Baselines section. -->
                <CheckBox Content="Capture a performance baseline automatically about once a week, while idle"
                          IsChecked="{Binding DataContext.Troubleshoot.Baselines.AutoCaptureEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Keep the most recent" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="50" Text="{Binding DataContext.Troubleshoot.Baselines.MaxBaselinesKept, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="baselines" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>
                <TextBlock Text="{Binding DataContext.Troubleshoot.Baselines.AutoCaptureStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="REMOTE MONITORING" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- #101: read-only metrics endpoint for a second device on the LAN - see
                     RemoteMonitorService's remarks. Off by default; the warning below is
                     deliberately blunt since HttpListener has no built-in authentication. -->
                <CheckBox Content="Enable remote monitoring (LAN)"
                          IsChecked="{Binding DataContext.IsRemoteMonitorEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Unauthenticated by default - anyone on your network can view (read-only) CPU/RAM/Disk/Network/temp while this is on. Only enable on a trusted network."
                           Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />

                <!-- #97: optional shared-token step up from the fully-open default above - still
                     not real authentication (a plain-text query-string token over unencrypted
                     HTTP), just a minimal "not literally anyone who finds the port" bar. -->
                <TextBlock Text="Optional access token" Style="{StaticResource ColorRowLabel}" Margin="0,4,0,4" />
                <TextBox Width="180" HorizontalAlignment="Left"
                         Text="{Binding DataContext.RemoteMonitorToken, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="When set, every request needs a matching ?token=... in the URL or gets rejected - still not real security (visible in the URL, no encryption), just a minimal step up from fully open."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="{Binding DataContext.RemoteMonitorStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="APP" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />

                <!-- #85: minimize-to-tray - see UiPreferences.MinimizeToTray's remarks. -->
                <CheckBox Content="Minimize to system tray"
                          IsChecked="{Binding DataContext.MinimizeToTray, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,16" />

                <!-- #86: Ctrl+Alt+T global "bring to front" hotkey - see GlobalHotkeyService's
                     remarks for why this isn't literally Ctrl+Shift+Esc. Takes effect on next
                     launch (registration happens once at startup). -->
                <CheckBox Content="Global hotkey: Ctrl+Alt+T brings this window to the front"
                          IsChecked="{Binding DataContext.GlobalHotkeyEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Takes effect after restarting the app. Not the literal Ctrl+Shift+Esc combination - Windows itself intercepts that one for the real Task Manager before it would ever reach this app."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,16" />

                <!-- suggestions.md #1000: Ctrl+K command palette + the discoverable shortcut sheet. -->
                <Button Content="Keyboard shortcuts..." HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,4"
                        Command="{Binding DataContext.OpenKeyboardShortcutsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutomationProperties.Name="Show keyboard shortcuts" />
                <TextBlock Text="Ctrl+K also opens a command palette to search and jump to tabs, findings, rules, glossary terms, and more from anywhere."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,16" />

                <!-- #87: portable mode is a launch-time decision (the "portable" launch flag or
                     a portable.marker file next to the exe), not a live toggle - shown here as a
                     read-only status line so it's at least visible where settings are currently
                     being written. -->
                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="Settings storage: " />
                    <Run Text="{Binding DataContext.AppPathsModeText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneTime}" FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Text="LEAK ALERTS" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Fires a toast the first time a process crosses one of these, edge-triggered the same way the CPU/Memory/temperature thresholds on the Summary tab work. Both are 'quick flag, not a verdict' - see the Memory tab's Leak growth summary and Processes tab's Leak slope/Handles columns for the underlying figures."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <!-- #414: "any process grows more than X MB over Y minutes" -->
                <CheckBox Content="Alert on rapid private-bytes growth"
                          IsChecked="{Binding DataContext.Summary.LeakGrowthAlertEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="More than" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="60" Text="{Binding DataContext.Summary.LeakGrowthAlertMb, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="MB over" VerticalAlignment="Center" Margin="6,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="50" Text="{Binding DataContext.Summary.LeakGrowthAlertMinutes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>

                <!-- #414: "any process exceeds N handles" -->
                <CheckBox Content="Alert on high handle count"
                          IsChecked="{Binding DataContext.Summary.LeakHandleCountAlertEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="More than" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="70" Text="{Binding DataContext.Summary.LeakHandleCountAlertThreshold, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text="handles" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>

                <!-- suggestions.md #998: technician mode - portable-mode-only per-machine data
                     partitioning. Hidden entirely outside portable mode, since AppPaths.
                     SwitchMachine is a no-op there anyway. -->
                <StackPanel Visibility="{Binding DataContext.IsPortableMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="TECHNICIAN MODE" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,14" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,8">
                        <Run Text="Portable-mode-only: keeps baselines, findings history, the change journal, and other saved data separated per physical machine when this build is carried between several clients on a USB drive. Fingerprint scheme: sanitized computer name (currently " />
                        <Run Text="{Binding DataContext.CurrentMachineFingerprint, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneTime}" FontWeight="SemiBold" />
                        <Run Text=")." />
                    </TextBlock>
                    <TextBlock Text="Active data folder" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DataContext.MachineOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.SelectedMachineOption, RelativeSource={RelativeSource AncestorType=Window}}"
                              Margin="0,0,0,8" AutomationProperties.Name="Active per-machine data folder" />
                    <Button Content="Add this machine" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,6"
                            Command="{Binding DataContext.AddCurrentMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.Name="Register this physical machine's own data folder" />
                    <TextBlock Text="Switching or adding a machine here takes effect after restarting the app - most settings/data services already cache their own file path the moment they're constructed."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,20" />
                </StackPanel>

                <TextBlock Text="PLAIN ENGLISH &amp; OFFLINE" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- suggestions.md #991: swaps a Health Check finding's technical wording for a
                     plain-language alternative wherever the firing rule provides one. -->
                <CheckBox Content="Plain English mode for Health Check findings"
                          IsChecked="{Binding DataContext.PlainEnglishMode, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,16"
                          AutomationProperties.Name="Plain English mode toggle" />
                <!-- suggestions.md #999: see NetworkActivityCatalogService's remarks for exactly
                     which calls this disables - also toggleable from the Troubleshoot tab's
                     Network Activity panel, which lists them. -->
                <CheckBox Content="Offline mode (disable the public IP lookup, update check, and traceroute)"
                          IsChecked="{Binding DataContext.OfflineMode, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6"
                          AutomationProperties.Name="Offline mode toggle" />
                <TextBlock Text="See the Troubleshoot tab's &quot;Network Activity&quot; panel for the full, itemized list of what this does and doesn't affect."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="UNATTENDED DIAGNOSTIC SCAN" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <!-- suggestions.md #997: schedules a quiet, headless "scan" launch of this exe via
                     schtasks.exe, writing each run's findings into its own dated subfolder
                     under AppPaths.SettingsDirectory\UnattendedScans\. A banner appears at next
                     launch summarizing scans since the app was last opened. -->
                <TextBlock Text="Runs a headless Health Check scan on a schedule, with no window shown - useful for catching problems between sessions on a machine that's mostly left on."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton GroupName="UnattendedScanFrequency" Content="Daily" Margin="0,0,14,0"
                                 IsChecked="{Binding DataContext.UnattendedScanWeekly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}" />
                    <RadioButton GroupName="UnattendedScanFrequency" Content="Weekly (Sunday)"
                                 IsChecked="{Binding DataContext.UnattendedScanWeekly, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="At" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                    <TextBox Width="40" Text="{Binding DataContext.UnattendedScanHour, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Text=":00 (24h, local time)" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                </StackPanel>
                <CheckBox Content="Scrub personal info from each unattended scan's output"
                          IsChecked="{Binding DataContext.UnattendedScanScrub, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Set up nightly diagnostic scan" Padding="10,4" Margin="0,0,8,0"
                            Command="{Binding DataContext.SetupUnattendedScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.Name="Set up scheduled unattended diagnostic scan" />
                    <Button Content="Remove" Padding="10,4"
                            Command="{Binding DataContext.RemoveUnattendedScanCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="{Binding DataContext.UnattendedScanStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock Text="POLLING INTERVALS" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Lower = more responsive, higher = lighter background load (useful on battery). Defaults match every prior release."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="{Binding DataContext.Processes.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Processes — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                        Value="{Binding DataContext.Processes.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="{Binding DataContext.Performance.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=CPU / Memory / Storage / Network — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                        Value="{Binding DataContext.Performance.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="{Binding DataContext.Services.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Services — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                        Value="{Binding DataContext.Services.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <TextBlock Text="{Binding DataContext.EnergyThermals.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Energy &amp; Thermals — {0:0.0}s}" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <Slider Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,16"
                        Value="{Binding DataContext.EnergyThermals.PollIntervalSeconds, RelativeSource={RelativeSource AncestorType=Window}}" />

                <!-- Round 14, item 25: crash-analysis settings - symbol cache folder/path, used by
                     the Stability tab's "Analyse (!analyze -v)" button (DebuggerToolsService). -->
                <TextBlock Text="CRASH ANALYSIS" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Used by the Stability tab's dump analysis (cdb.exe/!analyze -v). A bad or unreachable symbol path is a common reason analysis stalls."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Text="Current _NT_SYMBOL_PATH" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding DataContext.Stability.CurrentSymbolPathText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Text="Symbol cache folder" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                <TextBox Width="200" HorizontalAlignment="Left" Margin="0,0,0,8"
                         Text="{Binding DataContext.Stability.SymbolCacheFolder, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Apply suggested symbol path" Margin="0,0,8,0"
                            Command="{Binding DataContext.Stability.ApplySymbolPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Test symbol server"
                            Command="{Binding DataContext.Stability.TestSymbolServerCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="{Binding DataContext.Stability.SymbolServerStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,16" />

                <!-- #796: a compact mirror of the Windows Health tab's own "Changes made by this
                     app" card (registry-change journal) - reaches WindowsHealthViewModel via the
                     same DataContext.X/AncestorType=Window cross-view-model pattern the polling
                     sliders above already use, since this drawer's own DataContext is
                     ThemeViewModel. Undo only here (no export - this drawer is 280px wide; use the
                     Windows Health tab's card for the full view/export). -->
                <TextBlock Text="CHANGES MADE BY THIS APP" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding DataContext.WindowsHealth.RegistryChanges, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Description}" />
                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Timestamp, StringFormat={}{0:g}}" Margin="0,0,0,4" />
                                    <Button Content="Undo" FontSize="{StaticResource FontCaption}" Padding="6,2" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.UndoRegistryChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No registry changes made by this app yet." TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.WindowsHealth.RegistryChanges.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- #916-927: the Health Check card's rules engine - pack validation (#921), the
                     rule list with inline enable/disable + severity override and a live would-fire
                     indicator (#922/#923), an edit form that only ever writes to the user's own
                     pack (#922), and import/export with a review step plus a metric-bag test
                     fixture flow (#925/#926). Suppression (#924) lives on the Health Check card
                     itself, where findings actually render. -->
                <TextBlock Text="RULES ENGINE" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,14" />
                <TextBlock Text="Health Check findings come from JSON rule definitions under %AppData%\TaskManagerPlus\Rules\, hot-reloaded whenever a pack file changes. Edits here never touch the built-in pack - they write to your own user-overrides.json."
                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="Rule packs" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding DataContext.RulesEditor.PackValidation, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock FontSize="{StaticResource FontBody}">
                                        <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" — " /><Run Text="{Binding RuleCount, Mode=OneWay}" /><Run Text=" rule(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="14,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Rules" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                <Button Content="+ New rule" HorizontalAlignment="Left" Margin="0,0,0,8"
                        Command="{Binding DataContext.RulesEditor.NewRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <ListBox ItemsSource="{Binding DataContext.RulesEditor.Rows, RelativeSource={RelativeSource AncestorType=Window}}"
                         SelectedItem="{Binding DataContext.RulesEditor.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}}"
                         MaxHeight="340" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,3,8,0" ToolTip="Enable/disable this rule (#923)" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" />
                                        <TextBlock Text="BUILT-IN" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="6,2,0,0"
                                                   Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource WarningBrush}" Margin="6,2,0,0"
                                                   Visibility="{Binding IsImported, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="IMPORTED FROM " /><Run Text="{Binding ImportSourceFileName, Mode=OneWay}" />
                                            <Run Text=" - NOT VERIFIED" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConditionSummary}" FontSize="{StaticResource FontBody}" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · confidence " /><Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Source={x:Static vm:RulesEditorViewModel.SeverityValues}}"
                                          SelectedItem="{Binding EffectiveSeverity}" Width="86" FontSize="{StaticResource FontBody}" VerticalAlignment="Top" Margin="8,0,8,0" />
                                <Border Grid.Column="3" Width="10" Height="10" CornerRadius="6" VerticalAlignment="Top" Margin="0,4,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BorderBrush2}" />
                                            <Setter Property="ToolTip" Value="Would not currently fire" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WouldFire}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Setter Property="ToolTip" Value="Would currently fire (#922 live preview)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- #922: inline edit form for the selected rule - writes only to user-overrides.json. -->
                <StackPanel Visibility="{Binding DataContext.RulesEditor.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}"
                            Margin="0,4,0,14">
                    <TextBlock Text="Edit selected rule" Style="{StaticResource ColorRowLabel}" />
                    <TextBlock Text="Title" Style="{StaticResource SubStat}" />
                    <TextBox Text="{Binding DataContext.RulesEditor.EditTitle, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Body (may reference {metric.key} placeholders)" Style="{StaticResource SubStat}" />
                    <TextBox Text="{Binding DataContext.RulesEditor.EditBody, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource SubStat}" />
                            <TextBox Text="{Binding DataContext.RulesEditor.EditCategory, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Severity" Style="{StaticResource SubStat}" />
                            <ComboBox ItemsSource="{Binding Source={x:Static vm:RulesEditorViewModel.SeverityValues}}"
                                      SelectedItem="{Binding DataContext.RulesEditor.EditSeverity, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Confidence (0-100)" Style="{StaticResource SubStat}" />
                            <TextBox Text="{Binding DataContext.RulesEditor.EditConfidence, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sustained for (seconds, optional - #920)" Style="{StaticResource SubStat}" />
                            <TextBox Text="{Binding DataContext.RulesEditor.EditSustainedText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Docs URL (optional)" Style="{StaticResource SubStat}" />
                    <TextBox Text="{Binding DataContext.RulesEditor.EditDocsUrl, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                    <TextBlock Text="Condition JSON - {&quot;metric&quot;,&quot;op&quot;,&quot;value&quot;} or all/any/not (#918)" Style="{StaticResource SubStat}" />
                    <TextBox Text="{Binding DataContext.RulesEditor.EditConditionJson, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" AcceptsReturn="True" MinLines="3" MaxLines="8"
                             VerticalScrollBarVisibility="Auto" Margin="0,2,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Preview condition" Margin="0,0,8,0"
                                Command="{Binding DataContext.RulesEditor.PreviewConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Text="{Binding DataContext.RulesEditor.EditConditionPreview, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontFamily="Consolas" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="Save rule" HorizontalAlignment="Left"
                            Command="{Binding DataContext.RulesEditor.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <TextBlock Text="Import / export your rules" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Export my rules..." Margin="0,0,8,0"
                            Command="{Binding DataContext.RulesEditor.ExportUserPackCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Import rules..."
                            Command="{Binding DataContext.RulesEditor.ImportPackCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <!-- #926: review every incoming rule before committing the import. -->
                <StackPanel Visibility="{Binding DataContext.RulesEditor.IsImportReviewOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,10">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="Reviewing import from " />
                        <Run Text="{Binding DataContext.RulesEditor.ImportSourceFileName, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" - not verified by this app:" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding DataContext.RulesEditor.PendingImportRules, RelativeSource={RelativeSource AncestorType=Window}}" MaxHeight="160" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" (" /><Run Text="{Binding Id, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Confirm import" Margin="0,0,8,0"
                                Command="{Binding DataContext.RulesEditor.ConfirmImportCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Cancel"
                                Command="{Binding DataContext.RulesEditor.CancelImportCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>

                <!-- #925: capture-current-metrics / test-pack-against-a-saved-snapshot. -->
                <TextBlock Text="Test a rule pack against a saved snapshot" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Capture current metrics..." Margin="0,0,8,0"
                            Command="{Binding DataContext.RulesEditor.CaptureBagCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Test pack against snapshot..."
                            Command="{Binding DataContext.RulesEditor.TestPackCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DataContext.RulesEditor.TestResults, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BorderBrush2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WouldFire}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontBody}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding DataContext.RulesEditor.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="Wrap" Margin="0,0,0,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.RulesEditor.StatusText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
