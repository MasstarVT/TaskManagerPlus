<UserControl x:Class="TaskManagerPlus.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:CpuViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="CPU" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.CpuCurrentPercent, StringFormat={}{0:0.0}%}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="{Binding Performance.CpuCurrentClockGhz, StringFormat={}{0:0.00} GHz}" Style="{StaticResource SubStat}" />
                </StackPanel>
            </Border>

            <!-- CPU chart + per-core grid -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="{Binding Performance.CpuName}" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Performance.CpuSpecs}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                    </Grid>
                    <lvc:CartesianChart Series="{Binding Performance.CpuSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                         Height="200" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                    <TextBlock Text="Per-core usage" Style="{StaticResource SubStat}" Margin="0,16,0,10" />
                    <ItemsControl ItemsSource="{Binding Performance.Cores}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="70" Height="54" Margin="0,0,8,8" Background="{DynamicResource BgElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="9,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SubStat}" FontSize="10.5" />
                                        <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{Binding Percent, Converter={StaticResource PercentToBrushConverter}}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
