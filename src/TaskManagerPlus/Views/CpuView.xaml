<UserControl x:Class="TaskManagerPlus.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:CpuViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- #9: best-effort thermal-throttle flag - hot package temp AND meaningfully below
                 rated base clock under load. See CpuViewModel.IsThrottling's remarks for why this
                 is a heuristic, not a verified "throttle reason" the way HWiNFO's MSR reads are. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsThrottling}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5">
                    <Run Text="Possible thermal throttling: " /><Run Text="{Binding ThrottleText, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!-- #35: power-ceiling detector - distinct from the thermal-throttle banner above:
                 pinned at its own session-high power draw while below base clock under load, but
                 NOT running hot, points at a PSU/motherboard power limit or a vendor PL1/PL2 cap
                 rather than the cooler. See CpuViewModel.IsPowerLimited's remarks. -->
            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPowerLimited}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="12.5">
                    <Run Text="Possible power limit (not thermal): " /><Run Text="{Binding PowerLimitText, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="CPU" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.CpuCurrentPercent, StringFormat={}{0:0.0}%}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="{Binding Performance.CpuCurrentClockGhz, StringFormat={}{0:0.00} GHz}" Style="{StaticResource SubStat}" />
                    <!-- #18: base vs. current clock, so "stuck at base clock" (≈0%) or a turbo
                         boost (positive %) is explicit rather than implied by two separate numbers. -->
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                        <Run Text="{Binding Performance.CpuBaseClockGhz, StringFormat={}Base {0:0.00} GHz, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Performance.CpuVsBasePercent, StringFormat={}{0:+0;-0;0}% vs base, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- CPU chart + per-core grid -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="{Binding Performance.CpuName}" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Performance.CpuSpecs}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                    </Grid>
                    <lvc:CartesianChart Series="{Binding Performance.CpuSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                         Height="200" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />

                    <TextBlock Text="Per-core usage" Style="{StaticResource SubStat}" Margin="0,16,0,10" />

                    <!-- One nested ItemsControl per NUMA node (CoreGroups is built in
                         CpuViewModel, not via ICollectionView grouping - a plain nested
                         ItemsControl+WrapPanel is what reliably lays cores out side by side;
                         binding a single ItemsControl to an externally-grouped CollectionView
                         via GroupStyle did not). Outer panel is a vertical StackPanel (one entry
                         per NUMA node - almost always just one), inner panel is the WrapPanel
                         that actually arranges that node's cores in a grid. -->
                    <ItemsControl ItemsSource="{Binding CoreGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding NumaNode, StringFormat=NUMA node {0}}"
                                               FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.HasMultipleNumaNodes, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Cores}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- #78: a parked core is dimmed and tagged "Parked"
                                                     (taking priority over the P-core/E-core tag) -
                                                     Windows has scheduled it off to save power, not
                                                     a fault, but a common, otherwise invisible
                                                     reason only some cores appear busy under light
                                                     load. -->
                                                <views:VfdMeter Title="{Binding Label}" Percent="{Binding Percent}" Glow="False"
                                                                 ValueText="{Binding Percent, StringFormat={}{0:0}}" Unit="%"
                                                                 AccentBrush="{Binding Percent, Converter={StaticResource PercentToBrushConverter}}"
                                                                 Width="104" Margin="0,0,8,8">
                                                    <views:VfdMeter.Style>
                                                        <Style TargetType="views:VfdMeter">
                                                            <Setter Property="SubText" Value="" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.HasHybridTopology, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                        <Condition Binding="{Binding IsPCore}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="SubText" Value="P-core" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.HasHybridTopology, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                        <Condition Binding="{Binding IsPCore}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="SubText" Value="E-core" />
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsParked}" Value="True">
                                                                    <Setter Property="SubText" Value="Parked" />
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </views:VfdMeter.Style>
                                                </views:VfdMeter>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #84: throttle reason breakdown - the one combined "Thermal"/"Power"/"None" readout
                 for the two banners above (see CpuViewModel.ThrottleReason's remarks - it's not a
                 third independent signal, just IsThrottling/IsPowerLimited read together). -->
            <UniformGrid Columns="2" Margin="0,16,0,0">
                <views:VfdMeter Title="Throttle reason" Glow="False" Margin="0,0,6,0"
                                ValueText="{Binding ThrottleReason}"
                                SubText="Best-effort — no vendor limit-reason API available">
                    <views:VfdMeter.Style>
                        <Style TargetType="views:VfdMeter">
                            <Setter Property="AccentBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThrottleReason}" Value="Thermal">
                                    <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ThrottleReason}" Value="Power">
                                    <Setter Property="AccentBrush" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:VfdMeter.Style>
                </views:VfdMeter>
            </UniformGrid>

            <!-- #83: C-state residency - a CPU idling deeply for power savings (high C2/C3) looks
                 very different from one held at a low clock by real throttling, even though both
                 can present as "the CPU seems slow". Collapsed entirely when the counters aren't
                 exposed on this Windows/CPU generation. -->
            <StackPanel Margin="0,16,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Performance.CStatesAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="C-state residency" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
                <UniformGrid Columns="4">
                    <views:VfdMeter Title="Idle (C0/halt)" Glow="False" Margin="0,0,6,0"
                                    Percent="{Binding Performance.CpuIdlePercent}"
                                    ValueText="{Binding Performance.CpuIdlePercent, StringFormat={}{0:0.0}}" Unit="%"
                                    AccentBrush="{DynamicResource TextSecondaryBrush}" />
                    <views:VfdMeter Title="C1" Glow="False" Margin="3,0,3,0"
                                    Percent="{Binding Performance.CpuC1Percent}"
                                    ValueText="{Binding Performance.CpuC1Percent, StringFormat={}{0:0.0}}" Unit="%"
                                    AccentBrush="{DynamicResource AccentBrush}" />
                    <views:VfdMeter Title="C2" Glow="False" Margin="3,0,3,0"
                                    Percent="{Binding Performance.CpuC2Percent}"
                                    ValueText="{Binding Performance.CpuC2Percent, StringFormat={}{0:0.0}}" Unit="%"
                                    AccentBrush="{DynamicResource AccentBrush}" />
                    <views:VfdMeter Title="C3" Glow="False" Margin="6,0,0,0"
                                    Percent="{Binding Performance.CpuC3Percent}"
                                    ValueText="{Binding Performance.CpuC3Percent, StringFormat={}{0:0.0}}" Unit="%"
                                    AccentBrush="{DynamicResource AccentBrush}" />
                </UniformGrid>
            </StackPanel>

            <!-- CPU diagnostics: interrupt/DPC time (#13, a sustained spike usually means a bad
                 driver, not app load), context-switch rate (#14, thrashing/livelock), queue
                 length (#15, threads waiting for a core - CpuQueueLengthGaugePercent is a rough
                 "how concerning" fill past 2x logical processors, same idea as the Storage tab's
                 latency gauges), and session min/max/avg clock (#11). -->
            <TextBlock Text="CPU diagnostics" Style="{StaticResource SubStat}" Margin="0,16,0,10" />
            <UniformGrid Columns="5">
                <views:VfdMeter Title="Interrupt / DPC" Glow="False" Margin="0,0,6,0"
                                Percent="{Binding Performance.CpuInterruptPercent}"
                                ValueText="{Binding Performance.CpuInterruptPercent, StringFormat={}{0:0.0}}" Unit="%"
                                SubText="{Binding Performance.CpuDpcPercent, StringFormat={}+{0:0.0}% DPC}"
                                AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="Context switches" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Performance.ContextSwitchesPerSec, StringFormat={}{0:0}}" Unit="/s"
                                SubText="Thrashing indicator" AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="Queue length" Glow="False" Margin="3,0,3,0"
                                Percent="{Binding Performance.CpuQueueLengthGaugePercent}"
                                ValueText="{Binding Performance.CpuQueueLength, StringFormat={}{0:0}}" Unit="threads"
                                SubText="Waiting for a core" AccentBrush="{Binding Performance.CpuQueueLengthGaugePercent, Converter={StaticResource PercentToBrushConverter}}" />
                <views:VfdMeter Title="Clock (session)" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Performance.CpuAvgClockGhz, StringFormat={}{0:0.00}}" Unit="GHz avg"
                                SubText="{Binding Performance.CpuMaxClockGhzSeen, StringFormat={}up to {0:0.00} GHz}"
                                AccentBrush="{DynamicResource AccentBrush}" />
                <!-- #78: how many logical cores Windows currently has parked to save power - a
                     common, otherwise invisible reason "only half my CPU seems busy" under
                     light load. Always 0 (not "unavailable") when the counter itself doesn't
                     exist on this Windows version - see HardwareMonitorService's remarks. -->
                <views:VfdMeter Title="Parked cores" Glow="False" Margin="6,0,0,0"
                                ValueText="{Binding Performance.ParkedCoreCount, StringFormat={}{0}}" Unit="cores"
                                SubText="Power-saving" AccentBrush="{DynamicResource AccentBrush}" />
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
