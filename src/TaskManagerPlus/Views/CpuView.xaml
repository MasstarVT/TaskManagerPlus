<UserControl x:Class="TaskManagerPlus.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:CpuViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="CPU" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.CpuCurrentPercent, StringFormat={}{0:0.0}%}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="{Binding Performance.CpuCurrentClockGhz, StringFormat={}{0:0.00} GHz}" Style="{StaticResource SubStat}" />
                </StackPanel>
            </Border>

            <!-- CPU chart + per-core grid -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="{Binding Performance.CpuName}" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Performance.CpuSpecs}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                    </Grid>
                    <lvc:CartesianChart Series="{Binding Performance.CpuSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                         Height="200" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />

                    <TextBlock Text="Per-core usage" Style="{StaticResource SubStat}" Margin="0,16,0,10" />

                    <!-- One nested ItemsControl per NUMA node (CoreGroups is built in
                         CpuViewModel, not via ICollectionView grouping - a plain nested
                         ItemsControl+WrapPanel is what reliably lays cores out side by side;
                         binding a single ItemsControl to an externally-grouped CollectionView
                         via GroupStyle did not). Outer panel is a vertical StackPanel (one entry
                         per NUMA node - almost always just one), inner panel is the WrapPanel
                         that actually arranges that node's cores in a grid. -->
                    <ItemsControl ItemsSource="{Binding CoreGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding NumaNode, StringFormat=NUMA node {0}}"
                                               FontSize="10.5" FontWeight="SemiBold" Margin="0,4,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.HasMultipleNumaNodes, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Cores}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <views:VfdMeter Title="{Binding Label}" Percent="{Binding Percent}" Glow="False"
                                                                 ValueText="{Binding Percent, StringFormat={}{0:0}}" Unit="%"
                                                                 AccentBrush="{Binding Percent, Converter={StaticResource PercentToBrushConverter}}"
                                                                 Width="104" Margin="0,0,8,8">
                                                    <views:VfdMeter.Style>
                                                        <Style TargetType="views:VfdMeter">
                                                            <Setter Property="SubText" Value="" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.HasHybridTopology, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                        <Condition Binding="{Binding IsPCore}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="SubText" Value="P-core" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.HasHybridTopology, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                        <Condition Binding="{Binding IsPCore}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="SubText" Value="E-core" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </views:VfdMeter.Style>
                                                </views:VfdMeter>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
