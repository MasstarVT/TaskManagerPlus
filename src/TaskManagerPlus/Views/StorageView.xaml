<UserControl x:Class="TaskManagerPlus.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StorageViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Disk" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.DiskPercent, StringFormat={}{0:0.0}%}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="Active time (% Disk Time - a busy-time counter that can read above 100% under a deep queue)"
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                    <!-- #365: Task Manager's own "Active time" is really 100 - % Idle Time, not
                         % Disk Time - shown alongside so a pinned-at-100% reading above can be
                         sanity-checked against it. Hidden when % Idle Time isn't available on this
                         system, rather than showing a fabricated/duplicate figure. -->
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Performance.DiskIdleTimeAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Corrected utilization (100 − % Idle Time, matches Task Manager's own &quot;Active time&quot;): " />
                        <Run Text="{Binding Performance.DiskUtilizationPercent, StringFormat={}{0:0.0}%}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Disk chart -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Disk activity" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <!-- #141: crash/error markers, reusing whatever the Stability tab last read - toggleable. -->
                    <CheckBox Content="Show crash/error markers" IsChecked="{Binding Performance.ShowEventMarkers}"
                               FontSize="10.5" HorizontalAlignment="Right" Margin="0,0,0,4" />
                    <lvc:CartesianChart Series="{Binding Performance.DiskSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                         Sections="{Binding Performance.EventMarkerSections}"
                                         Height="200" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- #682: compact PCIe link-speed/width readout for NVMe controllers - see the GPU
                 tab's own PCIe link card for the full picture (drift detection, ASPM, eGPU). An
                 x4 drive isn't a problem; a Gen4 drive silently running at Gen1, or a link that's
                 changed since a previous boot, points at a dirty slot or a dying drive. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NVMe PCIe link" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check PCIe links" Command="{Binding LoadPciLinkInfoCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PciLinkStatusText}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PciLinkStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding NvmePciLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}" FontSize="10.5" TextWrapping="Wrap">
                                            <Run Text="Max " /><Run Text="{Binding MaxLinkText, Mode=OneWay}" />
                                            <Run Text=" · Previous boot " /><Run Text="{Binding PreviousBootLinkText, TargetNullValue='(none recorded)', Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentLinkText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBelowMax}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ChangedSincePreviousBoot}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Bottleneck diagnostics: queue length (requests waiting, not just active) and
                 per-I/O latency - both flag a saturated/failing drive earlier than raw
                 throughput or %-active-time alone. -->
            <TextBlock Text="Bottleneck diagnostics" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <views:VfdMeter Title="Queue length" Glow="False" Margin="0,0,8,0"
                                Percent="{Binding Performance.DiskQueueLengthGaugePercent}"
                                ValueText="{Binding Performance.DiskQueueLength, StringFormat={}{0:0.00}}"
                                SubText="Requests waiting" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Read latency" Glow="False" Margin="4,0,4,0"
                                Percent="{Binding Performance.DiskReadLatencyGaugePercent}"
                                ValueText="{Binding Performance.DiskReadLatencyMs, StringFormat={}{0:0.0}}" Unit="ms"
                                SubText="Avg. per read" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Write latency" Glow="False" Margin="8,0,0,0"
                                Percent="{Binding Performance.DiskWriteLatencyGaugePercent}"
                                ValueText="{Binding Performance.DiskWriteLatencyMs, StringFormat={}{0:0.0}}" Unit="ms"
                                SubText="Avg. per write" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
            </UniformGrid>

            <!-- Round 18, #366: read/write activity split ("% Disk Read Time" vs. "% Disk Write
                 Time") and average I/O size (Bytes/sec ÷ Transfers/sec), beside the queue-length/
                 latency tiles above. -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <views:VfdMeter Title="Read time" Glow="False" Margin="0,0,8,0" Unit="%"
                                Percent="{Binding Performance.DiskReadTimePercent}"
                                ValueText="{Binding Performance.DiskReadTimePercent, StringFormat={}{0:0.0}}"
                                SubText="% Disk Read Time" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Write time" Glow="False" Margin="4,0,4,0" Unit="%"
                                Percent="{Binding Performance.DiskWriteTimePercent}"
                                ValueText="{Binding Performance.DiskWriteTimePercent, StringFormat={}{0:0.0}}"
                                SubText="% Disk Write Time" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Avg. I/O size" Glow="False" Margin="8,0,0,0" Percent="0"
                                ValueText="{Binding Performance.DiskAverageBytesPerTransfer, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=–}"
                                SubText="Bytes/sec ÷ Transfers/sec" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
            </UniformGrid>

            <!-- Round 18, #362/#363/#365: per-physical-disk bottleneck diagnostics - one row per
                 PhysicalDisk instance Windows reports (not just the "_Total" aggregate above), so
                 one slow drive isn't averaged away by others, plus a rolling-window latency-
                 percentile summary and bucketed histogram per disk (#363) - this is where stutter
                 lives, which the flat mean above hides. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Per-disk diagnostics" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="One row per physical disk Windows reports, each with its own queue length, latency, throughput, and a rolling 5-minute latency-percentile window - a single slow drive doesn't get averaged into the aggregate figures above."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PhysicalDiskRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DiskName}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                        <UniformGrid Columns="5" Margin="0,0,0,8">
                                            <views:VfdMeter Title="Utilization" Glow="False" Margin="0,0,4,0" Unit="%"
                                                            Percent="{Binding UtilizationPercent}"
                                                            ValueText="{Binding UtilizationPercent, StringFormat={}{0:0.0}}"
                                                            SubText="100 − % Idle Time"
                                                            AccentBrush="{Binding DataContext.Performance.DiskColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                                            <views:VfdMeter Title="Active time" Glow="False" Margin="4,0,4,0" Unit="%"
                                                            Percent="{Binding ActivePercent}"
                                                            ValueText="{Binding ActivePercent, StringFormat={}{0:0.0}}"
                                                            SubText="% Disk Time"
                                                            AccentBrush="{Binding DataContext.Performance.DiskColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                                            <views:VfdMeter Title="Queue length" Glow="False" Margin="4,0,4,0" Percent="0"
                                                            ValueText="{Binding QueueLength, StringFormat={}{0:0.00}}"
                                                            SubText="Requests waiting"
                                                            AccentBrush="{Binding DataContext.Performance.DiskColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                                            <views:VfdMeter Title="Read latency" Glow="False" Margin="4,0,4,0" Unit="ms" Percent="0"
                                                            ValueText="{Binding ReadLatencyMs, StringFormat={}{0:0.0}}"
                                                            SubText="Avg. per read"
                                                            AccentBrush="{Binding DataContext.Performance.DiskColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                                            <views:VfdMeter Title="Write latency" Glow="False" Margin="4,0,0,0" Unit="ms" Percent="0"
                                                            ValueText="{Binding WriteLatencyMs, StringFormat={}{0:0.0}}"
                                                            SubText="Avg. per write"
                                                            AccentBrush="{Binding DataContext.Performance.DiskColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                                        </UniformGrid>

                                        <TextBlock Text="{Binding PercentileSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding PercentileWindowText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" FontSize="10.5" Margin="0,0,0,8"
                                                   Visibility="{Binding PercentileWindowText, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <ItemsControl ItemsSource="{Binding HistogramBuckets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Border Grid.Column="1" Height="10" CornerRadius="3" Background="{DynamicResource BgPanelBrush}" HorizontalAlignment="Left" Width="160">
                                                            <Border CornerRadius="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                                                    Width="{Binding Percent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=160}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:0.#}%}" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 18, #364: disk stall timeline - every sample where "Avg. Disk sec/Transfer"
                 exceeded the threshold below, logged chronologically with a best-effort top disk
                 process (see StorageViewModel.FindTopDiskProcessText). Always watching (unlike most
                 of this tab's other on-demand cards) since a stall the user isn't looking for is
                 exactly what this exists to catch. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Disk stalls" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Logs every sample where a disk's average per-transfer latency crosses the threshold below, with a best-effort guess at the top disk-consuming process at that moment (a partial correlation, not a guarantee - see the note on each row)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stall threshold (ms)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <TextBox Grid.Column="1" Width="70" Text="{Binding DiskStallThresholdMs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Grid.Column="2" Content="Watch for stalls" IsChecked="{Binding DiskStallDetectionEnabled}" VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding DiskStalls}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                            <DataGridTextColumn Header="Disk" Binding="{Binding DiskName}" Width="110" />
                            <DataGridTextColumn Header="Latency" Binding="{Binding TransferLatencyMs, StringFormat={}{0:0} ms}" Width="80" />
                            <DataGridTextColumn Header="Top disk process (approx.)" Binding="{Binding TopProcessText}" Width="2.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #17: per-drive temperature, filtered from the same LibreHardwareMonitorLib
                 sensor poll the Energy & Thermals tab already runs - see StorageViewModel. -->
            <TextBlock Text="Drive temperatures" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding DriveTemperatures}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:VfdMeter Title="{Binding HardwareName}" Glow="False" Width="172" Margin="0,0,8,8"
                                        Percent="{Binding Value, TargetNullValue=0}"
                                        ValueText="{Binding Value, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                        SubText="{Binding SensorName}"
                                        AccentBrush="{Binding Value, Converter={StaticResource TemperatureToBrushConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No drive temperature sensors detected.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DriveTemperatures.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- #85: Storage Spaces / RAID member health rollup - hidden entirely when the system
                 has no Storage Spaces pools configured (the common case). Round 20, #386/#387/#388
                 extend each virtual disk row with its pool's member physical disks, any in-flight
                 repair/rebuild job (plus a Repair action), and a thin-provisioning over-commit
                 warning. -->
            <Border Margin="0,16,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StoragePools.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Storage Spaces / RAID" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding StoragePools}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="12.5">
                                                    <Run Text="{Binding VirtualDiskName}" FontWeight="SemiBold" />
                                                    <Run Text=" · " /><Run Text="{Binding PoolName}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                                                    <Run Text="{Binding ResiliencySettingName}" /><Run Text=" · " /><Run Text="{Binding OperationalStatus}" />
                                                    <Run Text=" · " /><Run Text="{Binding ProvisioningTypeText}" /><Run Text=" provisioning" />
                                                    <Run Text=" · " /><Run Text="{Binding AllocatedSizeText}" /><Run Text=" of " /><Run Text="{Binding SizeText}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding HealthStatus}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHealthWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- #388: thin-provisioning over-commit warning - empty/hidden unless the pool
                                             actually has a thin virtual disk and is over-committed or close to full. -->
                                        <TextBlock Text="{Binding ThinProvisioningWarningText}" Style="{StaticResource SubStat}"
                                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,4"
                                                   Visibility="{Binding ShowThinProvisioningWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- #386: pool member physical disks. -->
                                        <StackPanel Visibility="{Binding HasMemberDisks, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                                            <TextBlock Text="Pool members" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,2" />
                                            <ItemsControl ItemsSource="{Binding MemberDisks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnhealthy}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding FriendlyName, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text=" - " /><Run Text="{Binding UsageText, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding OperationalStatusText, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding AllocatedText, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- #387: in-flight repair/rebuild jobs + Repair action. -->
                                        <StackPanel Visibility="{Binding HasActiveJobs, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                                            <TextBlock Text="Active jobs" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,2" />
                                            <ItemsControl ItemsSource="{Binding ActiveJobs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource SubStat}" FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text=" - " /><Run Text="{Binding JobStateText, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding PercentComplete, Mode=OneWay, StringFormat={}{0:0}%}" /><Run Text=" complete" />
                                                            <Run Text=" · elapsed " /><Run Text="{Binding ElapsedTimeText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid Margin="0,6,0,0" Visibility="{Binding CanRepair, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="This virtual disk is Degraded or In Service - repair restores redundancy to different/new physical disks in the pool."
                                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Grid.Column="1" Content="Repair" Padding="10,4" FontSize="11.5"
                                                    Command="{Binding DataContext.RepairVirtualDiskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding RepairStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding RepairStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 20, #389-#393: BitLocker card. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="BitLocker" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Key protector identifiers are shown, never the recovery key itself. Cipher, hardware-encryption support, live conversion percentage, suspended-protection countdown, and (where BitLocker is off) a best-effort reason why."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BitLockerStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding BitLockerVolumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DriveLetter, StringFormat={}{0}:}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ConversionStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Not applicable / unknown - no Win32_EncryptableVolume instance, or access denied. -->
                                        <TextBlock Text="{Binding UnavailableReason}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Available}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Visibility="{Binding Available, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- #391: cipher + hardware encryption + live conversion percentage. -->
                                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap">
                                                <Run Text="Cipher: " /><Run Text="{Binding EncryptionMethodText, Mode=OneWay, TargetNullValue=Unknown}" />
                                                <Run Text=" · Hardware encryption: " /><Run Text="{Binding HardwareEncryptionStatusText, Mode=OneWay}" />
                                            </TextBlock>
                                            <StackPanel Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,2,0,4">
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding EncryptionPercentage, Mode=OneWay, TargetNullValue=0}" Margin="0,0,0,2" />
                                                <TextBlock Style="{StaticResource SubStat}" Text="{Binding EncryptionPercentageText, StringFormat={}{0} complete}" />
                                            </StackPanel>

                                            <!-- #390: suspended protection + auto-unlock. -->
                                            <TextBlock Text="{Binding ProtectionSummaryText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,2"
                                                       Visibility="{Binding IsProtectionSuspended, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding AutoUnlockText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,2"
                                                       Visibility="{Binding AutoUnlockText, Converter={StaticResource StringToVisibilityConverter}}" />
                                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap"
                                                       Visibility="{Binding IsAutoUnlockKeyStored, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Run Text="An auto-unlock key for at least one data volume is stored on this OS volume." />
                                            </TextBlock>

                                            <!-- #393: only shown when BitLocker is off and a reason was actually found. -->
                                            <TextBlock Text="{Binding OffReasonText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Visibility="{Binding HasOffReason, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- #389: key protector inventory - IDs and types ONLY, never the recovery key. -->
                                            <StackPanel Visibility="{Binding HasKeyProtectors, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Key protectors" FontWeight="SemiBold" FontSize="11.5" Margin="0,2,0,2" />
                                                <ItemsControl ItemsSource="{Binding KeyProtectors}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource SubStat}" FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                                <Run Text="{Binding TypeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=" - ID " /><Run Text="{Binding Id, Mode=OneWay}" FontFamily="Consolas" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #392: recovery-prompt history - explicit button, event-log scan. -->
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Recovery-prompt history: times this PC asked for the recovery key, correlated with nearby TPM/firmware/Secure-Boot-related events (a likely cause, not a proven one)."
                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Check now" Padding="10,4" Command="{Binding CheckBitLockerRecoveryPromptsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding BitLockerRecoveryPromptsStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding BitLockerRecoveryPrompts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0,0,0,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap">
                                            <Run Text="{Binding TimeCreated, Mode=OneWay, StringFormat={}{0:g}}" FontWeight="SemiBold" />
                                            <Run Text=" - " /><Run Text="{Binding Channel, Mode=OneWay}" />
                                            <Run Text=" (event " /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding LikelyCauseText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasLikelyCause, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 21 (final chunk), #394-#400: "Volume Shadow Copy" card - VSS writer health,
                 correlated VSS/SPP/volsnap failure events, shadow copy inventory, shadow storage
                 allocation/limit + resize, restore points + System Protection per-drive state +
                 "create a restore point now," and registered VSS provider inventory. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume Shadow Copy" Style="{StaticResource CardTitle}" Margin="0" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshVssCommand}" />
                    </Grid>
                    <TextBlock Text="VSS writer health, backup/restore-point failure events, shadow copy inventory, shadow storage allocation/limits, System Protection state, and registered snapshot providers - the diagnostics behind Windows' own System Restore and every VSS-based backup tool."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding VssStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <!-- #394: VSS writer health - a failed writer is the single most common root
                         cause of "my backup keeps failing," and is otherwise invisible everywhere
                         else in Windows. -->
                    <TextBlock Text="Writers" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding VssWriters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="3" Padding="8,3" VerticalAlignment="Top" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap">
                                            <Run Text="Last error: " /><Run Text="{Binding LastError, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource SubStat}" FontFamily="Consolas" FontSize="10.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No VSS writers reported.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VssWriters.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #395/#399: correlated VSS/SPP/volsnap failure events - a writer that
                         currently shows Stable above but has been failing nightly still shows up
                         here. volsnap 25 gets a distinct callout since it's why restore points/
                         shadow copies silently disappear. -->
                    <TextBlock Text="Correlated failure events (last 30 days)" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4" />
                    <TextBlock Text="Application-log VSS (8193, 12289, 12293) and SPP (16387); System-log volsnap (25, 33, 36)."
                               Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding VssRelatedEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0,0,0,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap">
                                            <Run Text="{Binding TimeCreated, Mode=OneWay, StringFormat={}{0:g}}" FontWeight="SemiBold" />
                                            <Run Text=" - " /><Run Text="{Binding Volume, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" - " /><Run Text="{Binding Source, Mode=OneWay}" />
                                            <Run Text=" (event " /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding ExplanationText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No VSS/SPP/volsnap failure events found in the last 30 days.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VssRelatedEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #396: shadow copy inventory - grouped by volume with age. -->
                    <TextBlock Text="Shadow copies" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding VssShadowCopies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap">
                                            <Run Text="{Binding Volume, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" - created " /><Run Text="{Binding CreationTime, Mode=OneWay, StringFormat={}{0:g}, TargetNullValue=Unknown}" />
                                            <Run Text=" (" /><Run Text="{Binding AgeText, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Provider: " /><Run Text="{Binding Provider, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Originating machine: " /><Run Text="{Binding OriginatingMachine, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding ShadowCopyId}" Style="{StaticResource SubStat}" FontFamily="Consolas" FontSize="10.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No shadow copies exist on any volume.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VssShadowCopies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #397: shadow storage allocation/limit + resize. -->
                    <TextBlock Text="Shadow storage allocation and limit" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding VssShadowStorage}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Volume}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,2"
                                                   Visibility="{Binding StorageVolume, Converter={StaticResource StringToVisibilityConverter}}">
                                            <Run Text="Storage lives on: " /><Run Text="{Binding StorageVolume, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2">
                                            <Run Text="Used: " /><Run Text="{Binding UsedBytes, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                                            <Run Text=" · Allocated: " /><Run Text="{Binding AllocatedBytes, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNumericMaximum}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Maximum: " /><Run Text="{Binding MaximumBytes, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                                        </TextBlock>
                                        <TextBlock Text="Maximum: UNBOUNDED - no cap set, can grow to fill the volume" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnbounded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Resize (a number of GB, or type UNBOUNDED):" Style="{StaticResource SubStat}" Margin="0,4,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding NewMaxSizeGb, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" Padding="6,3" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Resize" Padding="10,4" FontSize="11.5"
                                                    Command="{Binding DataContext.ResizeShadowStorageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ResizeStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding ResizeStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No volume has a shadow-copy-storage association.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VssShadowStorage.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #398: System Protection per-drive state + restore points + create action. -->
                    <TextBlock Text="System Protection" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding SystemProtectionStatuses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock FontSize="12.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding DriveLetter, Mode=OneWay, StringFormat={}{0}:}" />
                                        <Run Text=" - " /><Run Text="{Binding ProtectedText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DetectionMethodText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Create a restore point now" FontWeight="SemiBold" FontSize="12.5" Margin="0,10,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewRestorePointDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Padding="6,3" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Create restore point" Padding="10,4" Command="{Binding CreateRestorePointCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding CreateRestorePointStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,4" TextWrapping="Wrap"
                               Visibility="{Binding CreateRestorePointStatusText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <TextBlock Text="Restore points" FontWeight="SemiBold" FontSize="12.5" Margin="0,10,0,4" />
                    <ItemsControl ItemsSource="{Binding RestorePoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0,0,0,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap">
                                            <Run Text="{Binding CreationTime, Mode=OneWay, StringFormat={}{0:g}, TargetNullValue=Unknown}" FontWeight="SemiBold" />
                                            <Run Text=" - " /><Run Text="{Binding Description, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                                            <Run Text="Type: " /><Run Text="{Binding RestorePointTypeText, Mode=OneWay}" />
                                            <Run Text=" · Sequence " /><Run Text="{Binding SequenceNumber, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No restore points found - System Protection may be off for every drive, or this Windows edition/build doesn't expose the SystemRestore WMI class. An empty list on a drive you believe is protected is itself the finding.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RestorePoints.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #400: registered VSS provider inventory. -->
                    <TextBlock Text="Registered VSS providers" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,4" />
                    <TextBlock Text="A third-party provider shadowing the Microsoft Software Shadow Copy provider is a recurring cause of failed snapshots and stuck writers - not a fault by itself, but worth a manual check if writers above are unhealthy or snapshots are getting stuck."
                               Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding VssProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock FontSize="12.5" TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" (" /><Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding Id, Mode=OneWay}" FontFamily="Consolas" />
                                    </TextBlock>
                                    <TextBlock Text="Not a Microsoft provider - worth a manual check if snapshots are failing or getting stuck (informational, not a fault by itself)."
                                               Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMicrosoft}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No VSS providers reported.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VssProviders.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 14, #328: per-drive Healthy/Watch/Replace verdict - combines predicted
                 failure, critical SMART attributes, NVMe critical-warning bits, pending sectors and
                 pool membership into one three-state verdict with reasons listed beneath it,
                 deliberately not a made-up numeric score. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Drive health verdict" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Predicted failure + pool status are always current; critical-attribute/pending-sector/NVMe-warning counts refine once you read SMART details for that disk below."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DriveHealthVerdicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="3" Padding="8,3" VerticalAlignment="Top" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LevelText}" Value="Watch">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LevelText}" Value="Replace">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Model}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ReasonsText}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No disks detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DriveHealthVerdicts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 19, #385: Layout card - unallocated tail space (over-provisioning) + 4K
                 partition-alignment per disk, read once at tab load. Informational throughout:
                 deliberate over-provisioning is a valid, common SSD choice; misalignment costs
                 real read-modify-write overhead but is stated as a fact, not an alarm. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Layout" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Unallocated space at the tail of each disk, and whether every partition starts on a 4K boundary. Deliberate over-provisioning is a valid, common SSD choice - only shown as a plain fact. Misalignment costs real read-modify-write overhead on 4Kn/512e media."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DiskLayoutStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding DiskLayoutRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Model, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MediaTypeText, Mode=OneWay}" />
                                        </TextBlock>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Available}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="Disk size: " /><Run Text="{Binding DiskSizeText, Mode=OneWay}" />
                                                <Run Text=" · Partitioned: " /><Run Text="{Binding PartitionedText, Mode=OneWay}" />
                                                <Run Text=" · Largest free extent: " /><Run Text="{Binding LargestFreeExtentText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding OverProvisioningSummaryText}" Style="{StaticResource SubStat}" Margin="0,2,0,6" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding UnavailableReason}" Margin="0,2,0,6" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Available}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Partitions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAligned}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="Partition " /><Run Text="{Binding PartitionNumber, Mode=OneWay}" />
                                                        <Run Text=" (" /><Run Text="{Binding DriveLetterText, Mode=OneWay}" /><Run Text=", " />
                                                        <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=") - " />
                                                        <Run Text="{Binding AlignmentText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #337/#338/#339/#343/#345: per-volume filesystem facts - the anchor for
                 this round's NTFS/chkdsk features. One row per fixed, lettered volume; NTFS-only
                 facts (self-healing, corruption log) show "Unknown"/an empty log on a non-NTFS row
                 rather than a guessed value. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filesystem" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshVolumeFilesystemFactsCommand}" />
                    </Grid>
                    <TextBlock Text="One MSFT_Volume query per volume, plus fsutil dirty/self-healing state, the NTFS corruption log, and boot-time check scheduling."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding VolumeFilesystemRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <!-- #345: header - letter, filesystem/label/health/operational status, dirty badge (#337). -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DriveLetter, StringFormat={}{0}:}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap">
                                                <Run Text="{Binding Facts.FileSystemName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · " /><Run Text="{Binding Facts.FileSystemLabel, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding Facts.HealthStatus, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding Facts.OperationalStatus, Mode=OneWay}" />
                                            </TextBlock>
                                            <Border Grid.Column="2" CornerRadius="3" Padding="8,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DirtyText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                        </Grid>

                                        <!-- #345: allocation unit vs. physical sector, dedup, ReFS integrity streams. -->
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap">
                                            <Run Text="Cluster " /><Run Text="{Binding AllocationUnitSizeText, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · Physical sector " /><Run Text="{Binding PhysicalSectorSizeText, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · Dedup: " /><Run Text="{Binding Facts.DedupModeText, Mode=OneWay}" />
                                            <Run Text=" · ReFS integrity streams: " /><Run Text="{Binding Facts.RefsIntegrityStreamsText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="Cluster size is smaller than this drive's physical sector size - every sub-sector write costs a read-modify-write penalty."
                                                   Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Facts.ClusterSmallerThanPhysicalSector}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- #338: self-healing state + Enable/Disable toggle. -->
                                        <Grid Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource SubStat}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                <Run Text="NTFS self-healing: " /><Run Text="{Binding SelfHealingText, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Padding="8,3" FontSize="11.5" IsEnabled="{Binding Facts.IsNtfs}"
                                                    Command="{Binding DataContext.ToggleSelfHealingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Enable" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelfHealingEnabled}" Value="True">
                                                                <Setter Property="Content" Value="Disable" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding SelfHealingActionStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Visibility="{Binding SelfHealingActionStatusText, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <!-- #339: corruption record log - count badge + list. -->
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap">
                                            <Run Text="NTFS corruption log: " /><Run Text="{Binding CorruptionCountText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding CorruptionRecords}" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11.5" Margin="0,0,0,3" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}">
                                                        <Run Text="{Binding Index, Mode=OneWay, StringFormat=#{0}: }" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- #343: boot-time check scheduling - reboot requirement and /r runtime stated up front. -->
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap">
                                            <Run Text="Boot-time check: " /><Run Text="{Binding ChkntfsText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding BootExecuteText, StringFormat=Raw BootExecute value: {0}}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                        <TextBlock Text="Scheduling requires a reboot to take effect. The /r (bad-sector) pass can take several hours on a large volume - the computer won't be usable for normal work until it finishes."
                                                   Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Button Content="Schedule boot check (/f /r)" Padding="8,3" FontSize="11.5" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ScheduleBootCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Cancel scheduled check" Padding="8,3" FontSize="11.5"
                                                    Command="{Binding DataContext.CancelBootCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BootCheckActionStatusText}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding BootCheckActionStatusText, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <!-- Round 16, #346/#348: USN journal status + create/resize/delete. -->
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,8" />
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap">
                                            <Run Text="USN journal: " /><Run Text="{Binding UsnJournalSummaryText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding UsnJournalRangeText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                                                   Visibility="{Binding UsnJournalRangeText, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding UsnJournalSizeText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                                                   Visibility="{Binding UsnJournalSizeText, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Text="A journal that has already wrapped/been recreated is the usual reason backup, search, and indexing tools keep falling back to a full rescan instead of an incremental one. Quick flag, not a verdict."
                                                   Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Visibility="{Binding ShowUsnJournalWrappedWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,4,0" Padding="4,2" FontSize="11.5" VerticalContentAlignment="Center"
                                                     Text="{Binding DataContext.UsnMaxSizeMbInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Maximum size in MB (blank = fsutil default)" />
                                            <TextBox Grid.Column="1" Margin="0,0,4,0" Padding="4,2" FontSize="11.5" VerticalContentAlignment="Center"
                                                     Text="{Binding DataContext.UsnAllocationDeltaMbInput, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Allocation delta in MB (blank = fsutil default)" />
                                            <Button Grid.Column="2" Content="Create/resize" Padding="8,3" FontSize="11.5" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.CreateOrResizeUsnJournalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="3" Content="Delete journal" Padding="8,3" FontSize="11.5"
                                                    Command="{Binding DataContext.DeleteUsnJournalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="Sizes are optional (fsutil picks a volume-size-based default when blank). Deleting the journal forces every dependent tool to rescan."
                                                   Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding UsnJournalActionStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Visibility="{Binding UsnJournalActionStatusText, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <!-- #350: NTFS geometry facts. -->
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,2" TextWrapping="Wrap">
                                            <Run Text="Geometry: " /><Run Text="{Binding GeometryClusterSectorText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding GeometryMftText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                                                   Visibility="{Binding GeometryMftText, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding GeometryLogFileText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Visibility="{Binding GeometryLogFileText, Converter={StaticResource StringToVisibilityConverter}}" />

                                        <TextBlock Text="{Binding NtfsFactsStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding NtfsFactsStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No fixed, lettered volumes detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VolumeFilesystemRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 16, #349: NTFS metadata activity - per-second deltas, sampled every
                 PerformanceViewModel tick for the selected volume. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NTFS metadata activity" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Width="70" ItemsSource="{Binding ChkdskVolumeOptions}" SelectedItem="{Binding SelectedNtfsActivityDrive}" />
                    </Grid>
                    <TextBlock Text="`fsutil fsinfo statistics` MFT/metadata/log-file counters, sampled every tick and shown as per-second deltas - not a live kernel event stream, so a very short burst between two ticks can be missed."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <UniformGrid Columns="5">
                        <views:VfdMeter Title="MFT reads" Glow="False" Margin="0,0,6,0" Percent="0" Unit="/s"
                                        ValueText="{Binding MftReadsPerSec, StringFormat={}{0:0.0}}" SubText="fsutil fsinfo statistics"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <views:VfdMeter Title="MFT writes" Glow="False" Margin="0,0,6,0" Percent="0" Unit="/s"
                                        ValueText="{Binding MftWritesPerSec, StringFormat={}{0:0.0}}" SubText="fsutil fsinfo statistics"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <views:VfdMeter Title="Metadata reads" Glow="False" Margin="0,0,6,0" Percent="0" Unit="/s"
                                        ValueText="{Binding MetadataReadsPerSec, StringFormat={}{0:0.0}}" SubText="fsutil fsinfo statistics"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <views:VfdMeter Title="Metadata writes" Glow="False" Margin="0,0,6,0" Percent="0" Unit="/s"
                                        ValueText="{Binding MetadataWritesPerSec, StringFormat={}{0:0.0}}" SubText="fsutil fsinfo statistics"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <views:VfdMeter Title="$LogFile writes" Glow="False" Percent="0" Unit="/s"
                                        ValueText="{Binding LogFileWritesPerSec, StringFormat={}{0:0.0}}" SubText="fsutil fsinfo statistics"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding NtfsActivityStatusText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding NtfsActivityStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Round 16, #347: USN churn hot spots - "what is writing to this disk". -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="What is writing to this disk" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Reads the USN change journal and aggregates records by the changed file's own name (not a resolved parent-directory path - see the folder reference column) into a top-20 list by change count, broken down by reason flag."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Width="70" Margin="0,0,8,0" ItemsSource="{Binding ChkdskVolumeOptions}" SelectedItem="{Binding SelectedUsnHotSpotDrive}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Last" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                            <TextBox Width="40" Text="{Binding UsnHotSpotMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" FontSize="11.5" VerticalContentAlignment="Center" />
                            <TextBlock Text="minute(s)" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="Find hot spots" Padding="10,4" Command="{Binding FindUsnHotSpotsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding UsnHotSpotStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding UsnHotSpots}" IsReadOnly="True" MaxHeight="320" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.6*" />
                            <DataGridTextColumn Header="Changes" Binding="{Binding ChangeCount}" Width="Auto" />
                            <DataGridTextColumn Header="Folder ref (FRN)" Binding="{Binding ParentFrnText}" Width="1.4*" />
                            <DataGridTextColumn Header="Reasons" Binding="{Binding ReasonBreakdownText}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 16, #351: NTFS behaviour settings audit - system-wide, not per volume. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NTFS behaviour settings" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshNtfsBehaviorSettingsCommand}" />
                    </Grid>
                    <TextBlock Text="`fsutil behavior query` - system-wide settings, not per volume. Enable/Disable controls are offered only for the two most commonly toggled, safest-to-expose settings; the rest are read-only here."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NtfsBehaviorStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding NtfsBehaviorSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Setting.Label}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Setting.CanToggle}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="Enable" Padding="8,3" FontSize="11.5" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.EnableNtfsBehaviorSettingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Disable" Padding="8,3" FontSize="11.5"
                                                        Command="{Binding DataContext.DisableNtfsBehaviorSettingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Setting.ValueText}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Setting.PerformanceImplication}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ActionStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding ActionStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 15, #340/#341: online chkdsk /scan runner (streamed, cancellable) plus
                 MSFT_Volume.Repair (Scan/SpotFix/OfflineScanAndFix). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Chkdsk / repair" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Online verification (chkdsk /scan - no dismount, no reboot) and the WMI methods behind Repair-Volume (Scan/SpotFix/OfflineScanAndFix)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ComboBox Margin="0,0,0,8" ItemsSource="{Binding ChkdskVolumeOptions}" SelectedItem="{Binding SelectedChkdskVolume}" />
                    <TextBlock Text="{Binding ChkdskLastScanText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding ChkdskLastScanText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <TextBlock Text="Online scan (chkdsk /scan)" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Run scan" Padding="10,4" Margin="0,0,8,0" Command="{Binding RunChkdskScanCommand}" />
                        <Button Content="Cancel" Padding="10,4" Command="{Binding CancelChkdskScanCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ChkdskScanStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ChkdskScanLogText, Mode=OneWay}" IsReadOnly="True" Height="160" FontFamily="Consolas" FontSize="11"
                             TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                    <TextBlock Text="WMI repair (Repair-Volume)" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                    <TextBlock Text="SpotFix and Offline scan and fix are confirmed before running - Offline dismounts the volume for the duration of the repair."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Scan" Padding="10,4" Margin="0,0,8,0" Command="{Binding RunVolumeScanCommand}" />
                        <Button Content="SpotFix" Padding="10,4" Margin="0,0,8,0" Command="{Binding RunVolumeSpotFixCommand}" />
                        <Button Content="Offline scan and fix" Padding="10,4" Command="{Binding RunVolumeOfflineFixCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding VolumeRepairStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                               Visibility="{Binding VolumeRepairStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Round 15, #342: filesystem check history - this app's own persisted #340/#341 runs
                 merged with chkdsk reports Windows itself already logged (Wininit event 1001 at
                 boot, the classic "Chkdsk" provider's online-run events). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filesystem check history" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshChkdskHistoryCommand}" />
                    </Grid>
                    <TextBlock Text="This app's own runs (persisted locally) plus the reports Windows itself already logged - boot-time (Wininit) and online (Chkdsk provider) - combined into one list; the Source column says which is which."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ChkdskHistoryStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding ChkdskHistory}" IsReadOnly="True" MaxHeight="260" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="130" />
                            <DataGridTextColumn Header="Volume" Binding="{Binding DriveLetter}" Width="70" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.4*" />
                            <DataGridTextColumn Header="Bad sectors (KB)" Binding="{Binding BadSectorsKb, TargetNullValue=–}" Width="110" />
                            <DataGridTextColumn Header="Errors fixed" Binding="{Binding ErrorsFixedText, TargetNullValue=–}" Width="1.4*" />
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 15, #344: NTFS corruption event feed - a future chunk merges this into a
                 fully unified storage event timeline. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NTFS corruption events" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check now" Padding="10,4" Command="{Binding CheckNtfsCorruptionEventsCommand}" />
                    </Grid>
                    <TextBlock Text="System-log provider &quot;Ntfs&quot;: corruption detected (55), transaction log unwritable (98), volume resource exhaustion / full transaction log (130/137), volume no longer writable (140/142) - last 60 days, grouped by volume."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NtfsCorruptionEventsStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding NtfsCorruptionEvents}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTextColumn Header="Volume" Binding="{Binding VolumeText}" Width="90" />
                            <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #86, widened by round 17 #353/#354: fragmentation / MFT health / free-space
                 fragmentation - a row per fixed volume. Only hidden entirely when there are no
                 fixed volumes at all; the file-fragmentation-percent line itself stays HDD-only
                 (not meaningful on an SSD), but MFT health and free-space fragmentation show for
                 every row. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FragmentationRows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Fragmentation &amp; MFT health" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Analyze-only pass (defrag /A) - never moves data. File-fragmentation % is HDD-only; MFT health and free-space fragmentation apply to any medium."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding FragmentationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2" Content="Analyze" Padding="10,4"
                                                Command="{Binding DataContext.CheckFragmentationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <TextBlock Text="{Binding MftHealthText}" FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MftHealthWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FreeSpaceFragmentationText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 17, #352/#355: free-space history + days-until-full projection, sampled per
                 fixed volume on the Storage tab's shared sampler tick. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Free space history" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Daily low-water mark per fixed volume, persisted across restarts. The run-out projection is a linear extrapolation from recent history, hidden whenever the trend is flat or rising."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding FreeSpaceVolumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DriveLetter}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource SubStat}" />
                                    </Grid>
                                    <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding DataContext.FreeSpaceHiddenXAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Height="100" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" Margin="0,4,0,4">
                                        <lvc:CartesianChart.Style>
                                            <Style TargetType="lvc:CartesianChart">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowChart}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </lvc:CartesianChart.Style>
                                    </lvc:CartesianChart>
                                    <TextBlock Text="{Binding ProjectionText}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowProjection}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No fixed volumes sampled yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FreeSpaceVolumes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 17, #359: page file placement, sizing, and peak usage. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageFiles.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Page files" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding PageFileStatusText}" Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PageFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock FontSize="12.5">
                                        <Run Text="{Binding Path}" FontWeight="SemiBold" />
                                        <Run Text=" · " /><Run Text="{Binding MediaType}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap">
                                        <Run Text="Initial " /><Run Text="{Binding InitialSizeMb, StringFormat={}{0:N0} MB}" />
                                        <Run Text=" · Maximum " /><Run Text="{Binding MaximumSizeMb, StringFormat={}{0:N0} MB}" />
                                        <Run Text=" · Peak usage " /><Run Text="{Binding PeakUsageMb, StringFormat={}{0:N0} MB}" />
                                    </TextBlock>
                                    <TextBlock Text="System-managed size." Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemManaged}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="This page file is on an HDD while a faster SSD exists elsewhere on this system - quick flag, not a verdict." Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FasterDriveElsewhereFlag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="This page file's physical disk also hosts a drive this app's own health verdict has flagged Replace." Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SameDiskAsFailingDriveFlag}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 17, #356/#357/#358/#360: "reclaimable space" - component store analysis/
                 cleanup, a reclaimable-space inventory + Storage Sense policy, hibernation file
                 sizing, and the search indexer's footprint. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Reclaimable space" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshReclaimableSpaceCommand}" />
                    </Grid>

                    <!-- #357: inventory -->
                    <TextBlock Text="{Binding ReclaimableItemsStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ReclaimableItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Top" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Text="{Binding SizeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue='Not present'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #357: Storage Sense policy -->
                    <TextBlock Text="Storage Sense" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,4" />
                    <TextBlock Margin="0,0,0,2" Style="{StaticResource SubStat}">
                        <Run Text="Enabled: " /><Run Text="{Binding StorageSensePolicy.Enabled}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding StorageSensePolicy.RawPolicyValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource SubStat}" FontFamily="Consolas" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #358: hibernation -->
                    <TextBlock Text="Hibernation" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Enabled: " /><Run Text="{Binding HibernationInfo.Enabled}" />
                        <Run Text=" · hiberfil.sys: " /><Run Text="{Binding HibernationInfo.HiberFileSizeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" />
                        <Run Text=" · Size policy: " /><Run Text="{Binding HibernationInfo.HiberFileSizePercent, TargetNullValue='Windows default (not customized)', StringFormat={}{0}% of RAM}" />
                    </TextBlock>
                    <TextBlock Text="Disabling hibernation also disables Fast Startup, since Fast Startup depends on it - stated here before you click Disable."
                               Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Disable hibernation" Padding="10,4" Margin="0,0,8,0" Command="{Binding DisableHibernationCommand}" />
                        <Button Grid.Column="1" Content="Enable hibernation" Padding="10,4" Margin="0,0,16,0" Command="{Binding EnableHibernationCommand}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding HibernateSizePercentInput, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="3" Content="Set size % of RAM" Padding="10,4" Command="{Binding SetHibernateSizeCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding HibernationActionStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <!-- #360: search indexer footprint -->
                    <TextBlock Text="Search indexer" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                        <Run Text="Windows.edb: " /><Run Text="{Binding IndexerFootprint.EdbSizeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" />
                        <Run Text=" · WSearch service: " /><Run Text="{Binding IndexerFootprint.ServiceStatus}" />
                        <Run Text=" (" /><Run Text="{Binding IndexerFootprint.ServiceStartType}" /><Run Text=" startup)" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                        <Run Text="Backlog: " /><Run Text="{Binding IndexerFootprint.BacklogItemCount, StringFormat={}{0:N0} item(s)}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndexerFootprint.BacklogAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Windows doesn't expose a reliable indexing-backlog counter here on every build - check Indexing Options &gt; Advanced, or the Services tab's WSearch controls, for live status. A runaway index rebuild is a common cause of &quot;my disk is at 100% and nothing is running&quot;."
                               Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" />

                    <!-- #356: component store -->
                    <TextBlock Text="Component store (WinSxS)" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4" />
                    <TextBlock Text="Slow to analyze (walks the whole store) - on-demand only, never run automatically." Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Analyze" Padding="10,4" Margin="0,0,8,0" Command="{Binding AnalyzeComponentStoreCommand}" />
                        <Button Grid.Column="1" Content="Start component cleanup" Padding="10,4" Command="{Binding StartComponentCleanupCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ComponentStoreActionStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ComponentStoreAnalysis.Available}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                            <Run Text="Actual size: " /><Run Text="{Binding ComponentStoreAnalysis.ActualStoreSizeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" />
                            <Run Text=" · Shared with Windows: " /><Run Text="{Binding ComponentStoreAnalysis.SharedWithWindowsBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="Backups/disabled features: " /><Run Text="{Binding ComponentStoreAnalysis.BackupsAndDisabledFeaturesBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" />
                            <Run Text=" · Cache/temp: " /><Run Text="{Binding ComponentStoreAnalysis.CacheAndTempDataBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=Unknown}" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" FontWeight="SemiBold">
                            <Run Text="Cleanup recommended: " /><Run Text="{Binding ComponentStoreAnalysis.CleanupRecommended}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ComponentStoreAnalysis.DateBasedCleanupNote}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Raw dism report" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,4" />
                        <TextBox Text="{Binding ComponentStoreAnalysis.RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11" Height="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 9, #38: on-demand full SMART attribute table - a disk picker plus a button,
                 since walking every reliability-counter field per disk is only useful when
                 actively investigating one drive, not something to poll. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SMART details" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Full MSFT_StorageReliabilityCounter attribute set for one disk, beyond the wear percentage shown on the System tab. Field availability varies by drive/driver."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding SmartDiskOptions}"
                                  SelectedItem="{Binding SelectedSmartDisk}" DisplayMemberPath="Display" />
                        <Button Grid.Column="1" Content="Read SMART details" Padding="10,4" Command="{Binding ReadSmartDetailsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SmartStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" />

                    <!-- Round 19, #384: drive-header firmware revision + a starter, non-exhaustive
                         known-issue list match - "worth checking the vendor's site", never a claim
                         this drive will fail. -->
                    <Border Margin="0,0,0,10" Padding="8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            Visibility="{Binding FirmwareText, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding FirmwareText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FirmwareKnownIssueMatched}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Round 13, #323: MSFT_StorageReliabilityCounter latency-maximum tiles,
                         promoted out of the flat SMART-details dump above - any disk that reports
                         them, not NVMe-specific. Hidden until at least one has actually been read. -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowReliabilityLatencyTiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reliability-counter latency maxima" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Reset counters" Padding="8,3" FontSize="11.5" Command="{Binding ResetReliabilityCountersCommand}" />
                        </Grid>
                        <UniformGrid Columns="3">
                            <views:VfdMeter Title="Read latency max" Glow="False" Margin="0,0,8,0" Percent="0" Unit="ms"
                                            ValueText="{Binding ReliabilityReadLatencyText}" SubText="MSFT_StorageReliabilityCounter"
                                            AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <views:VfdMeter Title="Write latency max" Glow="False" Margin="4,0,4,0" Percent="0" Unit="ms"
                                            ValueText="{Binding ReliabilityWriteLatencyText}" SubText="MSFT_StorageReliabilityCounter"
                                            AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <views:VfdMeter Title="Flush latency max" Glow="False" Margin="8,0,0,0" Percent="0" Unit="ms"
                                            ValueText="{Binding ReliabilityFlushLatencyText}" SubText="MSFT_StorageReliabilityCounter"
                                            AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        </UniformGrid>
                        <TextBlock Text="{Binding ReliabilityResetStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ReliabilityResetStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding SmartDetails}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attribute" Binding="{Binding Label}" Width="1.4*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 10, #301/#302/#303/#304/#306/#307/#308/#312: raw ATA SMART attribute table
                 for the disk selected above, populated by the same "Read SMART details" action -
                 the real 30-entry attribute table (MSStorageDriver_ATAPISmartData), not just the
                 driver-summarised MSFT_StorageReliabilityCounter fields in the card above. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Raw SMART attributes" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Full 30-entry ATA attribute table + published failure thresholds for the disk selected above. Vendor-reassigned IDs (0xAD/0xB1/0xE8/0xE9/0xF1/0xF2, ...) are reinterpreted per the matched vendor profile where one exists."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- Round 14, #325: "changed since last run" - a persisted snapshot journal
                         (smart-history.json), diffed against the previous run's snapshot for this
                         disk. Hidden entirely until there's something to show. -->
                    <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SmartHistoryChanges.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Changed since last run" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SmartHistoryChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Margin="0,0,0,3">
                                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " />
                                            <Run Text="{Binding Previous, Mode=OneWay}" /><Run Text=" → " />
                                            <Run Text="{Binding Current, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" (" /><Run Text="{Binding DeltaText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SmartHistoryStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding SmartHistoryStatusText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Round 14, #326: reallocated/pending trend, plotted from the same persisted
                         history - hidden until at least three snapshots exist for this disk. -->
                    <Border Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSmartTrendChart}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Reallocated / pending sector trend" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SmartTrendRangeText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                            <lvc:CartesianChart Series="{Binding SmartTrendSeries}" XAxes="{Binding Performance.HiddenXAxes}"
                                                 Height="140" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                        </StackPanel>
                    </Border>

                    <!-- #306: critical-attribute triage strip - "quick flag, not a verdict". -->
                    <TextBlock Text="One pending sector is worth watching, not replacing a drive over - a quick flag, not a verdict."
                               Margin="0,0,0,6" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SmartTriageTiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding SmartTriageTiles}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:VfdMeter Title="{Binding Title}" Glow="False" Margin="0,0,6,0"
                                                ValueText="{Binding ValueText}" Percent="0">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Setter Property="AccentBrush" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #307/#308: per-disk temperature and power-on/duty-cycle summary lines. -->
                    <TextBlock Text="{Binding SmartTemperatureSummary}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                               Visibility="{Binding SmartTemperatureSummary, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding SmartPowerOnSummary}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding SmartPowerOnSummary, Converter={StaticResource StringToVisibilityConverter}}" />

                    <TextBlock Text="{Binding SmartRawStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SmartVendorProfileText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                               Visibility="{Binding SmartVendorProfileText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <!-- #312: explains why the grid below is empty (USB/1394/SD bridge, NVMe, etc.), or names the data source (WMI vs. SCSI pass-through fallback) when it isn't. -->
                    <TextBlock Text="{Binding SmartAvailabilityNote}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding SmartAvailabilityNote, Converter={StaticResource StringToVisibilityConverter}}" />

                    <DataGrid ItemsSource="{Binding SmartRawAttributes}" IsReadOnly="True" MaxHeight="320" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="45" />
                            <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" Width="1.6*" />
                            <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="60" />
                            <DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="55" />
                            <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdText}" Width="70" />
                            <DataGridTextColumn Header="Margin" Binding="{Binding MarginText}" Width="60" />
                            <DataGridTextColumn Header="Raw value" Binding="{Binding RawDisplay}" Width="1.2*" />
                            <DataGridTextColumn Header="Note" Binding="{Binding VendorNote}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Round 14, #334: ATA short/extended self-test - structure/UI in place,
                         issuance stubbed (see AtaSelfTestService's remarks). Non-NVMe drives only. -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAtaSelfTest}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="ATA self-test" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AtaSelfTestEstimatedDurationText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Short self-test" Padding="8,3" FontSize="11.5" Margin="0,0,8,0" Command="{Binding RunAtaShortSelfTestCommand}" />
                            <Button Content="Extended self-test" Padding="8,3" FontSize="11.5" Command="{Binding RunAtaExtendedSelfTestCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AtaSelfTestStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                   Visibility="{Binding AtaSelfTestStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 19, #377/#378/#379/#380/#381/#382/#383: Controller card - system-wide storage-
                 mode/driver-inventory facts (top half, read once at tab load) plus per-disk link-
                 speed/CRC-trend/write-cache facts for the disk selected in SMART details above
                 (bottom half, populated by the same "Read SMART details" action). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Controller" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" FontSize="11.5" Command="{Binding RefreshControllerFactsCommand}" />
                    </Grid>
                    <TextBlock Text="Storage-controller mode, driver inventory, and (for the disk selected in SMART details above) link speed, SATA CRC-error trend, and write-cache/power-protection facts. Mode/driver facts are read once at tab load and don't change without a reboot."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ControllerFactsStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" />

                    <StackPanel Visibility="{Binding ControllerFacts, Converter={StaticResource NullToVisibilityConverter}}">
                        <!-- #377: active controller mode - "quick flag, not a verdict" for legacy IDE. -->
                        <TextBlock Text="{Binding ControllerFacts.ModeDetailText}" Margin="0,0,0,10" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ControllerFacts.LegacyIdeQuickFlag}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- #378: StorAHCI MSI/idle-power known-issue quick flag - only shown when
                             storahci is confirmed as the bound driver above. -->
                        <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                Visibility="{Binding ControllerFacts.ShowStorAhciMsiCheck, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="StorAHCI MSI / idle-power known-issue check" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                    <Run Text="MSISupported: " /><Run Text="{Binding ControllerFacts.MsiSupported, TargetNullValue=Unknown, Mode=OneWay}" />
                                    <Run Text=" · Idle power management enabled: " /><Run Text="{Binding ControllerFacts.IdlePowerEnabled, TargetNullValue=Unknown, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Some storahci + MSI interrupt combinations have a documented history of causing periodic system freezes, particularly alongside idle-power management. If you're seeing periodic freezes with no other obvious cause, this specific combination is worth checking - not a confirmed diagnosis of your system." />
                            </StackPanel>
                        </Border>

                        <!-- #383: loaded storage-stack driver inventory + PnP problem codes + disk timeout. -->
                        <TextBlock Text="Storage driver inventory" FontWeight="SemiBold" FontSize="12.5" Margin="0,4,0,4" />
                        <DataGrid ItemsSource="{Binding ControllerFacts.Drivers}" IsReadOnly="True" MaxHeight="220" AutoGenerateColumns="False" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1*" />
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="1.6*" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="1*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="1.1*" />
                                <DataGridTextColumn Header="Signer" Binding="{Binding Signer}" Width="1.2*" />
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceNote}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="An outdated vendor RAID/AHCI driver is a leading cause of storage-related bugchecks - informational inventory, not a diagnosis of this specific system."
                                   Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                            <Run Text="Disk I/O timeout (Services\Disk\TimeOutValue): " />
                            <Run Text="{Binding ControllerFacts.DiskTimeoutValueSeconds, TargetNullValue=Unknown, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" seconds" />
                        </TextBlock>

                        <StackPanel Margin="0,0,0,4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ControllerFacts.ProblemDevices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Storage devices reporting a problem code" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" Foreground="{DynamicResource WarningBrush}" />
                            <ItemsControl ItemsSource="{Binding ControllerFacts.ProblemDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- #379/#380/#381/#382: per-disk facts for the disk selected in SMART details
                         above - hidden until that card's "Read SMART details" has actually run. -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowControllerDiskFacts}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding SelectedSmartDisk.Display}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />

                        <!-- #379 -->
                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Visibility="{Binding ShowSataLinkInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="SATA link speed: " FontWeight="SemiBold" /><Run Text="{Binding SataLinkText, Mode=OneWay}" />
                        </TextBlock>

                        <!-- #381 -->
                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Visibility="{Binding ShowNvmeLinkInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="PCIe link: " FontWeight="SemiBold" /><Run Text="{Binding NvmeLinkText, Mode=OneWay}" />
                        </TextBlock>

                        <!-- #380 -->
                        <TextBlock Text="{Binding CrcTrendText}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Visibility="{Binding CrcTrendText, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CrcTrendRising}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- #382: framed as a real data-loss risk, not just a quick flag, per this item's own brief. -->
                        <Border Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                            <StackPanel>
                                <TextBlock Text="Write cache / power protection" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding WriteCacheSummaryText}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WriteCacheRisk}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding WriteCacheSettingText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 13, #313-#322: NVMe health card - shown only when the disk selected above
                 reports BusType NVMe, populated by the same "Read SMART details" action. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowNvmeHealth}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="NVMe health" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="SMART/Health Information Log (page 0x02), Identify Controller, and on-demand error/self-test logs, all via IOCTL_STORAGE_QUERY_PROPERTY - no vendor driver required."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NvmeHealthStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <!-- #322: Identify Controller facts + APST. -->
                    <TextBlock Text="{Binding NvmeIdentifyText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                               Visibility="{Binding NvmeIdentifyText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding NvmeApstText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding NvmeApstText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- #315: spare/threshold/percentage-used tiles. Available Spare turns red once
                         it falls below its own reported threshold. -->
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <views:VfdMeter Title="Available spare" Glow="False" Margin="0,0,8,0" Percent="0" Unit="%"
                                        ValueText="{Binding NvmeSpareText}" SubText="{Binding NvmeSpareThresholdText, StringFormat=Threshold {0}}">
                            <views:VfdMeter.Style>
                                <Style TargetType="views:VfdMeter">
                                    <Setter Property="AccentBrush" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NvmeSpareBelowThreshold}" Value="True">
                                            <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:VfdMeter.Style>
                        </views:VfdMeter>
                        <views:VfdMeter Title="Spare threshold" Glow="False" Margin="4,0,4,0" Percent="0" Unit="%"
                                        ValueText="{Binding NvmeSpareThresholdText}" SubText="Vendor-set floor"
                                        AccentBrush="{DynamicResource TextSecondaryBrush}" />
                        <views:VfdMeter Title="Percentage used" Glow="False" Margin="8,0,0,0" Percent="0"
                                        ValueText="{Binding NvmePercentUsedText}" SubText="Not clamped at 100%"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                    </UniformGrid>

                    <!-- #314: Critical Warning bit checklist. -->
                    <TextBlock Text="Critical warning bits" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding NvmeCriticalWarnings}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OK" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                            <Setter Property="Text" Value="SET" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #316: data units / average I/O size. -->
                    <TextBlock Text="{Binding NvmeDataUnitsText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                               Visibility="{Binding NvmeDataUnitsText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding NvmeAverageIoSizeText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding NvmeAverageIoSizeText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- #317: media/data-integrity errors - one of the few unambiguous NVMe "losing data" signals. -->
                    <TextBlock Text="{Binding NvmeMediaErrorText}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NvmeMediaErrorsPresent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #318: temperature + cumulative throttle-time counters. -->
                    <TextBlock Text="{Binding NvmeTemperatureText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap"
                               Visibility="{Binding NvmeTemperatureText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding NvmeThrottleText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding NvmeThrottleText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- #319: controller busy time / power cycles / power-on hours / unsafe shutdowns. -->
                    <TextBlock Text="{Binding NvmePowerText}" Style="{StaticResource SubStat}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Visibility="{Binding NvmePowerText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- #320: on-demand Error Information Log (page 0x01) - separate round trip. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Error Information Log (page 0x01)" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Read error log" Padding="8,3" FontSize="11.5" Command="{Binding ReadNvmeErrorLogCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding NvmeErrorLogStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding NvmeErrorLog}" IsReadOnly="True" MaxHeight="200" AutoGenerateColumns="False" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Count" Binding="{Binding ErrorCount}" Width="60" />
                            <DataGridTextColumn Header="SQ ID" Binding="{Binding SubmissionQueueId}" Width="55" />
                            <DataGridTextColumn Header="Cmd ID" Binding="{Binding CommandId}" Width="60" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.6*" />
                            <DataGridTextColumn Header="LBA" Binding="{Binding Lba}" Width="90" />
                            <DataGridTextColumn Header="NSID" Binding="{Binding NamespaceId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #321: Device Self-test Log (page 0x06) + Short/Extended triggers. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Device self-test log (page 0x06)" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Read log" Padding="8,3" FontSize="11.5" Margin="0,0,6,0" Command="{Binding ReadNvmeSelfTestLogCommand}" />
                        <Button Grid.Column="2" Content="Short (~2 min)" Padding="8,3" FontSize="11.5" Margin="0,0,6,0" Command="{Binding RunNvmeShortSelfTestCommand}" />
                        <Button Grid.Column="3" Content="Extended" Padding="8,3" FontSize="11.5" Command="{Binding RunNvmeExtendedSelfTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding NvmeSelfTestStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NvmeSelfTestTriggerStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Visibility="{Binding NvmeSelfTestTriggerStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <DataGrid ItemsSource="{Binding NvmeSelfTestResults}" IsReadOnly="True" MaxHeight="200" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Test" Binding="{Binding OperationText}" Width="90" />
                            <DataGridTextColumn Header="Result" Binding="{Binding StatusText}" Width="1.6*" />
                            <DataGridTextColumn Header="Segment" Binding="{Binding SegmentNumber}" Width="65" />
                            <DataGridTextColumn Header="Failing LBA" Binding="{Binding FailingLba}" Width="100" />
                            <DataGridTextColumn Header="NSID" Binding="{Binding NamespaceId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #309: Load/Unload + Start/Stop wear vs. this vendor's typical rated maximum -
                 HDD-only, hidden entirely for SSD/NVMe media. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSmartWearCycles}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="HDD mechanical wear" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Head-parking and spin-up/down cycles against this vendor's typical (not per-model) rated maximum - informational only."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Load/unload cycles: " FontWeight="SemiBold" /><Run Text="{Binding SmartLoadUnloadText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                        <Run Text="Start/stop cycles: " FontWeight="SemiBold" /><Run Text="{Binding SmartStartStopText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #310/#311: Endurance card - host TBW/write-amplification estimate plus SSD
                 wear-levelling detail cross-checked against the driver's own Wear% summary. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSmartEndurance}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Endurance" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding SmartEnduranceTbwText}" Style="{StaticResource SubStat}" Margin="0,-4,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SmartEnduranceWafText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Visibility="{Binding SmartEnduranceWafText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding SmartWearLevelText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Visibility="{Binding SmartWearLevelText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding SmartWearWarningText}" Foreground="{DynamicResource WarningBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Visibility="{Binding SmartWearWarningText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Round 14, #327: TB-written-per-day wear-rate projection from the persisted
                         SMART history - hidden until at least two snapshots exist. -->
                    <TextBlock Text="{Binding WearProjectionText}" Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWearProjection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 14, #329: Windows' own disk-diagnosis events - a different signal from the
                 WMI-level predicted-failure flag watched live above (#324). A later chunk (#370)
                 folds this into a unified storage event timeline. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Windows disk-diagnosis events" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check now" Padding="10,4" Command="{Binding CheckDiskDiagnosisCommand}" />
                    </Grid>
                    <TextBlock Text="Microsoft-Windows-DiskDiagnosisDataCollector, plus System-log disk event 52 (&quot;the driver has detected that device ... has predicted that it will fail&quot;) - last 30 days."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DiskDiagnosisStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DiskDiagnosisEvents}" IsReadOnly="True" MaxHeight="220" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.4*" />
                            <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 14, #330/#331/#336: unified bad-sector view - SMART 05/C5/C6 (from the raw
                 attribute grid above), the most recent chkdsk report, and the $BadClus allocation,
                 shown side by side rather than reconciled when they disagree - plus a read-only
                 pending-sector re-check and bad-block/retry event correlation. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bad sectors" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check bad sectors" Padding="10,4" Command="{Binding CheckBadSectorsCommand}" />
                    </Grid>
                    <TextBlock Text="Select a disk and read SMART details above first. These three sources measure different things and can legitimately disagree - shown as-is, never silently reconciled."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BadSectorStatusText}" Margin="0,0,0,10" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BadSectorSummary.SourcesDisagree}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <views:VfdMeter Title="SMART" Glow="False" Margin="0,0,8,0" Percent="0"
                                        ValueText="{Binding BadSectorSummary.SmartReallocated, TargetNullValue=–}"
                                        SubText="Reallocated (05)" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <views:VfdMeter Title="chkdsk" Glow="False" Margin="4,0,4,0" Percent="0" Unit="KB"
                                        ValueText="{Binding BadSectorSummary.ChkdskBadSectorsKb, TargetNullValue=–}"
                                        SubText="Most recent report" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <views:VfdMeter Title="$BadClus" Glow="False" Margin="8,0,0,0" Percent="0"
                                        ValueText="{Binding BadSectorSummary.BadClusAllocatedBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue=–}"
                                        SubText="{Binding BadSectorSummary.BadClusVolume, StringFormat=Volume {0}, TargetNullValue='Volume unknown'}"
                                        AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}" />
                    </UniformGrid>

                    <TextBlock Text="{Binding BadBlockEventCorrelationText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding BadBlockEventCorrelationText, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- #331: labelled accurately as a re-check, not a targeted sector re-read -
                         see RecheckPendingSectorsAsync's remarks for why. -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Read-only - re-reads the whole SMART table now and diffs it against the values before you clicked. Not a targeted re-read of specific sectors."
                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Re-check SMART now" Padding="8,3" FontSize="11.5" Command="{Binding RecheckPendingSectorsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PendingSectorRecheckText}" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                               Visibility="{Binding PendingSectorRecheckText, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- Round 14, #332/#335: read-only surface scan - sequential end-to-end read via
                 FILE_FLAG_NO_BUFFERING, recording error/stall ranges, cancellable. Bad LBAs are
                 mapped to an owning file afterwards (approximate - see ClusterMappingService). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Surface scan" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Reads only, never writes; can take hours on a large HDD. Uses the disk selected above. Cancel at any time - already-found problems stay listed."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stall threshold (ms)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <TextBox Grid.Column="1" Width="70" Text="{Binding SurfaceScanStallThresholdMs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Start scan" Padding="10,4" Margin="0,0,8,0" Command="{Binding StartSurfaceScanCommand}" />
                        <Button Grid.Column="4" Content="Cancel" Padding="10,4" Command="{Binding CancelSurfaceScanCommand}" />
                    </Grid>
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding SurfaceScanProgressPercent, Mode=OneWay}" Margin="0,0,0,8"
                                 Visibility="{Binding IsSurfaceScanning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding SurfaceScanStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding SurfaceScanResults}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start LBA" Binding="{Binding StartLba}" Width="90" />
                            <DataGridTextColumn Header="End LBA" Binding="{Binding EndLba}" Width="90" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Note}" Width="1.6*" />
                            <DataGridTextColumn Header="Elapsed (ms)" Binding="{Binding ElapsedMs, StringFormat={}{0:0}}" Width="90" />
                            <DataGridTextColumn Header="Owning file (approx.)" Binding="{Binding OwningFile}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 9, #39: largest files/folders scanner - on-demand, depth-capped, for
                 finding what's eating a nearly-full volume. Access-denied subtrees are skipped
                 silently rather than failing the whole scan. Round 14, #333 adds a file-level
                 read-verification scanner alongside it, reusing the same safe-enumeration helpers. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Largest files &amp; folders" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="On-demand, depth-capped scan (6 levels). Folder sizes are recursive totals; inaccessible subtrees are skipped rather than failing the scan."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding LargestItemsRoot, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Scan" Padding="10,4" Command="{Binding ScanLargestItemsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding LargestItemsStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding LargestItems}" IsReadOnly="True" MaxHeight="280" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="*" />
                            <!-- #361: size on disk vs. logical size - a large logical size with a
                                 much smaller on-disk size (a cloud placeholder, a sparse/compressed
                                 file) is called out via the Flags column instead of looking like the
                                 actual culprit. -->
                            <DataGridTextColumn Header="Size on disk" Binding="{Binding SizeOnDiskText}" Width="*" />
                            <DataGridTextColumn Header="Flags" Binding="{Binding FlagsText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Round 14, #333: file-level read verification - walks a folder tree reading
                         every byte of every file, listing which ones fail. -->
                    <TextBlock Text="File-level read verification" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4" />
                    <TextBlock Text="Turns an abstract bad-sector count into a concrete list of files that are already unreadable. Reads every byte - can be slow on a large tree, especially on a struggling drive."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding FileVerificationRoot, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Verify" Padding="10,4" Margin="0,0,8,0" Command="{Binding VerifyFilesCommand}" />
                        <Button Grid.Column="2" Content="Cancel" Padding="10,4" Command="{Binding CancelFileVerificationCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding FileVerificationStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding FileVerificationFailures}" IsReadOnly="True" MaxHeight="200" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2.4*" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 9, #41: on-demand simple sequential throughput test - clearly labeled as
                 approximate, not a real benchmark (single-threaded sequential I/O only). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Throughput test" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Approximate only - a single-threaded sequential write then read against a temp file, not a real benchmark (no queue-depth sweep, no random I/O)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding ThroughputDriveOptions}" SelectedItem="{Binding SelectedThroughputDrive}" />
                        <Button Grid.Column="1" Content="Run test" Padding="10,4" Command="{Binding RunThroughputTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ThroughputResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Round 18, #367: StorPort driver-level latency tracing - time-boxed, on-demand
                 real-time ETW capture, never automatic. This chunk ships the capture path (button,
                 duration/threshold, results grid) without a live ETW session wired up - see
                 StorPortTraceService's remarks; StorPortStatusText explains why after every run. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="StorPort driver-level latency (ETW)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Real-time trace of Microsoft-Windows-StorPort's per-request start/complete events - the lowest-level per-I/O timing source available, below the filesystem and cache layer entirely. Not implemented in this build (see the status line below after running) - the capture controls are wired up and ready."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duration (s)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <TextBox Grid.Column="1" Width="50" Text="{Binding StorPortCaptureDurationSeconds, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="Threshold (ms)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <TextBox Grid.Column="3" Width="60" Text="{Binding StorPortThresholdMs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                        <Button Grid.Column="5" Content="Start capture" Padding="10,4" Command="{Binding StartStorPortCaptureCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding StorPortStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding StorPortEvents}" IsReadOnly="True" MaxHeight="220" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" Width="110" />
                            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="1.4*" />
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="90" />
                            <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs, StringFormat={}{0:0.0}}" Width="100" />
                            <DataGridTextColumn Header="I/O size" Binding="{Binding IoSizeBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 18, #368: per-file I/O attribution - same time-boxed, on-demand ETW shape
                 as #367 above (see FileIoAttributionService's remarks). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="I/O capture (per-file / per-process attribution)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Real-time trace of Microsoft-Windows-Kernel-File/Kernel-Disk, aggregating bytes read/written by file path and by process for the capture window - the &quot;what's actually hitting the disk&quot; view raw counters can't give. Not implemented in this build (see the status line below after running) - the capture controls are wired up and ready."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duration (10-60s)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <TextBox Grid.Column="1" Width="50" Text="{Binding IoCaptureDurationSeconds, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                        <Button Grid.Column="3" Content="Start capture" Padding="10,4" Command="{Binding StartIoAttributionCaptureCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding IoAttributionStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="Top 20 files" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding TopIoFiles}" IsReadOnly="True" MaxHeight="180" AutoGenerateColumns="False" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Key}" Width="2.2*" />
                            <DataGridTextColumn Header="Read" Binding="{Binding BytesRead, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                            <DataGridTextColumn Header="Written" Binding="{Binding BytesWritten, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Top 20 processes" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding TopIoProcesses}" IsReadOnly="True" MaxHeight="180" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Key}" Width="2.2*" />
                            <DataGridTextColumn Header="Read" Binding="{Binding BytesRead, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                            <DataGridTextColumn Header="Written" Binding="{Binding BytesWritten, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 18, #369: minifilter (filesystem filter driver) stack audit - "quick flag,
                 not a verdict" (see MinifilterAuditService's remarks). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filesystem filter driver stack" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check now" Padding="10,4" Command="{Binding CheckMinifiltersCommand}" />
                    </Grid>
                    <TextBlock Text="Parses `fltmc filters` / `fltmc instances` - every filesystem filter driver, its altitude, and the volumes it's attached to. Quick flag only: a high instance count on one volume is a plausible latency contributor (e.g. multiple AV products plus a backup agent plus a sync client all filtering the same I/O), not proof of one - a clean modern Windows install already carries several in-box filters, so review the list yourself rather than trusting the flag alone."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MinifilterStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Deep-stack threshold (instances)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5" />
                        <TextBox Grid.Column="1" Width="50" Text="{Binding MinifilterDeepStackThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Volumes" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding MinifilterVolumes}" IsReadOnly="True" MaxHeight="160" AutoGenerateColumns="False" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Volume" Binding="{Binding VolumeName}" Width="100" />
                            <DataGridTextColumn Header="Filter instances" Binding="{Binding InstanceCount}" Width="120" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeepStack}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <TextBlock Text="Filters (sorted by altitude, highest first)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding MinifilterDrivers}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Filter" Binding="{Binding Name}" Width="1.4*" />
                            <DataGridTextColumn Header="Altitude" Binding="{Binding Altitude}" Width="90" />
                            <DataGridTextColumn Header="Instances" Binding="{Binding InstanceCount}" Width="80" />
                            <DataGridTextColumn Header="Attached volumes" Binding="{Binding AttachedVolumesText}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 18, #370-#374: unified storage event timeline across disk/Ntfs/volmgr/
                 partmgr/storahci/stornvme/iaStorAC/Kernel-PnP, folding the Disk-diagnosis (above)
                 and NTFS-corruption (above) cards' own reads back in rather than a third
                 disconnected list - see StorageEventTimelineService's remarks. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Storage events" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check now" Padding="10,4" Command="{Binding CheckStorageEventTimelineCommand}" />
                    </Grid>
                    <TextBlock Text="One chronological scan across disk (11/15/51/157), volmgr, partmgr, storahci/stornvme/iaStorAC (129), and Microsoft-Windows-Kernel-PnP (219/225) - last 30 days - plus the Disk-diagnosis and NTFS-corruption events already shown above, folded in here rather than queried a third time."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StorageEventTimelineStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding StorageEventTimeline}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="110" />
                            <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceText}" Width="1.2*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #371: event 153 (I/O retried) - per-device timeline + daily-count trend. -->
                    <TextBlock Text="Event 153 - I/O retries (early drive/cable warning)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Retry153SummaryText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding Retry153Series}" XAxes="{Binding Retry153XAxes}" YAxes="{Binding Retry153YAxes}"
                                         Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Retry153Events}" IsReadOnly="True" MaxHeight="160" AutoGenerateColumns="False" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceText}" Width="1.4*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #372: event 51 (paging-operation error) - cross-linked to the page-file
                         placement card (#359) above by a text note, not navigation. -->
                    <TextBlock Text="Event 51 - Paging-operation errors" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PagingErrorSummaryText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding PagingErrorEvents}" IsReadOnly="True" MaxHeight="160" AutoGenerateColumns="False" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceText}" Width="1.4*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.4*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #373: storahci/stornvme/iaStorAC event 129 - also raised as a Summary
                         HealthIssue when recent (see SummaryViewModel.RefreshHealthIssues). -->
                    <TextBlock Text="Controller resets" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ControllerResetSummaryText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding ControllerResetEvents}" IsReadOnly="True" MaxHeight="160" AutoGenerateColumns="False" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceText}" Width="1.2*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #374: Ntfs 140/142 + disk 157 + Kernel-PnP 219/225 correlated. -->
                    <TextBlock Text="Surprise-removal history" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SurpriseRemovalSummaryText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding SurpriseRemovalEvents}" IsReadOnly="True" MaxHeight="160" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="100" />
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceText}" Width="1.2*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 18, #375/#376: external-drive connection history + currently-attached
                 removal policy / eject blockers. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="External drives seen on this PC" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Every USB mass-storage/portable device Windows has ever recorded (USBSTOR + SWD\WPDBUSENUM registry history), plus removal-policy and eject-blocker details for whatever's attached right now."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- #375: read-only connection history. -->
                    <TextBlock Text="Connection history" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding RemovableDriveHistoryStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="First/last-connected timestamps are read from an undocumented registry layout and may be blank for some devices even though the device itself is listed correctly - friendly name and serial are the reliable part."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding RemovableDriveHistory}" IsReadOnly="True" MaxHeight="240" AutoGenerateColumns="False" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding FriendlyName}" Width="1.6*" />
                            <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="1.4*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Source}" Width="140" />
                            <DataGridTextColumn Header="First connected" Binding="{Binding FirstConnected, StringFormat={}{0:g}, TargetNullValue=Unknown}" Width="130" />
                            <DataGridTextColumn Header="Last connected" Binding="{Binding LastConnected, StringFormat={}{0:g}, TargetNullValue=Unknown}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #376: currently-attached removable drives - removal policy + eject-blocker
                         check (read-only diagnostic, never actually ejects anything). -->
                    <TextBlock Text="Currently attached - removal policy" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding RemovableDrivesStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RemovableDrives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="0,0,0,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5">
                                            <Run Text="{Binding Facts.DriveLetter, Mode=OneWay, StringFormat={}{0}: }" FontWeight="SemiBold" />
                                            <Run Text="{Binding Facts.Model, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,2">
                                            <Run Text="Interface: " /><Run Text="{Binding Facts.InterfaceType, Mode=OneWay}" />
                                            <Run Text=" · Size: " /><Run Text="{Binding Facts.SizeBytes, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6">
                                            <Run Text="Removal policy: " /><Run Text="{Binding Facts.RemovalPolicyText, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Check for processes that would block an eject (read-only - never ejects the drive itself)."
                                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Grid.Column="1" Content="Check eject blockers" Padding="8,3" FontSize="11.5"
                                                    Command="{Binding DataContext.CheckEjectBlockersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding EjectBlockerStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Visibility="{Binding EjectBlockerStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <ItemsControl ItemsSource="{Binding EjectBlockers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                        <Run Text="{Binding ProcessName, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Pid, Mode=OneWay, StringFormat=(PID {0})}" />
                                                        <Run Text="{Binding OpenFileHandleCount, Mode=OneWay, StringFormat=- {0} open file handle(s)}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
