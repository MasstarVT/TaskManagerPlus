<UserControl x:Class="TaskManagerPlus.Views.EnergyThermalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:EnergyThermalsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Sections. 63 cards in one scroll ran from the fan-stopped banner all the way to the stress-
         test panel. Grouped by subsystem, with the always-on readouts on the first page. -->
    <TabControl Style="{StaticResource SectionTabControl}" SelectedIndex="0">
        <TabItem Header="Overview">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- "Sensors unavailable" banner - shown when the LibreHardwareMonitorLib driver
                         couldn't open at all (Smart App Control, driver-signing policy, unsupported
                         hardware, ...). Never an error dialog, just a quiet inline note. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorsAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}"
                                   Text="Sensors unavailable — the hardware sensor driver couldn't be opened. This can happen under Smart App Control, a restrictive driver-signing policy, or on hardware LibreHardwareMonitor doesn't support." />
                    </Border>
                    <!-- #41: a fan reading 0 RPM while the system is clearly running warm is a real
                         "this fan stopped" signal - see EnergyThermalsViewModel.RefreshAsync. -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeadFanDetected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}">
                            <Run Text="Possible stopped fan: " /><Run Text="{Binding DeadFanName, Mode=OneWay}" />
                            <Run Text=" is reading 0 RPM while the system is running warm." />
                        </TextBlock>
                    </Border>
                    <!-- #613: fan stall/hunting detector - distinct from the exactly-0-RPM dead-fan
                         banner above (oscillation or sub-minimum dwell, a failing bearing or a
                         badly-tuned firmware fan curve). Quick flag, not a verdict. -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FanHuntingDetected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}">
                            <Run Text="Fan hunting (quick flag, not a verdict): " /><Run Text="{Binding FanHuntingReason, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <!-- #605: time-to-throttle header readout - falling time-to-throttle across weeks is
                         the clearest single signal of degrading cooling. -->
                    <TextBlock Text="{Binding TimeToThrottleText}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <!-- #618: cooldown-rate readout, alongside the time-to-throttle readout above. -->
                    <TextBlock Text="{Binding CooldownText}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <!-- #617: heat-soak readout - burst vs. steady-state temperature under one sustained
                         load, which needs a different fix (undersized cooler / hot case) than a high
                         peak alone. -->
                    <TextBlock Text="{Binding HeatSoakText}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <!-- Headline tiles -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <views:VfdMeter Title="CPU Package" Glow="True" Margin="0,0,8,0"
                                        Percent="{Binding CpuPackageTempC, TargetNullValue=0}"
                                        ValueText="{Binding CpuPackageTempC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                        SubText="Package temperature"
                                        AccentBrush="{Binding CpuPackageTempC, Converter={StaticResource TemperatureToBrushConverter}}" />
                        <views:VfdMeter Title="Power draw" Glow="True" Margin="8,0,0,0"
                                        ValueText="{Binding TotalPackagePowerW, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                        SubText="CPU package"
                                        AccentBrush="{DynamicResource DangerBrush}" />
                    </UniformGrid>
                    <!-- #607: per-core temperature spread - a persistently large spread on a desktop
                         points at uneven cooler mount or poor pump contact. Hidden entirely until at
                         least two per-core temperature sensors are reported. -->
                    <views:VfdMeter Title="Core spread" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding CoreTempSpreadC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                    SubText="Max − min across per-core temperatures"
                                    AccentBrush="{DynamicResource WarningBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CoreTempSpreadC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- #608: thermal headroom - remaining °C before an inferred/reported throttle point,
                         which predicts "will this throttle under more load" better than an absolute
                         reading alone. Hidden until a ceiling (reported or inferred from this machine's
                         own throttle history) is available. -->
                    <views:VfdMeter Title="CPU thermal headroom" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding CpuThermalHeadroomC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                    SubText="Remaining before this CPU's known/inferred throttle point"
                                    AccentBrush="{DynamicResource AccentBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CpuThermalHeadroomC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- Round 12, #93: GPU power-limit/TDP readout, alongside the headline power draw
                         tile above - hidden entirely when the GPU backend reports no distinct limit/TDP
                         sensor (most only expose instantaneous draw; see GpuPowerLimitW's remarks). -->
                    <views:VfdMeter Title="GPU power limit" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding GpuPowerLimitW, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                    SubText="TDP / configured power limit"
                                    AccentBrush="{DynamicResource DangerBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GpuPowerLimitW}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- #29: GPU hotspot-vs-edge differential - a large, sustained gap flags degraded
                         thermal paste/pads distinct from either reading alone being high. Hidden entirely
                         when no discrete GPU/hotspot sensor is reported. -->
                    <views:VfdMeter Title="GPU ΔT" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding GpuHotspotDeltaC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                    SubText="Hotspot vs. edge — a large gap can flag thermal paste/pad wear"
                                    AccentBrush="{DynamicResource WarningBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GpuHotspotDeltaC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- Round 9, #43: NVMe controller-vs-flash-die temperature split - only shown when a
                         drive actually reports more than one temperature sensor (not every NVMe/driver
                         combination does). -->
                    <views:VfdMeter Title="Storage ΔT" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding StorageHotspotDeltaC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                    SubText="{Binding StorageHotspotDriveName, StringFormat=Controller vs. flash die — {0}}"
                                    AccentBrush="{DynamicResource WarningBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StorageHotspotDeltaC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- #619: ambient-temperature proxy - lowest of the motherboard "System"/drive
                         temperatures during the most recent genuinely-idle window. Hidden until at least
                         one idle window has completed. -->
                    <views:VfdMeter Title="Ambient (proxy)" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding AmbientProxyC, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                    SubText="Lowest motherboard/drive reading during recent idle"
                                    AccentBrush="{DynamicResource TextSecondaryBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmbientProxyC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- #612: cooling delivered per RPM (power / temp-above-ambient / RPM) - a rising
                         index means more RPM is needed for the same cooling, pointing at dust or a
                         clogged heatsink. An arbitrary-but-consistent unit, only meaningful as a trend on
                         this one machine. Hidden until an ambient proxy is available. -->
                    <views:VfdMeter Title="Fan efficiency index" Glow="False" Margin="0,0,0,16"
                                    ValueText="{Binding FanEfficiencyIndex, StringFormat={}{0:0.###}, TargetNullValue=–}"
                                    SubText="Cooling delivered per RPM — a rising trend suggests dust or a clogged heatsink"
                                    AccentBrush="{DynamicResource AccentBrush}">
                        <views:VfdMeter.Style>
                            <Style TargetType="views:VfdMeter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FanEfficiencyIndex}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VfdMeter.Style>
                    </views:VfdMeter>
                    <!-- Power trend -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TitleRow}">
                                <Border Style="{StaticResource ColorDot}" Background="{DynamicResource DangerBrush}" />
                                <TextBlock Text="Power draw" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <lvc:CartesianChart Series="{Binding PowerSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding PowerYAxes}"
                                                 Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Temperatures">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #25: historical CPU temperature chart, with a timestamped log of exactly when
                         the CPU was detected running hot and below its rated base clock under load -
                         see EnergyThermalsViewModel.RefreshAsync. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Style="{StaticResource TitleRow}">
                                <Border Style="{StaticResource ColorDot}" Background="#3C9EE8" />
                                <TextBlock Text="CPU temperature" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <lvc:CartesianChart Series="{Binding TempSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding TempYAxes}"
                                                 Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThrottleEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Throttle events (hot + below base clock under load)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ThrottleEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #601: Thermal zones - Windows' own built-in "Thermal Zone Information" perf
                         counters, a genuine ACPI-sourced throttle source independent of
                         LibreHardwareMonitorLib (still works when SensorsAvailable is false). Hidden
                         entirely when the category itself isn't exposed on this system. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThermalZonesAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Thermal zones (Windows ACPI)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Windows' own driver-free throttle source - a genuine ACPI throttle percentage the OS itself acts on, independent of the sensor driver above."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ThermalZones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ZoneName}" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="{Binding TemperatureC, StringFormat={}{0:0.#}°C, TargetNullValue=Temperature: Unknown, Mode=OneWay}" />
                                                    <Run Text=" · Passive limit " /><Run Text="{Binding PassiveLimitPercent, StringFormat={}{0:0}%, TargetNullValue=Unknown, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                                    Background="{DynamicResource BgElevatedBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ThrottlePercent}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}">
                                                    <Run Text="{Binding ThrottlePercent, StringFormat={}{0:0}%, Mode=OneWay}" /><Run Text=" throttle" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No thermal zones currently reporting data.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThermalZones.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #81: motherboard/VRM temperature trend - VRM overheating causes throttling that
                         CPU package temp alone won't show. Collapsed when no Motherboard-hardware
                         temperature sensor with a VRM/system/chipset name is reported at all. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MotherboardTempC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                                    <Border Style="{StaticResource ColorDot}" Background="#3CD68C" />
                                    <TextBlock Text="Motherboard / VRM temperature" Style="{StaticResource CardTitle}" Margin="0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding MotherboardTempC, StringFormat={}{0:0.#}°C}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                            </Grid>
                            <lvc:CartesianChart Series="{Binding MotherboardTempSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding MotherboardTempYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #623: VRM-specific temperature - a narrower, VRM/MOS-named-sensor-only reading
                         distinct from the generic motherboard trend above, plus a "VRM hot while package
                         is not" flag that indicts a poorly-cooled VRM heatsink rather than the CPU cooler.
                         Collapsed entirely when no VRM-named motherboard sensor is reported at all. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VrmTempC}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                                    <Border Style="{StaticResource ColorDot}" Background="#FF6347" />
                                    <TextBlock Text="VRM temperature" Style="{StaticResource CardTitle}" Margin="0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding VrmTempC, StringFormat={}{0:0.#}°C}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap"
                                       Text="Explicit VRM/MOSFET-named sensor(s) only - separate from the generic motherboard trend above." />
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VrmHotWhilePackageNotFlag}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                           Text="VRM is hot while the CPU package is not - points at a poorly-cooled VRM heatsink rather than the CPU cooler. Quick flag, not a verdict." />
                            </Border>
                            <lvc:CartesianChart Series="{Binding VrmTempSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding VrmTempYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- Temperatures -->
                    <TextBlock Text="Temperatures" Style="{StaticResource SubStat}" Margin="0,16,0,10" />
                    <ItemsControl ItemsSource="{Binding Temperatures}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- #46: session min/max lets a reading answer "is this normal for my
                                     CPU" without an external baseline - see EnergyThermalsViewModel's
                                     WithSessionBaseline. -->
                                <views:VfdMeter Title="{Binding SensorName}" Glow="False" Width="172" Margin="0,0,8,8"
                                                Percent="{Binding Value, TargetNullValue=0}"
                                                ValueText="{Binding Value, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                                AccentBrush="{Binding Value, Converter={StaticResource TemperatureToBrushConverter}}">
                                    <views:VfdMeter.SubText>
                                        <MultiBinding StringFormat="{}{0} • {1:0}–{2:0}°C session">
                                            <Binding Path="HardwareName" />
                                            <Binding Path="SessionMin" />
                                            <Binding Path="SessionMax" />
                                        </MultiBinding>
                                    </views:VfdMeter.SubText>
                                </views:VfdMeter>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- #450: DIMM temperature sensors - hidden entirely when none are reported (most
                         systems, since this needs vendor SMBus/SPD support LibreHardwareMonitorLib doesn't
                         have for every chipset - see EnergyThermalsViewModel.MemoryTemperatures). -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MemoryTemperatures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="DIMM temperatures" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding MemoryTemperatures}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:VfdMeter Title="{Binding SensorName}" Glow="False" Width="172" Margin="0,0,8,8"
                                                    Percent="{Binding Value, TargetNullValue=0}"
                                                    ValueText="{Binding Value, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="°C"
                                                    AccentBrush="{Binding Value, Converter={StaticResource TemperatureToBrushConverter}}">
                                        <views:VfdMeter.SubText>
                                            <MultiBinding StringFormat="{}{0} • {1:0}–{2:0}°C session">
                                                <Binding Path="HardwareName" />
                                                <Binding Path="SessionMin" />
                                                <Binding Path="SessionMax" />
                                            </MultiBinding>
                                        </views:VfdMeter.SubText>
                                    </views:VfdMeter>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- #609: idle-temperature baseline drift - median CPU package temp during genuinely
                         idle windows (CPU < 5% for 60s), one entry per day, charted "since first run". A
                         rising idle floor at unchanged ambient is a cleaner dust/pump-failure signal than
                         load temps. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Idle-temperature baseline" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <!-- #619: normalize-to-ambient toggle - without it, a hot summer looks
                                     identical to a dying cooler in this trend. -->
                                <CheckBox Grid.Column="1" Content="Normalize to ambient" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                          IsChecked="{Binding NormalizeToAmbient}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <TextBlock Text="Median CPU package temperature during genuinely idle windows, one point per day since first run. A rising floor at similar ambient conditions is a cleaner dust/pump-failure signal than load temps."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />
                            <lvc:CartesianChart Series="{Binding IdleBaselineSeries}" XAxes="{Binding IdleBaselineXAxes}" YAxes="{Binding IdleBaselineYAxes}"
                                                 Height="160" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                            <TextBlock Text="No idle baseline recorded yet - stays idle (under 5% CPU) for 60 seconds to record the first point.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IdleBaselineHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #618: cooldown-rate monthly trend - seconds to fall 20°C from peak once load
                         drops from >80% to <10%. Cooldown slope is largely workload-independent, so a
                         slowing trend degrades measurably as thermal paste dries out. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Cooldown rate" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Average seconds to fall 20°C from peak after a sustained load ends, one point per month. A slowing trend at similar peak temperatures points at drying thermal paste rather than a workload change."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <lvc:CartesianChart Series="{Binding CooldownSeries}" XAxes="{Binding CooldownXAxes}" YAxes="{Binding CooldownYAxes}"
                                                 Height="140" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #611: cooling-degradation card - for each (load, power) bucket with data spanning
                         more than one calendar month, the delta between the most recent and earliest
                         recorded month for that *same* bucket. Bucketing by load/power removes workload
                         as a confounder that a naive "average temp is up" comparison would get wrong.
                         Hidden entirely until at least one bucket has two months of data. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CoolingDegradationRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Cooling degradation" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Same CPU load/power bucket, compared against the earliest recorded month for that bucket - removes 'the machine's been working harder lately' as a confounder."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CoolingDegradationRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding BucketText}" FontSize="{StaticResource FontBody}" />
                                                <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource SubStat}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="{Binding DeltaC, StringFormat={}{0:+0.#;-0.#;0}°C}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Throttling">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #602: firmware-limited-processor event attribution (Kernel-Processor-Power 37/38) -
                         the one authoritative, non-heuristic statement Windows itself makes about
                         firmware-side CPU throttling, labelled "confirmed by Windows" rather than this
                         app's usual quick-flag wording. On-demand (event-log query), loaded once at
                         startup plus a manual refresh button. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Firmware-limited processor events" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Check firmware events" Command="{Binding LoadFirmwareEventsCommand}" />
                            </Grid>
                            <TextBlock Text="Confirmed by Windows — Kernel-Processor-Power event 37/38, the one authoritative statement Windows itself makes about firmware-side CPU throttling."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding FirmwareThrottleEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="10" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource DangerMutedBrush}">
                                                <TextBlock FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="Confirmed by Windows" />
                                            </Border>
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" VerticalAlignment="Center">
                                                <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding IsRecovery, Converter={StaticResource BoolToFirmwareEventTextConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No firmware-limit events found in the last 30 days.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FirmwareThrottleEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #604: persisted throttle-episode history - turns the throttle list above from "the
                         10 most recent in-memory entries" into a rolling, cross-session record, plus a
                         per-week episode-count sparkline ("has this been getting worse?"). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Throttle history (persisted across sessions)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Episode count per week, last 12 weeks." Style="{StaticResource SubStat}" Margin="0,-4,0,10" />
                            <lvc:CartesianChart Series="{Binding WeeklyEpisodeSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding WeeklyEpisodeYAxes}"
                                                 Height="120" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding RecentThrottleEpisodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="{StaticResource FontBody}">
                                                    <Run Text="{Binding Start, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" — " /><Run Text="{Binding ReasonClass, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="{Binding PeakTempC, StringFormat={}Peak {0:0.#}°C, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding PeakPackagePowerW, StringFormat={}{0:0.#}W, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding MeanEffectiveMhz, StringFormat={}{0:0} MHz avg, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Converter={StaticResource EpisodeDurationConverter}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No throttle episodes recorded yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentThrottleEpisodes.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #693: AC vs. DC sustained-performance cliff - measured, not configured. Hidden on
                         any system HasBattery has never latched true (a desktop). -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBattery}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="AC vs. battery sustained-performance cliff" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                                       Text="Steady-state clock, package power, and temperature recorded separately during sustained CPU load (60%+ for 20+ seconds) on AC and on battery, so this shows what the machine actually does - not what its power plan is configured to allow." />
                            <TextBlock Text="{Binding AcDcCliffText, Mode=OneWay}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,10" />
                            <UniformGrid Columns="3">
                                <views:VfdMeter Title="AC sustained clock" Glow="False" Margin="0,0,6,0"
                                                ValueText="{Binding AcDcCliff.AcClockGhz, StringFormat={}{0:0.00}, TargetNullValue=–}" Unit="GHz"
                                                SubText="{Binding AcDcCliff.AcSampleCount, StringFormat={}{0} samples}" AccentBrush="{DynamicResource AccentBrush}" />
                                <views:VfdMeter Title="Battery sustained clock" Glow="False" Margin="3,0,3,0"
                                                ValueText="{Binding AcDcCliff.DcClockGhz, StringFormat={}{0:0.00}, TargetNullValue=–}" Unit="GHz"
                                                SubText="{Binding AcDcCliff.DcSampleCount, StringFormat={}{0} samples}" AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="Battery package power" Glow="False" Margin="6,0,0,0"
                                                ValueText="{Binding AcDcCliff.DcPackagePowerW, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                                SubText="Vs. AC package power" AccentBrush="{DynamicResource WarningBrush}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Power">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #621/#622: "Power delivery" section - rail-sag-under-load correlation and Vcore
                         droop/load-line behavior, both rolling scatter clouds with a live fitted line. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Power delivery" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="A 12V rail that measurably drops as system power rises is a loaded or failing PSU; a noisy-but-uncorrelated reading is just a poor sensor. Vcore plotted against package power exposes the effective load-line calibration curve - excessive droop shows as an unusually steep slope."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />

                            <TextBlock Text="Rail sag under load" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <lvc:CartesianChart Series="{Binding RailSagSeries}" XAxes="{Binding RailSagXAxes}" YAxes="{Binding RailSagYAxes}"
                                                 Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding RailSagVerdictText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <TextBlock Text="Vcore vs. load (load-line behavior)" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <lvc:CartesianChart Series="{Binding VcoreLoadSeries}" XAxes="{Binding VcoreLoadXAxes}" YAxes="{Binding VcoreLoadYAxes}"
                                                 Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding VcoreLoadSlopeText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- #632: AMD PPT/TDC/EDC limit approximation - hidden entirely on non-AMD CPUs, since
                         PPT/TDC/EDC don't apply there. Approximate: Ryzen's real limit-reason telemetry
                         needs the vendor SMU access this app deliberately does not take. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAmdCpu}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="AMD power/current limit approximation (PPT/TDC/EDC)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding AmdLimitVerdictText}" Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <UniformGrid Columns="2">
                                <views:VfdMeter Title="Package power" Glow="False" Margin="0,0,6,0"
                                                ValueText="{Binding TotalPackagePowerW, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                                SubText="{Binding PowerSessionMaxW, StringFormat={}session high {0:0.#} W}"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="SoC/package current" Glow="False" Margin="6,0,0,0"
                                                ValueText="{Binding AmdCurrentA, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="A"
                                                SubText="{Binding AmdCurrentSessionMaxA, StringFormat={}session high {0:0.#} A}"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <!-- #624: PSU inventory + wattage sanity check - a WMI-reported wattage (rare) or a
                         user-entered one, compared against estimated total draw (CPU package + GPU + a
                         fixed platform allowance). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="PSU inventory &amp; wattage sanity check" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding PsuInventoryText}" Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PsuBrownoutRiskDetected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                           Text="Sustained estimated draw above ~80% of rated wattage - a brownout/shutdown risk under this PSU's rated capacity. Quick flag, not a verdict." />
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PsuWattageInputText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,8,0" ToolTip="PSU rated wattage (e.g. 650)" />
                                <Button Grid.Column="1" Content="Save wattage" Command="{Binding SavePsuWattageCommand}" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="Re-check WMI" Command="{Binding LoadPsuInfoCommand}" />
                            </Grid>

                            <UniformGrid Columns="3">
                                <views:VfdMeter Title="Rated wattage" Glow="False" Margin="0,0,6,0"
                                                ValueText="{Binding PsuRatedWattageW, StringFormat={}{0:0}, TargetNullValue=–}" Unit="W"
                                                SubText="From WMI or user entry" AccentBrush="{DynamicResource AccentBrush}" />
                                <views:VfdMeter Title="Estimated draw" Glow="False" Margin="3,0,3,0"
                                                ValueText="{Binding EstimatedTotalDrawW, StringFormat={}{0:0}, TargetNullValue=–}" Unit="W"
                                                SubText="CPU package + GPU + platform allowance" AccentBrush="{DynamicResource DangerBrush}" />
                                <views:VfdMeter Title="PSU load" Glow="False" Margin="6,0,0,0"
                                                ValueText="{Binding PsuLoadPercent, StringFormat={}{0:0}, TargetNullValue=–}" Unit="%"
                                                SubText="Of rated wattage">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PsuBrownoutRiskDetected}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <!-- Voltages -->
                    <TextBlock Text="Voltages" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                    <!-- #620: ATX rail verdict caveat - shown once per section, not per row, since it
                         applies to every Super I/O voltage reading here regardless of in/out-of-spec. -->
                    <TextBlock Text="Super I/O rail readings are uncalibrated on many boards - treat the deviation/excursion figures below as informational, not a certified measurement."
                               Style="{StaticResource SubStat}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Voltages}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Round 12, #96/#620: out-of-spec 12V/5V/3.3V rail flagging - a recognized
                                     rail more than ~5% off nominal tints red and its SubText becomes a
                                     verdict ("6% low, 14 excursions/hr") instead of the bare hardware
                                     name; an in-spec recognized rail or unrecognized rail name keeps the
                                     normal accent color (RailVerdictText already reads "in spec (±5%)" or
                                     the hardware name respectively - see EnergyThermalsViewModel.TrackVoltageExcursions). -->
                                <!-- AccentBrush's default is set via the Style's own base Setter (not a
                                     local attribute on the element) so the Style.Triggers override below
                                     can actually win - a locally-set value always beats a style trigger in
                                     WPF's property-value precedence, which would otherwise silently make
                                     this "out of spec" tint never render. -->
                                <views:VfdMeter Title="{Binding SensorName}" Glow="False" Width="172" Margin="0,0,8,8"
                                                ValueText="{Binding Value, StringFormat={}{0:0.###}, TargetNullValue=–}" Unit="V"
                                                SubText="{Binding RailVerdictText}">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVoltageOutOfSpec}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Wattages -->
                    <TextBlock Text="Power rails" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Wattages}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:VfdMeter Title="{Binding SensorName}" Glow="False" Width="172" Margin="0,0,8,8"
                                                ValueText="{Binding Value, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                                SubText="{Binding HardwareName}" AccentBrush="{DynamicResource DangerBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Cooling">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #34: fan curve (RPM vs. temp) - a fan that isn't ramping with load shows up as a
                         flat/scattered cloud instead of a rising trend. Collapsed until at least one
                         (temp, RPM) sample has been recorded. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FanCurvePoints.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Fan curve (primary CPU fan)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="RPM vs. CPU temperature over the last few minutes - a fan that isn't ramping with temperature reads as a flat line instead of an upward trend. The faint ghosted line, when present, is last month's fitted curve (#612) - shifted right means more RPM is now needed for the same temperature, pointing at dust or a clogged heatsink."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <lvc:CartesianChart Series="{Binding FanCurveSeries}" XAxes="{Binding FanCurveXAxes}" YAxes="{Binding FanCurveYAxes}"
                                                 Height="180" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- Round 12, #95: fan RPM over time, complementing the temp-vs-RPM scatter above -
                         a plain time series shows hunting/oscillation (RPM repeatedly ramping up and down
                         at a near-constant temperature) that a scatter cloud's shape hides. Same
                         primary-fan tracking as the scatter, so this appears/disappears together with it. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FanCurvePoints.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Fan RPM over time" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="A fan that repeatedly ramps up and down at a near-constant temperature ('hunting') shows here as visible oscillation, which the scatter plot above hides."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <lvc:CartesianChart Series="{Binding FanRpmSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding FanRpmYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- Fans -->
                    <TextBlock Text="Fans" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Fans}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- #614/#615: per-fan status (OK/Slow/Stopped/Not reporting) instead of
                                     a single global dead-fan flag, plus the step-loss "was" comparison
                                     against this fan's historical RPM ceiling when it's dropped 20%+. -->
                                <views:VfdMeter Title="{Binding SensorName}" Glow="False" Width="172" Margin="0,0,8,8"
                                                ValueText="{Binding Value, StringFormat={}{0:0}, TargetNullValue=–}" Unit="RPM"
                                                SubText="{Binding HardwareName}" AccentBrush="{DynamicResource AccentBrush}">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FanStatus}" Value="Slow">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource WarningBrush}" />
                                                    <Setter Property="SubText" Value="Slow — well below sibling fans" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FanStatus}" Value="Stopped">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="SubText" Value="Stopped" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FanStatus}" Value="Not reporting">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="SubText" Value="Not reporting" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StepLossDetected}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- #614: RPM step-loss list - "Max RPM 1120 (was 1480)" for any fan whose session
                         ceiling has dropped 20%+ below its historical max, a bearing wearing out even
                         though the fan still spins. Hidden entirely when no fan currently qualifies. -->
                    <ItemsControl ItemsSource="{Binding Fans}" Margin="0,-8,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StepLossDetected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding SensorName, Mode=OneWay}" /><Run Text=": Max RPM " />
                                    <Run Text="{Binding SessionMax, StringFormat={}{0:0}, Mode=OneWay}" />
                                    <Run Text=" (was " /><Run Text="{Binding HistoricalMaxRpm, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- #616: coolant-pump variance card - a pump should hold a near-constant RPM, so
                         variance (not absolute RPM) is the fault signal, unlike the case fans above.
                         Hidden entirely when no channel matched a Pump/AIO/W_PUMP name hint. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CoolantPumps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Coolant pump" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="A pump should run at a near-constant RPM - rising variance, not absolute RPM, is the fault signal here."
                                       Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CoolantPumps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="{StaticResource FontBody}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text=" — " /><Run Text="{Binding CurrentRpm, StringFormat={}{0:0} RPM, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="{Binding MeanRpm, StringFormat={}Mean {0:0} RPM, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding CoefficientOfVariation, StringFormat={}{0:0.0%} variation, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                                                    Background="{DynamicResource BgElevatedBrush}">
                                                <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Stable" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVariable}" Value="True">
                                                                    <Setter Property="Text" Value="Variable — check pump" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Power plans">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- Round 12, #90/#91/#92: power scheme + sleep-state support + USB selective-suspend -
                         all on-demand (shelling out to powercfg/WMI, not something to poll every tick). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Power plan &amp; sleep support" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Load power info" Command="{Binding LoadPowerInfoCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding PowerPlanStatusText}" Margin="0,4,0,8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerPlanStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PowerPlans}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Foreground="{DynamicResource SuccessBrush}">
                                                    <Run.Text>
                                                        <Binding Path="IsActive" Converter="{StaticResource ActivePlanSuffixConverter}" Mode="OneWay" />
                                                    </Run.Text>
                                                </Run>
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="Switch to this" FontSize="{StaticResource FontBody}" Padding="8,3"
                                                    Command="{Binding DataContext.SetPowerPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Guid}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Style="{StaticResource SubStat}" VerticalAlignment="Center">
                                    <Run Text="Sleep state: " />
                                    <Run Text="{Binding SleepStateSupportText, Mode=OneWay}" FontSize="{StaticResource FontStrong}" />
                                </TextBlock>
                                <!-- #736: cross-link over to the Startup tab's full hibernation/sleep-state
                                     inventory card (powercfg /a details, hiberfile size, and the confirmed
                                     on/off/type/size toggles) - same SelectTabByName mechanism as
                                     StartupView.xaml.cs's own cross-tab links. -->
                                <Button Grid.Column="1" Content="Hibernation details (Startup tab)" Padding="8,4" FontSize="{StaticResource FontBody}" Click="ViewHibernationDetails_Click" />
                            </Grid>

                            <!-- #664: power-plan change history - a change this app didn't itself cause
                                 (vendor utility/game silently calling powercfg /setactive) shows up here
                                 with a timestamp. -->
                            <ItemsControl ItemsSource="{Binding PowerPlanChangeHistory}" Margin="0,10,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerPlanChangeHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">
                                            <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" — plan changed from " />
                                            <Run Text="{Binding FromPlanName, Mode=OneWay}" />
                                            <Run Text=" to " />
                                            <Run Text="{Binding ToPlanName, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #691/#692: power-mode overlay readout + switch, and OEM vendor thermal-profile
                         detection - both "what is this machine actually running right now" readouts that
                         sit alongside (not inside) the power-plan card above, since the overlay is a
                         genuinely separate layer on top of whichever scheme is active. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Power mode overlay &amp; vendor thermal mode" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                                       Text="The power-mode overlay sits on top of the power plan above - a machine can show Balanced as its active plan while the overlay independently caps it to the efficiency profile. Vendor thermal mode reads the OEM's own fan-mode/thermal-profile setting where a WMI namespace for it exists." />

                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Run Text="Active overlay: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" />
                                <Run Text="{Binding ActiveOverlaySchemeText, Mode=OneWay}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PowerOverlaySchemes}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Switch to this" FontSize="{StaticResource FontBody}" Padding="8,3"
                                                    Command="{Binding DataContext.SetOverlaySchemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Guid}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="Vendor thermal mode: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" />
                                <Run Text="{Binding OemThermalProfile.ModeText, Mode=OneWay}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding OemThermalProfile.Vendor, Mode=OneWay, StringFormat=({0})}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OemThermalProfile.Available}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #694: blocked-vent/airflow-obstruction heuristic - hidden until BlockedVentSuspected
                         latches true, same "quick flag, not a verdict" banner treatment as the dead-fan/
                         fan-hunting banners near the top of this view. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BlockedVentSuspected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding BlockedVentText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" />
                    </Border>
                    <!-- #661: active-plan setting diff against Balanced defaults. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Settings changed from Balanced" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Compare to defaults" Command="{Binding LoadPowerPlanDiffCommand}" />
                            </Grid>
                            <TextBlock Text="Only settings that actually differ from the built-in Balanced scheme's own defaults are listed - the rest are unchanged and not worth reviewing."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PowerPlanDiffStatusText}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerPlanDiffStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding PowerPlanSettingDiffs}" IsReadOnly="True" MaxHeight="260">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerPlanSettingDiffs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Subgroup" Binding="{Binding SubgroupName}" Width="140" />
                                    <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="*" />
                                    <DataGridTextColumn Header="Active AC" Binding="{Binding ActiveAcText}" Width="90" />
                                    <DataGridTextColumn Header="Active DC" Binding="{Binding ActiveDcText}" Width="90" />
                                    <DataGridTextColumn Header="Balanced AC" Binding="{Binding DefaultAcText}" Width="90" />
                                    <DataGridTextColumn Header="Balanced DC" Binding="{Binding DefaultDcText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #662: hidden high-impact settings, paired AC | DC, plus #663's passive-cooling
                         flag + fix (piggybacked on the same read). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hidden power settings" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Check hidden settings" Command="{Binding LoadHiddenPowerSettingsCommand}" />
                            </Grid>
                            <TextBlock Text="Settings the Control Panel Power Options UI hides by default, paired AC next to DC - a 'fast plugged in, crawls on battery' complaint is almost always a DC-side value that's only visible side by side like this."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HiddenPowerSettingsStatusText}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HiddenPowerSettingsStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- #663: passive-cooling-on-AC warning banner + one-click fix - same
                                 Background=BgElevatedBrush/BorderBrush=WarningBrush banner style the
                                 dead-fan/fan-hunting flags above already establish. -->
                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PassiveCoolingOnAcDetected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center"
                                               Text="System cooling policy is Passive on AC (quick flag, not a verdict) - this throttles the CPU instead of ramping fans, a classic cause of 'inexplicably slow but cool.' Some quiet-focused builds set this on purpose." />
                                    <Button Grid.Column="1" Content="Set to Active" Margin="10,0,0,0" Command="{Binding FixPassiveCoolingCommand}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding PassiveCoolingFixStatusText}" Margin="0,-6,0,8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PassiveCoolingFixStatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding HiddenPowerSettings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SettingName}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Explanation}" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="{StaticResource FontBody}">
                                                        <Run Text="AC: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding AcValueText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontBody}" Margin="16,0,0,0">
                                                        <Run Text="DC: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding DcValueText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Text="differs" FontSize="{StaticResource FontBody}" Margin="10,0,0,0" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ValuesDiffer}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #660: powercfg /energy 60-second diagnostic scan. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Power efficiency scan" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding RunPowerEfficiencyScanCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Run scan (~60s)" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPowerEfficiencyScanRunning}" Value="True">
                                                    <Setter Property="Content" Value="Running…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="Runs Windows' own 60-second energy-efficiency diagnostic (powercfg /energy) and lists its Errors/Warnings/Information findings - devices blocking sleep, USB selective suspend disabled, processor power-management problems, and more."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PowerEfficiencyStatusText}" Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource SubStat}" />
                            <DataGrid ItemsSource="{Binding PowerEfficiencyFindings}" IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerEfficiencyFindings.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Severity" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Margin="4,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="USB">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #92: per-device USB selective-suspend status - on-demand, and honestly reports
                         "Unknown" for most devices on most systems (see UsbPowerService's remarks). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="USB selective suspend" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Load USB devices" Command="{Binding LoadUsbDevicesCommand}" />
                            </Grid>
                            <TextBlock Text="Best-effort per-device read - Windows exposes no simple public API for this, so most devices on most systems will honestly show 'Unknown' rather than a guess."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,4" TextWrapping="Wrap" />

                            <!-- #668: plan-level shortcut - the fastest fix when several flagged devices
                                 all need the same change at once. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding UsbFixStatusText}" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UsbFixStatusText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Content="Disable plan-level USB suspend (AC)" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding DisablePlanUsbSuspendCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding UsbDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" />
                                                <!-- #668: "quick flag, not a verdict" - a device in a
                                                     suspend-fragile class (USB audio/DAC, HID input,
                                                     external storage) with suspend currently enabled. -->
                                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuspendRisk}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Suspend risk (quick flag, not a verdict): " /><Run Text="{Binding RiskClass, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Unknown" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectiveSuspendEnabled}" Value="True">
                                                                <Setter Property="Text" Value="Enabled" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectiveSuspendEnabled}" Value="False">
                                                                <Setter Property="Text" Value="Disabled" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- #667: re-enumeration count - hidden until LoadUsbEventsCommand
                                                 has actually run (ReenumerationCount's -1 default). -->
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReenumerationCount}" Value="-1">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding ReenumerationCount, Mode=OneWay}" /><Run Text=" re-enum" />
                                            </TextBlock>
                                            <Button Grid.Column="3" Content="Toggle suspend" FontSize="{StaticResource FontCaption}" Padding="6,2" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ToggleUsbDeviceSuspendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #665/#667: USB over-current/port-reset events + re-enumeration scan. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="USB power events" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Scan event logs" Command="{Binding LoadUsbEventsCommand}" />
                            </Grid>
                            <TextBlock Text="Over-current and port-reset-failure records ('a USB device has exceeded the power limits of its hub port') plus the re-enumeration count shown per device above - keyword-matched, since Windows doesn't publish stable event IDs for these across drivers/builds."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UsbEventsStatusText}" Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource SubStat}" />
                            <ItemsControl ItemsSource="{Binding UsbOverCurrentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Message, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #666: USB hub inventory + system-wide port-occupancy proxy. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsbHubs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="USB hubs" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Windows doesn't publish a documented per-port milliamp budget/draw figure without deeper hardware interop this app avoids - shown instead is real hub port-count inventory plus a system-wide devices-vs-ports proxy for the same over-subscription risk."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UsbHubStatusText}" Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource SubStat}" />
                            <ItemsControl ItemsSource="{Binding UsbHubs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding HubName}" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0">
                                                <Run Text="{Binding PortCount, TargetNullValue=?, Mode=OneWay}" /><Run Text=" ports" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #669: USB-C/Thunderbolt PD negotiation (UCSI) - hidden entirely when this
                         platform doesn't publish a UCSI WMI class, the common desktop case. -->
                    <Border Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUsbPdConnectors}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="USB-C power delivery (UCSI)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Reported exactly as this system's UCSI class publishes it - Windows has no stable, versioned property contract for UCSI, so this is a raw dump rather than a guessed Voltage/Current mapping."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding UsbPdConnectors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ClassName}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SummaryText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Properties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas">
                                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Battery">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- Battery: empty (and the whole section collapsed) on any desktop - see
                         EnergyThermalsViewModel.Battery's remarks. "Degradation Level" is the closest
                         thing to a real battery-health figure this app can show. Gated on HasBattery
                         (sticky - see its remarks) rather than the instantaneous Battery.Count, so a
                         transient #647 gauge dropout doesn't hide this whole section along with the very
                         dropout log it's meant to reveal. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBattery}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Battery" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
                        <!-- #88: real-time drain rate, pulled out as its own headline tile - see
                             EnergyThermalsViewModel.BatteryDrainRateW's remarks. -->
                        <views:VfdMeter Glow="True" Width="220" Margin="0,0,0,10"
                                        ValueText="{Binding BatteryDrainRateW, StringFormat={}{0:0.#}, TargetNullValue=–}" Unit="W"
                                        AccentBrush="{DynamicResource DangerBrush}">
                            <views:VfdMeter.Style>
                                <Style TargetType="views:VfdMeter">
                                    <Setter Property="Title" Value="Discharge rate" />
                                    <Setter Property="SubText" Value="Draining" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BatteryIsCharging}" Value="True">
                                            <Setter Property="Title" Value="Charge rate" />
                                            <Setter Property="SubText" Value="Charging" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:VfdMeter.Style>
                        </views:VfdMeter>
                        <ItemsControl ItemsSource="{Binding Battery}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:VfdMeter Title="{Binding SensorName}" Glow="False" Width="172" Margin="0,0,8,8"
                                                    ValueText="{Binding Value, StringFormat={}{0:0.#}, TargetNullValue=–}"
                                                    Unit="{Binding Type, Converter={StaticResource SensorTypeToUnitConverter}}"
                                                    SubText="{Binding HardwareName}" AccentBrush="{DynamicResource AccentBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- #626: DC-jack/adapter power-source flapping - Kernel-Power 105 (AC/DC
                             transition) events, on-demand. Rapid flapping while plugged in points at a
                             failing barrel jack, bad USB-C PD negotiation, or a bad cable. -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PowerSourceFlapText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerSourceFlapWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Content="Check power-source events" FontSize="{StaticResource FontBody}" Padding="8,3"
                                    Command="{Binding LoadPowerSourceEventsCommand}" />
                        </Grid>
                    </StackPanel>
                    <!-- #641-#648: full battery report panel - powercfg /batteryreport + WMI fallback
                         (#641/#643), capacity-fade chart + 50%-of-design projection (#642), charge-rate/
                         stall detection (#645), design-vs-actual runtime (#646), gauge-dropout log
                         (#647), and charge-ceiling/hot-pack charge-throttle awareness (#648). SRUM
                         per-app drain attribution (#644) is its own card further below - a separate,
                         slower on-demand scan. Lives inside this same HasBattery-gated section. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Battery report" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Run battery report" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding LoadBatteryReportCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding BatteryReportStatusText}" Style="{StaticResource SubStat}"
                                       TextWrapping="Wrap" Margin="0,6,0,10" />

                            <!-- #641/#643: identity/capacity figures + #642's chart + #641's recent-usage
                                 table - all only meaningful once a report has actually loaded. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBatteryReport}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <WrapPanel Margin="0,0,0,4">
                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Text="Manufacturer" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Text="{Binding BatteryReport.Manufacturer, TargetNullValue=Unknown}" Style="{StaticResource SpecValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Text="Chemistry" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Text="{Binding BatteryReport.Chemistry, TargetNullValue=Unknown}" Style="{StaticResource SpecValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Text="Cycle count" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Text="{Binding BatteryReport.CycleCount, TargetNullValue=Unknown}" Style="{StaticResource SpecValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Text="Design capacity" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Text="{Binding BatteryReport.DesignCapacityMwh, StringFormat={}{0:0} mWh, TargetNullValue=Unknown}" Style="{StaticResource SpecValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,10">
                                        <TextBlock Text="Full-charge capacity" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Text="{Binding BatteryReport.FullChargeCapacityMwh, StringFormat={}{0:0} mWh, TargetNullValue=Unknown}" Style="{StaticResource SpecValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Health (full-charge / design)" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Text="{Binding BatteryReport.HealthPercent, StringFormat={}{0:0.#}%, TargetNullValue=Unknown}" Style="{StaticResource SpecValue}" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- #642: capacity-fade chart - empty (and hidden) whenever the report
                                     has no usable capacity-history rows, which is always true on the WMI
                                     fallback path (no history table exists in WMI). -->
                                <StackPanel Margin="0,6,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CapacityHistoryPoints.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Capacity fade" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <lvc:CartesianChart Series="{Binding CapacityHistorySeries}" XAxes="{Binding CapacityHistoryXAxes}" YAxes="{Binding CapacityHistoryYAxes}"
                                                         Height="160" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                                </StackPanel>
                                <TextBlock Text="{Binding CapacityProjectionText}" TextWrapping="Wrap" Margin="0,6,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CapacityProjectionText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- #641: recent-usage table from the report itself - empty on the WMI
                                     fallback path, same reasoning as the chart above. -->
                                <StackPanel Margin="0,0,0,4">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BatteryReport.RecentUsage.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Recent usage" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                    <DataGrid ItemsSource="{Binding BatteryReport.RecentUsage}" Height="180" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Period" Binding="{Binding PeriodStart, StringFormat={}{0:g}}" Width="150" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding PowerSource}" Width="*" />
                                            <DataGridTextColumn Header="Capacity remaining" Binding="{Binding CapacityRemainingMwh, StringFormat={}{0:0} mWh}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>

                            <!-- #646: design-vs-actual runtime estimate - independent of whether a report
                                 has loaded yet (shows a prompt to run one until it has). -->
                            <TextBlock Text="{Binding RuntimeComparisonText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RuntimeComparisonText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- #645: charge-rate / charge-stall - only meaningful while actually
                                 charging, tinted as a warning when a stall or a suspiciously weak charge
                                 rate is flagged. Quick flag, not a verdict (see the text itself). -->
                            <TextBlock Text="{Binding ChargeRateVerdictText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChargeRateVerdictText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ChargeStallDetected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WeakChargerSuspected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- #648: charge-ceiling (vendor conservation policy) + hot-pack charge
                                 throttle - both purely informational/protective-behavior notes, never
                                 tinted as a warning (the whole point is "this isn't a fault"). -->
                            <TextBlock Text="{Binding ChargeCeilingText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChargeCeilingText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding HotChargeThrottleText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HotChargeThrottleText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- #647: gauge-dropout log - the battery instance disappearing and
                                 reappearing between polls, timestamped. Hidden entirely until at least
                                 one transition has actually been observed this session. -->
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatteryDropoutEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Gauge presence log" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="The battery instance disappearing and reappearing between polls points at a failing battery connector or gauge IC - quick flag, not a verdict." />
                                <ItemsControl ItemsSource="{Binding BatteryDropoutEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,3" Foreground="{DynamicResource WarningBrush}">
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding DescriptionText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #644: SRUM per-app battery-drain attribution - a separate card since it's its
                         own, slower on-demand scan (powercfg /srumutil), independent of the battery
                         report button above. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Battery drain by app (SRUM)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Scan drain history" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding LoadBatteryDrainAttributionCommand}" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,4,0,10"
                                       Text="What's been draining the battery over the last several days - a best-effort, informational ranking built from Windows' own SRUM energy-estimation data, not a calibrated watt-hour reading. This is a real subprocess scan and can take a moment." />
                            <TextBlock Text="{Binding BatteryDrainAttributionStatusText}" Style="{StaticResource SubStat}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding BatteryDrainAttribution}" Height="240" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="2*" />
                                    <DataGridTextColumn Header="Energy (relative)" Binding="{Binding EnergyEstimate, StringFormat={}{0:0.#}}" Width="*" />
                                    <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="*" />
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, StringFormat={}{0:g}}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Sleep &amp; wake">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #649-#659: Sleep, Modern Standby and wake diagnostics panel. Every on-demand read
                         here is a real subprocess/event-log call, gated behind its own button - never the
                         tick timer (see EnergyThermalsViewModel's remarks). Not gated on HasBattery like
                         the battery-report panel above - sleep/wake diagnostics matter on desktops too. -->
                    <TextBlock Text="Sleep, Modern Standby &amp; wake diagnostics" Style="{StaticResource CardTitle}"
                               FontSize="{StaticResource FontSection}" Margin="0,20,0,8" />
                    <!-- #657: overnight standby-drain summary - shown at the top of the panel per the
                         backlog item's own framing, since it's the headline "was my laptop dead this
                         morning" answer. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Overnight standby drain" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StandbyDrainSummaryText}" TextWrapping="Wrap" Style="{StaticResource SubStat}" />
                            <ItemsControl ItemsSource="{Binding StandbyDrainSessions}" Margin="0,8,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StandbyDrainSessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,3">
                                            <Run Text="{Binding SleepTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding WakeTime, StringFormat={}{0:t}, Mode=OneWay}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding SleepBatteryPercent, StringFormat={}{0:0}%, Mode=OneWay}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding WakeBatteryPercent, StringFormat={}{0:0}%, Mode=OneWay}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding DrainPercentPerHour, StringFormat={}{0:0.#}%/hr, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #649/#650/#651: sleepstudy / system power report - session table + cross-session
                         ranked offenders, routed by Modern-Standby-vs-legacy-S3 detection. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sleep report (sleepstudy)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Run sleep report" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding LoadSleepStudyCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding SleepStudyStatusText}" TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,8" />

                            <TextBlock Text="Sessions" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
                                        <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SleepStudySessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding SleepStudySessions}" IsReadOnly="True" Height="180" Margin="0,0,0,10">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SleepStudySessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat={}{0:g}, TargetNullValue=Unknown}" Width="1.4*" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat={}{0:hh\:mm\:ss}, TargetNullValue=Unknown}" Width="*" />
                                    <DataGridTextColumn Header="Low-power %" Binding="{Binding LowPowerPercent, StringFormat={}{0:0.#}%, TargetNullValue=Unknown}" Width="*" />
                                    <DataGridTextColumn Header="Drain %" Binding="{Binding DrainPercent, StringFormat={}{0:0.#}%, TargetNullValue=Unknown}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- #650: cross-session ranked offenders - the actionable answer a single
                                 session's own top-offender list buries. -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopStandbyOffenders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Top standby offenders (across all parsed sessions)" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding TopStandbyOffenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,3">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Run Text=" (in " />
                                                <Run Text="{Binding SessionCount, Mode=OneWay}" />
                                                <Run Text=" session(s))" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #652: live power-request blocker list - the direct "why won't my PC sleep right
                         now" answer, refreshed on demand only. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outstanding power requests" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding LoadPowerRequestsCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding PowerRequestsStatusText}" TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding PowerRequests}" IsReadOnly="True" Height="160">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerRequests.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="*" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="2*" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #653: wake-armed device inventory (wake_armed ∩ wake_from_any) with a per-device
                         disable action - the mouse/NIC/keyboard that wakes a PC at 3 a.m. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wake-armed devices" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Load wake-armed devices" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding LoadWakeArmedDevicesCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding WakeArmedDevicesStatusText}" TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding WakeArmedDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="Disable wake" FontSize="{StaticResource FontBody}" Padding="8,3"
                                                    Command="{Binding DataContext.DisableDeviceWakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #654/#655/#656: wake history (event-log attribution), wake sources (wake timers +
                         wake-enabled scheduled tasks), and failed-sleep/vetoed-transition detection - one
                         combined on-demand action, since all three key off the same underlying scan. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wake history &amp; software wake sources" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Load wake history" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Command="{Binding LoadWakeHistoryCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding WakeHistoryStatusText}" TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,8" />

                            <!-- #656: vetoed-transition warning banner - hidden until at least one is found. -->
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VetoedSleepTransitions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4"
                                           Text="Possible failed/vetoed sleep transitions (quick flag, not a verdict - a driver veto and a deliberate near-instant wake look identical from the event log alone):" />
                                <ItemsControl ItemsSource="{Binding VetoedSleepTransitions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,3" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap">
                                                <Run Text="{Binding SleepAttemptTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding DescriptionText, Mode=OneWay}" />
                                                <Run Text=" Possible vetoing driver: " />
                                                <Run Text="{Binding PossibleVetoingDriverHint, Mode=OneWay, TargetNullValue=Unknown}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="Wake history" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding WakeHistory}" IsReadOnly="True" Height="160" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Wake time" Binding="{Binding WakeTime, StringFormat={}{0:g}}" Width="1.3*" />
                                    <DataGridTextColumn Header="Sleep time" Binding="{Binding SleepTime, StringFormat={}{0:g}, TargetNullValue=Unknown}" Width="1.3*" />
                                    <DataGridTextColumn Header="Wake source" Binding="{Binding WakeSource, TargetNullValue=Unknown}" Width="1.5*" />
                                    <DataGridTextColumn Header="Record" Binding="{Binding RecordSource}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Software wake sources (wake timers + wake-enabled scheduled tasks)" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding WakeSources}" IsReadOnly="True" Height="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #658/#659: hibernation configuration + enable/disable action. Fast Startup
                         (HiberbootEnabled, #659) is annotated on the footer's uptime readout instead - see
                         MainWindow.xaml - since it's about uptime attribution, not this panel's own state. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hibernation" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" FontSize="{StaticResource FontBody}" Padding="8,3" Margin="0,0,6,0"
                                        Command="{Binding LoadHibernationStatusCommand}" />
                                <Button Grid.Column="2" FontSize="{StaticResource FontBody}" Padding="8,3"
                                        Content="{Binding Hibernation.Enabled, Converter={StaticResource BoolToEnableDisableTextConverter}}"
                                        Command="{Binding ToggleHibernationCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding Hibernation.StatusText}" TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Stress test">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #695-#700: Stress test panel - its own ViewModel/UserControl (StressTestViewModel/
                         StressTestPanel), composed at the MainViewModel level since it needs Gpu (TDR
                         watch) as well as EnergyThermals/Performance - reached the same cross-ViewModel way
                         the Sleep panel's Logging/Summary cards reach a sibling ViewModel elsewhere in this
                         app (CLAUDE.md's {Binding DataContext.X, RelativeSource={RelativeSource
                         AncestorType=Window}} convention), set once here rather than repeated per binding
                         inside StressTestPanel.xaml itself. -->
                    <views:StressTestPanel DataContext="{Binding DataContext.StressTest, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,16" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
