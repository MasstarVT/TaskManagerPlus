<UserControl x:Class="TaskManagerPlus.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Plays on the status dot's ring whenever a service's Status actually changes
             (started, stopped, or any other transition) - see ServicesView.xaml.cs. -->
        <Storyboard x:Key="StatusPulse">
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                              From="0.6" To="0" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                              From="1" To="3" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                              From="1" To="3" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Height="32" />

            <CheckBox Grid.Column="1" Content="Failed to start only" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding FailedToStartOnly}"
                      ToolTip="Show only Automatic services whose last start attempt reported an error" />

            <Button Grid.Column="3" Content="Start" Margin="0,0,8,0" Command="{Binding StartCommand}" Style="{StaticResource SuccessButton}" />
            <Button Grid.Column="4" Content="Stop" Margin="0,0,8,0" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" />
            <Button Grid.Column="5" Content="Restart" Margin="0,0,8,0" Command="{Binding RestartCommand}" Style="{StaticResource PrimaryButton}" />
            <!-- #71: what Windows does when this service crashes (auto-restart, run a program,
                 reboot, ...) - loaded on demand, see ServicesViewModel.LoadFailureActionsAsync. -->
            <Button Grid.Column="6" Content="Recovery actions" Command="{Binding ViewFailureActionsCommand}" />
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ServicesView}"
                  SelectedItem="{Binding SelectedService}">
            <DataGrid.RowStyle>
                <!-- A service whose last start attempt returned a real Win32 error code (not just
                     "currently stopped" - see ServiceRow.HasFailedToStart for why that alone is
                     too noisy a signal) gets tinted and a tooltip explaining the exit code. -->
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFailedToStart}" Value="True">
                            <Setter Property="Background" Value="#1AE81123" />
                            <Setter Property="ToolTip" Value="{Binding ExitCode, StringFormat=Last start attempt failed (exit code {0})}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2.5*" />
                <DataGridTextColumn Header="Service name" Binding="{Binding ServiceName}" Width="1.5*" />
                <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="20" Height="20" Margin="-6,0,2,0">
                                    <!-- Expanding ring: transparent/scale-1 at rest, flashes green and grows on pulse. -->
                                    <Border x:Name="PulseRing" Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource SuccessBrush}" Opacity="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5"
                                            Loaded="PulseRing_Loaded" Unloaded="PulseRing_Unloaded"
                                            DataContextChanged="PulseRing_DataContextChanged">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource ServiceStatusToBrushConverter}}" />
                                </Grid>
                                <TextBlock Text="{Binding Status}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Startup type" Binding="{Binding StartType}" Width="110" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Start" Command="{Binding StartCommand}" />
                    <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                    <MenuItem Header="Restart" Command="{Binding RestartCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- #37: dependency graph for the selected service, so a user understands the blast
             radius before stopping something. -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,24,0" MaxWidth="420">
                    <TextBlock Text="Depends on" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.DependsOn, Converter={StaticResource StringListJoinConverter}}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel MaxWidth="420" Margin="0,0,24,0">
                    <TextBlock Text="Other services depend on this" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.DependentServices, Converter={StaticResource StringListJoinConverter}}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <!-- #71: on-demand recovery-actions text - empty (and collapsed) until the
                     "Recovery actions" button is clicked, see ServicesViewModel. -->
                <StackPanel MaxWidth="420">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.FailureActionsText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Recovery actions" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.FailureActionsText}"
                               TextWrapping="Wrap" FontSize="11.5" FontFamily="Consolas" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</UserControl>
