<UserControl x:Class="TaskManagerPlus.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Plays on the status dot's ring whenever a service's Status actually changes
             (started, stopped, or any other transition) - see ServicesView.xaml.cs. -->
        <Storyboard x:Key="StatusPulse">
            <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                              From="0.6" To="0" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                              From="1" To="3" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                              Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                              From="1" To="3" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="420" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Height="32" />

            <CheckBox Grid.Column="1" Content="Failed to start only" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding FailedToStartOnly}"
                      ToolTip="Show only Automatic services whose last start attempt reported an error" />

            <!-- Round 7 #15 -->
            <CheckBox Grid.Column="2" Content="Show drivers" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding ShowDrivers}"
                      ToolTip="Show kernel/file-system drivers (ServiceController.GetDevices) instead of ordinary Win32 services" />

            <!-- #750: populated only after "Load failure history" runs. -->
            <CheckBox Grid.Column="3" Content="Crash-looping only" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding CrashLoopingOnly}"
                      ToolTip="Show only services that terminated unexpectedly more than a handful of times in the last 24h (requires 'Load failure history')" />

            <!-- #753: populated only after "Run service audit" runs. -->
            <CheckBox Grid.Column="4" Content="Orphaned only" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding OrphanedOnly}"
                      ToolTip="Show only services whose ImagePath resolves to a binary that no longer exists (requires 'Run service audit')" />

            <!-- #761/#762 -->
            <CheckBox Grid.Column="5" Content="Show svchost groups" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0"
                      IsChecked="{Binding ShowSvcHostGroups}"
                      ToolTip="Roll up CPU time/working set/handles/threads per svchost.exe -k group" />

            <Button Grid.Column="6" Content="Start" Margin="0,0,8,0" Command="{Binding StartCommand}" Style="{StaticResource SuccessButton}" />
            <Button Grid.Column="7" Content="Stop" Margin="0,0,8,0" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" />
            <Button Grid.Column="8" Content="Restart" Margin="0,0,8,0" Command="{Binding RestartCommand}" Style="{StaticResource PrimaryButton}" />
            <!-- #71: what Windows does when this service crashes (auto-restart, run a program,
                 reboot, ...) - loaded on demand, see ServicesViewModel.LoadFailureActionsAsync. -->
            <Button Grid.Column="9" Content="Recovery actions" Margin="0,0,8,0" Command="{Binding ViewFailureActionsCommand}" />
            <!-- #756: trigger-start conditions - loaded on demand, see ServicesViewModel.LoadTriggerInfoAsync. -->
            <Button Grid.Column="10" Content="Trigger info" Command="{Binding ViewTriggerInfoCommand}" />
        </Grid>

        <!-- Round 7 #13/#16, #749-754: start-duration history, config-drift baseline actions,
             SCM failure history (#749/#750/#751), and registry inventory audit (#752/#753/#754).
             #192/#193: a crash-loop/start-timeout scan alongside them - same SCM-event-mining shape. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Load start-time history" Margin="0,0,8,4" Command="{Binding LoadStartDurationsCommand}"
                    ToolTip="Mine the System event log's Service Control Manager entries for approximate per-service start durations, plus SCM 7009 start-timeouts (#193)" />
            <Button Content="Scan for crash loops" Margin="0,0,8,4" Command="{Binding ScanCrashLoopsCommand}"
                    ToolTip="Correlate SCM 7000/7009/7024/7031/7034 per service and flag services that crashed and restarted repeatedly (#192)" />
            <Button Content="Capture config baseline" Margin="0,0,8,4" Command="{Binding CaptureConfigBaselineCommand}"
                    ToolTip="Save every service's current StartType/logon account to a JSON file" />
            <Button Content="Check config drift" Margin="0,0,8,4" Command="{Binding CheckConfigDriftCommand}"
                    ToolTip="Compare current StartType/logon accounts against a previously saved baseline" />
            <Button Content="Load failure history" Margin="0,0,8,4" Command="{Binding LoadFailureHistoryCommand}"
                    ToolTip="Mine the System event log's SCM failure/crash events (7000/7001/7009/7011/7022/7023/7024/7031/7034/7043) for a per-service failure timeline, crash-loop count, and dependency root cause" />
            <Button Content="Run service audit" Margin="0,0,16,4" Command="{Binding RunInventoryAuditCommand}"
                    ToolTip="Scan HKLM\SYSTEM\CurrentControlSet\Services for broken dependencies, orphaned binaries, and unquoted paths" />
            <!-- #757 -->
            <Button Content="Audit recovery actions" Margin="0,0,8,4" Command="{Binding RunRecoveryAuditCommand}"
                    ToolTip="Runs sc qfailure across every service, batched off the UI thread, flagging no-recovery-configured, reboot-on-failure, and a missing run-program target" />
            <ProgressBar Width="120" Height="16" Margin="0,0,8,4" Minimum="0" Maximum="100" Value="{Binding RecoveryAuditProgress, Mode=OneWay}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunningRecoveryAudit}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <!-- #759 -->
            <Button Content="Load config changes" Margin="0,0,8,4" Command="{Binding LoadStartTypeChangesCommand}"
                    ToolTip="Mine the System event log's event 7040 (start-type changed) for recent configuration changes" />
            <!-- #760 -->
            <Button Content="Load new installs" Margin="0,0,8,4" Command="{Binding LoadNewServiceInstallsCommand}"
                    ToolTip="Mine the System event log's event 7045 (service installed) for services/drivers new in the last 30 days" />
            <!-- #763 -->
            <Button Content="Diagnose hang" Margin="0,0,16,4" Command="{Binding DiagnoseHangCommand}"
                    ToolTip="Samples the selected service's sc queryex CHECKPOINT twice, ~3s apart, to tell a stuck START_PENDING/STOP_PENDING service from one still making progress" />
            <TextBlock Text="{Binding StartDurationStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
        </WrapPanel>
        <TextBlock Grid.Row="1" Text="{Binding ServicesPipeTimeoutText}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420"
                    Visibility="{Binding ServicesPipeTimeoutText, Converter={StaticResource NullToVisibilityConverter}}" />

        <!-- #192: crash-loop summary card - only the services the scan actually flagged, each with
             its `sc qfailure` recovery settings shown alongside. Collapsed until a scan has run /
             found nothing. -->
        <Border Grid.Row="2" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CrashLoopSummary.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Services crashing and restarting repeatedly" Style="{StaticResource CardTitle}" />
                <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                    <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                    <Run Text="services with 3+ unexpected terminations/start-timeouts in the last 30 days (SCM 7031/7034/7009), with the current recovery (`sc qfailure`) settings for each." />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding CrashLoopSummary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding ServiceName}" />
                                        <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="Last event " /><Run Text="{Binding LastEventTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="{Binding TerminatedCount, Mode=OneWay}" /><Run Text=" termination(s), " />
                                        <Run Text="{Binding TimeoutCount, Mode=OneWay}" /><Run Text=" timeout(s), " />
                                        <Run Text="{Binding FailedToStartCount, Mode=OneWay}" /><Run Text=" failed start(s), " />
                                        <Run Text="{Binding ServiceSpecificExitCodeCount, Mode=OneWay}" /><Run Text=" service-specific exit code(s)." />
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}"
                                                TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding RecoveryActionsText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding CrashLoopStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding ServicesView}"
                  SelectedItem="{Binding SelectedService}">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDrivers}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.RowStyle>
                <!-- A service whose last start attempt returned a real Win32 error code (not just
                     "currently stopped" - see ServiceRow.HasFailedToStart for why that alone is
                     too noisy a signal) gets tinted and a tooltip explaining the exit code. -->
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFailedToStart}" Value="True">
                            <Setter Property="Background" Value="#1AE81123" />
                            <Setter Property="ToolTip" Value="{Binding ExitCode, StringFormat=Last start attempt failed (exit code {0})}" />
                        </DataTrigger>
                        <!-- Round 7 #16: current config no longer matches the loaded baseline. -->
                        <DataTrigger Binding="{Binding HasConfigDrift}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                            <Setter Property="ToolTip" Value="{Binding ConfigDriftText}" />
                        </DataTrigger>
                        <!-- #192: this service crashed and restarted repeatedly - see "Scan for
                             crash loops" above. -->
                        <DataTrigger Binding="{Binding IsCrashLoopingFlagged}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                            <Setter Property="ToolTip" Value="{Binding CrashLoopSummaryText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2.2*" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <!-- #192: crash-loop badge. -->
                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="8" Padding="4,0" Margin="6,0,0,0"
                                        VerticalAlignment="Center" ToolTip="{Binding CrashLoopSummaryText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCrashLoopingFlagged}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="CRASH LOOP" FontSize="{StaticResource FontCaption}" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Service name" Binding="{Binding ServiceName}" Width="1.3*" />
                <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="20" Height="20" Margin="-6,0,2,0">
                                    <!-- Expanding ring: transparent/scale-1 at rest, flashes green and grows on pulse. -->
                                    <Border x:Name="PulseRing" Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource SuccessBrush}" Opacity="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5"
                                            Loaded="PulseRing_Loaded" Unloaded="PulseRing_Unloaded"
                                            DataContextChanged="PulseRing_DataContextChanged">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource ServiceStatusToBrushConverter}}" />
                                </Grid>
                                <TextBlock Text="{Binding Status}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #755: shows "Automatic (Delayed Start, ~120s)" instead of a bare "Automatic"
                     when DelayedAutostart is set - see ServiceRow.StartTypeDisplay. -->
                <DataGridTextColumn Header="Startup type" Binding="{Binding StartTypeDisplay}" Width="160" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                <!-- Round 7 #14: logon account, tinted when it's neither empty (drivers) nor one
                     of the standard built-in service accounts. -->
                <DataGridTemplateColumn Header="Log on as" Width="170" SortMemberPath="LogOnAs">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LogOnAs}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNonStandardAccount}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Round 7 #13: populated only after "Load start-time history" runs. -->
                <DataGridTextColumn Header="Start duration" Binding="{Binding StartDurationText}" Width="1.4*" />
                <!-- #750/#752/#753/#754: quick-flag badges, each populated only after its
                     respective on-demand scan ("Load failure history" / "Run service audit") has
                     run - a clean row shows nothing here rather than an empty placeholder cell. -->
                <DataGridTemplateColumn Header="Flags" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="Crash-looping" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"
                                           ToolTip="{Binding CrashLoopCount24H, StringFormat='Terminated unexpectedly {0} time(s) in the last 24h'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCrashLooping}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Orphaned" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"
                                           ToolTip="{Binding OrphanedImagePath, StringFormat='Points at a missing binary: {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Unquoted path" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           ToolTip="{Binding UnquotedPathCorrected, StringFormat='Corrected: {0}'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnquotedPath}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Broken dependency" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           ToolTip="{Binding BrokenDependencyText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBrokenDependency}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Start" Command="{Binding StartCommand}" />
                    <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                    <MenuItem Header="Restart" Command="{Binding RestartCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Round 7 #15: driver sub-view, shown instead of the grid above while ShowDrivers is on. -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Drivers}">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDrivers}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2.5*" />
                <DataGridTextColumn Header="Driver name" Binding="{Binding ServiceName}" Width="1.5*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Startup type" Binding="{Binding StartType}" Width="110" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- #761/#762: svchost group breakdown sub-view, shown instead of the grid above while
             ShowSvcHostGroups is on. -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSvcHostGroups}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="{StaticResource FontBody}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding SvcHostSplitInfo.CaptionText}" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding SvcHostGroups}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="1.6*" />
                    <DataGridTextColumn Header="Services" Binding="{Binding RunningServiceCount}" Width="80" />
                    <DataGridTextColumn Header="Processes" Binding="{Binding ProcessCount}" Width="90" />
                    <DataGridTextColumn Header="PIDs" Binding="{Binding ProcessIdsText}" Width="1.2*" />
                    <DataGridTextColumn Header="Working set" Binding="{Binding TotalWorkingSetBytes, Converter={StaticResource BytesToReadableConverter}}" Width="110" />
                    <DataGridTextColumn Header="Handles" Binding="{Binding TotalHandleCount}" Width="80" />
                    <DataGridTextColumn Header="Threads" Binding="{Binding TotalThreadCount}" Width="80" />
                    <DataGridTextColumn Header="CPU time" Binding="{Binding CpuTimeText}" Width="90" />
                    <DataGridTextColumn Header="Hosted services" Binding="{Binding RunningServiceNames, Converter={StaticResource StringListJoinConverter}}" Width="2.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- #37: dependency graph for the selected service, so a user understands the blast
             radius before stopping something. -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,24,8" MaxWidth="420">
                    <TextBlock Text="Depends on" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.DependsOn, Converter={StaticResource StringListJoinConverter}}"
                               TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <TextBlock Text="Other services depend on this" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.DependentServices, Converter={StaticResource StringListJoinConverter}}"
                               TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,2,0,0" />
                </StackPanel>
                <!-- #71: on-demand recovery-actions text - empty (and collapsed) until the
                     "Recovery actions" button is clicked, see ServicesViewModel. -->
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.FailureActionsText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Recovery actions" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.FailureActionsText}"
                               TextWrapping="Wrap" FontSize="{StaticResource FontBody}" FontFamily="Consolas" Margin="0,2,0,0" />
                </StackPanel>

                <!-- #756: on-demand trigger-start conditions - empty (and collapsed) until the
                     "Trigger info" button is clicked. -->
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.TriggerInfoText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Trigger-start conditions" Style="{StaticResource SubStat}" />
                    <TextBlock Text="{Binding SelectedService.TriggerInfoText}"
                               TextWrapping="Wrap" FontSize="{StaticResource FontBody}" FontFamily="Consolas" Margin="0,2,0,0" />
                </StackPanel>

                <!-- #752: broken DependOnService reference - visible only once "Run service audit"
                     has flagged this row. -->
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.HasBrokenDependency}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Broken dependency" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding SelectedService.BrokenDependencyText}"
                               TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- #753: orphaned - ImagePath resolves to a binary that no longer exists, with a
                     confirmed sc delete offered right here. -->
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.IsOrphaned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Orphaned - missing binary" Style="{StaticResource SubStat}" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{Binding SelectedService.OrphanedImagePath}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" FontFamily="Consolas" Margin="0,2,0,4" />
                    <Button Content="Delete service…" HorizontalAlignment="Left" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteOrphanedServiceCommand}"
                            ToolTip="Runs sc delete after confirmation" />
                </StackPanel>

                <!-- #754: unquoted service path, with the exact corrected value. -->
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.HasUnquotedPath}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Unquoted service path" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding SelectedService.UnquotedPathOriginal}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" FontFamily="Consolas"
                               Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedService.UnquotedPathCorrected}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" FontFamily="Consolas" Margin="0,2,0,0" />
                </StackPanel>

                <!-- #749/#750/#751: SCM failure history, crash-loop count, and dependency root
                     cause - visible only once "Load failure history" has found something for this
                     row. -->
                <StackPanel MaxWidth="480" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.HasScmEvents}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Failure history (last 30 days)" Style="{StaticResource SubStat}" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <ItemsControl ItemsSource="{Binding SelectedService.ScmEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,0,0,4">
                                        <Run Text="{Binding TimeCreated, StringFormat=g, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding EventLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="{Binding Message, Mode=OneWay}" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Root cause" Style="{StaticResource SubStat}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedService.DependencyRootCauseText}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- #758: editable recovery actions - a small form rather than raw sc.exe syntax,
                     with a confirmation dialog showing the exact command. Hidden for a protected
                     core service (see ServiceControlService.ProtectedCoreServiceNames). -->
                <StackPanel MaxWidth="360" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.IsProtectedCore}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Recovery actions (editable)" Style="{StaticResource SubStat}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="First failure:" VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Margin="0,0,8,4" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:ServicesViewModel.RecoveryActionOptions}"
                                  SelectedItem="{Binding RecoveryFirstFailureAction}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Second failure:" VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Margin="0,0,8,4" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:ServicesViewModel.RecoveryActionOptions}"
                                  SelectedItem="{Binding RecoverySecondFailureAction}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Subsequent failures:" VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Margin="0,0,8,4" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" ItemsSource="{x:Static vm:ServicesViewModel.RecoveryActionOptions}"
                                  SelectedItem="{Binding RecoverySubsequentFailureAction}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Reset period (days):" VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Margin="0,0,8,4" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Text="{Binding RecoveryResetPeriodDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Restart delay (s):" VerticalAlignment="Center" FontSize="{StaticResource FontBody}" Margin="0,0,8,4" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Text="{Binding RecoveryRestartDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Button Content="Save recovery actions…" HorizontalAlignment="Left" Margin="0,4,0,0" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveRecoveryActionsCommand}"
                            ToolTip="Runs sc failure with the exact command shown in a confirmation dialog first" />
                </StackPanel>

                <!-- #763: hung-service diagnosis + a confirmed force-kill of the host process. -->
                <StackPanel MaxWidth="420" Margin="0,0,24,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedService.HangDiagnosisText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Hang diagnosis" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding SelectedService.HangDiagnosisText}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,2,0,4" />
                    <Button Content="Force-end host process…" HorizontalAlignment="Left" Style="{StaticResource DangerButton}"
                            Command="{Binding ForceKillHostProcessCommand}"
                            ToolTip="Kills the process currently hosting this service - confirmed first" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- #757: bulk recovery-action audit results, shown only once at least one outlier has
             been found. -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecoveryAuditResults.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Recovery action audit - outliers" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                <DataGrid Height="140" ItemsSource="{Binding RecoveryAuditResults}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1.5*" />
                        <DataGridTextColumn Header="Outlier(s)" Binding="{Binding SummaryText}" Width="3*" />
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Go to" Padding="8,2" Command="{Binding DataContext.JumpToRecoveryAuditServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- #759/#760: recent start-type changes (event 7040) and newly installed services/drivers
             (event 7045) - each shown only once loaded and non-empty. -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentConfigChanges.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Recent configuration changes (event 7040)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <DataGrid Height="160" ItemsSource="{Binding RecentConfigChanges}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding TimeCreated, StringFormat=g}" Width="1.3*" />
                            <DataGridTextColumn Header="Service" Binding="{Binding DisplayName}" Width="1.6*" />
                            <DataGridTextColumn Header="Old" Binding="{Binding OldStartType}" Width="*" />
                            <DataGridTextColumn Header="New" Binding="{Binding NewStartType}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="12,8" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NewServiceInstalls.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="New services/drivers, last 30 days (event 7045)" Style="{StaticResource SubStat}" Margin="0,0,0,6" />
                    <DataGrid Height="160" ItemsSource="{Binding NewServiceInstalls}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding TimeCreated, StringFormat=g}" Width="1.1*" />
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1.3*" />
                            <DataGridTextColumn Header="Signature" Binding="{Binding SignatureStatus}" Width="80" />
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*" />
                            <DataGridTextColumn Header="Image path" Binding="{Binding ImagePath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
    </ScrollViewer>
</UserControl>
