<UserControl x:Class="TaskManagerPlus.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:models="clr-namespace:TaskManagerPlus.Models"
             d:DataContext="{d:DesignInstance Type=vm:TimelineViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- #938: one marker on a lane's track - a small colored dot, clickable (#945's "Details"
             action - a click rather than a right-click context menu, since a context menu is hard
             to land precisely on an 8-10px dot; see ShowMarkerDetailCommand). -->
        <DataTemplate x:Key="TimelineMarkerTemplate" DataType="{x:Type models:TimelineEvent}">
            <Button Width="14" Height="14" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding DataContext.ShowMarkerDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:g}}" FontSize="11" Opacity="0.8" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Source}" FontSize="10.5" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="11" Height="11" StrokeThickness="1" Stroke="{DynamicResource BorderSubtleBrush}"
                                 Fill="{Binding Converter={StaticResource TimelineEventBrushConverter}}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- One lane row: display name + event count on the left, its horizontal marker track on
             the right, positioned via TimelineMarkerPositionConverter against the view-model's
             currently resolved WindowStartLocal/WindowEndLocal/TrackWidthPx. -->
        <DataTemplate x:Key="TimelineLaneRowTemplate" DataType="{x:Type vm:TimelineLaneRow}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}">
                        <Run Text="{Binding Events.Count, Mode=OneWay}" /><Run Text=" total" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BgElevatedBrush}" CornerRadius="4" Height="26" ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource TimelineMarkerTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding DataContext.TrackWidthPx, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Top" Value="7" />
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource TimelineMarkerPositionConverter}">
                                            <Binding Path="Timestamp" />
                                            <Binding Path="DataContext.WindowStartLocal" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.WindowEndLocal" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.TrackWidthPx" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- HideTimelineCommand lives on TroubleshootViewModel, not this view's own
                     TimelineViewModel DataContext - TimelineView is itself a UserControl nested
                     inside TroubleshootView, so AncestorType=UserControl's default AncestorLevel=1
                     would resolve to this view; AncestorLevel=2 skips past it to TroubleshootView. -->
                <Button Grid.Column="0" Content="&#8592; Back"
                        Command="{Binding DataContext.HideTimelineCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                        Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Timeline" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Export range" Padding="10,4" Margin="0,0,8,0"
                        Command="{Binding ExportRangeCommand}" />
                <Button Grid.Column="3" Content="Refresh" Padding="10,4" Command="{Binding LoadCommand}" />
            </Grid>

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Loading…" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- #944: coincidence-count findings, explicitly worded as "not a confirmed cause" -
                 see TimelineService.ComputeCorrelations' remarks. -->
            <ItemsControl ItemsSource="{Binding CorrelationFindings}" Margin="0,0,0,4">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CorrelationFindings.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- #948: lane visibility + date-range preset, persisted to timeline-view.json. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Filters" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding Lanes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineLaneRow}">
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsVisible}" Margin="0,0,16,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Range:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubStat}" />
                        <ItemsControl ItemsSource="{x:Static vm:TimelineViewModel.RangePresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineRangePresetOption}">
                                    <Button Content="{Binding Label}" Padding="10,4" Margin="0,0,6,0"
                                            Command="{Binding DataContext.SelectRangePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource SubStat}">
                            <Run Text="Active: " /><Run Text="{Binding RangePreset, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Correlation window (hours):" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubStat}" />
                        <TextBox Width="60" Text="{Binding CorrelationWindowHours, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!-- #946: "the resolved start/end shown as explicit copyable text" - a plain
                         TextBlock's text can't be selected/copied in WPF, so this is a read-only
                         TextBox instead (selectable, Ctrl+C-able) rather than a label. -->
                    <TextBox Text="{Binding WindowRangeText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Margin="0,10,0,0" Padding="0" FontSize="12" FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <!-- #938: the lane visualization itself. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Lanes" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Lanes}" ItemTemplate="{StaticResource TimelineLaneRowTemplate}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #947: "Mark now" + a plain text+date form - a simple inline form rather than a
                 right-click-at-position/modal dialog, given the lane visualization approach above. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Notes" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mark now" Padding="10,4" Margin="0,0,10,0" Command="{Binding MarkNowCommand}" />
                        <DatePicker SelectedDate="{Binding NewNoteDate}" Width="130" Margin="0,0,10,0" />
                        <TextBox Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,10,0" />
                        <Button Content="Add note" Padding="10,4" Command="{Binding AddNoteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #945: "what happened right before this?" - filtered detail list around one
                 selected marker, with a window picker. -->
            <Border Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedMarker}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Margin="0">
                            <Run Text="What happened around " /><Run Text="{Binding SelectedMarker.Title, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="1" Content="Close" Padding="10,4" Command="{Binding CloseMarkerDetailCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SelectedMarker.Timestamp, StringFormat={}{0:g}}" Style="{StaticResource SubStat}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Window:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubStat}" />
                        <ItemsControl ItemsSource="{x:Static vm:TimelineViewModel.DetailWindowOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineDetailWindowOption}">
                                    <Button Content="{Binding Label}" Padding="10,4" Margin="0,0,6,0"
                                            Command="{Binding DataContext.SelectDetailWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Hours}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding AroundSelectedMarker}" Height="200" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTextColumn Header="Lane" Binding="{Binding LaneDisplayName}" Width="110" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- #946: linked detail table - exactly the events in the currently resolved window,
                 across currently visible lanes. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Events in range" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding FilteredEvents}" Height="280" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Detail}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTextColumn Header="Lane" Binding="{Binding LaneDisplayName}" Width="120" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.4*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No events in this window - widen the date range or enable more lanes." Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
