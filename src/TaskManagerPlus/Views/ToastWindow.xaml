<Window x:Class="TaskManagerPlus.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="86" Width="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1" CornerRadius="10" Padding="14,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource WarningBrush}" />
                <TextBlock x:Name="TitleTextBlock" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageTextBlock" Margin="0,6,0,0" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Border>
</Window>
