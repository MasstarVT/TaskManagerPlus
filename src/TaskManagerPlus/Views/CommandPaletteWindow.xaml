<Window x:Class="TaskManagerPlus.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
        xmlns:models="clr-namespace:TaskManagerPlus.Models"
        d:DataContext="{d:DesignInstance Type=vm:GlobalSearchViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Command palette" Height="440" Width="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True"
        Deactivated="OnDeactivated">
    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}"
            BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Search everything - tabs, findings, rules, remediation actions, glossary terms, timeline events, processes, services, startup items, drivers, software, USB devices"
                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBox Grid.Row="1" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{StaticResource FontTitle}" Padding="8,6" Margin="0,0,0,10" KeyDown="SearchBox_KeyDown"
                     AutomationProperties.Name="Command palette search box" />

            <ListBox Grid.Row="2" x:Name="ResultsList" ItemsSource="{Binding Results}"
                     BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SearchResult}">
                        <StackPanel Margin="4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Category}" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="Type at least 2 characters to search." VerticalAlignment="Top" Margin="4,10,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasQuery}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</Window>
