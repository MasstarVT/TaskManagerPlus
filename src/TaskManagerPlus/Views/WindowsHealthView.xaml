<UserControl x:Class="TaskManagerPlus.Views.WindowsHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:WindowsHealthViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Sections. This tab already marked its own groupings with all-caps TextBlock headers
         (INTEGRITY, RECOVERY, WMI, REGISTRY, ENVIRONMENT) inside one long scroll - those headers are
         now the chips, so the standalone title lines are gone. The four single-card groups at the
         end are merged into one System state page rather than becoming four one-item chips. -->
    <TabControl Style="{StaticResource SectionTabControl}" SelectedIndex="0">
        <TabItem Header="Overview">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Windows Health" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSection}" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" />
                    </Grid>
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding RefreshErrorText, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Text="{Binding RefreshErrorText}" />
                    </Border>
                    <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Text="{Binding StatusMessage}" />
                    </Border>
                    <!-- #800: activation, build lifecycle and upgrade-readiness roll-up - the tab's other
                         top card (loads automatically alongside #774's pending-reboot panel below - see
                         WindowsHealthViewModel's constructor remarks for why this one's cheap enough to). -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Activation &amp; upgrade readiness" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Visibility="{Binding UpgradeReadiness, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpgradeReadiness.ReadyForNextFeatureUpdate}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Ready for next feature update" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpgradeReadiness.ReadyForNextFeatureUpdate}" Value="False">
                                                        <Setter Property="Text" Value="Blocked" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <TextBlock Text="Loading…" Style="{StaticResource SubStat}" Visibility="{Binding IsLoadingUpgradeReadiness, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Visibility="{Binding UpgradeReadiness, Converter={StaticResource NullToVisibilityConverter}}">
                                <UniformGrid Columns="3" Margin="0,4,0,10">
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="EDITION / BUILD" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}">
                                            <Run Text="{Binding UpgradeReadiness.EditionText, Mode=OneWay}" />
                                            <Run Text=" - build " /><Run Text="{Binding UpgradeReadiness.BuildText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="VERSION" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.DisplayVersionText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="LICENSE STATUS" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.Activation.LicenseStatusText}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="EDITION DESCRIPTION" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.Activation.Description}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="LICENSE FAMILY" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.Activation.LicenseFamily}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PRODUCT KEY CHANNEL" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.Activation.ProductKeyChannel}" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="3" Margin="0,0,0,10" Visibility="{Binding UpgradeReadiness.Activation.GracePeriodRemaining, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="GRACE PERIOD REMAINING" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Foreground="{DynamicResource DangerBrush}" Text="{Binding UpgradeReadiness.Activation.GracePeriodRemaining.Value.TotalHours, StringFormat={}{0:0} hour(s)}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontSize="{StaticResource FontBody}"
                                            Visibility="{Binding UpgradeReadiness.Activation.KmsHost, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text="KMS host: " /><Run Text="{Binding UpgradeReadiness.Activation.KmsHost, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  ·  renewal every " /><Run Text="{Binding UpgradeReadiness.Activation.KmsRenewalIntervalMinutes, Mode=OneWay}" /><Run Text=" minute(s)" />
                                </TextBlock>

                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                            <Run Text="End of servicing: " FontWeight="SemiBold" />
                                            <Run Text="{Binding UpgradeReadiness.EndOfServicing.ReleaseName, Mode=OneWay, TargetNullValue='Unknown build - not in the bundled table'}" />
                                        </TextBlock>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding UpgradeReadiness.EndOfServicing, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Stopped/stops receiving security updates on " /><Run Text="{Binding UpgradeReadiness.EndOfServicing.EndOfServicingDate, StringFormat={}{0:d}, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Text="{Binding UpgradeReadiness.ServicingStackVersionText}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="UPGRADE-READINESS CHECK" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="TPM" Style="{StaticResource SpecLabel}" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                                    <Setter Property="Text" Value="Unknown" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpgradeReadiness.TpmReady}" Value="True">
                                                            <Setter Property="Text" Value="Ready" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UpgradeReadiness.TpmReady}" Value="False">
                                                            <Setter Property="Text" Value="Not ready" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,8">
                                        <TextBlock Text="SECURE BOOT" Style="{StaticResource SpecLabel}" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                                    <Setter Property="Text" Value="Unknown" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpgradeReadiness.SecureBootEnabled}" Value="True">
                                                            <Setter Property="Text" Value="Enabled" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UpgradeReadiness.SecureBootEnabled}" Value="False">
                                                            <Setter Property="Text" Value="Disabled" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="SYSTEM DISK" Style="{StaticResource SpecLabel}" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SpecValue}">
                                                    <Setter Property="Text" Value="GPT" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpgradeReadiness.SystemDiskIsMbr}" Value="True">
                                                            <Setter Property="Text" Value="MBR" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="SYSTEM DRIVE FREE" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.SystemDriveFreeBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ESP FREE SPACE" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpgradeReadiness.EspFreeBytes, Converter={StaticResource BytesToReadableConverter}, TargetNullValue='Not measured'}" />
                                        <!-- #800: measuring free space briefly mounts the ESP - opt-in only,
                                             same "manual button, never automatic" rule the Startup tab's
                                             own #738 ESP card already follows for this exact operation. -->
                                        <Button Command="{Binding MeasureEspForReadinessCommand}" Padding="6,2" FontSize="{StaticResource FontCaption}" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding UpgradeReadiness.EspFound, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Measure ESP free space" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoadingUpgradeReadiness}" Value="True">
                                                                <Setter Property="Text" Value="Measuring…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </UniformGrid>

                                <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpgradeReadiness.ReadyForNextFeatureUpdate}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ItemsControl ItemsSource="{Binding UpgradeReadiness.BlockingItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,3" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="A quick flag, not a verdict - CPU/RAM minimums and OEM-specific blockers aren't checked here." Style="{StaticResource SubStat}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #774: pending-reboot detail panel - top card of the tab. Turns
                         SystemSpecsService.ReadRebootPending's single bool into a per-indicator list, each
                         with a plain-language detail and (where readable) the key's own last-write time -
                         see WindowsUpdatePolicyService.ReadRebootPendingDetail. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pending reboot" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRebootPending}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="No reboot pending" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRebootPending}" Value="True">
                                                        <Setter Property="Text" Value="Reboot pending" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Every well-known reboot-pending indicator, checked individually - CBS servicing, Windows Update, queued file renames, a pending computer rename, a pending domain join, and an installer's own volatile-update flag." />
                            <ItemsControl ItemsSource="{Binding RebootPendingIndicators}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,3,10,0" VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Detail}" />
                                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                                           Visibility="{Binding LastWriteTime, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="Key last written " /><Run Text="{Binding LastWriteTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Updates">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #769/#771/#772: Update history - Windows Update Client install/download/failure
                         events (Microsoft-Windows-WindowsUpdateClient/Operational), correlated against the
                         Setup servicing channel and described via the shared offline error catalog. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Update history" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-4,0,10"
                                       Text="Install/download successes and failures from the Windows Update client log, last 180 days - covers driver, definition and feature updates that Win32_QuickFixEngineering (the System tab's hotfix list) never sees." />
                            <DataGrid ItemsSource="{Binding UpdateEvents}" Height="340" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding RawMessage}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTemplateColumn Header="Event" Width="150" SortMemberPath="Kind">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Kind}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                                    <DataGridTextColumn Header="Error" Binding="{Binding ErrorCode}" Width="110" />
                                    <DataGridTemplateColumn Header="Cause / fix" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ErrorDescription}" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ErrorDescription}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No Windows Update client history found in the last 180 days." Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- #771: a failed KB's row above shows its ErrorCode/Cause-fix from the WU
                                 client log; ServicingCorrelationText (row tooltip already shows the full
                                 WU-client message - this line adds the Setup-channel's own package/error
                                 when one was correlated nearby) is shown per-row below the grid instead of
                                 a further column, since it's only ever populated for a minority of rows. -->
                            <ItemsControl ItemsSource="{Binding UpdateEvents}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                                                Visibility="{Binding ServicingCorrelationText, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                                <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding ServicingCorrelationText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #775: "why has this PC not had an update in 8 months" - pause/defer/policy audit. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Update pause, defer &amp; policy audit" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Resume updates" Command="{Binding ResumeUpdatesCommand}" Padding="10,4" FontSize="{StaticResource FontBody}"
                                        Visibility="{Binding UpdatePolicy.IsPausedNow, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Text="{Binding UpdatePolicy.SummaryText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,12" />

                            <UniformGrid Columns="3" Rows="3">
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="PAUSE EXPIRES" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.PauseUpdatesExpiryTime, StringFormat={}{0:g}, TargetNullValue=Not set}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="FEATURE UPDATES PAUSED UNTIL" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.PauseFeatureUpdatesEnd, StringFormat={}{0:g}, TargetNullValue=Not set}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="QUALITY UPDATES PAUSED UNTIL" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.PauseQualityUpdatesEnd, StringFormat={}{0:g}, TargetNullValue=Not set}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="ACTIVE HOURS" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}">
                                        <Run Text="{Binding UpdatePolicy.ActiveHoursStart, TargetNullValue=?, Mode=OneWay}" />
                                        <Run Text=" – " /><Run Text="{Binding UpdatePolicy.ActiveHoursEnd, TargetNullValue=?, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="AUTOMATIC UPDATES DISABLED" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.NoAutoUpdate}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="FEATURE UPDATE DEFERRAL" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.DeferFeatureUpdatesPeriodInDays, StringFormat={}{0} day(s), TargetNullValue=Not set}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="QUALITY UPDATE DEFERRAL" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.DeferQualityUpdatesPeriodInDays, StringFormat={}{0} day(s), TargetNullValue=Not set}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="TARGET RELEASE" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.TargetReleaseVersionInfo, TargetNullValue=Not set}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="WSUS SERVER" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdatePolicy.WuServer, TargetNullValue=Not set}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </UniformGrid>

                            <!-- #776: WSUS/WUfB reachability check - only offered when a WUServer policy
                                 value is actually set. A plain HTTP GET/HEAD, on demand only (network call). -->
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding UpdatePolicy.WuServer, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Is the WSUS server reachable?" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Grid.Column="1" Command="{Binding CheckWuServerReachabilityCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Check reachability" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCheckingWuServerReachability}" Value="True">
                                                            <Setter Property="Text" Value="Checking…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                                <Border CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                                        Visibility="{Binding WuServerReachability, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WuServerReachability.IsReachable}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WuServerReachability.IsReachable}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding WuServerReachability.StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #770: servicing package state table - dism /online /get-packages, on demand
                         (a full package-store enumeration can take several seconds). -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Servicing packages" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadServicingPackagesCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Load servicing packages" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingPackages}" Value="True">
                                                        <Setter Property="Text" Value="Loading…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Every installed servicing package and its state (Installed, Install Pending, Uninstall Pending, Superseded, Failed) - dism /online /get-packages /format:table. Install Pending/Failed entries are flagged." />
                            <DataGrid ItemsSource="{Binding ServicingPackages}" Height="260" IsReadOnly="True"
                                      Visibility="{Binding HasLoadedPackages, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Package identity" Binding="{Binding PackageIdentity}" Width="3*" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No packages loaded yet." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasLoadedPackages}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #773: feature-update failure analysis - on demand, hidden (a brief "not found"
                         line instead of a full card) when no upgrade logs exist on this machine. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Feature-update failure analysis" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding CheckFeatureUpdateFailureCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Check for failure logs" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingFeatureUpdateFailure}" Value="True">
                                                        <Setter Property="Text" Value="Checking…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Parses setuperr.log/setupact.log from a failed in-place upgrade for the failing phase and rollback reason, and offers to run SetupDiag.exe when it's present on this machine." />

                            <TextBlock Text="Not checked yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FeatureUpdateFailure}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding FeatureUpdateFailure, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="No feature-update failure logs found on this machine.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FeatureUpdateFailure.LogsFound}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Visibility="{Binding FeatureUpdateFailure.LogsFound, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap">
                                        <Run Text="Source: " /><Run Text="{Binding FeatureUpdateFailure.SourceLogPath, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="FAILING PHASE" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" TextWrapping="Wrap" Text="{Binding FeatureUpdateFailure.FailingPhase, TargetNullValue=Not found}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="ROLLBACK REASON" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" TextWrapping="Wrap" Text="{Binding FeatureUpdateFailure.RollbackReason, TargetNullValue=Not found}" />
                                    </StackPanel>

                                    <TextBlock Text="MOUPG ERROR LINES" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding FeatureUpdateFailure.MoupgErrorLines}" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding}" Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Command="{Binding RunSetupDiagCommand}" Padding="10,4" FontSize="{StaticResource FontBody}"
                                            HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Visibility="{Binding FeatureUpdateFailure.SetupDiagAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Run SetupDiag" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunningSetupDiag}" Value="True">
                                                            <Setter Property="Text" Value="Running…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <StackPanel Visibility="{Binding FeatureUpdateFailure.SetupDiagVerdict, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="SETUPDIAG VERDICT" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="{StaticResource FontBody}"
                                                   Text="{Binding FeatureUpdateFailure.SetupDiagVerdict}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #777: update service-stack health check - start type/state for every service
                         Windows Update itself depends on, with a one-click restore-to-defaults and a
                         cross-link over to the Services tab. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Update service-stack health" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadUpdateServiceStackHealthCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Check services" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingUpdateServiceStackHealth}" Value="True">
                                                        <Setter Property="Text" Value="Checking…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="2" Content="Restore defaults" Command="{Binding RestoreUpdateServiceStackDefaultsCommand}" Padding="10,4" FontSize="{StaticResource FontBody}"
                                        Visibility="{Binding HasFlaggedUpdateServices, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Start type and current state for wuauserv, BITS, CryptSvc, msiserver, TrustedInstaller, UsoSvc, WaaSMedicSvc and DoSvc - a Disabled entry silently breaks updates, the same way an unreachable WSUS server above does." />
                            <ItemsControl ItemsSource="{Binding UpdateServiceStackHealth}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontStrong}" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontBody}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StartTypeText}" />
                                            <TextBlock Grid.Column="3" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Not checked yet." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLoadedUpdateServiceStackHealth}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="View services tab" HorizontalAlignment="Left" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,10,0,0"
                                    Click="ViewUpdateServicesInServices_Click"
                                    Visibility="{Binding HasFlaggedUpdateServices, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <!-- #778: guided "reset Windows Update components" - the documented repair sequence,
                         run as one explicit, confirmed, step-logged action. Never automatic. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Reset Windows Update components" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ResetWindowsUpdateComponentsCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run reset" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResettingWuComponents}" Value="True">
                                                        <Setter Property="Text" Value="Running…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Stops wuauserv/CryptSvc/BITS/msiserver, renames SoftwareDistribution and catroot2 to .bak, then restarts the services - the standard repair for updates that fail to install no matter what. Guided and confirmed: nothing here runs on a schedule or without the exact steps shown first." />
                            <ItemsControl ItemsSource="{Binding ResetWuComponentsLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding}" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #779: update cache reclaim - reports the two SoftwareDistribution cache folder
                         sizes, with a confirmed clear action. Cross-linked to the Storage tab. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Update cache reclaim" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding CheckUpdateCacheSizeCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Check cache size" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingUpdateCacheInfo}" Value="True">
                                                        <Setter Property="Text" Value="Checking…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding ClearUpdateCacheCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Clear caches" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClearingUpdateCache}" Value="True">
                                                        <Setter Property="Text" Value="Clearing…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Sizes of the WU download cache and the Delivery Optimization cache under SoftwareDistribution - routinely the largest reclaimable chunk of space on a machine that's run Windows Update for a while." />

                            <StackPanel Visibility="{Binding UpdateCacheInfo, Converter={StaticResource NullToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="DOWNLOAD CACHE" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdateCacheInfo.DownloadCacheSizeBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Text="{Binding UpdateCacheInfo.DownloadCachePath}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="DELIVERY OPTIMIZATION CACHE" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding UpdateCacheInfo.DeliveryOptimizationCacheSizeBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Text="{Binding UpdateCacheInfo.DeliveryOptimizationCachePath}" />
                                    </StackPanel>
                                </UniformGrid>
                                <Button Content="View in Storage" HorizontalAlignment="Left" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,0,10"
                                        Click="ViewCacheInStorage_Click" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ClearUpdateCacheLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding}" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #780: uninstall a specific update - combines QFE hotfixes and DISM "Installed"
                         packages into one removable-updates list, each row offering a confirmed uninstall. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Uninstall a specific update" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadRemovableUpdatesCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="List removable updates" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingRemovableUpdates}" Value="True">
                                                        <Setter Property="Text" Value="Loading…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Every removable update - KB-numbered hotfixes (Win32_QuickFixEngineering, removable via wusa) and DISM servicing packages in the Installed state (removable via dism /remove-package). Uninstall is confirmed and shows the exact command; a reboot may be required afterwards." />
                            <DataGrid ItemsSource="{Binding RemovableUpdates}" Height="260" IsReadOnly="True"
                                      Visibility="{Binding HasLoadedRemovableUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Update" Binding="{Binding DisplayName}" Width="3*" />
                                    <DataGridTextColumn Header="Installed" Binding="{Binding InstalledOn, StringFormat={}{0:d}, TargetNullValue=Unknown}" Width="110" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" />
                                    <DataGridTemplateColumn Header="" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Uninstall" Padding="8,2" FontSize="{StaticResource FontBody}"
                                                        Command="{Binding DataContext.UninstallUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No removable updates loaded yet." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLoadedRemovableUpdates}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Integrity">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #782/#783: component store analysis + cleanup runner. Analysis and cleanup live in
                         one card since the analysis card's own numbers are exactly what a cleanup decision is
                         made from. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Component store (WinSxS)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding AnalyzeComponentStoreCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Analyze component store" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAnalyzingComponentStore}" Value="True">
                                                        <Setter Property="Text" Value="Analyzing…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="dism /online /cleanup-image /analyzecomponentstore - actual WinSxS size, how much is shared with Windows itself, backups/disabled features, cache/temp data, and DISM's own cleanup recommendation." />

                            <TextBlock Text="Not analyzed yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DismComponentStoreAnalysis}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding DismComponentStoreAnalysis, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DismComponentStoreAnalysis.Success}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding DismComponentStoreAnalysis.ErrorText}" />
                                </Border>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="ACTUAL SIZE" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding DismComponentStoreAnalysis.ActualSizeText, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="SHARED WITH WINDOWS" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding DismComponentStoreAnalysis.SharedWithWindowsText, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Text="BACKUPS &amp; DISABLED FEATURES" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding DismComponentStoreAnalysis.BackupsAndDisabledFeaturesText, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="CACHE &amp; TEMP DATA" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding DismComponentStoreAnalysis.CacheAndTempDataText, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="DATE OF LAST CLEANUP" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding DismComponentStoreAnalysis.DateOfLastCleanupText, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,0">
                                        <TextBlock Text="RECLAIMABLE PACKAGES" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding DismComponentStoreAnalysis.ReclaimablePackageCount, TargetNullValue=Unknown}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Border CornerRadius="8" Padding="10,6" Margin="0,4,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DismComponentStoreAnalysis.CleanupRecommended}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Text" Value="Component Store Cleanup Recommended: Unknown" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DismComponentStoreAnalysis.CleanupRecommended}" Value="True">
                                                        <Setter Property="Text" Value="Component Store Cleanup Recommended: Yes" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DismComponentStoreAnalysis.CleanupRecommended}" Value="False">
                                                        <Setter Property="Text" Value="Component Store Cleanup Recommended: No" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Button Command="{Binding ToggleComponentStoreRawOutputCommand}"
                                        HorizontalAlignment="Left" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,0,8">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Show details ▾" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowComponentStoreRawOutput}" Value="True">
                                                        <Setter Property="Text" Value="Hide details ▴" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        CornerRadius="6" Padding="10" Margin="0,0,0,10" MaxHeight="260"
                                        Visibility="{Binding ShowComponentStoreRawOutput, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock FontFamily="Consolas" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DismComponentStoreAnalysis.RawOutput}" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,14" />

                            <TextBlock Text="Component store cleanup" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Plain cleanup removes superseded component versions and is reversible. /ResetBase goes further and is PERMANENT - see its own confirmation before running it." />

                            <WrapPanel Margin="0,0,0,6">
                                <Button Command="{Binding RunComponentCleanupCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,6">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run cleanup (reversible)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCleaningComponentStore}" Value="True">
                                                        <Setter Property="Text" Value="Cleaning…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding RunComponentCleanupResetBaseCommand}" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,6">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run /ResetBase (PERMANENT)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResetBaseRunning}" Value="True">
                                                        <Setter Property="Text" Value="Running…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding CancelComponentCleanupCommand}" Content="Cancel" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCleaningComponentStore}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsResetBaseRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- #790 cross-reference: creating a restore point first is suggested (and
                                     re-stated in the /ResetBase confirmation dialog itself) as a pre-step
                                     before this card's destructive action - this reuses the exact same
                                     CreateRestorePointCommand the Recovery section's own button below runs. -->
                                <Button Command="{Binding CreateRestorePointCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,0,6"
                                        ToolTip="Runs the same action as the Recovery section's &quot;Create a restore point&quot; button below - a reasonable pre-step before either cleanup action.">
                                    <TextBlock Text="Create a restore point first" />
                                </Button>
                            </WrapPanel>

                            <ProgressBar Minimum="0" Maximum="100" Height="14" Margin="0,0,0,8" Value="{Binding CleanupProgressPercent, Mode=OneWay}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCleaningComponentStore}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsResetBaseRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6"
                                    Visibility="{Binding CleanupResultText, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock FontFamily="Consolas" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding CleanupResultText}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- #784/#785: DISM health scan trio (CheckHealth/ScanHealth/RestoreHealth), each its
                         own on-demand action with its difference explained inline, plus RestoreHealth's own
                         repair-source picker for the 0x800f081f "needs a source" case. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="DISM health scan" Style="{StaticResource CardTitle}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="CheckHealth" />
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="Instant - reads a stored corruption flag, doesn't scan anything new." />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RunCheckHealthCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" VerticalAlignment="Center">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run CheckHealth" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheckingHealth}" Value="True">
                                                        <Setter Property="Text" Value="Checking…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <StackPanel Margin="0,0,0,14" Visibility="{Binding CheckHealthResult, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border CornerRadius="6" Padding="10,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CheckHealthResult.Success}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Text="{Binding CheckHealthResult.Summary}" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="ScanHealth" />
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="A real scan of the component store for corruption - can take several minutes." />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RunScanHealthCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run ScanHealth" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanningHealth}" Value="True">
                                                        <Setter Property="Text" Value="Scanning…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding CancelScanHealthCommand}" Content="Cancel" Padding="10,4" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                        Visibility="{Binding IsScanningHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Height="14" Margin="0,0,0,8" Value="{Binding ScanHealthProgressPercent, Mode=OneWay}"
                                         Visibility="{Binding IsScanningHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel Margin="0,0,0,14" Visibility="{Binding ScanHealthResult, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border CornerRadius="6" Padding="10,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScanHealthResult.Success}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Text="{Binding ScanHealthResult.Summary}" />
                                </Border>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding ScanHealthResult.DismLogTail, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="DISM.LOG TAIL (failure)" Style="{StaticResource SpecLabel}" Foreground="{DynamicResource DangerBrush}" />
                                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding ScanHealthResult.DismLogTail}" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="RestoreHealth" />
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="Attempts an actual repair, downloading replacement files from Windows Update unless a local repair source is picked below." />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RunRestoreHealthCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run RestoreHealth" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRestoringHealth}" Value="True">
                                                        <Setter Property="Text" Value="Repairing…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding CancelRestoreHealthCommand}" Content="Cancel" Padding="10,4" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"
                                        Visibility="{Binding IsRestoringHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Height="14" Margin="0,0,0,8" Value="{Binding RestoreHealthProgressPercent, Mode=OneWay}"
                                         Visibility="{Binding IsRestoringHealth, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel Visibility="{Binding RestoreHealthResult, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RestoreHealthResult.Success}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Text="{Binding RestoreHealthResult.Summary}" />
                                </Border>
                                <StackPanel Margin="0,0,0,10" Visibility="{Binding RestoreHealthResult.DismLogTail, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="DISM.LOG TAIL (failure)" Style="{StaticResource SpecLabel}" Foreground="{DynamicResource DangerBrush}" />
                                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="10" MaxHeight="200">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding RestoreHealthResult.DismLogTail}" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <!-- #785: repair-source picker - only surfaced once RestoreHealth actually
                                     failed with 0x800f081f asking for one. -->
                                <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding RestoreHealthResult.NeedsRepairSource, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Margin="0,0,0,4" Text="Repair source needed (0x800f081f)" />
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Text="Mount a matching Windows ISO, then browse to its sources\install.wim or sources\install.esd. Pick the image index whose edition matches this PC, then retry." />
                                        <Button Command="{Binding BrowseRepairSourceCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" HorizontalAlignment="Left" Margin="0,0,0,8">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Browse for repair source…" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoadingRepairSourceImages}" Value="True">
                                                                <Setter Property="Text" Value="Reading image indexes…" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding RepairSourceWimPath, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Source: " /><Run Text="{Binding RepairSourceWimPath, Mode=OneWay}" />
                                        </TextBlock>

                                        <DataGrid ItemsSource="{Binding RepairSourceImages}" SelectedItem="{Binding SelectedRepairSourceImage}"
                                                  Height="140" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="50" />
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Command="{Binding RetryRestoreHealthWithSourceCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" HorizontalAlignment="Left"
                                                Content="Retry RestoreHealth with this source" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #786: sfc /scannow with CBS.log [SR]-line parsing - a results grid of repaired vs.
                         unrepairable files, not just the one-line verdict. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="System File Checker (sfc /scannow)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding RunSfcScanCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run sfc /scannow" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunningSfcScan}" Value="True">
                                                        <Setter Property="Text" Value="Scanning…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding CancelSfcScanCommand}" Content="Cancel" Padding="10,4" FontSize="{StaticResource FontBody}"
                                        Visibility="{Binding IsRunningSfcScan, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Verifies protected system files and repairs any that don't match the known-good version, then parses CBS.log's own [SR] lines for exactly which files were repaired or couldn't be. Can take 10-20+ minutes on a full scan." />

                            <ProgressBar Minimum="0" Maximum="100" Height="14" Margin="0,0,0,10" Value="{Binding SfcProgressPercent, Mode=OneWay}"
                                         Visibility="{Binding IsRunningSfcScan, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Visibility="{Binding SfcScanResult, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SfcScanResult.FoundViolations}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Text="{Binding SfcScanResult.VerdictText}" />
                                        <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                            <Run Text="Duration: " /><Run Text="{Binding SfcScanResult.DurationSeconds, StringFormat={}{0:0}s, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="REPAIRED FILES" Style="{StaticResource SpecLabel}" />
                                        <ItemsControl ItemsSource="{Binding SfcScanResult.RepairedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding}"
                                                               Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="(none)" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SfcScanResult.RepairedFiles.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="UNREPAIRABLE FILES" Style="{StaticResource SpecLabel}" />
                                        <ItemsControl ItemsSource="{Binding SfcScanResult.UnrepairableEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding}"
                                                               Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="(none)" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SfcScanResult.UnrepairableEntries.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding SfcScanResult.ExtractedLogPath, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Run Text="[SR] log excerpt saved to " /><Run Text="{Binding SfcScanResult.ExtractedLogPath, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #787: integrity scan history - shared timeline across SFC and every DISM
                         health-scan verb, plus a same/new/resolved comparison against the previous SFC run. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Integrity scan history" Style="{StaticResource CardTitle}" />
                            <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding SfcComparisonText, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding SfcComparisonText}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding IntegrityHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,3,10,0" VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="{Binding ScanType}" />
                                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Timestamp, StringFormat={}{0:g}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Verdict}" />
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" Text="{Binding DurationText}" />
                                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"
                                                           Text="{Binding UnrepairableFiles.Count, StringFormat={}{0} unrepairable}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UnrepairableFiles.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No integrity scans recorded yet - run sfc /scannow or a DISM health scan above." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IntegrityHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #788: in-place repair-install guidance - only shown once RestoreHealth has failed
                         this session, or SFC has reported unrepairable files on the two most recent scans in
                         a row. Guidance only - this app never launches an OS installer itself. -->
                    <Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource DangerBrush}"
                            Visibility="{Binding RepairInstallGuidance, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="In-place repair install may be needed" Style="{StaticResource CardTitle}" Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,-6,0,12" Text="{Binding RepairInstallGuidance.TriggerReason}" />

                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="EDITION" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding RepairInstallGuidance.EditionText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="BUILD" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding RepairInstallGuidance.BuildText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="VERSION" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding RepairInstallGuidance.DisplayVersionText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="LANGUAGE" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding RepairInstallGuidance.LanguageText}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="ARCHITECTURE" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding RepairInstallGuidance.ArchitectureText}" />
                                </StackPanel>
                            </UniformGrid>

                            <ItemsControl ItemsSource="{Binding RepairInstallGuidance.ChecklistItems}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#9744;" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="COMMAND (run from the mounted ISO's root, elevated)" Style="{StaticResource SpecLabel}" />
                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="{StaticResource FontBody}" Text="{Binding RepairInstallGuidance.SetupCommandLine}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="System state">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #789/#790: restore point inventory, per-volume System Protection inference,
                         shadow-storage allocation and the automatic-frequency policy readout, plus the two
                         mutating actions (create a restore point, launch the System Restore wizard). -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="System Restore" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadSystemRestoreCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Load restore points" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingSystemRestore}" Value="True">
                                                        <Setter Property="Text" Value="Loading…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding CreateRestorePointCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,0">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Create a restore point" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCreatingRestorePoint}" Value="True">
                                                        <Setter Property="Text" Value="Creating…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="3" Content="Open System Restore…" Command="{Binding LaunchRstruiCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Restore point inventory, per-volume System Protection status, shadow-copy storage allocation, and the policy-defined automatic restore-point frequency." />

                            <TextBlock Text="Not loaded yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SystemRestoreSnapshot}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Visibility="{Binding SystemRestoreSnapshot, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SystemRestoreSnapshot.SystemRestoreAvailable}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                        <Run Text="System Restore isn't available on this machine: " /><Run Text="{Binding SystemRestoreSnapshot.ErrorText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>

                                <StackPanel Visibility="{Binding SystemRestoreSnapshot.SystemRestoreAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                            Visibility="{Binding SystemRestoreSnapshot.HasNoRestorePointsAtAll, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                                                   Text="No restore points found at all - System Protection may be off, or none has ever been created on this PC." />
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="AUTOMATIC RESTORE POINT FREQUENCY" Style="{StaticResource SpecLabel}" />
                                            <TextBlock Style="{StaticResource SpecValue}" Text="{Binding SystemRestoreSnapshot.AutomaticFrequencyMinutes, StringFormat={}{0} minute(s), TargetNullValue='Not set (Windows default: 1440 minutes / 24 hours)'}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="RESTORE POINTS" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                    <DataGrid ItemsSource="{Binding SystemRestoreSnapshot.RestorePoints}" Height="180" IsReadOnly="True" Margin="0,0,0,14">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Seq" Binding="{Binding SequenceNumber}" Width="60" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding RestorePointTypeText}" Width="150" />
                                            <DataGridTextColumn Header="Created" Binding="{Binding CreationTime, StringFormat={}{0:g}, TargetNullValue=Unknown}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="SYSTEM PROTECTION BY VOLUME" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding SystemRestoreSnapshot.VolumeProtection}" Margin="0,0,0,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,3,10,0" VerticalAlignment="Top">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProtectionLooksOn}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Grid.Column="1" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding Volume}" />
                                                    <TextBlock Grid.Column="2" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="SHADOW-COPY STORAGE ALLOCATION" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                    <DataGrid ItemsSource="{Binding SystemRestoreSnapshot.ShadowStorage}" Height="140" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="70" />
                                            <DataGridTextColumn Header="Used" Binding="{Binding UsedText}" Width="*" />
                                            <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedText}" Width="*" />
                                            <DataGridTextColumn Header="Maximum" Binding="{Binding MaxText}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No shadow-copy storage allocated on any volume." Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SystemRestoreSnapshot.ShadowStorage.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #791-793: repository verify/salvage/reset, the WMI-Activity/Operational error
                         analyzer grouped by client process, and a read-only inventory of permanent WMI
                         event-consumer subscriptions in root\subscription. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="WMI" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-4,0,10"
                                       Text="Repository health, recent client-query failures grouped by process, and every permanent WMI event-consumer subscription registered on this machine." />

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="REPOSITORY SIZE" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding WmiRepositoryHealth.RepositorySizeBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="LAST MODIFIED" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SpecValue}" Text="{Binding WmiRepositoryHealth.RepositoryLastModified, StringFormat={}{0:g}, TargetNullValue=Unknown}" />
                                </StackPanel>
                            </UniformGrid>

                            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="{Binding WmiRepositoryHealth.IsConsistent, Converter={StaticResource NullToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WmiRepositoryHealth.IsConsistent}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Repository is consistent" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WmiRepositoryHealth.IsConsistent}" Value="False">
                                                        <Setter Property="Text" Value="Repository is INCONSISTENT" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding WmiRepositoryHealth.VerifyOutputText}" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,14">
                                <Button Command="{Binding VerifyWmiRepositoryCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,8">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Verify repository" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheckingWmiRepository}" Value="True">
                                                        <Setter Property="Text" Value="Verifying…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding SalvageWmiRepositoryCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,8">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Salvage repository" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSalvagingWmiRepository}" Value="True">
                                                        <Setter Property="Text" Value="Salvaging…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding ResetWmiRepositoryCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Margin="0,0,8,8"
                                        Background="{DynamicResource DangerMutedBrush}" Foreground="{DynamicResource DangerBrush}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Reset repository (escalation)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResettingWmiRepository}" Value="True">
                                                        <Setter Property="Text" Value="Resetting…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </WrapPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recent client-query failures &amp; permanent event consumers" Style="{StaticResource SpecLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadWmiDiagnosticsCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Load WMI diagnostics" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingWmiDiagnostics}" Value="True">
                                                        <Setter Property="Text" Value="Loading…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding HasLoadedWmiDiagnostics, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="QUERY FAILURES BY CLIENT PROCESS (last 30 days)" Style="{StaticResource SpecLabel}" Margin="0,10,0,4" />
                                <DataGrid ItemsSource="{Binding WmiActivityErrorGroups}" Height="160" IsReadOnly="True" Margin="0,0,0,14">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding ClientProcessId}" Width="70" />
                                        <DataGridTextColumn Header="Errors" Binding="{Binding ErrorCount}" Width="60" />
                                        <DataGridTextColumn Header="Last error" Binding="{Binding LastErrorTime, StringFormat={}{0:g}}" Width="140" />
                                        <DataGridTextColumn Header="Most recent operation / result" Binding="{Binding Events[0].OperationText}" Width="2*" />
                                        <DataGridTemplateColumn Header="" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="View process" FontSize="{StaticResource FontCaption}" Padding="6,2"
                                                            Click="ViewWmiClientProcess_Click" Tag="{Binding ProcessName}"
                                                            Visibility="{Binding ProcessStillRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No WMI client-query failures in the last 30 days." Margin="0,-10,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WmiActivityErrorGroups.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="PERMANENT WMI EVENT CONSUMERS (root\subscription)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding WmiEventConsumers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="{Binding FilterName}" />
                                                        <TextBlock Grid.Column="1" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="ORPHANED (no consumer bound)">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BindingFound}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Query}" />
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Margin="0,4,0,0">
                                                        <Run Text="{Binding ConsumerType, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" - " /><Run Text="{Binding ConsumerName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ConsumerDetail}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No permanent WMI event-consumer subscriptions found.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WmiEventConsumers.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #794/#795: hive/hive-log file size and health, plus RegBack backup status and its
                         re-enable toggle. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Registry" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadRegistryHealthCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Load registry health" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingRegistryHealth}" Value="True">
                                                        <Setter Property="Text" Value="Loading…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="File size and last-write time for every system hive and each profile's NTUSER.DAT/UsrClass.dat, oversized-hive flags, stale transaction-log notes, and System32\config\RegBack's own backup status." />

                            <StackPanel Visibility="{Binding RegistryHealth, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="SYSTEM HIVES" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <DataGrid ItemsSource="{Binding RegistryHealth.SystemHives}" Height="150" IsReadOnly="True" Margin="0,0,0,14">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOversized}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hive" Binding="{Binding Name}" Width="110" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                                        <DataGridTextColumn Header="Last write" Binding="{Binding LastWriteTime, StringFormat={}{0:g}}" Width="140" />
                                        <DataGridTextColumn Header="Transaction-log notes" Binding="{Binding TransactionLogNotes, Converter={StaticResource StringListJoinConverter}}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="USER HIVES" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <DataGrid ItemsSource="{Binding RegistryHealth.UserHives}" Height="150" IsReadOnly="True" Margin="0,0,0,14">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOversized}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hive" Binding="{Binding Name}" Width="220" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                                        <DataGridTextColumn Header="Last write" Binding="{Binding LastWriteTime, StringFormat={}{0:g}}" Width="140" />
                                        <DataGridTextColumn Header="Transaction-log notes" Binding="{Binding TransactionLogNotes, Converter={StaticResource StringListJoinConverter}}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="REGBACK STATUS" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}">
                                            <Run Text="{Binding RegistryBackupStatus.PopulatedStatusText, Mode=OneWay}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding RegistryBackupStatus.NewestFileTime, StringFormat={}newest {0:g}, TargetNullValue='(no populated files)', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                            <Run Text="Periodic backup policy: " />
                                            <Run Text="{Binding RegistryBackupStatus.PeriodicBackupStatusText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding EnablePeriodicBackupCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" Content="Enable periodic backup"
                                            Visibility="{Binding RegistryBackupStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #797-799: PATH doctor, full environment-variable inspector/editor with sanity
                         checks and WM_SETTINGCHANGE broadcast, and the process-vs-system drift summary. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Environment" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding RunPathDoctorCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Run PATH doctor" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunningPathDoctor}" Value="True">
                                                        <Setter Property="Text" Value="Checking…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Flags nonexistent PATH directories, duplicates within and across the Machine/User scopes, empty segments, unresolved %VAR% references, REG_SZ used where REG_EXPAND_SZ is needed, and the combined expanded length against the 8191-character limit." />

                            <StackPanel Visibility="{Binding PathDoctorResult, Converter={StaticResource NullToVisibilityConverter}}">
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="COMBINED EXPANDED LENGTH" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding PathDoctorResult.TotalExpandedLength, StringFormat={}{0:N0} chars}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MACHINE PATH KIND" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding PathDoctorResult.MachineValueKindText}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ISSUES FOUND" Style="{StaticResource SpecLabel}" />
                                        <TextBlock Style="{StaticResource SpecValue}" Text="{Binding PathDoctorResult.Issues.Count}" />
                                    </StackPanel>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding PathDoctorResult.Issues}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                                        <Run Text="{Binding Scope, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding IssueType, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Text="{Binding Segment}" />
                                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No PATH problems found." Margin="0,-10,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PathDoctorResult.Issues.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Variable inspector &amp; editor" Style="{StaticResource SpecLabel}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding LoadEnvironmentVariablesCommand}" Padding="10,4" FontSize="{StaticResource FontBody}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Load variables" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingEnvironmentVariables}" Value="True">
                                                        <Setter Property="Text" Value="Loading…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding HasLoadedEnvironmentVariables, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid ItemsSource="{Binding EnvironmentVariables}" Height="200" IsReadOnly="True" Margin="0,4,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="70" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                                        <DataGridTemplateColumn Header="" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Delete" FontSize="{StaticResource FontCaption}" Padding="6,2"
                                                            Command="{Binding DataContext.DeleteEnvironmentVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="ADD / EDIT A VARIABLE" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Margin="0,0,6,0" ItemsSource="{Binding EnvVarScopeOptions}" SelectedItem="{Binding NewEnvVarScope}" />
                                    <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding NewEnvVarName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="2" Margin="0,0,6,0" Text="{Binding NewEnvVarValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3" Content="Save" Command="{Binding SetEnvironmentVariableCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" />
                                </Grid>

                                <TextBlock Text="SANITY CHECKS" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding EnvironmentSanityChecks}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,3,10,0" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Grid.Column="2" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROCESS ENVIRONMENT DRIFT" Style="{StaticResource SpecLabel}" />
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="Which running processes inherited a PATH/TEMP from before your last change - see the Processes tab for a per-process check." />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasScannedProcessEnvironmentDrift, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                            <Run Text="{Binding ProcessEnvironmentDriftCount, Mode=OneWay}" />
                                            <Run Text=" of " /><Run Text="{Binding ProcessEnvironmentCheckedCount, Mode=OneWay}" />
                                            <Run Text=" processes have drifted" />
                                        </TextBlock>
                                        <Button Content="View in Processes" Click="ViewDriftedProcesses_Click" Margin="10,0,0,0" Padding="8,2" FontSize="{StaticResource FontBody}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProcessEnvironmentDriftCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ScanProcessEnvironmentDriftCommand}" Padding="10,4" FontSize="{StaticResource FontBody}" VerticalAlignment="Top">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Scan running processes" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanningProcessEnvironmentDrift}" Value="True">
                                                        <Setter Property="Text" Value="Scanning…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- #796: registry-change journal - every write this app itself routed through
                         RegistryChangeJournalService, with per-entry undo and export-as-.reg. Also mirrored
                         (read-only-enough summary) in the settings drawer - see SettingsPanel.xaml. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Changes made by this app" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-4,0,10"
                                       Text="Every registry write this app has made through its own change journal - undo writes the previous value straight back; export saves the change as a standalone .reg file. Covers a representative sample of this app's registry-writing actions, not literally every one - see CLAUDE.md." />
                            <ItemsControl ItemsSource="{Binding RegistryChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="{Binding Description}" />
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}">
                                                        <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                        <Run Text="  ·  " /><Run Text="{Binding Source, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding FullKeyText, Mode=OneWay}" />\<Run Text="{Binding ValueName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <Run Text="{Binding OldValueText, Mode=OneWay, TargetNullValue='(did not exist)'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        <Run Text=" -&gt; " />
                                                        <Run Text="{Binding NewValueText, Mode=OneWay, TargetNullValue='(deleted)'}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Undo" FontSize="{StaticResource FontCaption}" Padding="8,3" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.UndoRegistryChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Export .reg" FontSize="{StaticResource FontCaption}" Padding="8,3"
                                                        Command="{Binding DataContext.ExportRegistryChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No registry changes made by this app yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RegistryChanges.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
