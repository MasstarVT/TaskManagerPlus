<UserControl x:Class="TaskManagerPlus.Views.BaselineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:TaskManagerPlus.Common"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:models="clr-namespace:TaskManagerPlus.Models"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:BaselineViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- suggestions.md #1000: Ctrl+Shift+C copies this panel's baselines as Markdown. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyMarkdownCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- #950/#952: one captured baseline row in the "Captured baselines" list. -->
        <DataTemplate x:Key="BaselineRowTemplate" DataType="{x:Type models:PerformanceBaseline}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap">
                            <Run Text="{Binding CapturedAt, StringFormat={}{0:g}, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Label, TargetNullValue='routine baseline', Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiaryBrush}" Text="Automatic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WasAutomatic}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WasIdleAtCapture}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Captured under load - idle metrics not comparable." />
                    </TextBlock>
                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Boot: " /><Run Text="{Binding LastBootDurationMs, TargetNullValue='n/a', StringFormat={}{0:0}ms, Mode=OneWay}" />
                        <Run Text="  •  Idle CPU: " /><Run Text="{Binding IdleCpuPercent, TargetNullValue='n/a', StringFormat={}{0:0.#}%, Mode=OneWay}" />
                        <Run Text="  •  Idle RAM: " /><Run Text="{Binding IdleRamCommittedGb, TargetNullValue='n/a', StringFormat={}{0:0.#} GB, Mode=OneWay}" />
                        <Run Text="  •  Idle disk latency: " /><Run Text="{Binding IdleDiskLatencyMs, TargetNullValue='n/a', StringFormat={}{0:0.#}ms, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                        <Run Text="WinSAT — CPU: " /><Run Text="{Binding WinSatCpuScore, TargetNullValue='n/a', Mode=OneWay}" />
                        <Run Text="  Mem: " /><Run Text="{Binding WinSatMemoryScore, TargetNullValue='n/a', Mode=OneWay}" />
                        <Run Text="  Disk: " /><Run Text="{Binding WinSatDiskScore, TargetNullValue='n/a', Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- #951: one metric comparison row. -->
        <DataTemplate x:Key="MetricComparisonTemplate" DataType="{x:Type models:BaselineMetricComparison}">
            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegression}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsImprovement}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding SummaryText, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <!-- #958: one rule-finding transition row. -->
        <DataTemplate x:Key="RuleTransitionTemplate" DataType="{x:Type vm:RuleFindingTransition}">
            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4">
                <Run Text="{Binding Title, Mode=OneWay}" />
                <Run Text=" — " />
                <Run FontWeight="SemiBold" Text="{Binding Status, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- HideBaselinesCommand lives on TroubleshootViewModel, not this view's own
                     BaselineViewModel DataContext - same AncestorLevel=2 reasoning TimelineView
                     already documents for HideTimelineCommand. -->
                <Button Grid.Column="0" Content="&#8592; Back"
                        Command="{Binding DataContext.HideBaselinesCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                        Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Baselines" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Captures a fuller performance baseline than the Summary tab's quick snapshot - WinSAT scores, last boot duration, and idle CPU/RAM/disk-latency readings - then tracks it over time and flags a slowdown against your oldest saved baseline."
                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- #950/#957: manual capture. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Capture a baseline" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="260" Margin="0,0,10,0"
                                 Text="{Binding NewBaselineLabel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Optional label, e.g. 'monthly check-in'" />
                        <Button Content="Capture full baseline (includes WinSAT, ~1 min)" Padding="10,4"
                                Command="{Binding CaptureBaselineCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Text="Idle status: not idle right now - a capture will still save, just flagged as not comparable for idle metrics.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentlyIdle}" Value="True">
                                        <Setter Property="Text" Value="Idle status: this PC currently looks idle - a capture right now is fully comparable." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CaptureStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- #955: "wrap a change" before/after window. -->
            <Border Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChangeWindowOpen}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Wrap a change" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChangeWindowOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox Width="260" Margin="0,0,10,0"
                                 Text="{Binding ChangeLabelInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="What change are you about to make? e.g. 'installing GPU driver 566.03'" />
                        <Button Content="Start change" Padding="10,4" Command="{Binding StartChangeCommand}" />
                    </StackPanel>

                    <!-- Persistent banner while the change window is open. -->
                    <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChangeWindowOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="Change in progress: " /><Run Text="{Binding ActiveChangeLabel, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubStat}">
                                    <Run Text="Started " /><Run Text="{Binding ChangeStartedAt, StringFormat={}{0:t}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Finish change" Padding="10,4" VerticalAlignment="Center"
                                    Command="{Binding FinishChangeCommand}" />
                        </Grid>
                    </Border>

                    <!-- Finished change summary. -->
                    <StackPanel Margin="0,4,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeSummaryText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChangeHasFingerprintMismatch}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                       Text="Hardware changed between the before and after capture (CPU, RAM, disk, or GPU differ) - this comparison may not be meaningful." />
                        </Border>

                        <TextBlock Text="{Binding ChangeSummaryText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,8" />

                        <TextBlock Text="Performance" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding ChangePerformanceDiff}" ItemTemplate="{StaticResource MetricComparisonTemplate}" Margin="0,0,0,8" />

                        <TextBlock Text="Findings since &quot;Start change&quot;" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding ChangeRuleTransitions}" ItemTemplate="{StaticResource RuleTransitionTemplate}" Margin="0,0,0,8" />

                        <Button Content="Export before/after report..." HorizontalAlignment="Left" Padding="10,4"
                                Command="{Binding GenerateChangeReportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #952: automatic weekly capture toggle (also duplicated in the Settings drawer). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Automatic weekly capture" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <CheckBox Content="Capture a baseline automatically about once a week, while idle" IsChecked="{Binding AutoCaptureEnabled}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Keep the most recent" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource SubStat}" />
                        <TextBox Width="50" Text="{Binding MaxBaselinesKept, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="baselines" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SubStat}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AutoCaptureStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- #951/#953: regression vs. the oldest saved baseline. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="This PC got slower? (vs. your oldest baseline)" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RegressionHeaderText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRegressionFingerprintWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RegressionFingerprintWarningText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}"
                                   Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Text="No regressions or improvements to show yet." Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RegressionComparisons.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding RegressionComparisons}" ItemTemplate="{StaticResource MetricComparisonTemplate}" />
                </StackPanel>
            </Border>

            <!-- #954: trend chart across every saved baseline. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Trend" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" YAxes="{Binding TrendYAxes}"
                                         Height="240" TooltipPosition="Top" LegendPosition="Bottom" common:ChartTheme.ThemedLegend="True" />
                </StackPanel>
            </Border>

            <!-- Captured baselines list. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Captured baselines" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBlock Text="No baselines captured yet - use the button above." Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentBaselines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding RecentBaselines}" ItemTemplate="{StaticResource BaselineRowTemplate}" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #994: known-good comparison against an imported reference profile -
                 every difference below is explicitly framed as "different, not necessarily wrong",
                 never a pass/fail check. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Compare against a reference profile" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Import reference profile..." Command="{Binding ImportReferenceProfileCommand}"
                                AutomationProperties.Name="Import a reference profile baseline file" />
                    </Grid>
                    <TextBlock Text="Import an exported baseline from a known-good machine (Baselines panel's own &quot;Capture a baseline&quot; button, run there and brought here) to see how THIS machine differs - a comparison, not a pass/fail check."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-2,0,8" />
                    <TextBlock Text="{Binding ReferenceStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Visibility="{Binding HasReferenceProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Hardware fingerprints, side by side. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Reference machine" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding ReferenceProfile.Fingerprint.CpuName}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReferenceProfile.Fingerprint.RamTotalGb, StringFormat={}{0:0.#} GB RAM}" FontSize="{StaticResource FontBody}" />
                                <TextBlock Text="{Binding ReferenceProfile.Fingerprint.DiskModels, Converter={StaticResource StringListJoinConverter}}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding ReferenceProfile.Fingerprint.GpuNames, Converter={StaticResource StringListJoinConverter}}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="This machine" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding CurrentFingerprint.CpuName}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CurrentFingerprint.RamTotalGb, StringFormat={}{0:0.#} GB RAM}" FontSize="{StaticResource FontBody}" />
                                <TextBlock Text="{Binding CurrentFingerprint.DiskModels, Converter={StaticResource StringListJoinConverter}}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{Binding CurrentFingerprint.GpuNames, Converter={StaticResource StringListJoinConverter}}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Different hardware - figures below reflect that, not necessarily a problem." FontSize="{StaticResource FontBody}" FontStyle="Italic"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding ReferenceFingerprintMismatch, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Performance figures, only when this machine also has at least one local baseline. -->
                        <TextBlock Text="Performance" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReferencePerformanceComparison.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ReferencePerformanceComparison}" ItemTemplate="{StaticResource MetricComparisonTemplate}" Margin="0,0,0,10" />

                        <!-- Installed software / services / startup - neutral wording ("only on
                             reference" / "only on this machine"), not +/- added/removed, since
                             neither side is the ground truth here. -->
                        <TextBlock Text="Software, services, and startup items" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                        <StackPanel Visibility="{Binding ReferenceDiff, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="No differences found.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReferenceDiff.HasChanges}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ReferenceDiff.SoftwareAdded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Text="{Binding StringFormat='Software, only on this machine: {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReferenceDiff.SoftwareRemoved}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Text="{Binding StringFormat='Software, only on the reference: {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReferenceDiff.ServicesAdded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Text="{Binding StringFormat='Service, only on this machine: {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReferenceDiff.ServicesRemoved}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Text="{Binding StringFormat='Service, only on the reference: {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReferenceDiff.StartupAdded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Text="{Binding StringFormat='Startup item, only on this machine: {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReferenceDiff.StartupRemoved}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Text="{Binding StringFormat='Startup item, only on the reference: {0}'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
