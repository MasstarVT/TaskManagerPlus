<UserControl x:Class="TaskManagerPlus.Views.GlossaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:models="clr-namespace:TaskManagerPlus.Models"
             d:DataContext="{d:DesignInstance Type=vm:GlossaryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- suggestions.md #990: one glossary term row. -->
        <DataTemplate x:Key="GlossaryTermTemplate" DataType="{x:Type models:GlossaryTerm}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="{Binding Term}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Definition}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- HideGlossaryCommand lives on TroubleshootViewModel, not this view's own
                     DataContext (GlossaryViewModel) - AncestorLevel=2 skips this UserControl to
                     reach TroubleshootView, the same pattern TimelineView/ChangeJournalView use. -->
                <Button Grid.Column="0" Content="&#8592; Back"
                        Command="{Binding DataContext.HideGlossaryCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                        Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Back to Troubleshoot landing page" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Glossary" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="Plain-English definitions for the technical terms this app's own findings and checks use."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Search" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,14" Padding="8,6"
                     AutomationProperties.Name="Search glossary terms" />

            <TextBlock Text="No terms match your search." Margin="0,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Terms.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Terms}" ItemTemplate="{StaticResource GlossaryTermTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
