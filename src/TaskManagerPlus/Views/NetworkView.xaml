<UserControl x:Class="TaskManagerPlus.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- suggestions.md #501-509: always-on latency/jitter/packet-loss monitor - a
                 continuous probe ring with its own start/stop toggle, distinct from the
                 Connectivity card's existing single-shot 15s gateway/DNS check further down. See
                 LatencyMonitorService's remarks for the full design. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLatencyMonitoring}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Latency" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Interval (s)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Width="46" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                     Text="{Binding LatencyIntervalSeconds, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                            <Button Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Start monitoring" />
                                        <Setter Property="Command" Value="{Binding ToggleLatencyMonitorCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLatencyMonitoring}" Value="True">
                                                <Setter Property="Content" Value="Stop monitoring" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- #501: continuous ring - Gateway/First hop/Resolver, glow+core paired like
                         every other history chart in the app (PerformanceViewModel.LineOf). -->
                    <lvc:CartesianChart Series="{Binding LatencySeries}" XAxes="{Binding LatencyHiddenXAxes}" YAxes="{Binding LatencyMsYAxes}"
                                         Height="160" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />

                    <!-- #504: baseline deviation badges - hidden individually when there's no
                         baseline yet or nothing to flag. -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding GatewayDeviationText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,3" Visibility="{Binding GatewayDeviationText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding FirstHopDeviationText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,3" Visibility="{Binding FirstHopDeviationText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ResolverDeviationText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Visibility="{Binding ResolverDeviationText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Flag when over" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Width="40" Margin="6,0,4,0" VerticalContentAlignment="Center"
                                     Text="{Binding DeviationMultiplier, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                            <TextBlock Text="x your usual latency" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- #508: route-flap (TTL-change) summary. -->
                    <TextBlock Text="{Binding RouteFlapText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <!-- #502: packet-loss timeline strips, one per charted tier, plus a combined
                         "quick flag, not a verdict" caption distinguishing isolated drops from bursts. -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Packet loss" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Gateway" Width="70" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding GatewayLossStrip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="5" Height="14" Margin="1,0,0,0" CornerRadius="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PartOfBurst}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="First hop" Width="70" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding FirstHopLossStrip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="5" Height="14" Margin="1,0,0,0" CornerRadius="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PartOfBurst}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Resolver" Width="70" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding ResolverLossStrip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="5" Height="14" Margin="1,0,0,0" CornerRadius="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PartOfBurst}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding LossBreakdownText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>

                    <!-- #503: LAN vs ISP vs internet matrix - four fixed tiers, read live from the
                         same rolling window the chart above is built from. -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Latency matrix (LAN / ISP / internet)" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding LatencyMatrix}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tier" Binding="{Binding Label}" Width="1.1*" />
                                <DataGridTextColumn Header="Target" Binding="{Binding TargetHost}" Width="1.3*" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                                <DataGridTextColumn Header="Avg" Binding="{Binding AvgMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                                <DataGridTextColumn Header="Max" Binding="{Binding MaxMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                                <DataGridTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat={}{0:0.#}%}" Width="0.7*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Gateway bad points at your router/Wi-Fi, first-hop bad points at your ISP's local plant, only the resolver bad points upstream/peering - not started, or no data yet, shows as an empty table."
                                   Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <!-- #506: persisted 24h/7d latency history for the Gateway tier. -->
                    <StackPanel Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="History (Gateway)" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="24h" Command="{Binding ShowLatencyHistoryDayCommand}" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="7d" Command="{Binding ShowLatencyHistoryWeekCommand}" Padding="8,3" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LatencyHistoryPoints}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding BucketStartLocal, StringFormat='{}{0:MM/dd HH:mm}'}" FontSize="12" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="avg " /><Run Text="{Binding AvgMs, StringFormat={}{0:0.#} ms}" />
                                            <Run Text="  ·  max " /><Run Text="{Binding MaxMs, StringFormat={}{0:0.#} ms}" />
                                            <Run Text="  ·  loss " /><Run Text="{Binding LossPercent, StringFormat={}{0:0.#}%}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No history recorded yet - leave the monitor running for a while." Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatencyHistoryPoints.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #505: latency-under-load overlay - the existing throughput series plus the
                 Gateway latency series on a shared time axis (own right-hand scale), so a ping
                 spike lining up with a throughput spike reads as self-inflicted congestion
                 instead of an ISP fault. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Latency under load" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Throughput (left axis) and Gateway latency (right axis) on one shared time axis."
                               Style="{StaticResource SubStat}" Margin="0,-8,0,10" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding LatencyOverlaySeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding OverlayYAxes}"
                                         Height="200" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.NetworkColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Network" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.NetworkReceiveBps, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="{Binding Performance.NetworkSendBps, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate, StringFormat=Up: {0}}" Style="{StaticResource SubStat}" />
                </StackPanel>
            </Border>

            <!-- Network chart -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.NetworkColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Throughput" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Performance.NetworkSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.NetworkYAxes}"
                                         Height="200" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                </StackPanel>
            </Border>

            <!-- Connectivity: on-demand/periodic gateway + DNS reachability, since it needs
                 actual network I/O rather than a local counter read - see NetworkViewModel's
                 remarks for why this is the one thing on this tab with its own (slow) timer. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connectivity" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- #46: hosts-file quick-open, for DNS override troubleshooting. -->
                            <Button Content="Open hosts file" Command="{Binding OpenHostsFileCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <!-- #24: opt-in, since it's a real outbound call to a third-party
                                 lookup service - never runs automatically. -->
                            <Button Content="Look up public IP" Command="{Binding LookupPublicIpCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Check now" Command="{Binding CheckConnectivityCommand}" Padding="10,4" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding PublicIpStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GatewayReachable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GatewayReachable}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="Gateway" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding GatewayStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DnsReachable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DnsReachable}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="Internet DNS" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DnsStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- #33: actual hostname resolution time - distinct from the ping-based
                             DNS reachability check to the left (which only proves the resolver
                             IP answers ICMP, not that name resolution itself is fast/working). -->
                        <StackPanel Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="DNS resolution" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DnsLookupText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- Round 9, #51: captive portal detection - distinct from a plain
                             gateway/DNS unreachable result (a portal answers HTTP, just not with
                             the expected NCSI body). -->
                        <StackPanel Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CaptivePortalDetected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CaptivePortalDetected}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="Captive portal" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CaptivePortalStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run Text="Proxy: " /><Run Text="{Binding ProxyStatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- suggestions.md #517-526: DNS resolution, cache and configuration - one card
                 bundling every DNS-focused diagnostic, the same "one card per feature cluster"
                 shape the Latency card above already uses for #501-509. #525's reverse-DNS
                 enrichment instead lives on the existing Active connections grid further down,
                 since it extends that grid directly rather than adding a new one. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DNS" Style="{StaticResource CardTitle}" />

                    <!-- #519: configured resolvers per adapter - "answered first" is filled in
                         once a #517 compare run below has actually completed. -->
                    <TextBlock Text="Configured resolvers" Style="{StaticResource SpecLabel}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding ConfiguredResolvers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding AdapterName}" FontWeight="SemiBold" />
                                        <Run Text=" — " /><Run Text="{Binding ResolverIp}" FontFamily="Consolas" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="answered first" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding IsFirstResponder, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No adapter has a configured resolver.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfiguredResolvers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #517: multi-resolver comparison - the adapter's own resolver(s) plus
                         1.1.1.1/8.8.8.8/9.9.9.9, side by side. -->
                    <TextBlock Text="Compare a hostname across resolvers" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DnsCompareHostname, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Compare" Padding="10,4" Command="{Binding RunDnsCompareCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DnsCompareStatusText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DnsCompareAnswers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resolver" Binding="{Binding ResolverIp}" Width="1*" />
                            <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="1.1*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding ElapsedMs, StringFormat={}{0} ms}" Width="0.7*" />
                            <DataGridTextColumn Header="Answers" Binding="{Binding Answers, Converter={StaticResource StringListJoinConverter}}" Width="2.2*" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="1.4*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="A blank Adapter column means a fixed public resolver added purely for comparison, not one of yours. Divergent answers can mean a hijacking/filtering resolver, a stale cache, or just normal GeoDNS/CDN load-balancing - quick flag, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <!-- #520: DNS-over-HTTPS configuration - read-only. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Encrypted DNS (DoH)" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" Command="{Binding RefreshDohConfigCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DohSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DohStatuses}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.3*" />
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerAddress}" Width="1.1*" />
                            <DataGridTextColumn Header="Encryption" Binding="{Binding EncryptionStatus}" Width="1*" />
                            <DataGridTextColumn Header="Auto-upgrade" Binding="{Binding AutoUpgrade}" Width="1*" />
                            <DataGridTextColumn Header="UDP fallback" Binding="{Binding UdpFallback}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Text="{Binding DohRawOutput, Mode=OneWay}" Margin="0,8,0,0" MaxHeight="110"
                             IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />

                    <!-- #521: NRPT split-DNS rules - hidden entirely when none exist. -->
                    <Expander Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NrptRules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="Split-DNS policy (NRPT)" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Namespace rules pushed by a VPN or group policy that route specific suffixes to specific servers - the reason internal hostnames resolve on VPN and nothing else does, or vice versa."
                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85" />
                            <ItemsControl ItemsSource="{Binding NrptRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap">
                                            <Run Text="{Binding Namespaces, Converter={StaticResource StringListJoinConverter}}" FontWeight="SemiBold" />
                                            <Run Text=" → " /><Run Text="{Binding DnsServers}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- #523: suffix/search list - collapsed by default. -->
                    <Expander Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="DNS suffix &amp; search list" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,6">
                                <Run Text="Primary suffix: " /><Run Text="{Binding PrimaryDnsSuffixText}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="Search list" Style="{StaticResource SpecLabel}" Margin="0,4,0,4" />
                            <ItemsControl ItemsSource="{Binding DnsSearchList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SubStat}" Margin="0,0,0,3" FontFamily="Consolas" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="(none configured)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DnsSearchList.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Per-adapter suffixes" Style="{StaticResource SpecLabel}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding AdapterDnsSuffixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="{Binding AdapterName}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Suffix}" FontFamily="Consolas" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- #518: DNS cache viewer with flush. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Resolver cache" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="10,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DnsCacheSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="Refresh" Padding="8,3" Margin="0,0,8,0" Command="{Binding RefreshDnsCacheCommand}" />
                        <Button Grid.Column="3" Content="Flush cache" Padding="8,3" Command="{Binding FlushDnsCacheCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DnsCacheStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DnsCacheEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding RecordName}" Width="1.6*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding RecordType}" Width="0.6*" />
                            <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="0.6*" />
                            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #522: hosts file parser with shadowing flags - beyond the existing "Open
                         hosts file" shortcut on the Connectivity card above. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hosts file" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" Command="{Binding RefreshHostsFileCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding HostsEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="0.5*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="1*" />
                            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="1.6*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="This hostname appears more than once in the hosts file - Windows uses whichever line comes first." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlackholed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="A well-known public domain is pointed at a blackhole address - could be an ad-blocker, or could be malware. Quick flag, not a verdict." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShadowsRecentLookup}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="ToolTip" Value="This entry overrides the hostname most recently compared above." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="No entries found (or the hosts file couldn't be read).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HostsEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #524: DNS-Client event log failure/timeout scan - explicit Scan button per
                         the on-demand-for-event-logs convention. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Failure / timeout scan" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DnsScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanDnsFailuresCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DnsScanStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="By queried name" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding DnsFailuresByName}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3" TextWrapping="Wrap">
                                            <Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Count}" />
                                            <Run Text=" (last " /><Run Text="{Binding LastSeenUtc, StringFormat={}{0:g}}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="By resolver" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding DnsFailuresByResolver}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3" TextWrapping="Wrap">
                                            <Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Count}" />
                                            <Run Text=" (last " /><Run Text="{Binding LastSeenUtc, StringFormat={}{0:g}}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- #526: per-resolver DNS response-time chart, sharing the Latency card's own
                         Start/Stop monitoring toggle above rather than getting a new one - see
                         NetworkViewModel.ToggleLatencyMonitor's remarks. -->
                    <TextBlock Text="Per-resolver response time" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <TextBlock Text="Shares the Latency card's Start/Stop monitoring toggle at the top of this page - start monitoring there to see this chart update."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
                    <lvc:CartesianChart Series="{Binding DnsResponseSeries}" XAxes="{Binding DnsResponseHiddenXAxes}" YAxes="{Binding DnsResponseMsYAxes}"
                                         Height="180" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                </StackPanel>
            </Border>

            <!-- Adapters: negotiated link speed per active adapter (#31, flags a "Gigabit"
                 adapter that negotiated down - a classic bad-cable/bad-port symptom) and VPN
                 presence (#37, a heuristic name/type match, not a "traffic is routed through it"
                 guarantee). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Adapters" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding AdapterLinks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SpeedMbps, StringFormat={}{0:0} Mbps}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksDegraded}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active adapters detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AdapterLinks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,10,0,0">
                        <Run Text="VPN: " /><Run Text="{Binding VpnStatusText, Mode=OneWay}" />
                    </TextBlock>

                    <!-- #511: per-adapter configured MTU, cross-referenced against the most
                         recent #510 discovered path MTU - flags an interface configured larger
                         than the path can actually carry. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Interface MTU" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" Command="{Binding RefreshInterfaceMtusCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding InterfaceMtus}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,6,0,0" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.6*" />
                            <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="0.7*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMismatched}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding MismatchReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="Run Path MTU discovery below to flag an interface configured larger than the path can carry."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <!-- Round 9, #48: adapter driver version/date - a date-based "worth a manual
                         check" heuristic, the same one ReadOutdatedDrivers uses elsewhere, NOT a
                         claim that a newer version is actually known to exist online. -->
                    <ItemsControl ItemsSource="{Binding AdapterDrivers}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap">
                                    <Run Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                    <Run Text=" — driver " /><Run Text="{Binding DriverVersion}" />
                                    <Run Text=" (" /><Run Text="{Binding DriverDate, StringFormat={}{0:d}, TargetNullValue=unknown date}" /><Run Text=")" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Round 9, #52: metered-connection flag - relevant context for this app's
                         own logging/remote-monitoring bandwidth use, not just informational. -->
                    <ItemsControl ItemsSource="{Binding MeteredAdapters}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4">
                                    <Run Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                    <Run Text=" — " /><Run Text="{Binding CostText}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 9, #45: historical connection-count totals by process, today and this
                 month - a persisted aggregate of the same honest connection-count proxy the live
                 "Top network processes" card above already uses, NOT real byte-level bandwidth
                 history (Windows exposes no public API for that - see NetworkHistoryService). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Historical connection activity" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Daily/monthly totals of the same connection-count proxy above - not a byte-rate figure, which Windows exposes no public API for."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Today" Style="{StaticResource SpecLabel}" />
                            <ItemsControl ItemsSource="{Binding HistoryToday}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="{Binding ProcessName}" /><Run Text=": " /><Run Text="{Binding ConnectionCountTotal}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="This month" Style="{StaticResource SpecLabel}" />
                            <ItemsControl ItemsSource="{Binding HistoryThisMonth}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="{Binding ProcessName}" /><Run Text=": " /><Run Text="{Binding ConnectionCountTotal}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Round 9, #50: on-demand jitter/packet-loss quick test - min/max/avg over N pings,
                 alongside the existing single-shot gateway/DNS latency reading above. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Jitter / packet loss test" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding JitterTestHost, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Run test (10 pings)" Padding="10,4" Command="{Binding RunJitterTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding JitterTestResultText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Round 9, #49: on-demand traceroute to a user-entered host - shells to tracert.exe.
                 #516 adds "Save as baseline" / "Compare to baseline" beside the output box, plus
                 the diff results below it. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Traceroute" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding TracerouteHost, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Traceroute" Padding="10,4" Command="{Binding RunTracerouteCommand}" />
                    </Grid>
                    <TextBox Text="{Binding TracerouteOutput, Mode=OneWay}" Margin="0,8,0,0" MaxHeight="240"
                             IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />

                    <!-- #516: save the run above as a named baseline, or diff it against one
                         already saved - turns the text dump above into an actionable "your ISP
                         rerouted you" signal instead of two blocks of text to eyeball. -->
                    <TextBlock Text="Baseline diff" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding TracerouteBaselineName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Save as baseline" Padding="10,4" Command="{Binding SaveTracerouteBaselineCommand}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding TracerouteBaselineNames}"
                                  SelectedItem="{Binding SelectedTracerouteBaseline}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Compare to baseline" Padding="10,4" Command="{Binding CompareTracerouteBaselineCommand}" />
                    </Grid>
                    <TextBlock Text="Run a traceroute above first - Save/Compare act on the most recently completed run."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <TextBlock Text="{Binding TracerouteDiffSummaryText}" Style="{StaticResource SubStat}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding TracerouteDiffSummaryText, Converter={StaticResource NullToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding TracerouteDiff}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BaselineHop, TargetNullValue=—, StringFormat=hop {0}}" FontSize="11.5" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentHop, TargetNullValue=—, StringFormat=hop {0}}" FontSize="11.5" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="2" Text="{Binding Ip}" FontSize="11.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Inserted">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Reordered">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #510/#512: on-demand path MTU discovery, plus the derived PMTUD black-hole
                 verdict from the same sweep - a dozen-plus round trips, never on a tick. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Path MTU discovery" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Binary-searches the largest packet that survives with DontFragment set, then reports the discovered path MTU."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding PathMtuTargetHost, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Discover path MTU" Padding="10,4" Command="{Binding RunPathMtuCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PathMtuResultText}" Style="{StaticResource SubStat}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <!-- #512: PMTUD black-hole verdict - hidden until a sweep actually flags one. -->
                    <TextBlock Text="{Binding PathMtuBlackHoleText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding PathMtuBlackHoleText, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- #515: MTR-style continuous hop monitor - own explicit start/stop toggle, distinct
                 from the one-shot traceroute above. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MTR (continuous hop monitor)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="160" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding MtrHost, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Start" />
                                    <Setter Property="Command" Value="{Binding ToggleMtrCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMtrRunning}" Value="True">
                                            <Setter Property="Content" Value="Stop" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="Repeatedly probes every hop with increasing-TTL pings, attributing sent/received/loss/min/avg/max to a specific hop over time - distinct from the one-shot traceroute above."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.85" />
                    <DataGrid ItemsSource="{Binding MtrHops}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="50" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Address, TargetNullValue='(no reply)'}" Width="1.4*" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="0.6*" />
                            <DataGridTextColumn Header="Recv" Binding="{Binding Received}" Width="0.6*" />
                            <DataGridTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat={}{0:0.#}%}" Width="0.7*" />
                            <DataGridTextColumn Header="Min" Binding="{Binding MinMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                            <DataGridTextColumn Header="Avg" Binding="{Binding AvgMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Not started - enter a host and click Start.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MtrHops.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #513/#514: routing table viewer with conflict flags, plus the separate
                 persistent-route section - the fastest way to see a VPN or virtual adapter
                 hijacking traffic, or a stale persistent route left by an uninstalled one. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Routing" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshRoutingCommand}" />
                    </Grid>
                    <TextBlock Text="Flags more than one default route, duplicate routes to the same prefix at an equal metric, and on-link routes that don't match their own interface's subnet. Quick flag, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.85" />
                    <DataGrid ItemsSource="{Binding Routes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*" />
                            <DataGridTextColumn Header="Netmask" Binding="{Binding Netmask}" Width="1.1*" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="1.2*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceLabel}" Width="1.2*" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="0.6*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding FlagReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- #514: persistent routes - read from the registry, not route print's own
                         Persistent Routes section, per this item's own spec. -->
                    <TextBlock Text="Persistent routes (survive a reboot)" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <TextBlock Text="A stale persistent route left by an uninstalled VPN silently fails to apply rather than showing up as visibly broken - worth checking against the live table above."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.7" />
                    <DataGrid ItemsSource="{Binding PersistentRoutes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*" />
                            <DataGridTextColumn Header="Netmask" Binding="{Binding Netmask}" Width="1.1*" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="1.2*" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="None found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersistentRoutes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #535: per-adapter routing metric + "which adapter wins" for outbound
                         traffic - the classic "Ethernet is plugged in but everything goes over
                         Wi-Fi" confusion explained by the numbers, not just asserted. Shares this
                         card's own Refresh button above rather than getting a second one, since
                         it's another netsh shell-out refreshed on the same on-demand cadence. -->
                    <TextBlock Text="Interface metrics" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <TextBlock Text="{Binding AdapterWinnerText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding InterfaceMetrics}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.6*" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="0.7*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No interface metrics found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InterfaceMetrics.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- suggestions.md #527/#528/#529/#530/#531/#534: "Addressing" card - DHCP lease detail
                 with expiry/rogue-server flags (#527), an APIPA banner with a one-click Renew
                 (#528), Release/Renew/Register-DNS actions behind an explicit confirmation since
                 they briefly drop connectivity (#529, the same MessageBox.Show Yes/No pattern
                 ProcessesViewModel's own disruptive "End process" action already uses), an
                 on-demand DHCP-Client event timeline (#530), an on-demand IP-conflict log
                 correlation + active gratuitous-ARP probe (#531), and a per-adapter addressing
                 sanity checklist (#534). All read from one DhcpAddressingService.ReadAll() sweep
                 per adapter, so the per-adapter block below shows every flag together rather than
                 splitting them across separate lists. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Addressing" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshAddressingCommand}" />
                    </Grid>
                    <TextBlock Text="DHCP lease detail, APIPA/self-assigned-address detection, and an addressing sanity checklist - one block per IP-configured adapter."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.85" />

                    <ItemsControl ItemsSource="{Binding Addressing}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApipa}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="Opacity" Value="0.9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="13">
                                            <Run Text="{Binding AdapterName}" FontWeight="SemiBold" />
                                            <Run Text=" — " /><Run Text="{Binding IpAddress}" FontFamily="Consolas" />
                                            <Run Text="/" /><Run Text="{Binding SubnetMask}" FontFamily="Consolas" />
                                        </TextBlock>

                                        <!-- #528: APIPA banner - "DHCP failed, no address was offered", with a Renew shortcut
                                             scoped to this adapter regardless of what's selected in the Actions section below. -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsApipa, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="DHCP failed — no address was offered. This 169.254.x.x address is self-assigned (APIPA); the adapter never heard back from a DHCP server, so it can only talk to other devices on the same self-assigned range."
                                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <Button Content="Renew this adapter" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RenewApipaAdapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding LeaseStatusText}" Margin="0,6,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LeaseExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding DhcpServer, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="DHCP server: " /><Run Text="{Binding DhcpServer}" FontFamily="Consolas" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding DefaultGateway, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Gateway: " /><Run Text="{Binding DefaultGateway}" FontFamily="Consolas" />
                                        </TextBlock>

                                        <!-- #527: rogue-DHCP-server flag. -->
                                        <TextBlock Text="{Binding RogueDhcpReason}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding RogueDhcpReason, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- #534: addressing sanity checklist. -->
                                        <ItemsControl ItemsSource="{Binding SanityFlags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource SubStat}" Margin="0,0,0,3" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No IP-configured adapters found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Addressing.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #529: release / renew / register-DNS, each behind an explicit confirmation
                         (see NetworkViewModel.ReleaseSelectedAdapter's remarks) since they briefly
                         drop connectivity. -->
                    <TextBlock Text="Actions" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Addressing}" DisplayMemberPath="AdapterName"
                                  SelectedItem="{Binding SelectedAddressingAdapter}" />
                        <Button Grid.Column="1" Content="Release" Padding="10,4" Margin="0,0,6,0" Command="{Binding ReleaseAddressCommand}" />
                        <Button Grid.Column="2" Content="Renew" Padding="10,4" Margin="0,0,6,0" Command="{Binding RenewAddressCommand}" />
                        <Button Grid.Column="3" Content="Register DNS" Padding="10,4" Command="{Binding RegisterDnsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DhcpActionStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <!-- #530: DHCP-Client event timeline - explicit Scan button per the
                         on-demand-for-event-logs convention. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DHCP lease event timeline" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DhcpScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanDhcpEventsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DhcpScanStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DhcpEvents}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11.5">
                                    <Run Text="{Binding TimeUtc, StringFormat={}{0:g}}" FontFamily="Consolas" />
                                    <Run Text=" [" /><Run Text="{Binding Channel}" /><Run Text="/" /><Run Text="{Binding Category}" FontWeight="SemiBold" /><Run Text="] " />
                                    <Run Text="{Binding Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #531: IP-conflict log correlation + active gratuitous-ARP probe. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP address conflicts" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding IpConflictScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan log" Padding="10,4" Command="{Binding ScanIpConflictsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding IpConflictScanStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding IpConflictEvents}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MatchesCurrentAddress}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding TimeUtc, StringFormat={}{0:g}}" FontFamily="Consolas" />
                                    <Run Text=" — IP " /><Run Text="{Binding ConflictingIp, TargetNullValue=unknown}" FontFamily="Consolas" />
                                    <Run Text=", MAC " /><Run Text="{Binding ConflictingMac, TargetNullValue='not in event data'}" FontFamily="Consolas" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Active check: sends a live ARP request for the selected adapter's own address and flags any other host that answers for it - a duplicate-address-detection probe, same idea as a gratuitous ARP. Quick flag, not a verdict."
                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Probe now" Padding="10,4" Command="{Binding ProbeGratuitousArpCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding GratuitousArpResultText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #532/#533: "ARP / neighbours" card - the neighbour cache as a
                 sortable grid with OUI vendor lookup (#532), flags for two IPs sharing one MAC and
                 an incomplete gateway entry (#532), and a gateway-MAC-change alert persisted per
                 network profile (#533). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ARP / neighbours" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshArpCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ArpStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!-- #533: gateway-MAC-change alert - hidden entirely when there's nothing to flag. -->
                    <TextBlock Text="{Binding GatewayMacChangeText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                               Visibility="{Binding GatewayMacChangeText, Converter={StaticResource NullToVisibilityConverter}}" />

                    <DataGrid ItemsSource="{Binding ArpEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="1.1*" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="1.4*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.1*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="0.8*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGateway}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="ToolTip" Value="This is the default gateway." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding FlagReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="No ARP entries found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArpEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #23: current Wi-Fi association - collapsed entirely on a wired connection, no
                 Wi-Fi adapter, or a non-English Windows install (see WifiDiagnosticsService). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Wifi}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Wi-Fi" Style="{StaticResource CardTitle}" />
                    <TextBlock FontSize="12.5">
                        <Run Text="{Binding Wifi.Ssid, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " /><Run Text="{Binding Wifi.RadioType, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0">
                        <Run Text="Signal " /><Run Text="{Binding Wifi.SignalPercent, TargetNullValue=Unknown, Mode=OneWay}" /><Run Text="%" />
                        <Run Text=" · Channel " /><Run Text="{Binding Wifi.Channel, TargetNullValue=Unknown, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #87: top network processes by connection count - a "per-process bandwidth" proxy,
                 since Windows exposes no public per-process byte-attribution API. See
                 NetworkProcessUsage's remarks for why this is a connection count, not a byte rate. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Top network processes" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="By active connection count - not a true byte-rate figure, which Windows exposes no public API for."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding TopNetworkProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5">
                                        <Run Text="{Binding ProcessName}" FontWeight="SemiBold" />
                                        <Run Text=" (PID " /><Run Text="{Binding Pid}" /><Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding ConnectionCount}" /><Run Text=" connections (" />
                                        <Run Text="{Binding EstablishedCount}" /><Run Text=" established)" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active connections.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TopNetworkProcesses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #21: active TCP connections with owning process - see NetworkConnectionsService. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Active connections" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Connections.Count, StringFormat={}{0} total}" Style="{StaticResource SubStat}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <!-- #525: on-demand reverse-DNS (PTR) enrichment - never automatic, since
                             it's a real DNS lookup per unique remote address. -->
                        <Button Grid.Column="2" Padding="10,4" Command="{Binding ResolveConnectionNamesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Resolve names" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResolvingConnectionNames}" Value="True">
                                            <Setter Property="Content" Value="Resolving..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <DataGrid ItemsSource="{Binding Connections}" Height="260" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                            <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="1.3*" />
                            <DataGridTextColumn Header="Local port" Binding="{Binding LocalPort}" Width="80" />
                            <DataGridTextColumn Header="Remote address" Binding="{Binding RemoteAddress}" Width="1.3*" />
                            <DataGridTextColumn Header="Remote port" Binding="{Binding RemotePort}" Width="90" />
                            <DataGridTextColumn Header="Remote host" Binding="{Binding RemoteHostName, TargetNullValue=''}" Width="1.6*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="PTR-resolves each unique remote address (memory-cached, strict per-lookup timeout) - turns a wall of IPs into recognizable CDN/service names where a reverse record exists."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Adapter errors: cumulative CRC/discard counters, not rates - see
                 HardwareMonitorService.ReadNetworkErrorCounters. Any nonzero value turns the
                 whole card the warning color; a healthy adapter shows all zeros. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Performance.HasNetworkErrors}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Adapter errors" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="In: " /><Run Text="{Binding Performance.NetworkInErrors, Mode=OneWay}" /><Run Text=" errors, " />
                        <Run Text="{Binding Performance.NetworkInDiscards, Mode=OneWay}" /><Run Text=" discarded  •  Out: " />
                        <Run Text="{Binding Performance.NetworkOutErrors, Mode=OneWay}" /><Run Text=" errors, " />
                        <Run Text="{Binding Performance.NetworkOutDiscards, Mode=OneWay}" /><Run Text=" discarded" />
                    </TextBlock>
                    <TextBlock Text="Cumulative since the adapter/driver last loaded, not a rate - any nonzero count can flag a failing NIC or a bad cable."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />
                    <!-- #32: TCP-level retransmits, distinct from the adapter/frame-level counters
                         above - a transport-level packet-loss signal (e.g. a congested/lossy
                         path) that can be nonzero even when the adapter itself reports clean. -->
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,10,0,0">
                        <Run Text="TCP retransmits: " /><Run Text="{Binding Performance.TcpRetransmitsPerSec, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text="/s" />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
