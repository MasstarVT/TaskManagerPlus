<UserControl x:Class="TaskManagerPlus.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- suggestions.md #501-509: always-on latency/jitter/packet-loss monitor - a
                 continuous probe ring with its own start/stop toggle, distinct from the
                 Connectivity card's existing single-shot 15s gateway/DNS check further down. See
                 LatencyMonitorService's remarks for the full design. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLatencyMonitoring}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Latency" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Interval (s)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Width="46" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                     Text="{Binding LatencyIntervalSeconds, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                            <Button Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Start monitoring" />
                                        <Setter Property="Command" Value="{Binding ToggleLatencyMonitorCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLatencyMonitoring}" Value="True">
                                                <Setter Property="Content" Value="Stop monitoring" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- #501: continuous ring - Gateway/First hop/Resolver, glow+core paired like
                         every other history chart in the app (PerformanceViewModel.LineOf). -->
                    <!-- #597: LatencyEventMarkers overlays #596 timeline events onto this chart's
                         own rolling window - see NetworkViewModel.RecomputeEventMarkers' remarks. -->
                    <lvc:CartesianChart Series="{Binding LatencySeries}" XAxes="{Binding LatencyHiddenXAxes}" YAxes="{Binding LatencyMsYAxes}"
                                         Sections="{Binding LatencyEventMarkers}"
                                         Height="160" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />

                    <!-- #504: baseline deviation badges - hidden individually when there's no
                         baseline yet or nothing to flag. -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding GatewayDeviationText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,3" Visibility="{Binding GatewayDeviationText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding FirstHopDeviationText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,3" Visibility="{Binding FirstHopDeviationText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ResolverDeviationText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Visibility="{Binding ResolverDeviationText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Flag when over" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox Width="40" Margin="6,0,4,0" VerticalContentAlignment="Center"
                                     Text="{Binding DeviationMultiplier, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                            <TextBlock Text="x your usual latency" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- #508: route-flap (TTL-change) summary. -->
                    <TextBlock Text="{Binding RouteFlapText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <!-- #502: packet-loss timeline strips, one per charted tier, plus a combined
                         "quick flag, not a verdict" caption distinguishing isolated drops from bursts. -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Packet loss" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Gateway" Width="70" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding GatewayLossStrip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="5" Height="14" Margin="1,0,0,0" CornerRadius="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PartOfBurst}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="First hop" Width="70" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding FirstHopLossStrip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="5" Height="14" Margin="1,0,0,0" CornerRadius="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PartOfBurst}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Resolver" Width="70" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding ResolverLossStrip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="5" Height="14" Margin="1,0,0,0" CornerRadius="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PartOfBurst}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding LossBreakdownText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>

                    <!-- #503: LAN vs ISP vs internet matrix - four fixed tiers, read live from the
                         same rolling window the chart above is built from. -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Latency matrix (LAN / ISP / internet)" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding LatencyMatrix}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tier" Binding="{Binding Label}" Width="1.1*" />
                                <DataGridTextColumn Header="Target" Binding="{Binding TargetHost}" Width="1.3*" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                                <DataGridTextColumn Header="Avg" Binding="{Binding AvgMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                                <DataGridTextColumn Header="Max" Binding="{Binding MaxMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                                <DataGridTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat={}{0:0.#}%}" Width="0.7*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Gateway bad points at your router/Wi-Fi, first-hop bad points at your ISP's local plant, only the resolver bad points upstream/peering - not started, or no data yet, shows as an empty table."
                                   Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <!-- #506: persisted 24h/7d latency history for the Gateway tier. -->
                    <StackPanel Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="History (Gateway)" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="24h" Command="{Binding ShowLatencyHistoryDayCommand}" Padding="8,3" Margin="0,0,4,0" />
                                <Button Content="7d" Command="{Binding ShowLatencyHistoryWeekCommand}" Padding="8,3" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LatencyHistoryPoints}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding BucketStartLocal, StringFormat='{}{0:MM/dd HH:mm}'}" FontSize="12" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="avg " /><Run Text="{Binding AvgMs, StringFormat={}{0:0.#} ms}" />
                                            <Run Text="  ·  max " /><Run Text="{Binding MaxMs, StringFormat={}{0:0.#} ms}" />
                                            <Run Text="  ·  loss " /><Run Text="{Binding LossPercent, StringFormat={}{0:0.#}%}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No history recorded yet - leave the monitor running for a while." Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatencyHistoryPoints.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #505: latency-under-load overlay - the existing throughput series plus the
                 Gateway latency series on a shared time axis (own right-hand scale), so a ping
                 spike lining up with a throughput spike reads as self-inflicted congestion
                 instead of an ISP fault. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Latency under load" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Throughput (left axis) and Gateway latency (right axis) on one shared time axis."
                               Style="{StaticResource SubStat}" Margin="0,-8,0,10" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding LatencyOverlaySeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding OverlayYAxes}"
                                         Height="200" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.NetworkColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Network" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.NetworkReceiveBps, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="{Binding Performance.NetworkSendBps, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate, StringFormat=Up: {0}}" Style="{StaticResource SubStat}" />
                </StackPanel>
            </Border>

            <!-- #584: link-utilization gauge - current throughput as a percent of the adapter's
                 negotiated link speed, so "1.2 MB/s" reads as "10% of a 100 Mbit link" or "1% of
                 gigabit". #585's adapter-throughput-reconciliation flag lands in the same card,
                 since both are about "is this the adapter I think it is, and how much of it am I
                 using". -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Link utilization" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding LinkUtilization, Converter={StaticResource NullToVisibilityConverter}}">
                        <views:VfdMeter Title="Of negotiated link speed" Glow="False" Width="150"
                                        Percent="{Binding LinkUtilization.UtilizationPercent}"
                                        ValueText="{Binding LinkUtilization.UtilizationPercent, StringFormat={}{0:0.#}}" Unit="%"
                                        SubText="{Binding LinkUtilization.AdapterName}"
                                        AccentBrush="{Binding LinkUtilization.UtilizationPercent, Converter={StaticResource PercentToBrushConverter}}" />
                        <TextBlock Style="{StaticResource SubStat}" Margin="14,4,0,0" TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="Negotiated link speed: " />
                            <Run Text="{Binding LinkUtilization.SpeedMbps, StringFormat={}{0:0} Mbps}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="No active adapter with a usable negotiated link speed was found." Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LinkUtilization}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #585: adapter-throughput reconciliation flag - hidden when nothing on a
                         non-primary adapter looks like a meaningful share of current traffic. -->
                    <Border Background="{DynamicResource WarningBrush}" Opacity="0.15" CornerRadius="4" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding AdapterTrafficFlagText, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding AdapterTrafficFlagText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Network chart -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.NetworkColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Throughput" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <!-- #597: ThroughputEventMarkers overlays #596 timeline events onto this
                         chart's own rolling window, the same way LatencyEventMarkers does above. -->
                    <lvc:CartesianChart Series="{Binding Performance.NetworkSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.NetworkYAxes}"
                                         Sections="{Binding ThroughputEventMarkers}"
                                         Height="200" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #579-581: on-demand speed test (internet, single-stream HTTP),
                 bufferbloat/latency-under-load grade, and a separate LAN-only throughput test - so
                 a slow #579 result can be told apart from a slow local Wi-Fi/LAN link, and a
                 latency-under-load complaint ("calls stutter when someone else downloads") gets an
                 actual A-F grade instead of a guess. Never on a timer - each is its own explicit
                 button with its own visible "running" status text. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Speed &amp; bufferbloat tests" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="A single-stream HTTP test - a rough floor on real capacity, not a certified/ISP-comparable figure. Endpoints default to Cloudflare's public no-auth speed-test service."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- #579: download / upload. -->
                    <TextBlock Text="Internet speed test" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding SpeedTestDownloadUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Test download" Padding="10,4" Command="{Binding RunDownloadTestCommand}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding SpeedTestUploadUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Test upload" Padding="10,4" Command="{Binding RunUploadTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SpeedTestStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <UniformGrid Columns="2" Margin="0,4,0,10">
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding LastDownloadResult, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Download" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding LastDownloadResult.Mbps, StringFormat={}{0:0.#} Mbps}" Style="{StaticResource BigStat}" FontSize="20" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0" Visibility="{Binding LastUploadResult, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Upload" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding LastUploadResult.Mbps, StringFormat={}{0:0.#} Mbps}" Style="{StaticResource BigStat}" FontSize="20" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- #580: bufferbloat / latency-under-load grade. -->
                    <TextBlock Text="Bufferbloat (latency under load)" Style="{StaticResource SpecLabel}" Margin="0,6,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding BufferbloatPingHost, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Run bufferbloat test" Padding="10,4" Command="{Binding RunBufferbloatTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding BufferbloatStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid Visibility="{Binding BufferbloatResult, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" Padding="14,6" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BufferbloatResult.Grade}" Value="C">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BufferbloatResult.Grade}" Value="D">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BufferbloatResult.Grade}" Value="F">
                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BufferbloatResult.Grade}" Value="N/A">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding BufferbloatResult.Grade}" FontSize="20" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12.5">
                                <Run Text="Idle " /><Run Text="{Binding BufferbloatResult.IdleLatencyMs, StringFormat={}{0:0.#} ms}" />
                                <Run Text="  →  Loaded " /><Run Text="{Binding BufferbloatResult.LoadedLatencyMs, StringFormat={}{0:0.#} ms}" />
                                <Run Text="  (+" /><Run Text="{Binding BufferbloatResult.DeltaMs, StringFormat={}{0:0.#} ms}" /><Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- #581: LAN-only throughput - either a large SMB-share read, or a raw TCP
                         stream to a listener started on another machine. -->
                    <TextBlock Text="LAN throughput" Style="{StaticResource SpecLabel}" Margin="0,6,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding LanTestSmbPath, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="\\server\share\largefile.ext" />
                        <Button Grid.Column="1" Content="Test SMB read" Padding="10,4" Command="{Binding RunLanSmbTestCommand}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding LanTestTcpTarget, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="192.168.1.20:5201" />
                        <Button Grid.Column="1" Content="Test TCP stream" Padding="10,4" Command="{Binding RunLanTcpTestCommand}" />
                    </Grid>
                    <TextBlock Text="SMB: point at a large file on a share you can already read. TCP: host:port of a raw byte-stream listener you started on the other machine (e.g. iperf/ncat) - this app is the client side only."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding LanTestStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />

                    <!-- #579's small history list, shared by #580/#581. -->
                    <TextBlock Text="Recent test history" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding NetworkTestHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimestampUtc, StringFormat='{}{0:MM/dd HH:mm}'}" FontSize="11.5" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="{Binding TestKind}" FontWeight="SemiBold" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Summary}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No tests run yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NetworkTestHistory.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Connectivity: on-demand/periodic gateway + DNS reachability, since it needs
                 actual network I/O rather than a local counter read - see NetworkViewModel's
                 remarks for why this is the one thing on this tab with its own (slow) timer. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connectivity" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- #46: hosts-file quick-open, for DNS override troubleshooting. -->
                            <Button Content="Open hosts file" Command="{Binding OpenHostsFileCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <!-- #24: opt-in, since it's a real outbound call to a third-party
                                 lookup service - never runs automatically. -->
                            <Button Content="Look up public IP" Command="{Binding LookupPublicIpCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Check now" Command="{Binding CheckConnectivityCommand}" Padding="10,4" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding PublicIpStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GatewayReachable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GatewayReachable}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="Gateway" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding GatewayStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DnsReachable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DnsReachable}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="Internet DNS" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DnsStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- #33: actual hostname resolution time - distinct from the ping-based
                             DNS reachability check to the left (which only proves the resolver
                             IP answers ICMP, not that name resolution itself is fast/working). -->
                        <StackPanel Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="DNS resolution" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DnsLookupText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- Round 9, #51: captive portal detection - distinct from a plain
                             gateway/DNS unreachable result (a portal answers HTTP, just not with
                             the expected NCSI body). -->
                        <StackPanel Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CaptivePortalDetected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CaptivePortalDetected}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="Captive portal" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CaptivePortalStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run Text="Proxy: " /><Run Text="{Binding ProxyStatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 19, #888: DNS posture - per-adapter configured DNS servers cross-referenced
                 against DHCP status (flags the "static DNS on an otherwise-DHCP adapter" shape a
                 DNS-hijack leaves), DNS-over-HTTPS template state, and NRPT policy rules.
                 Deliberately its own on-demand button, NOT part of the 15s connectivity timer
                 above - see NetworkViewModel/DnsPostureService's remarks for why. The
                 static-DNS-on-DHCP finding is mirrored to the Security tab's Network exposure
                 section via its own independent "Check DNS posture" button there. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DNS posture" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="10,4" Command="{Binding CheckDnsPostureCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Check DNS posture" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCheckingDnsPosture}" Value="True">
                                                <Setter Property="Text" Value="Checking..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding DnsPostureStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,8" TextWrapping="Wrap" />

                    <StackPanel Visibility="{Binding DnsPosture, Converter={StaticResource NullToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding DnsPosture.Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,6" CornerRadius="4" Background="{DynamicResource BgElevatedBrush}">
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="DHCP: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding DhcpEnabledText}" />
                                                <Run Text="   DNS servers: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Run Text="{Binding ConfiguredServers, Converter={StaticResource StringListJoinConverter}}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding StaticDnsOnDhcpAdapter, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Text="Static DNS set on an otherwise-DHCP adapter - the shape a DNS hijack leaves (also common as a deliberate choice, e.g. 1.1.1.1/8.8.8.8/a Pi-hole). Mirrored to the Security tab's Network exposure section." />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="DNS-over-HTTPS: " Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding DnsPosture.DohAvailabilityText}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DnsPosture.DohServers}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding ServerAddress}" /><Run Text=" - template: " /><Run Text="{Binding DohTemplate}" /><Run Text=" - auto-upgrade: " /><Run Text="{Binding AutoUpgradeText}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            <Run Text="NRPT policy rules: " Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding DnsPosture.NrptAvailabilityText}" />
                            <Run Text=" (" /><Run Text="{Binding DnsPosture.NrptRules.Count}" /><Run Text=" found - informational, most machines have none)" />
                        </TextBlock>
                    </StackPanel>
                    </StackPanel>
                </Border>

            <!-- suggestions.md #593: NLA / "No internet, secured" explainer - combines the NCSI
                 active-probe configuration, NlaSvc's own service state, and live results of the
                 same DNS-probe/HTTP-probe pair Windows itself runs, so when Windows' connectivity
                 icon disagrees with "but everything actually works" this shows exactly which of
                 the three checks is the one failing. Extends the Connectivity card's own #51
                 captive-portal flag above with the full picture, rather than duplicating it. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NCSI (&quot;No internet, secured&quot; explainer)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Re-check" Padding="10,4" Command="{Binding RunNcsiCheckCommand}" />
                    </Grid>
                    <TextBlock Text="Windows decides &quot;Internet access&quot; vs. &quot;No internet, secured&quot; vs. &quot;Limited&quot; from three checks: NlaSvc running, a DNS probe, and an HTTP probe. This re-runs the same two live probes so you can see which one actually failed."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.7" />

                    <TextBlock Text="Checking..." Style="{StaticResource SubStat}" Margin="0,0,0,10" Visibility="{Binding IsCheckingNcsi, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Visibility="{Binding NcsiResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding NcsiResult.ExplainerText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="NlaSvc" Style="{StaticResource SpecLabel}" Margin="0" />
                                <TextBlock Text="{Binding NcsiResult.NlaSvcStateText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="8,0,8,0">
                                <TextBlock Text="DNS probe" Style="{StaticResource SpecLabel}" Margin="0" />
                                <TextBlock Text="{Binding NcsiResult.DnsProbeOkText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NcsiResult.DnsProbeDetail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="HTTP probe" Style="{StaticResource SpecLabel}" Margin="0" />
                                <TextBlock Text="{Binding NcsiResult.WebProbeOkText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding NcsiResult.WebProbeDetail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- suggestions.md #591/#592/#594: IPv6 - decodes the DisabledComponents registry
                 override into readable terms, shows the RFC 6724 prefix-policy table, an on-demand
                 A-vs-AAAA dual-stack reachability comparison, and Teredo/6to4/ISATAP transition-
                 tunnel state (hidden when every tunnel is dormant). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IPv6" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshIpv6Command}" />
                    </Grid>

                    <!-- #591: DisabledComponents decode. -->
                    <TextBlock Text="IPv6 stack configuration" Style="{StaticResource SpecLabel}" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding Ipv6DisabledComponents.SummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Ipv6DisabledComponents.SetFlags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,2"
                               Visibility="{Binding Ipv6DisabledComponents.UnrecognizedBitsHex, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Also has unrecognized bit(s) set: " /><Run Text="{Binding Ipv6DisabledComponents.UnrecognizedBitsHex}" FontFamily="Consolas" />
                    </TextBlock>

                    <!-- #591: prefix-policy table. -->
                    <TextBlock Text="Prefix policy table (netsh int ipv6 show prefixpolicies)" Style="{StaticResource SpecLabel}" Margin="0,14,0,4" />
                    <DataGrid ItemsSource="{Binding Ipv6PrefixPolicies}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Precedence" Binding="{Binding Precedence}" Width="1*" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="1*" />
                            <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="A ::ffff:0:0/96 row ranked ahead of ::/0 means Windows is currently preferring IPv4 over native IPv6 for dual-stack destinations."
                               Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <!-- #594: transition-tunnel state - hidden entirely when every tunnel is dormant. -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TransitionTunnels.AllDormant}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Transition tunnels" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding TransitionTunnels.Tunnels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Kind}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="12.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LooksActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="An active tunnel adapter can add latency or break name resolution if it's half-configured - worth checking if things feel slow only sometimes."
                                   Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>

                    <!-- #592: dual-stack (A vs. AAAA) reachability comparison. -->
                    <TextBlock Text="Dual-stack reachability test" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <TextBlock Text="Resolves both A and AAAA for a hostname and times a TCP connect over each family separately - catches the classic &quot;AAAA is advertised but IPv6 is broken&quot; multi-second stall."
                               Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" Opacity="0.7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding DualStackHostname, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Test" Padding="10,4" Command="{Binding RunDualStackTestCommand}" />
                    </Grid>
                    <StackPanel Visibility="{Binding DualStackResult, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding DualStackResult.Verdict}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6" FontWeight="SemiBold" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="IPv4 (A)" Style="{StaticResource SpecLabel}" Margin="0" />
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding DualStackResult.V4.Address, TargetNullValue='No A record'}" FontFamily="Consolas" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding DualStackResult.V4.ConnectedText}" />
                                    <Run Text=" (" /><Run Text="{Binding DualStackResult.V4.ConnectMs, StringFormat={}{0:0} ms}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="IPv6 (AAAA)" Style="{StaticResource SpecLabel}" Margin="0" />
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding DualStackResult.V6.Address, TargetNullValue='No AAAA record'}" FontFamily="Consolas" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding DualStackResult.V6.ConnectedText}" />
                                    <Run Text=" (" /><Run Text="{Binding DualStackResult.V6.ConnectMs, StringFormat={}{0:0} ms}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- suggestions.md #517-526: DNS resolution, cache and configuration - one card
                 bundling every DNS-focused diagnostic, the same "one card per feature cluster"
                 shape the Latency card above already uses for #501-509. #525's reverse-DNS
                 enrichment instead lives on the existing Active connections grid further down,
                 since it extends that grid directly rather than adding a new one. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DNS" Style="{StaticResource CardTitle}" />

                    <!-- #519: configured resolvers per adapter - "answered first" is filled in
                         once a #517 compare run below has actually completed. -->
                    <TextBlock Text="Configured resolvers" Style="{StaticResource SpecLabel}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding ConfiguredResolvers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding AdapterName}" FontWeight="SemiBold" />
                                        <Run Text=" — " /><Run Text="{Binding ResolverIp}" FontFamily="Consolas" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="answered first" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Visibility="{Binding IsFirstResponder, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No adapter has a configured resolver.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfiguredResolvers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #517: multi-resolver comparison - the adapter's own resolver(s) plus
                         1.1.1.1/8.8.8.8/9.9.9.9, side by side. -->
                    <TextBlock Text="Compare a hostname across resolvers" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DnsCompareHostname, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Compare" Padding="10,4" Command="{Binding RunDnsCompareCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DnsCompareStatusText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DnsCompareAnswers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Resolver" Binding="{Binding ResolverIp}" Width="1*" />
                            <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="1.1*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding ElapsedMs, StringFormat={}{0} ms}" Width="0.7*" />
                            <DataGridTextColumn Header="Answers" Binding="{Binding Answers, Converter={StaticResource StringListJoinConverter}}" Width="2.2*" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="1.4*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="A blank Adapter column means a fixed public resolver added purely for comparison, not one of yours. Divergent answers can mean a hijacking/filtering resolver, a stale cache, or just normal GeoDNS/CDN load-balancing - quick flag, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <!-- #520: DNS-over-HTTPS configuration - read-only. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Encrypted DNS (DoH)" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" Command="{Binding RefreshDohConfigCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DohSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DohStatuses}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.3*" />
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerAddress}" Width="1.1*" />
                            <DataGridTextColumn Header="Encryption" Binding="{Binding EncryptionStatus}" Width="1*" />
                            <DataGridTextColumn Header="Auto-upgrade" Binding="{Binding AutoUpgrade}" Width="1*" />
                            <DataGridTextColumn Header="UDP fallback" Binding="{Binding UdpFallback}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Text="{Binding DohRawOutput, Mode=OneWay}" Margin="0,8,0,0" MaxHeight="110"
                             IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />

                    <!-- #521: NRPT split-DNS rules - hidden entirely when none exist. -->
                    <Expander Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NrptRules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="Split-DNS policy (NRPT)" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Namespace rules pushed by a VPN or group policy that route specific suffixes to specific servers - the reason internal hostnames resolve on VPN and nothing else does, or vice versa."
                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85" />
                            <ItemsControl ItemsSource="{Binding NrptRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap">
                                            <Run Text="{Binding Namespaces, Converter={StaticResource StringListJoinConverter}}" FontWeight="SemiBold" />
                                            <Run Text=" → " /><Run Text="{Binding DnsServers}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- #523: suffix/search list - collapsed by default. -->
                    <Expander Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="DNS suffix &amp; search list" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,6">
                                <Run Text="Primary suffix: " /><Run Text="{Binding PrimaryDnsSuffixText}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="Search list" Style="{StaticResource SpecLabel}" Margin="0,4,0,4" />
                            <ItemsControl ItemsSource="{Binding DnsSearchList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource SubStat}" Margin="0,0,0,3" FontFamily="Consolas" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="(none configured)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DnsSearchList.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Per-adapter suffixes" Style="{StaticResource SpecLabel}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding AdapterDnsSuffixes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="{Binding AdapterName}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Suffix}" FontFamily="Consolas" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- #518: DNS cache viewer with flush. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Resolver cache" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="10,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DnsCacheSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Content="Refresh" Padding="8,3" Margin="0,0,8,0" Command="{Binding RefreshDnsCacheCommand}" />
                        <Button Grid.Column="3" Content="Flush cache" Padding="8,3" Command="{Binding FlushDnsCacheCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DnsCacheStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding DnsCacheEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,8,0,0" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding RecordName}" Width="1.6*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding RecordType}" Width="0.6*" />
                            <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="0.6*" />
                            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="1.6*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #522: hosts file parser with shadowing flags - beyond the existing "Open
                         hosts file" shortcut on the Connectivity card above. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hosts file" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" Command="{Binding RefreshHostsFileCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding HostsEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="0.5*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="1*" />
                            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="1.6*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="This hostname appears more than once in the hosts file - Windows uses whichever line comes first." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlackholed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="A well-known public domain is pointed at a blackhole address - could be an ad-blocker, or could be malware. Quick flag, not a verdict." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShadowsRecentLookup}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="ToolTip" Value="This entry overrides the hostname most recently compared above." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="No entries found (or the hosts file couldn't be read).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HostsEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #524: DNS-Client event log failure/timeout scan - explicit Scan button per
                         the on-demand-for-event-logs convention. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Failure / timeout scan" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DnsScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanDnsFailuresCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DnsScanStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="By queried name" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding DnsFailuresByName}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3" TextWrapping="Wrap">
                                            <Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Count}" />
                                            <Run Text=" (last " /><Run Text="{Binding LastSeenUtc, StringFormat={}{0:g}}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="By resolver" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding DnsFailuresByResolver}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3" TextWrapping="Wrap">
                                            <Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Count}" />
                                            <Run Text=" (last " /><Run Text="{Binding LastSeenUtc, StringFormat={}{0:g}}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- #526: per-resolver DNS response-time chart, sharing the Latency card's own
                         Start/Stop monitoring toggle above rather than getting a new one - see
                         NetworkViewModel.ToggleLatencyMonitor's remarks. -->
                    <TextBlock Text="Per-resolver response time" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <TextBlock Text="Shares the Latency card's Start/Stop monitoring toggle at the top of this page - start monitoring there to see this chart update."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
                    <lvc:CartesianChart Series="{Binding DnsResponseSeries}" XAxes="{Binding DnsResponseHiddenXAxes}" YAxes="{Binding DnsResponseMsYAxes}"
                                         Height="180" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent"
                                         LegendTextPaint="{Binding Performance.LegendTextPaint}" LegendBackgroundPaint="{Binding Performance.LegendBackgroundPaint}"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                </StackPanel>
            </Border>

            <!-- Adapters: negotiated link speed per active adapter (#31, flags a "Gigabit"
                 adapter that negotiated down - a classic bad-cable/bad-port symptom) and VPN
                 presence (#37, a heuristic name/type match, not a "traffic is routed through it"
                 guarantee). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Adapters" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding AdapterLinks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SpeedMbps, StringFormat={}{0:0} Mbps}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksDegraded}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- #553: configured Speed & Duplex keyword (Auto vs. a forced
                                         value) - the actual mismatch cause, not just the negotiated-
                                         speed symptom above. Colored the same way LooksDegraded
                                         colors the negotiated-speed value above; hidden entirely
                                         when the driver doesn't register a `*SpeedDuplex` keyword at
                                         all (most Wi-Fi adapters). -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0" FontSize="11.5"
                                               Visibility="{Binding ConfiguredSpeedDuplex, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Run Text="Configured: " Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding ConfiguredSpeedDuplex}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfiguredLooksForcedOrHalfDuplex}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active adapters detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AdapterLinks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SubStat}" Margin="0" VerticalAlignment="Center">
                            <Run Text="VPN: " /><Run Text="{Binding VpnStatusText, Mode=OneWay}" />
                        </TextBlock>
                        <!-- #577: a real behavioural check (default-route ownership + a live DNS
                             query), distinct from the name-substring VPN presence heuristic to the
                             left - on-demand since it needs a routing-table read and a fresh nslookup. -->
                        <Button Grid.Column="1" Padding="8,3" Command="{Binding RunVpnTunnelCheckCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Check tunnel &amp; DNS" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCheckingVpnTunnel}" Value="True">
                                            <Setter Property="Content" Value="Checking..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding VpnTunnelCheck, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding VpnTunnelCheck.DefaultRouteExplanation}" TextWrapping="Wrap" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VpnTunnelCheck.VpnHoldsDefaultRoute}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding VpnTunnelCheck.DnsLeakExplanation}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VpnTunnelCheck.ResolverLooksOutsideVpn}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- #511: per-adapter configured MTU, cross-referenced against the most
                         recent #510 discovered path MTU - flags an interface configured larger
                         than the path can actually carry. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Interface MTU" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="8,3" Command="{Binding RefreshInterfaceMtusCommand}" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding InterfaceMtus}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,6,0,0" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.6*" />
                            <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="0.7*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMismatched}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding MismatchReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="Run Path MTU discovery below to flag an interface configured larger than the path can carry."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <!-- Round 9, #48: adapter driver version/date - a date-based "worth a manual
                         check" heuristic, the same one ReadOutdatedDrivers uses elsewhere, NOT a
                         claim that a newer version is actually known to exist online. #556 adds the
                         "packages present on this PC" list underneath each one - staged Driver Store
                         packages matched by INF name/provider, so the user can see whether an older
                         or newer package is already on the machine to roll back to, again NOT any
                         online claim. -->
                    <ItemsControl ItemsSource="{Binding AdapterDrivers}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                        <Run Text="{Binding DeviceName}" FontWeight="SemiBold" />
                                        <Run Text=" — driver " /><Run Text="{Binding DriverVersion}" />
                                        <Run Text=" (" /><Run Text="{Binding DriverDate, StringFormat={}{0:d}, TargetNullValue=unknown date}" /><Run Text=")" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding StagedPackages}" Margin="12,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="•" /> <Run Text="{Binding PublishedName}" FontFamily="Consolas" />
                                                    <Run Text=" (" /><Run Text="{Binding OriginalName}" /><Run Text=") — " />
                                                    <Run Text="{Binding ProviderName}" /><Run Text=", " />
                                                    <Run Text="{Binding DriverVersion}" />
                                                    <Run Text=" (" /><Run Text="{Binding DriverDate, StringFormat={}{0:d}, TargetNullValue=unknown date}" /><Run Text=")" />
                                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}">
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Setter Property="Text" Value="" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentlyInstalled}" Value="True">
                                                                        <Setter Property="Text" Value=" — currently installed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No other packages for this class found in the Driver Store." FontSize="11.5" Margin="12,1,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StagedPackages.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Round 9, #52: metered-connection flag - relevant context for this app's
                         own logging/remote-monitoring bandwidth use, not just informational.
                         #595 adds the network Category (Public/Private/Domain) alongside it, from
                         the same per-profile registry read - see MeteredConnectionService's
                         remarks for why every Public profile gets the same hedged flag rather than
                         trying to guess "should this be Private". -->
                    <ItemsControl ItemsSource="{Binding MeteredAdapters}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource SubStat}">
                                        <Run Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                        <Run Text=" — " /><Run Text="{Binding CostText}" />
                                        <Run Text="   Category: " /><Run Text="{Binding CategoryText}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="Public network - discovery, printer sharing and inbound SMB are blocked while this is set. If this is actually a home or office network, you can change it in Settings &gt; Network &amp; Internet."
                                               FontSize="11" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksStuckPublic}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- suggestions.md #547-556: Adapter health - per-adapter error/discard rates (#547),
                 an on-demand link-flap/reset scan (#548), the Device Manager "Advanced" tab nobody
                 can find (#549) with known-problem flags on top of it (#550), "allow the computer
                 to turn off this device" detection (#551), machine-wide TCP/IP offload settings
                 (#552), a #554 per-adapter clean/marginal/bad heuristic headline, and a "Restart
                 this adapter" action (#555) behind an explicit confirm. #553 (configured Speed &amp;
                 Duplex) and #556 (staged driver packages) extend the existing Adapters card above
                 instead of duplicating here. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Adapter health" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Driver, offload, power-management and link-quality detail per adapter - the Device Manager Advanced tab and Power Management checkbox nobody can find, in one place."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- #552: machine-wide TCP/IP offload settings, from `netsh int tcp show global`. -->
                    <TextBlock Text="TCP/IP offload (machine-wide)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                        <Run Text="Receive-Side Scaling: " /><Run Text="{Binding TcpGlobalSettings.ReceiveSideScalingState}" FontWeight="SemiBold" />
                        <Run Text="   Chimney Offload: " /><Run Text="{Binding TcpGlobalSettings.ChimneyOffloadState}" FontWeight="SemiBold" />
                        <Run Text="   Receive Segment Coalescing: " /><Run Text="{Binding TcpGlobalSettings.ReceiveSegmentCoalescingState}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="Read-only - this app never changes these. A buggy driver with LSO or RSC enabled can produce stalled-but-not-dead connections that look like a server problem rather than a local offload bug."
                               Style="{StaticResource SubStat}" Margin="0,4,0,16" TextWrapping="Wrap" Opacity="0.7" />

                    <!-- #548: on-demand link-flap/reset scan - the System log's own 27/32/33
                         link-state events, whichever vendor provider logged them. -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Link-flap / reset scan" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding LinkFlapScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanLinkFlapsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding LinkFlapScanStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding LinkFlapEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True"
                              MaxHeight="220" Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeUtc, StringFormat={}{0:g}}" Width="1.3*" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="1*" />
                            <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="1.2*" />
                            <DataGridTextColumn Header="Adapter hint" Binding="{Binding AdapterHint, TargetNullValue=''}" Width="1.3*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No scan run yet - set a window above and click Scan.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LinkFlapEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #555: restart action - target adapter picked from the same set listed
                         below, behind an explicit Yes/No confirm since it briefly drops the
                         connection. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding AdapterHealth}"
                                  DisplayMemberPath="AdapterName" SelectedValuePath="AdapterName"
                                  SelectedValue="{Binding SelectedHealthAdapterName}" />
                        <Button Grid.Column="1" Content="Restart this adapter" Padding="10,4" Command="{Binding RestartAdapterCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding RestartAdapterStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,16" TextWrapping="Wrap" />

                    <!-- Per-adapter detail: #547 error/discard deltas, #549/#550 advanced
                         properties + known-problem flags, #551 power management, #552's per-
                         adapter offload keywords, #554's quality headline. -->
                    <ItemsControl ItemsSource="{Binding AdapterHealth}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <StackPanel>
                                        <!-- #554: headline. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding AdapterName}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="9,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LinkQualityLabel}" Value="Clean">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LinkQualityLabel}" Value="Bad">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LinkQualityLabel}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding LinkQualityReason}" Style="{StaticResource SubStat}" Margin="0,3,0,2" TextWrapping="Wrap" Opacity="0.85" />
                                        <TextBlock Text="Link quality is a heuristic (link-state changes + error rate) - a quick flag, not a verdict."
                                                   Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.6" FontStyle="Italic" />

                                        <!-- #547: per-tick error/discard deltas - the whole card
                                             border turns danger-colored while the current rate is
                                             nonzero, same "color = flag" treatment the existing
                                             Adapter errors card uses. -->
                                        <TextBlock Text="Error / discard rate (this tick)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCurrentErrorRate}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="In: " /><Run Text="{Binding RxErrorsDelta}" /><Run Text=" errors, " />
                                            <Run Text="{Binding RxDiscardsDelta}" /><Run Text=" discarded  •  Out: " />
                                            <Run Text="{Binding TxErrorsDelta}" /><Run Text=" errors, " />
                                            <Run Text="{Binding TxDiscardsDelta}" /><Run Text=" discarded" />
                                        </TextBlock>
                                        <TextBlock Text="Non-zero receive errors on Ethernet almost always mean a bad cable or port."
                                                   Style="{StaticResource SubStat}" Margin="0,2,0,12" TextWrapping="Wrap" Opacity="0.7" />

                                        <!-- #551: power management. -->
                                        <TextBlock Text="Power management" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding PowerManagement.Explanation}" TextWrapping="Wrap" Margin="0,0,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerManagement.DeviceMayBePoweredOff}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,2">
                                            <Run Text="ARP offload: " /><Run Text="{Binding ArpOffloadText}" FontWeight="SemiBold" />
                                            <Run Text="   Wake on Magic Packet: " /><Run Text="{Binding WakeOnMagicPacketText}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <Grid Margin="0,2,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="To change this: Device Manager &gt; Network adapters &gt; this adapter &gt; Properties &gt; Power Management tab."
                                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Open Device Manager" Padding="8,3"
                                                    Command="{Binding DataContext.OpenDeviceManagerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Grid>

                                        <!-- #550: known-problem setting flags - hidden entirely when clean. -->
                                        <StackPanel Margin="0,0,0,10">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProblemFlags.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Worth a look, not a verdict" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding ProblemFlags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontSize="11.5" Foreground="{DynamicResource WarningBrush}">
                                                            <Run Text="{Binding Title}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Detail}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- #549: full advanced-property viewer, and #552's offload
                                             subset of the same list - both collapsed by default. -->
                                        <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock Text="Advanced properties" Style="{StaticResource CardTitle}" Margin="0" FontSize="12.5" />
                                            </Expander.Header>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="The Device Manager &quot;Advanced&quot; tab for this adapter - read-only here."
                                                           Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" Opacity="0.7" />
                                                <ItemsControl ItemsSource="{Binding AdvancedProperties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="This driver doesn't register any advanced properties.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AdvancedProperties.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- #552: offload-related subset of the list above. -->
                                                <TextBlock Text="Offload settings (LSO / RSC / checksum / RSS)" Style="{StaticResource SpecLabel}" Margin="0,12,0,4" />
                                                <ItemsControl ItemsSource="{Binding OffloadProperties}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="No offload-related keywords found for this driver.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OffloadProperties.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active adapters detected.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AdapterHealth.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #578: orphaned virtual/VPN adapter detection - a new section on this
                         existing card rather than a separate one, per this item's own text. The
                         result list is naturally empty (and so invisible) on a clean machine; only
                         the scan control and status line always show. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Orphaned virtual/VPN adapters" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="8,3" Command="{Binding ScanOrphanedAdaptersCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Scan" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanningOrphanedAdapters}" Value="True">
                                            <Setter Property="Content" Value="Scanning..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="Cross-references TAP/tunnel/VPN-looking adapters against installed services and staged driver packages by name - flags a leftover from an uninstalled client that may still hold routes or bind filters. Name-based matching only - quick flag, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,4,0,6" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock Text="{Binding OrphanedAdapterStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding OrphanedAdapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="9" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AdapterName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SubStat}" Margin="0,2,0,4" TextWrapping="Wrap" Opacity="0.85" />
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 9, #45: historical connection-count totals by process, today and this
                 month - a persisted aggregate of the same honest connection-count proxy the live
                 "Top network processes" card above already uses, NOT real byte-level bandwidth
                 history (Windows exposes no public API for that - see NetworkHistoryService), EXCEPT
                 (#583) for any process/day where a #582 ETW capture was actually run - those rows
                 show the real byte totals instead, clearly distinguished with an up/down arrow. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Historical connection activity" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Daily/monthly totals of the connection-count proxy above, except where a #582 ETW capture was actually run for that process - those rows show real bytes instead (marked with ↑↓)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Today" Style="{StaticResource SpecLabel}" />
                            <ItemsControl ItemsSource="{Binding HistoryToday}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="{Binding ProcessName}" /><Run Text=": " />
                                            <Run Text="{Binding ConnectionCountTotal}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasByteData}" Value="True">
                                                                <Setter Property="Text" Value="{Binding BytesSentTotal, Converter={StaticResource BytesToReadableConverter}, StringFormat='↑{0}'}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                            <Run Text=" ↓" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Text" Value="" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasByteData}" Value="True">
                                                                <Setter Property="Text" Value="{Binding BytesReceivedTotal, Converter={StaticResource BytesToReadableConverter}, StringFormat=' ↓{0}'}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="This month" Style="{StaticResource SpecLabel}" />
                            <ItemsControl ItemsSource="{Binding HistoryThisMonth}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="{Binding ProcessName}" /><Run Text=": " />
                                            <Run Text="{Binding ConnectionCountTotal}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasByteData}" Value="True">
                                                                <Setter Property="Text" Value="{Binding BytesSentTotal, Converter={StaticResource BytesToReadableConverter}, StringFormat='↑{0}'}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                            <Run Text="" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run.Style>
                                                    <Style TargetType="Run">
                                                        <Setter Property="Text" Value="" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasByteData}" Value="True">
                                                                <Setter Property="Text" Value="{Binding BytesReceivedTotal, Converter={StaticResource BytesToReadableConverter}, StringFormat=' ↓{0}'}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Run.Style>
                                            </Run>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Round 9, #50: on-demand jitter/packet-loss quick test - min/max/avg over N pings,
                 alongside the existing single-shot gateway/DNS latency reading above. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Jitter / packet loss test" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding JitterTestHost, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Run test (10 pings)" Padding="10,4" Command="{Binding RunJitterTestCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding JitterTestResultText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Round 9, #49: on-demand traceroute to a user-entered host - shells to tracert.exe.
                 #516 adds "Save as baseline" / "Compare to baseline" beside the output box, plus
                 the diff results below it. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Traceroute" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding TracerouteHost, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Traceroute" Padding="10,4" Command="{Binding RunTracerouteCommand}" />
                    </Grid>
                    <TextBox Text="{Binding TracerouteOutput, Mode=OneWay}" Margin="0,8,0,0" MaxHeight="240"
                             IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />

                    <!-- #516: save the run above as a named baseline, or diff it against one
                         already saved - turns the text dump above into an actionable "your ISP
                         rerouted you" signal instead of two blocks of text to eyeball. -->
                    <TextBlock Text="Baseline diff" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding TracerouteBaselineName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Save as baseline" Padding="10,4" Command="{Binding SaveTracerouteBaselineCommand}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding TracerouteBaselineNames}"
                                  SelectedItem="{Binding SelectedTracerouteBaseline}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Compare to baseline" Padding="10,4" Command="{Binding CompareTracerouteBaselineCommand}" />
                    </Grid>
                    <TextBlock Text="Run a traceroute above first - Save/Compare act on the most recently completed run."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />

                    <TextBlock Text="{Binding TracerouteDiffSummaryText}" Style="{StaticResource SubStat}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding TracerouteDiffSummaryText, Converter={StaticResource NullToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding TracerouteDiff}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BaselineHop, TargetNullValue=—, StringFormat=hop {0}}" FontSize="11.5" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentHop, TargetNullValue=—, StringFormat=hop {0}}" FontSize="11.5" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="2" Text="{Binding Ip}" FontSize="11.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Inserted">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Reordered">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #510/#512: on-demand path MTU discovery, plus the derived PMTUD black-hole
                 verdict from the same sweep - a dozen-plus round trips, never on a tick. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Path MTU discovery" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Binary-searches the largest packet that survives with DontFragment set, then reports the discovered path MTU."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding PathMtuTargetHost, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Discover path MTU" Padding="10,4" Command="{Binding RunPathMtuCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PathMtuResultText}" Style="{StaticResource SubStat}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <!-- #512: PMTUD black-hole verdict - hidden until a sweep actually flags one. -->
                    <TextBlock Text="{Binding PathMtuBlackHoleText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding PathMtuBlackHoleText, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- #515: MTR-style continuous hop monitor - own explicit start/stop toggle, distinct
                 from the one-shot traceroute above. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MTR (continuous hop monitor)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="160" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding MtrHost, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Start" />
                                    <Setter Property="Command" Value="{Binding ToggleMtrCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMtrRunning}" Value="True">
                                            <Setter Property="Content" Value="Stop" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="Repeatedly probes every hop with increasing-TTL pings, attributing sent/received/loss/min/avg/max to a specific hop over time - distinct from the one-shot traceroute above."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.85" />
                    <DataGrid ItemsSource="{Binding MtrHops}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="50" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Address, TargetNullValue='(no reply)'}" Width="1.4*" />
                            <DataGridTextColumn Header="Sent" Binding="{Binding Sent}" Width="0.6*" />
                            <DataGridTextColumn Header="Recv" Binding="{Binding Received}" Width="0.6*" />
                            <DataGridTextColumn Header="Loss" Binding="{Binding LossPercent, StringFormat={}{0:0.#}%}" Width="0.7*" />
                            <DataGridTextColumn Header="Min" Binding="{Binding MinMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                            <DataGridTextColumn Header="Avg" Binding="{Binding AvgMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxMs, StringFormat={}{0:0.#} ms}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Not started - enter a host and click Start.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MtrHops.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #513/#514: routing table viewer with conflict flags, plus the separate
                 persistent-route section - the fastest way to see a VPN or virtual adapter
                 hijacking traffic, or a stale persistent route left by an uninstalled one. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Routing" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshRoutingCommand}" />
                    </Grid>
                    <TextBlock Text="Flags more than one default route, duplicate routes to the same prefix at an equal metric, and on-link routes that don't match their own interface's subnet. Quick flag, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.85" />
                    <DataGrid ItemsSource="{Binding Routes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*" />
                            <DataGridTextColumn Header="Netmask" Binding="{Binding Netmask}" Width="1.1*" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="1.2*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceLabel}" Width="1.2*" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="0.6*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding FlagReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- #514: persistent routes - read from the registry, not route print's own
                         Persistent Routes section, per this item's own spec. -->
                    <TextBlock Text="Persistent routes (survive a reboot)" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <TextBlock Text="A stale persistent route left by an uninstalled VPN silently fails to apply rather than showing up as visibly broken - worth checking against the live table above."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.7" />
                    <DataGrid ItemsSource="{Binding PersistentRoutes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*" />
                            <DataGridTextColumn Header="Netmask" Binding="{Binding Netmask}" Width="1.1*" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="1.2*" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="None found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersistentRoutes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #535: per-adapter routing metric + "which adapter wins" for outbound
                         traffic - the classic "Ethernet is plugged in but everything goes over
                         Wi-Fi" confusion explained by the numbers, not just asserted. Shares this
                         card's own Refresh button above rather than getting a second one, since
                         it's another netsh shell-out refreshed on the same on-demand cadence. -->
                    <TextBlock Text="Interface metrics" Style="{StaticResource SpecLabel}" Margin="0,14,0,6" />
                    <TextBlock Text="{Binding AdapterWinnerText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding InterfaceMetrics}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.6*" />
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="0.7*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No interface metrics found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InterfaceMetrics.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- suggestions.md #527/#528/#529/#530/#531/#534: "Addressing" card - DHCP lease detail
                 with expiry/rogue-server flags (#527), an APIPA banner with a one-click Renew
                 (#528), Release/Renew/Register-DNS actions behind an explicit confirmation since
                 they briefly drop connectivity (#529, the same MessageBox.Show Yes/No pattern
                 ProcessesViewModel's own disruptive "End process" action already uses), an
                 on-demand DHCP-Client event timeline (#530), an on-demand IP-conflict log
                 correlation + active gratuitous-ARP probe (#531), and a per-adapter addressing
                 sanity checklist (#534). All read from one DhcpAddressingService.ReadAll() sweep
                 per adapter, so the per-adapter block below shows every flag together rather than
                 splitting them across separate lists. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Addressing" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshAddressingCommand}" />
                    </Grid>
                    <TextBlock Text="DHCP lease detail, APIPA/self-assigned-address detection, and an addressing sanity checklist - one block per IP-configured adapter."
                               Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.85" />

                    <ItemsControl ItemsSource="{Binding Addressing}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApipa}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="Opacity" Value="0.9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontSize="13">
                                            <Run Text="{Binding AdapterName}" FontWeight="SemiBold" />
                                            <Run Text=" — " /><Run Text="{Binding IpAddress}" FontFamily="Consolas" />
                                            <Run Text="/" /><Run Text="{Binding SubnetMask}" FontFamily="Consolas" />
                                        </TextBlock>

                                        <!-- #528: APIPA banner - "DHCP failed, no address was offered", with a Renew shortcut
                                             scoped to this adapter regardless of what's selected in the Actions section below. -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsApipa, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="DHCP failed — no address was offered. This 169.254.x.x address is self-assigned (APIPA); the adapter never heard back from a DHCP server, so it can only talk to other devices on the same self-assigned range."
                                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <Button Content="Renew this adapter" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RenewApipaAdapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding LeaseStatusText}" Margin="0,6,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LeaseExpiringSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding DhcpServer, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="DHCP server: " /><Run Text="{Binding DhcpServer}" FontFamily="Consolas" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding DefaultGateway, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Gateway: " /><Run Text="{Binding DefaultGateway}" FontFamily="Consolas" />
                                        </TextBlock>

                                        <!-- #527: rogue-DHCP-server flag. -->
                                        <TextBlock Text="{Binding RogueDhcpReason}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding RogueDhcpReason, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- #534: addressing sanity checklist. -->
                                        <ItemsControl ItemsSource="{Binding SanityFlags}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource SubStat}" Margin="0,0,0,3" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No IP-configured adapters found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Addressing.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #529: release / renew / register-DNS, each behind an explicit confirmation
                         (see NetworkViewModel.ReleaseSelectedAdapter's remarks) since they briefly
                         drop connectivity. -->
                    <TextBlock Text="Actions" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Addressing}" DisplayMemberPath="AdapterName"
                                  SelectedItem="{Binding SelectedAddressingAdapter}" />
                        <Button Grid.Column="1" Content="Release" Padding="10,4" Margin="0,0,6,0" Command="{Binding ReleaseAddressCommand}" />
                        <Button Grid.Column="2" Content="Renew" Padding="10,4" Margin="0,0,6,0" Command="{Binding RenewAddressCommand}" />
                        <Button Grid.Column="3" Content="Register DNS" Padding="10,4" Command="{Binding RegisterDnsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DhcpActionStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <!-- #530: DHCP-Client event timeline - explicit Scan button per the
                         on-demand-for-event-logs convention. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DHCP lease event timeline" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding DhcpScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanDhcpEventsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DhcpScanStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding DhcpEvents}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11.5">
                                    <Run Text="{Binding TimeUtc, StringFormat={}{0:g}}" FontFamily="Consolas" />
                                    <Run Text=" [" /><Run Text="{Binding Channel}" /><Run Text="/" /><Run Text="{Binding Category}" FontWeight="SemiBold" /><Run Text="] " />
                                    <Run Text="{Binding Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #531: IP-conflict log correlation + active gratuitous-ARP probe. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP address conflicts" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding IpConflictScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan log" Padding="10,4" Command="{Binding ScanIpConflictsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding IpConflictScanStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding IpConflictEvents}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MatchesCurrentAddress}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding TimeUtc, StringFormat={}{0:g}}" FontFamily="Consolas" />
                                    <Run Text=" — IP " /><Run Text="{Binding ConflictingIp, TargetNullValue=unknown}" FontFamily="Consolas" />
                                    <Run Text=", MAC " /><Run Text="{Binding ConflictingMac, TargetNullValue='not in event data'}" FontFamily="Consolas" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Active check: sends a live ARP request for the selected adapter's own address and flags any other host that answers for it - a duplicate-address-detection probe, same idea as a gratuitous ARP. Quick flag, not a verdict."
                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Probe now" Padding="10,4" Command="{Binding ProbeGratuitousArpCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding GratuitousArpResultText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #532/#533: "ARP / neighbours" card - the neighbour cache as a
                 sortable grid with OUI vendor lookup (#532), flags for two IPs sharing one MAC and
                 an incomplete gateway entry (#532), and a gateway-MAC-change alert persisted per
                 network profile (#533). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ARP / neighbours" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshArpCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding ArpStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!-- #533: gateway-MAC-change alert - hidden entirely when there's nothing to flag. -->
                    <TextBlock Text="{Binding GatewayMacChangeText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                               Visibility="{Binding GatewayMacChangeText, Converter={StaticResource NullToVisibilityConverter}}" />

                    <DataGrid ItemsSource="{Binding ArpEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="1.1*" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="1.4*" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceName}" Width="1.1*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="0.8*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGateway}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="ToolTip" Value="This is the default gateway." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding FlagReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Text="No ARP entries found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArpEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #23/#536-546: current Wi-Fi association + diagnostics - collapsed entirely on a
                 wired connection, no Wi-Fi adapter, or a non-English Windows install (Wifi/SSID
                 still comes from WifiDiagnosticsService's netsh parse, which stays the card's
                 visibility gate; everything else below is either the native-WLAN-API readout
                 WifiSignalMonitorService keeps warm on a 2s cadence, or an on-demand scan/action). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Wifi}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Wi-Fi" Style="{StaticResource CardTitle}" />
                    <TextBlock FontSize="12.5">
                        <Run Text="{Binding Wifi.Ssid, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " /><Run Text="{Binding WifiRadio.PhyType, TargetNullValue='', Mode=OneWay}" />
                    </TextBlock>

                    <!-- #536: real RSSI in dBm + good/marginal/poor band, replacing the old plain
                         signal-percent readout. -->
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0">
                        <Run Text="RSSI " /><Run Text="{Binding WifiRadio.RssiDbm, TargetNullValue=Unknown, Mode=OneWay}" /><Run Text=" dBm (" />
                        <Run Text="{Binding WifiRssiBandText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=")" />
                        <Run Text=" · Channel " /><Run Text="{Binding WifiRadio.Channel, TargetNullValue=Unknown, Mode=OneWay}" />
                        <Run Text=" (" /><Run Text="{Binding WifiRadio.BandLabel, Mode=OneWay}" /><Run Text=")" />
                        <Run Text=" · Link quality " /><Run Text="{Binding WifiRadio.LinkQualityPercent, TargetNullValue=Unknown, Mode=OneWay}" /><Run Text="%" />
                    </TextBlock>

                    <!-- #536: noise floor / SNR - hidden entirely today since Windows exposes no
                         standard noise-floor API (see WifiRadioSnapshot.NoiseDbm's remarks); wired
                         up for whenever a driver-specific source is added rather than removed. -->
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0" Visibility="{Binding WifiSnrText, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Noise floor " /><Run Text="{Binding WifiRadio.NoiseDbm, Mode=OneWay}" /><Run Text=" dBm · SNR " /><Run Text="{Binding WifiSnrText, Mode=OneWay}" /><Run Text=" dB" />
                    </TextBlock>

                    <!-- #540: negotiated Rx/Tx rate, plus the band-steering suggestion once an
                         Airspace scan below has actually seen the same SSID elsewhere. -->
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                        <Run Text="Rx " /><Run Text="{Binding WifiRadio.RxRateMbps, TargetNullValue=Unknown, StringFormat={}{0:0.#}, Mode=OneWay}" /><Run Text=" Mbps" />
                        <Run Text=" · Tx " /><Run Text="{Binding WifiRadio.TxRateMbps, TargetNullValue=Unknown, StringFormat={}{0:0.#}, Mode=OneWay}" /><Run Text=" Mbps" />
                    </TextBlock>
                    <TextBlock Text="{Binding WifiBandSteeringHintText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"
                               Visibility="{Binding WifiBandSteeringHintText, Converter={StaticResource NullToVisibilityConverter}}" />

                    <!-- #545: power-saving mode - hidden entirely when the adapter doesn't expose
                         the advanced-property keyword this reads (not every driver does). Run
                         has no Visibility property in WPF, so the "aggressive" caveat is a
                         separate TextBlock rather than a conditionally-hidden Run. -->
                    <StackPanel Visibility="{Binding WifiPowerSaving, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Power saving: " /><Run Text="{Binding WifiPowerSaving.Label, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="Aggressive power saving is a known cause of random idle disconnects and latency spikes on battery. Quick flag, not a verdict."
                                   Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding WifiPowerSaving.IsAggressive, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- #537: RSSI + link-rate history, with vertical roam markers so a mid-session
                         dropout can be matched to a BSSID change. Same glow/core LineSeries pairing
                         every history chart in the app uses. -->
                    <TextBlock Text="Signal history" Style="{StaticResource SpecLabel}" Margin="0,12,0,4" />
                    <lvc:CartesianChart Series="{Binding WifiRssiSeries}" XAxes="{Binding WifiHiddenXAxes}" YAxes="{Binding WifiRssiYAxes}" Sections="{Binding WifiRoamMarkers}"
                                         Height="120" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                    <lvc:CartesianChart Series="{Binding WifiRateSeries}" XAxes="{Binding WifiHiddenXAxes}" YAxes="{Binding WifiRateYAxes}" Sections="{Binding WifiRoamMarkers}"
                                         Height="100" Margin="0,6,0,0" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                    <TextBlock Text="Orange vertical lines mark a BSSID change (roam)." Style="{StaticResource SubStat}" Margin="0,4,0,0" Opacity="0.85" />

                    <!-- #543: one-click built-in wireless report. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding WlanReportStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Generate wireless report" Padding="10,4" Command="{Binding RunWlanReportCommand}" />
                    </Grid>

                    <!-- #538/#539/#546: Airspace - on-demand neighbour/channel scan. -->
                    <Expander Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="Airspace (channel congestion scan)" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding AirspaceStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Content="Scan airspace" Padding="10,4" Command="{Binding RunAirspaceScanCommand}" />
                            </Grid>

                            <!-- #539: 2.4 GHz overlap verdict for whatever channel this machine is on. -->
                            <TextBlock Text="{Binding WifiOverlapText}" Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding WifiOverlapText, Converter={StaticResource NullToVisibilityConverter}}" />

                            <!-- #538: per-band channel occupancy + recommendation. -->
                            <TextBlock Text="2.4 GHz channel occupancy" Style="{StaticResource SpecLabel}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding AirspaceOccupancy24}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                            <Run Text="Ch. " /><Run Text="{Binding Channel}" FontFamily="Consolas" FontWeight="SemiBold" />
                                            <Run Text=" — " /><Run Text="{Binding ApCount}" /><Run Text=" network(s), summed signal " /><Run Text="{Binding SummedSignalPercent}" /><Run Text="%" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding AirspaceRecommendation24}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AirspaceOccupancy5.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="5 GHz channel occupancy" Style="{StaticResource SpecLabel}" Margin="0,12,0,4" />
                                <ItemsControl ItemsSource="{Binding AirspaceOccupancy5}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                                <Run Text="Ch. " /><Run Text="{Binding Channel}" FontFamily="Consolas" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding ApCount}" /><Run Text=" network(s), summed signal " /><Run Text="{Binding SummedSignalPercent}" /><Run Text="%" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AirspaceRecommendation5}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AirspaceOccupancy6.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="6 GHz channel occupancy" Style="{StaticResource SpecLabel}" Margin="0,12,0,4" />
                                <ItemsControl ItemsSource="{Binding AirspaceOccupancy6}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,3">
                                                <Run Text="Ch. " /><Run Text="{Binding Channel}" FontFamily="Consolas" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding ApCount}" /><Run Text=" network(s), summed signal " /><Run Text="{Binding SummedSignalPercent}" /><Run Text="%" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AirspaceRecommendation6}" Style="{StaticResource SubStat}" Margin="0,2,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- #546: same-SSID BSSID groups - the mesh/extender "sticky client" view. -->
                            <TextBlock Text="Same-SSID BSSIDs (mesh / extender view)" Style="{StaticResource SpecLabel}" Margin="0,14,0,4" />
                            <ItemsControl ItemsSource="{Binding WifiMeshGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold" FontSize="12.5" />
                                                <ItemsControl ItemsSource="{Binding Bssids}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Run has no Visibility property in WPF, so the "(connected)"
                                                                 marker is a separate TextBlock rather than a conditionally-
                                                                 hidden Run. -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Style="{StaticResource SubStat}" FontFamily="Consolas">
                                                                    <Run Text="{Binding Bssid}" />
                                                                    <Run Text=" — " /><Run Text="{Binding Band}" /><Run Text=" ch." /><Run Text="{Binding Channel, TargetNullValue=?}" />
                                                                    <Run Text=", " /><Run Text="{Binding SignalPercent, TargetNullValue=Unknown}" /><Run Text="%" />
                                                                </TextBlock>
                                                                <TextBlock Text=" (connected)" Style="{StaticResource SubStat}" FontWeight="SemiBold"
                                                                           Visibility="{Binding IsCurrentBssid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No scan results yet - click &quot;Scan airspace&quot; above.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WifiMeshGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <!-- #541/#542: Wi-Fi events timeline - on-demand WLAN-AutoConfig/Operational scan. -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Wi-Fi events" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding WifiEventScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanWifiEventsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding WifiEventStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding WifiEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True"
                              MaxHeight="320" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeUtc, StringFormat={}{0:g}}" Width="1.3*" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="1.1*" />
                            <DataGridTextColumn Header="SSID" Binding="{Binding Ssid, TargetNullValue=''}" Width="1.1*" />
                            <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid, TargetNullValue=''}" Width="1.2*" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration, TargetNullValue='', StringFormat={}{0:hh\:mm\:ss}}" Width="0.9*" />
                            <!-- #542: decoded reason/status text attached to each row. -->
                            <DataGridTextColumn Header="Reason" Binding="{Binding ReasonText, TargetNullValue=''}" Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No Wi-Fi events loaded yet - set a window above and click Scan.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WifiEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #544: saved-profile audit. -->
                    <Expander Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="Saved Wi-Fi profiles" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WifiProfilesStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshWifiProfilesCommand}" />
                            </Grid>
                            <DataGrid ItemsSource="{Binding WifiProfiles}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True"
                                      MaxHeight="320" Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" />
                                    <DataGridTextColumn Header="Connect" Binding="{Binding ConnectionMode}" Width="1.2*" />
                                    <DataGridTextColumn Header="Auth" Binding="{Binding Authentication}" Width="1.1*" />
                                    <DataGridTextColumn Header="Cipher" Binding="{Binding Cipher}" Width="0.9*" />
                                    <!-- Run has no Visibility property in WPF, so each flag is its own
                                         TextBlock rather than a conditionally-hidden Run. -->
                                    <DataGridTemplateColumn Header="Flags" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Hidden SSID" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                               Visibility="{Binding IsHiddenSsid, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="Weak security (WEP/TKIP)" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                               Visibility="{Binding IsWeakSecurity, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="Auto-connects to any open network" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                               Visibility="{Binding AutoConnectsToOpenNetwork, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Padding="8,3"
                                                        Command="{Binding DataContext.DeleteWifiProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No saved profiles loaded yet - click Refresh above.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WifiProfiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- suggestions.md #582/#583: true per-process bandwidth via a short, explicit ETW
                 capture on the Microsoft-Windows-Kernel-Network provider - the real
                 bytes-per-process measurement the connection-count list below explicitly can't
                 provide. New section above that list, per this item's own text. Never automatic -
                 an explicit Start/Stop button pair with a visible "capture running" note while
                 active. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEtwCapturing}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Per-process bandwidth (ETW capture)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Padding="10,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Start capture" />
                                        <Setter Property="Command" Value="{Binding StartEtwCaptureCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEtwCapturing}" Value="True">
                                                <Setter Property="Content" Value="Stop capture" />
                                                <Setter Property="Command" Value="{Binding StopEtwCaptureCommand}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Real send/receive bytes per process, traced live from the kernel network stack - not a proxy, unlike the connection-count list below. Runs only while a capture is active; stop it to see results."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!-- Explicit "capture running" note, per this item's own text. -->
                    <Border Background="{DynamicResource DangerBrush}" Opacity="0.15" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                            Visibility="{Binding IsEtwCapturing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding EtwCaptureStatusText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding EtwCaptureStatusText}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEtwCapturing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding EtwBandwidthResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5">
                                        <Run Text="{Binding ProcessName}" FontWeight="SemiBold" />
                                        <Run Text=" (PID " /><Run Text="{Binding Pid}" /><Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding BytesSent, Converter={StaticResource BytesToReadableConverter}, StringFormat='↑ {0}'}" />
                                        <Run Text="   " />
                                        <Run Text="{Binding BytesReceived, Converter={StaticResource BytesToReadableConverter}, StringFormat='↓ {0}'}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No capture results yet - click Start capture, let it run for a few seconds while there's network activity, then Stop.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EtwBandwidthResults.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="#583: completed captures are also persisted into the History Today/This Month lists below as a real data-volume series, alongside the existing connection-count totals."
                               Style="{StaticResource SubStat}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- #87: top network processes by connection count - a "per-process bandwidth" proxy,
                 since Windows exposes no public per-process byte-attribution API. See
                 NetworkProcessUsage's remarks for why this is a connection count, not a byte rate. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Top network processes" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="By active connection count - not a true byte-rate figure, which Windows exposes no public API for."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding TopNetworkProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5">
                                        <Run Text="{Binding ProcessName}" FontWeight="SemiBold" />
                                        <Run Text=" (PID " /><Run Text="{Binding Pid}" /><Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding ConnectionCount}" /><Run Text=" connections (" />
                                        <Run Text="{Binding EstablishedCount}" /><Run Text=" established)" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active connections.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TopNetworkProcesses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- suggestions.md #557/#565: TCP health - retransmit/reset counters from
                 Win32_PerfRawData_Tcpip_TCPv4/TCPv6 (#557), charted as a retransmit-rate
                 percentage of segments sent ("above a couple of percent is the cleanest objective
                 evidence of a lossy path"), plus a full read of `netsh int tcp show global`'s
                 tuning/offload knobs (#565) with a one-line explanation of each and a flag on a
                 disabled/restricted receive-window autotuning level. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="TCP health" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Transport-layer retransmit/reset counters and the machine-wide TCP tuning knobs that most often explain a slow or capped connection."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- #557: retransmit-rate chart (IPv4) - glow/core paired like every other
                         history chart in the app. -->
                    <lvc:CartesianChart Series="{Binding TcpRetransmitSeries}" XAxes="{Binding LatencyHiddenXAxes}" YAxes="{Binding TcpRetransmitPercentYAxes}"
                                         Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent"
                                         TooltipTextPaint="{Binding Performance.TooltipTextPaint}" TooltipBackgroundPaint="{Binding Performance.TooltipBackgroundPaint}" />
                    <TextBlock Text="{Binding TcpHealthStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,10" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding TcpHealthSamples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AddressFamily}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="Not available (the TCP performance counters for this family couldn't be read)."
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="Retransmitted " /><Run Text="{Binding SegmentsRetransmittedPerSec, StringFormat={}{0:0.0}/s}" />
                                        <Run Text="   Sent " /><Run Text="{Binding SegmentsSentPerSec, StringFormat={}{0:0.0}/s}" />
                                        <Run Text="   Rate " /><Run Text="{Binding RetransmitRatePercent, StringFormat={}{0:0.00}%}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="Connection failures " /><Run Text="{Binding ConnectionFailuresDelta}" /><Run Text=" since last refresh (" /><Run Text="{Binding ConnectionFailuresTotal}" /><Run Text=" this session)" />
                                        <Run Text="   Resets " /><Run Text="{Binding ConnectionsResetDelta}" /><Run Text=" since last refresh (" /><Run Text="{Binding ConnectionsResetTotal}" /><Run Text=" this session)" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #565: full TCP global parameter audit, read once and reused from
                         TcpGlobalSettings - the same read #552's Adapter health card already shows
                         a 3-field subset of. -->
                    <TextBlock Text="TCP global parameters (netsh int tcp show global)" Style="{StaticResource SpecLabel}" Margin="0,10,0,4" />
                    <TextBlock Text="Read-only - this app never changes these." Style="{StaticResource SubStat}" Margin="0,0,0,8" Opacity="0.7" />

                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Receive-Side Scaling: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.ReceiveSideScalingState}" />
                        <LineBreak /><Run Text="Spreads incoming packet processing across multiple CPU cores instead of just one - normally left enabled." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Chimney Offload: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.ChimneyOffloadState}" />
                        <LineBreak /><Run Text="Offloads TCP processing onto the NIC itself - dropped from netsh's own output on newer Windows builds, so 'Unknown' here often just means this Windows version no longer reports it." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Receive Segment Coalescing: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.ReceiveSegmentCoalescingState}" />
                        <LineBreak /><Run Text="Merges multiple incoming TCP segments into one before handing them to the app - saves CPU, but a buggy driver with this on can produce a stalled-but-not-dead connection that looks like a server problem." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TcpGlobalSettings.IsAutoTuningLimited}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Receive Window Auto-Tuning: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.ReceiveWindowAutoTuningLevel}" />
                        <LineBreak /><Run Text="How aggressively the receive window grows to fill available bandwidth on longer/higher-latency links. 'disabled' or 'restricted' caps throughput regardless of available bandwidth - a very common bad 'optimization guide' edit." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Congestion provider: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.CongestionProvider}" />
                        <LineBreak /><Run Text="Which congestion-control algorithm governs how fast this machine ramps up (and backs off) its own sending rate." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="ECN capability: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.EcnCapability}" />
                        <LineBreak /><Run Text="Explicit Congestion Notification - lets a supporting router signal congestion without dropping a packet. Off by default; safe either way on most home/office networks." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                        <Run Text="RFC 1323 timestamps: " FontWeight="SemiBold" /><Run Text="{Binding TcpGlobalSettings.TimestampsState}" />
                        <LineBreak /><Run Text="Per-packet timestamps used for more accurate round-trip-time estimation and to guard against wrapped sequence numbers on very fast links." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Text="Auto-tuning is disabled/restricted - throughput on longer or higher-latency links is capped regardless of available bandwidth. If nothing intentionally set this, it's worth reverting."
                               Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding TcpGlobalSettings.IsAutoTuningLimited, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- #21: active TCP connections with owning process - see NetworkConnectionsService.
                 Extended by #558 (state histogram), #559 (stalled-SYN age column + status line),
                 #560 (port lookup box), and #561/#562 (a UDP table alongside this TCP one, now
                 spanning both address families). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Active connections" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Connections.Count, StringFormat={}{0} total}" Style="{StaticResource SubStat}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <!-- #525: on-demand reverse-DNS (PTR) enrichment - never automatic, since
                             it's a real DNS lookup per unique remote address. -->
                        <Button Grid.Column="2" Padding="10,4" Command="{Binding ResolveConnectionNamesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Resolve names" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResolvingConnectionNames}" Value="True">
                                            <Setter Property="Content" Value="Resolving..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- #558: connection-state histogram, derived entirely from the sample below -
                         no extra I/O. TIME_WAIT/CLOSE_WAIT/SYN_SENT chips turn the warning color
                         and carry a tooltip once their count crosses an informal "worth a look"
                         threshold. -->
                    <ItemsControl ItemsSource="{Binding ConnectionStateHistogram}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock ToolTip="{Binding FlagReason}" FontSize="12">
                                        <Run Text="{Binding State}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Count}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #559: stalled SYN_SENT status line - per-connection age lives on the Age
                         column below (and highlights that row), this is just the one combined
                         summary. -->
                    <TextBlock Text="{Binding StalledSynStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <!-- #560: "what is using port N" - scans whatever's currently in the TCP/UDP
                         tables below, no separate live query. -->
                    <TextBlock Text="What's using a port?" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding PortLookupQuery, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding LookupPortCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Padding="10,4" Command="{Binding LookupPortCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Look up port" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLookingUpPort}" Value="True">
                                            <Setter Property="Content" Value="Looking up..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding PortLookupStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding PortLookupResults}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,4">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PortLookupResults.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="0.6*" />
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.5*" />
                            <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1*" />
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.1*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                            <DataGridTextColumn Header="Path" Binding="{Binding ProcessPath, TargetNullValue='(unknown)'}" Width="1.8*" />
                            <DataGridTextColumn Header="Started" Binding="{Binding ProcessStartTime, StringFormat={}{0:g}, TargetNullValue='Unknown'}" Width="1.1*" />
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="End process" Padding="6,2" FontSize="11"
                                                Command="{Binding DataContext.EndPortLookupProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- #561: TCP/UDP toggle - two differently-shaped row types (UDP has no remote
                         endpoint or state), so a second small DataGrid rather than one merged grid. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <Button Content="TCP" Command="{Binding ShowTcpConnectionsCommand}" Padding="10,4" Margin="0,0,4,0" />
                        <Button Content="UDP" Command="{Binding ShowUdpConnectionsCommand}" Padding="10,4" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Connections}" Height="260" IsReadOnly="True">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowUdpConnections}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.3*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.5*" />
                            <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="Local port" Binding="{Binding LocalPort}" Width="75" />
                            <DataGridTextColumn Header="Remote address" Binding="{Binding RemoteAddress}" Width="1.2*" />
                            <DataGridTextColumn Header="Remote port" Binding="{Binding RemotePort}" Width="85" />
                            <DataGridTextColumn Header="Remote host" Binding="{Binding RemoteHostName, TargetNullValue=''}" Width="1.5*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                            <!-- #559: how long a SYN_SENT connection has persisted across polls. -->
                            <DataGridTextColumn Header="Age" Binding="{Binding SynSentAgeSeconds, StringFormat={}{0:0}s, TargetNullValue=''}" Width="60" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStalledSynSent}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="ToolTip" Value="{Binding StalledSynReason}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- #561: the UDP table - shown instead of the TCP grid above via the toggle. -->
                    <DataGrid ItemsSource="{Binding UdpConnections}" Height="260"
                              IsReadOnly="True" Visibility="{Binding ShowUdpConnections, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                            <DataGridTextColumn Header="AF" Binding="{Binding AddressFamily}" Width="0.6*" />
                            <DataGridTextColumn Header="Local address" Binding="{Binding LocalAddress}" Width="1.5*" />
                            <DataGridTextColumn Header="Local port" Binding="{Binding LocalPort}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="UDP is connectionless - Windows tracks no remote address, port, or state for a bound local endpoint, so this table only ever shows what's listening/bound locally (DNS, QUIC, game traffic, VPN tunnels, ...)."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7"
                               Visibility="{Binding ShowUdpConnections, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="PTR-resolves each unique remote address (memory-cached, strict per-lookup timeout) - turns a wall of IPs into recognizable CDN/service names where a reverse record exists."
                               Margin="0,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Opacity" Value="0.7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowUdpConnections}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- suggestions.md #563/#564: Ports - TCP port exclusion/reservation ranges vs. the
                 dynamic (ephemeral) port range, flagging any overlap (#563 - the well-known
                 Hyper-V/WinNAT reservation bug, "the port is free in netstat but the app still
                 can't bind it"), plus how full that dynamic range currently is from the
                 connections tables above (#564). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ports" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="10,4" Command="{Binding RefreshPortReservationCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Refresh" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingPortReservation}" Value="True">
                                            <Setter Property="Content" Value="Loading..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding PortReservationStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBlock Text="TCP port exclusions (netsh int ipv4 show excludedportrange)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <TextBlock Text="Windows reserves these for its own use - a bind attempt to any port inside one fails even though the port shows as free in a plain netstat listing. Hyper-V/WinNAT virtual switches are the best-known cause of a large, unexpected block; '*' marks a range netsh calls 'administered'."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.7" />
                    <DataGrid ItemsSource="{Binding PortReservation.ExcludedRanges}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartPort}" Width="0.8*" />
                            <DataGridTextColumn Header="End" Binding="{Binding EndPort}" Width="0.8*" />
                            <DataGridTextColumn Header="Ports" Binding="{Binding PortCount}" Width="0.7*" />
                            <DataGridCheckBoxColumn Header="Administered" Binding="{Binding IsAdministered}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No excluded ranges reported.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PortReservation.ExcludedRanges.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Dynamic (ephemeral) port range (netsh int ipv4 show dynamicport tcp)" Style="{StaticResource SpecLabel}" Margin="0,14,0,4" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding PortReservation.DynamicRange, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="{Binding PortReservation.DynamicRange.StartPort}" />
                        <Run Text=" – " />
                        <Run Text="{Binding PortReservation.DynamicRange.EndPort}" />
                        <Run Text=" (" /><Run Text="{Binding PortReservation.DynamicRange.PortCount}" /><Run Text=" ports) - the pool Windows assigns a local port from for any outbound connection that doesn't bind an explicit one." />
                    </TextBlock>
                    <TextBlock Text="Unknown - refresh above to read it from netsh.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PortReservation.DynamicRange}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #564: ephemeral-port utilization, derived from the TCP/UDP tables the
                         Active connections card above already samples - no extra I/O. -->
                    <TextBlock Text="Ephemeral port utilization" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <TextBlock Text="How many currently-open local ports fall inside the dynamic range above - the classic 'new connections fail but existing ones keep working' cause once this gets close to full. Windows doesn't fail at one exact percentage (TIME_WAIT reuse blurs the real ceiling), so treat this as worth investigating, not a hard prediction."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.7" />

                    <StackPanel Visibility="{Binding PortExhaustion, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="{Binding PortExhaustion.ConnectionsInRange}" FontWeight="SemiBold" /><Run Text=" of " />
                            <Run Text="{Binding PortExhaustion.RangeSize}" /><Run Text=" ports in use  •  " />
                            <Run Text="{Binding PortExhaustion.UtilizationPercent, StringFormat={}{0:0.#}%}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="Above ~80% used - worth checking which process(es) below are holding the most ports." Style="{StaticResource SubStat}"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding PortExhaustion.IsHighUtilization, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding PortExhaustion.TopContributors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,2">
                                        <Run Text="{Binding ProcessName}" /><Run Text="  —  " /><Run Text="{Binding Count}" /><Run Text=" port(s)" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="Refresh the port ranges above to see utilization.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PortExhaustion}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #221: NIC interrupt-moderation/RSS audit - registry-driven, loaded once at start-up
                 plus a manual refresh. Cross-linked to the Responsiveness tab's DPC table with a
                 plain-text note (see NetworkViewModel.NdisDpcCrossLinkText's remarks) when
                 ndis.sys/this adapter's own driver is also a top DPC offender there. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NIC interrupt moderation / RSS" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadNicInterruptSettingsCommand}" Padding="10,4" />
                    </Grid>
                    <TextBlock Text="{Binding NicAuditStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding NicInterruptSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="8" CornerRadius="6" BorderThickness="1" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlagInterruptModerationOff}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FlagRssOffOnMultiCore}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AdapterName}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="Interrupt moderation: " /><Run Text="{Binding InterruptModerationEnabled, TargetNullValue=Unknown, Mode=OneWay}" />
                                            <Run Text="  •  RSS: " /><Run Text="{Binding RssEnabled, TargetNullValue=Unknown, Mode=OneWay}" />
                                            <Run Text=" (" /><Run Text="{Binding RssQueueCount, TargetNullValue=unknown, Mode=OneWay}" /><Run Text=" queues)" />
                                            <Run Text="  •  Flow control: " /><Run Text="{Binding FlowControlEnabled, TargetNullValue=Unknown, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No adapters exposed these registry settings on this system.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NicInterruptSettings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding NdisDpcCrossLinkText}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NdisDpcCrossLinkText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Adapter errors: cumulative CRC/discard counters, not rates - see
                 HardwareMonitorService.ReadNetworkErrorCounters. Any nonzero value turns the
                 whole card the warning color; a healthy adapter shows all zeros. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Performance.HasNetworkErrors}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Adapter errors" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="In: " /><Run Text="{Binding Performance.NetworkInErrors, Mode=OneWay}" /><Run Text=" errors, " />
                        <Run Text="{Binding Performance.NetworkInDiscards, Mode=OneWay}" /><Run Text=" discarded  •  Out: " />
                        <Run Text="{Binding Performance.NetworkOutErrors, Mode=OneWay}" /><Run Text=" errors, " />
                        <Run Text="{Binding Performance.NetworkOutDiscards, Mode=OneWay}" /><Run Text=" discarded" />
                    </TextBlock>
                    <TextBlock Text="Cumulative since the adapter/driver last loaded, not a rate - any nonzero count can flag a failing NIC or a bad cable."
                               Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" />
                    <!-- #32: TCP-level retransmits, distinct from the adapter/frame-level counters
                         above - a transport-level packet-loss signal (e.g. a congested/lossy
                         path) that can be nonzero even when the adapter itself reports clean. -->
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,10,0,0">
                        <Run Text="TCP retransmits: " /><Run Text="{Binding Performance.TcpRetransmitsPerSec, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text="/s" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- suggestions.md #572-574: Proxy - extends the existing read-only proxy readout
                 (ProxyStatusText, shown on the Connectivity card above) into a full card: PAC
                 fetch/health (#572), per-user-vs-machine-wide WinHTTP divergence (#573), and the
                 bypass list plus a "does this host bypass" tester (#574). Read-only throughout -
                 this app never writes to any proxy setting. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Proxy" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="10,4" Command="{Binding RefreshProxyCardCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Refresh" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingProxyCard}" Value="True">
                                            <Setter Property="Content" Value="Loading..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,14" TextWrapping="Wrap">
                        <Run Text="Per-user proxy: " /><Run Text="{Binding ProxyStatusText, Mode=OneWay}" />
                    </TextBlock>

                    <!-- #572: PAC fetch/health. -->
                    <TextBlock Text="PAC / auto-config script" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PacStatusText}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PacLooksProblematic}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False"
                              Visibility="{Binding PacBody, Converter={StaticResource NullToVisibilityConverter}}">
                        <Expander.Header>
                            <TextBlock Text="View PAC script body" Style="{StaticResource CardTitle}" Margin="0" FontSize="12.5" />
                        </Expander.Header>
                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}" MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding PacBody}" FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </Expander>

                    <!-- #573: per-user vs. machine-wide divergence. -->
                    <TextBlock Text="Per-user vs. machine-wide (WinHTTP)" Style="{StaticResource SpecLabel}" Margin="0,16,0,4" />
                    <Grid Visibility="{Binding ProxyDivergence, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Per-user (this account)" Style="{StaticResource SubStat}" Opacity="0.7" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ProxyDivergence.PerUserSummary}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Machine-wide (WinHTTP)" Style="{StaticResource SubStat}" Opacity="0.7" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding ProxyDivergence.SystemWideSummary}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ProxyDivergence.MismatchReason}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding ProxyDivergence.Mismatch, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- #574: bypass list + tester. -->
                    <TextBlock Text="Bypass list (ProxyOverride)" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding ProxyBypassEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6" Padding="7,3" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No bypass entries configured.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProxyBypassEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding BypassTestHostname, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Test" Padding="10,4" Command="{Binding TestBypassCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding BypassTestResultText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #566-571: Firewall - profile status (#566), a full rule browser with
                 a filter/executable-only mode (#567), the blocked-connection log (pfirewall.log)
                 reader (#568), WFP drop auditing with filter attribution (#569), a read-only
                 filter-driver/security-product stack inventory (#571), and the "This app can't
                 reach the network" guided wizard (#570) at the bottom. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Firewall" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Windows Firewall configuration, rules, and what it's actually blocked - this app's own connectivity checks can look clean while the firewall silently drops traffic underneath them."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,14" TextWrapping="Wrap" />

                    <!-- #566: profile status. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Profile status" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="8,3" Command="{Binding RefreshFirewallProfilesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Refresh" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingFirewallProfiles}" Value="True">
                                            <Setter Property="Content" Value="Loading..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FirewallProfiles}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="8" CornerRadius="6" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="7,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EnabledText}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="In: " /><Run Text="{Binding InboundPolicy}" FontWeight="SemiBold" />
                                            <Run Text="  Out: " /><Run Text="{Binding OutboundPolicy}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FlagReason}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                                                   Visibility="{Binding FlagReason, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #567: full rule browser, filter box, "this executable only" mode. -->
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="Rule browser" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Every configured firewall rule (name/direction/action/protocol/ports/program/enabled state)." Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Padding="8,3" Command="{Binding RefreshFirewallRulesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Load rules" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingFirewallRules}" Value="True">
                                                    <Setter Property="Content" Value="Loading..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding FirewallRulesStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,10,0" VerticalContentAlignment="Center"
                                         Text="{Binding FirewallRuleFilterText, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Column="1" Content="This executable only" VerticalAlignment="Center"
                                          IsChecked="{Binding FirewallFilterExecutableOnly}"
                                          ToolTip="Type an executable name (e.g. chrome.exe) or full path above, then check this to show only rules scoped to that program - the same filter a right-click &quot;jump to Firewall&quot; from the Processes tab would use." />
                            </Grid>
                            <DataGrid ItemsSource="{Binding FilteredFirewallRules}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserSortColumns="True" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="0.6*" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="0.7*" />
                                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.8*" />
                                    <DataGridTextColumn Header="Local port" Binding="{Binding LocalPort}" Width="1*" />
                                    <DataGridTextColumn Header="Remote port" Binding="{Binding RemotePort}" Width="1*" />
                                    <DataGridTextColumn Header="Program" Binding="{Binding ApplicationPath}" Width="2.4*" />
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="0.7*" />
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Action}" Value="Block">
                                                <Setter Property="Opacity" Value="0.85" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <!-- #568: blocked-connection (pfirewall.log) log reader. -->
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="Blocked-connection log" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="The only first-party record of what the firewall actually blocked, from %SystemRoot%\System32\LogFiles\Firewall\pfirewall.log - disabled by default."
                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Padding="8,3" Margin="0,0,8,0" Command="{Binding RefreshFirewallLogCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Load log" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingFirewallLog}" Value="True">
                                                    <Setter Property="Content" Value="Loading..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1" Content="Enable dropped-packet logging" Padding="8,3" Command="{Binding EnableDroppedLoggingCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding FirewallLogStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding FirewallLogEntries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserSortColumns="True" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat={}{0:g}}" Width="1.3*" />
                                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="0.9*" />
                                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.8*" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="1.1*" />
                                    <DataGridTextColumn Header="Src port" Binding="{Binding SourcePort}" Width="0.7*" />
                                    <DataGridTextColumn Header="Destination" Binding="{Binding DestIp}" Width="1.1*" />
                                    <DataGridTextColumn Header="Dst port" Binding="{Binding DestPort}" Width="0.7*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <!-- #569: WFP drop auditing with filter attribution. -->
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="WFP drop auditing (which rule blocked it)" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Answers &quot;which rule blocked it&quot;, which the plain blocked-connection log above can't - resolves each drop's Filter Run-Time ID to a rule name via `netsh wfp show filters`."
                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7" />
                            <Button Content="Enable auditing" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6" Command="{Binding EnableWfpAuditingCommand}" />
                            <TextBlock Text="{Binding WfpAuditStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Scan Security log for drops" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         Text="{Binding WfpScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                                <Button Grid.Column="3" Padding="8,3" Command="{Binding ScanWfpDropsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Scan" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningWfpDrops}" Value="True">
                                                    <Setter Property="Content" Value="Scanning..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding WfpScanStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding WfpDropEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserSortColumns="True" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeUtc, StringFormat={}{0:g}}" Width="1.2*" />
                                    <DataGridTextColumn Header="Event" Binding="{Binding EventLabel}" Width="1.1*" />
                                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="0.6*" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceAddress}" Width="1*" />
                                    <DataGridTextColumn Header="Dest" Binding="{Binding DestAddress}" Width="1*" />
                                    <DataGridTextColumn Header="Dst port" Binding="{Binding DestPort}" Width="0.7*" />
                                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.7*" />
                                    <DataGridTextColumn Header="App" Binding="{Binding ApplicationPath}" Width="1.6*" />
                                    <DataGridTextColumn Header="Matched rule" Binding="{Binding MatchedRuleName, TargetNullValue='(unresolved)'}" Width="1.6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <!-- #571: read-only filter-driver/security-product stack inventory. -->
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False" Margin="0,0,0,4">
                        <Expander.Header>
                            <TextBlock Text="Filter-driver / security-product stack" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="What's actually stacked on top of the network stack - a common, hard-to-see cause of unexplained latency/drops. Informational only." Style="{StaticResource SubStat}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                                <Button Grid.Column="1" Padding="8,3" Command="{Binding RefreshStackInventoryCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Load" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingStackInventory}" Value="True">
                                                    <Setter Property="Content" Value="Loading..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding StackInventoryStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="Bound filter drivers (per adapter)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding BoundFilterDrivers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Driver" Binding="{Binding DisplayName}" Width="1.6*" />
                                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1*" />
                                    <DataGridCheckBoxColumn Header="Non-MS" Binding="{Binding LooksNonMicrosoft}" Width="0.7*" />
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LooksNonMicrosoft}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="Opacity" Value="0.85" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <TextBlock Text="WFP providers" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding WfpProviders}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Run Text=" — " /><Run Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="WFP callouts" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding WfpCallouts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Run Text=" — " /><Run Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- #570: "This app can't reach the network" guided wizard. -->
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False" Margin="0,4,0,0">
                        <Expander.Header>
                            <TextBlock Text="Wizard: &quot;This app can't reach the network&quot;" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Pick a process (name or full executable path) and get one panel combining its firewall rules, any WFP drops naming it, whether a proxy applies, whether a VPN holds the default route, and its current connections - signals this tab otherwise scatters across several cards."
                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         Text="{Binding WizardQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Padding="10,4" Command="{Binding RunWizardCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Diagnose" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunningWizard}" Value="True">
                                                    <Setter Property="Content" Value="Diagnosing..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding WizardStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <StackPanel Visibility="{Binding WizardReport, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="Matching firewall rules" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding WizardReport.MatchingFirewallRules}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding Direction}" /><Run Text="/" /><Run Text="{Binding Action}" />
                                                <Run Text=", " /><Run Text="{Binding Protocol}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No matching firewall rules found." Opacity="0.7" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardReport.MatchingFirewallRules.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Matching WFP drops (last 24h)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding WizardReport.MatchingWfpDrops}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}">
                                                <Run Text="{Binding TimeUtc, StringFormat={}{0:g}}" />
                                                <Run Text=" — " /><Run Text="{Binding DestAddress}" /><Run Text=":" /><Run Text="{Binding DestPort}" />
                                                <Run Text=" (" /><Run Text="{Binding MatchedRuleName, TargetNullValue='unresolved rule'}" /><Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No matching WFP drops in the last 24h (or auditing isn't enabled yet - see the WFP drop auditing section above)." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardReport.MatchingWfpDrops.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Proxy" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding WizardReport.ProxyApplicability}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="VPN / routing" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding WizardReport.VpnRouteSummary}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="Current connections" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding WizardReport.MatchingConnections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11.5" Margin="0,0,0,2" TextWrapping="Wrap">
                                                <Run Text="{Binding ProcessName}" FontWeight="SemiBold" />
                                                <Run Text=" — " /><Run Text="{Binding RemoteAddress}" /><Run Text=":" /><Run Text="{Binding RemotePort}" />
                                                <Run Text=" (" /><Run Text="{Binding State}" /><Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No current connections for this process.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Opacity" Value="0.7" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardReport.MatchingConnections.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- suggestions.md #575/#576: Stack - Winsock LSP catalog inspection with a
                 non-Microsoft-provider flag and a `netsh winsock reset` action (#575), plus the
                 network stack reset toolkit grouping five classic "reset everything" commands, each
                 individually confirmed and logged (#576). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Stack" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Winsock, and the classic &quot;just reset everything&quot; toolkit for when nothing above pinpoints the problem."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,14" TextWrapping="Wrap" />

                    <!-- #575: Winsock LSP catalog. -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Winsock LSP catalog" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="8,3" Command="{Binding RefreshWinsockCatalogCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Refresh" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingWinsockCatalog}" Value="True">
                                            <Setter Property="Content" Value="Loading..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="Non-Microsoft layered service providers left behind by an uninstalled proxy/&quot;internet accelerator&quot; are the classic Winsock-corruption signature - flagged below by provider DLL location, not a verdict."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.7" />
                    <TextBlock Text="{Binding WinsockStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding WinsockProviders}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserSortColumns="True" MaxHeight="240" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="1.3*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.8*" />
                            <DataGridTextColumn Header="Provider path" Binding="{Binding ProviderPath}" Width="2.4*" />
                            <DataGridCheckBoxColumn Header="Non-MS" Binding="{Binding LooksNonMicrosoft}" Width="0.7*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LooksNonMicrosoft}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Opacity" Value="0.85" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Removes every registered LSP and restores Windows' defaults. A restart is required for this to fully take effect." Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Padding="10,4" Command="{Binding ResetWinsockCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Reset Winsock catalog" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResettingWinsock}" Value="True">
                                            <Setter Property="Content" Value="Resetting..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding WinsockResetStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-10,0,14" />

                    <!-- #576: reset toolkit - one row per action, each individually confirmed. -->
                    <TextBlock Text="Network stack reset toolkit" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <TextBlock Text="Each action below is confirmed individually and appended to a small log (Logs\network-stack-actions.log next to this app's other logs) so you have a record of what was run and when."
                               Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.7" />

                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <Button Content="Reset TCP/IP stack" Margin="0,0,8,8" Padding="8,5" Command="{Binding ResetIpStackCommand}" />
                        <Button Content="Flush DNS resolver cache" Margin="0,0,0,8" Padding="8,5" Command="{Binding FlushDnsResolverCacheCommand}" />
                        <Button Content="Clear ARP cache" Margin="0,0,8,0" Padding="8,5" Command="{Binding ClearArpCacheCommand}" />
                        <Button Content="Reset NetBIOS name cache" Padding="8,5" Command="{Binding ResetNetBiosCacheCommand}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding StackResetStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #586-590 "SMB and network drives": share latency (#586), mapped-drive
                 inventory with an on-demand reachability test and confirmed Disconnect (#587),
                 negotiated dialect/signing/encryption per connection (#588), an on-demand SMBClient
                 event scan (#589), and Offline Files/CSC state, hidden entirely when not in use
                 (#590). "The PC is slow" very often means one unresponsive network share silently
                 stalling Explorer, a file dialog, or a save - nothing else on this tab surfaces that. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Network drives" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Padding="10,4" Command="{Binding RefreshNetworkDrivesCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding NetworkDrivesStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- #586: per-connected-share latency/queue-depth, charting the slow ones. -->
                    <TextBlock Text="Share latency" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding SmbShareLatencies}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              MaxHeight="220" Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Share" Binding="{Binding ShareName}" Width="1.3*" />
                            <DataGridTextColumn Header="Avg read" Binding="{Binding AvgReadLatencyMs, StringFormat={}{0:0.#} ms}" Width="0.9*" />
                            <DataGridTextColumn Header="Avg write" Binding="{Binding AvgWriteLatencyMs, StringFormat={}{0:0.#} ms}" Width="0.9*" />
                            <DataGridTextColumn Header="Queue depth" Binding="{Binding AvgDataQueueLength, StringFormat={}{0:0.##}}" Width="1.0*" />
                            <DataGridTextColumn Header="Throughput" Binding="{Binding DataBytesPerSec, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Width="1.0*" />
                            <DataGridTemplateColumn Header="" Width="0.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Slow" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"
                                                   Visibility="{Binding LooksSlow, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No connected SMB shares (or the SMB Client Shares performance counters aren't available on this machine).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SmbShareLatencies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #587: mapped-drive inventory - HKCU\Network + live `net use`, with an
                         on-demand reachability test and a confirmed Disconnect. -->
                    <TextBlock Text="Mapped drives" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <DataGrid ItemsSource="{Binding MappedDrives}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              MaxHeight="260" Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Drive" Binding="{Binding DriveLetter}" Width="0.6*" />
                            <DataGridTextColumn Header="Path" Binding="{Binding RemotePath}" Width="1.8*" />
                            <DataGridTextColumn Header="State" Binding="{Binding ConnectionState}" Width="1.1*" />
                            <DataGridCheckBoxColumn Header="Reconnect" Binding="{Binding ReconnectAtLogon}" Width="0.8*" />
                            <DataGridTextColumn Header="Reachability" Binding="{Binding ReachabilityText}" Width="1.4*" />
                            <DataGridTemplateColumn Header="" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Test" Padding="8,3" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.TestDriveReachabilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Disconnect" Padding="8,3"
                                                    Command="{Binding DataContext.DisconnectMappedDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No mapped drives found (checked HKCU\Network and `net use`).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MappedDrives.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #588: negotiated dialect/signing/encryption per server connection. -->
                    <TextBlock Text="SMB connections (dialect &amp; signing)" Style="{StaticResource SpecLabel}" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding SmbConnections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SMB1" FontSize="10.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Top"
                                               Padding="5,1" Margin="0,1,8,0" Background="{DynamicResource DangerBrush}"
                                               Visibility="{Binding IsSmb1, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding ServerName}" FontWeight="SemiBold" />
                                            <Run Text=" \ " /><Run Text="{Binding ShareName}" />
                                            <Run Text="   dialect " /><Run Text="{Binding Dialect}" FontWeight="SemiBold" />
                                            <Run Text="   signed: " /><Run Text="{Binding Signed}" />
                                            <Run Text="   encrypted: " /><Run Text="{Binding Encrypted}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SigningCaveat}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,0"
                                                   Visibility="{Binding SigningCaveat, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No active SMB connections.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SmbConnections.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #589: on-demand SMBClient Connectivity/Operational event scan. -->
                    <Expander Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" IsExpanded="False" Margin="0,16,0,0">
                        <Expander.Header>
                            <TextBlock Text="SMB session events (drops, reconnects, timeouts)" Style="{StaticResource CardTitle}" Margin="0" FontSize="13" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Scans Microsoft-Windows-SMBClient/Connectivity and /Operational for session-drop, reconnect, and timeout events - a timeline of when a share actually went away."
                                       Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Lookback (hours)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Width="60" VerticalContentAlignment="Center" Text="{Binding SmbEventScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Scan" Padding="10,4" Command="{Binding ScanSmbEventsCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding SmbEventScanStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding SmbClientEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeUtc, StringFormat='{}{0:MM/dd HH:mm:ss}'}" FontSize="11" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding Category}" FontWeight="SemiBold" />
                                                <Run Text=" (ID " /><Run Text="{Binding EventId}" /><Run Text=")  " />
                                                <Run Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- #590: Offline Files (CSC) state - the whole section hidden when not in use. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding OfflineFiles.IsInUse, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Offline Files (CSC)" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OfflineFiles.ServiceRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Service: " FontWeight="SemiBold" />
                            <Run Text="Stopped">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OfflineFiles.ServiceRunning}" Value="True">
                                                <Setter Property="Text" Value="Running" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text="   Policy: " FontWeight="SemiBold" /><Run Text="{Binding OfflineFiles.FeatureEnabled}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding OfflineFiles.CacheEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Offline" FontSize="10.5" FontWeight="Bold" Foreground="White"
                                                   Padding="5,1" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="A share that has silently gone offline still lets edits appear to save locally, without actually reaching the server - watch for the &quot;Offline&quot; flag above."
                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- suggestions.md #596/#597/#598: unified network event timeline - merges Tcpip,
                 DHCP, DNS, WLAN, NlaSvc, NetworkProfile, SMBClient and NIC miniport link-state
                 events into one chronological, filterable grid over a chosen window, behind an
                 explicit Scan button (never a timer - this is a genuinely heavier scan than any
                 single source above, since it runs all of them). #597's chart-marker overlays live
                 on the Latency/Throughput charts themselves further up this page, not here. #598's
                 sleep/resume derived finding is its own banner below the scan controls. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Network events" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Merges Tcpip, DHCP, DNS, WLAN, NlaSvc, NetworkProfile, SMBClient and NIC link-state events into one timeline - matches a chart gap to the exact disconnect, DHCP renewal or roam that caused it."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Event scan" Style="{StaticResource SpecLabel}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Window (h)" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="2" Width="50" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 Text="{Binding NetworkEventScanWindowHours, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.#}}" />
                        <Button Grid.Column="3" Content="Scan" Padding="10,4" Command="{Binding ScanNetworkEventsCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding NetworkEventScanStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!-- #598: derived sleep/resume-correlation finding - a "quick flag, not a
                         verdict" banner, hidden entirely when nothing correlates. -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SleepResumeFindings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="{DynamicResource WarningBrush}" Opacity="0.15" CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Possible post-sleep networking issue" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,6" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding SleepResumeFindings.Count}" FontWeight="SemiBold" />
                                    <Run Text=" resume(s) from sleep were followed within a few minutes by something that looks like a network problem. The most common cause this app can actually detect is the NIC's own &quot;allow the computer to turn off this device&quot; power-management setting - check the Power management section of the Adapter health card above first. This is a timing correlation, not a diagnosis." />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding SleepResumeFindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap">
                                                <Run Text="{Binding ResumeTimeUtc, StringFormat={}{0:g}}" FontFamily="Consolas" />
                                                <Run Text=" — " /><Run Text="{Binding IssueSummary}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- #596: filterable grid. -->
                    <TextBlock Text="Filter (source, category or message)" Style="{StaticResource SpecLabel}" Margin="0,0,0,4" />
                    <TextBox Margin="0,0,0,6" VerticalContentAlignment="Center"
                             Text="{Binding NetworkEventFilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGrid ItemsSource="{Binding NetworkEvents}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="True" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeUtc, StringFormat={}{0:g}}" Width="1.2*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.3*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.1*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- suggestions.md #599: one-click network diagnostic report - bundles adapter config,
                 routes, DNS settings/cache stats, Wi-Fi association/airspace, firewall profile
                 state, TCP global settings, a fresh latency/loss run and the recent event timeline
                 into one document, emitted the same Markdown/HTML way SummaryViewModel's own
                 report already does (see BuildNetworkReportMarkdown's remarks for why that's the
                 real "existing report writer" this reuses). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnostic report" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding NetworkReportStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate Markdown report" Padding="10,4" Margin="0,0,8,0" Command="{Binding GenerateNetworkReportMarkdownCommand}" />
                        <Button Content="Generate HTML report" Padding="10,4" Command="{Binding GenerateNetworkReportHtmlCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- suggestions.md #600: rolling network black-box recorder - a bounded in-memory ring
                 buffer, written to a timestamped file only on a detected disconnect/link-down
                 transition (never continuously) - see NetworkBlackBoxRecorderService's remarks. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlackBoxRecording}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="Black-box recorder" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open incidents folder" Padding="10,4" Margin="0,0,8,0" Command="{Binding OpenBlackBoxIncidentsFolderCommand}" />
                        <Button Grid.Column="2" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="Start recording" />
                                    <Setter Property="Command" Value="{Binding ToggleBlackBoxRecordingCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBlackBoxRecording}" Value="True">
                                            <Setter Property="Content" Value="Stop recording" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding BlackBoxStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="Captured incidents" Style="{StaticResource SpecLabel}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding BlackBoxIncidents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap">
                                    <Run Text="{Binding TriggeredAtUtc, StringFormat={}{0:g}}" FontFamily="Consolas" FontWeight="SemiBold" />
                                    <Run Text=" — " /><Run Text="{Binding TriggerReason}" />
                                    <Run Text=" (" /><Run Text="{Binding SampleCount}" /><Run Text=" sample(s)) — " />
                                    <Run Text="{Binding FilePath}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No incidents captured yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BlackBoxIncidents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
