<UserControl x:Class="TaskManagerPlus.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:MemoryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Memory" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Performance.RamPercent, StringFormat={}{0:0.0}%}" Style="{StaticResource BigStat}" />
                    <TextBlock Style="{StaticResource SubStat}">
                        <Run Text="{Binding Performance.RamUsedGb, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Performance.RamTotalGb, StringFormat={}{0:0.0}, Mode=OneWay}" /><Run Text=" GB" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Memory chart -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="Memory Utilization" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold">
                            <Run Text="{Binding Performance.RamUsedGb, StringFormat={}{0:0.0}, Mode=OneWay}" />
                            <Run Text=" / " FontSize="13" FontWeight="Normal" />
                            <Run Text="{Binding Performance.RamTotalGb, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="13" FontWeight="Normal" />
                            <Run Text=" GB" FontSize="13" FontWeight="Normal" />
                        </TextBlock>
                    </Grid>
                    <lvc:CartesianChart Series="{Binding Performance.RamSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                         Height="180" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Windows-native memory breakdown: Windows has no macOS-style "wired"/"compressed"
                 concept, so these use Windows' own terms - Available (physical free), Committed
                 (Task Manager's own overall memory-pressure figure), Cached (system file cache). -->
            <TextBlock Text="Breakdown" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <views:VfdMeter Title="Available" Glow="False" Margin="0,0,6,0"
                                Percent="{Binding Performance.RamAvailablePercent}"
                                ValueText="{Binding Performance.RamAvailableGb, StringFormat={}{0:0.0}}" Unit="GB"
                                SubText="Physical free" AccentBrush="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Committed" Glow="False" Margin="3,0,3,0"
                                Percent="{Binding Performance.CommittedPercent}"
                                ValueText="{Binding Performance.CommittedGb, StringFormat={}{0:0.0}}" Unit="GB"
                                SubText="{Binding Performance.CommitLimitGb, StringFormat={}of {0:0.0} GB limit}"
                                AccentBrush="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Cached" Glow="False" Margin="3,0,3,0"
                                Percent="{Binding Performance.CachedPercent}"
                                ValueText="{Binding Performance.CachedGb, StringFormat={}{0:0.0}}" Unit="GB"
                                SubText="System file cache" AccentBrush="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                <!-- Page file: AccentBrush deliberately uses PercentToBrushConverter (green/amber/
                     red) instead of the fixed RAM accent color the other three tiles use - a nearly-
                     full page file is a real memory-pressure warning worth calling out visually,
                     independent of whether physical RAM itself looks fine. -->
                <views:VfdMeter Title="Page file" Glow="False" Margin="6,0,0,0"
                                Percent="{Binding Performance.PageFilePercent}"
                                ValueText="{Binding Performance.PageFileUsedGb, StringFormat={}{0:0.0}}" Unit="GB"
                                SubText="{Binding Performance.PageFileTotalGb, StringFormat={}of {0:0.0} GB total}"
                                AccentBrush="{Binding Performance.PageFilePercent, Converter={StaticResource PercentToBrushConverter}}" />
            </UniformGrid>

            <!-- Diagnostics: standby (reclaimable) list (#22, explains "why does Windows show
                 low free RAM when nothing is running" - this memory looks used but is instantly
                 reclaimable), kernel pool usage (#24, a slow sustained climb usually means a
                 leaking driver), and page fault rate (#20, hard faults spiking means heavy
                 paging to disk; soft faults are cheap and normal). -->
            <TextBlock Text="Diagnostics" Style="{StaticResource SubStat}" Margin="0,0,0,10" />
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <views:VfdMeter Title="Standby list" Glow="False" Margin="0,0,6,0"
                                Percent="{Binding Performance.StandbyPercent}"
                                ValueText="{Binding Performance.StandbyGb, StringFormat={}{0:0.0}}" Unit="GB"
                                SubText="Reclaimable cache" AccentBrush="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                <views:VfdMeter Title="Nonpaged pool" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Performance.PoolNonpagedGb, StringFormat={}{0:0.00}}" Unit="GB"
                                SubText="Kernel memory" AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="Paged pool" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Performance.PoolPagedGb, StringFormat={}{0:0.00}}" Unit="GB"
                                SubText="Kernel memory" AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="Page faults" Glow="False" Margin="6,0,0,0"
                                ValueText="{Binding Performance.HardFaultsPerSec, StringFormat={}{0:0}}" Unit="hard/s"
                                SubText="{Binding Performance.SoftFaultsPerSec, StringFormat={}+{0:0} soft/s}"
                                AccentBrush="{DynamicResource AccentBrush}" />
            </UniformGrid>

            <!-- Committed trend -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Committed memory" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Performance.CommittedSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.MemoryBytesYAxes}"
                                         Height="180" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Top memory consumers: re-presents the already-polling Processes tab's collection,
                 live-sorted by memory instead of CPU - see MemoryViewModel. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Top memory consumers" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding TopMemoryProcesses}" MaxHeight="240">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}" FontSize="10.5">
                                            <Run Text="PID " /><Run Text="{Binding Pid, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding CpuPercent, StringFormat={}{0:0.0}% CPU, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MemoryMb, StringFormat={}{0:0} MB}"
                                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
