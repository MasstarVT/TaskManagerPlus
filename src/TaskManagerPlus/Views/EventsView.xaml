<UserControl x:Class="TaskManagerPlus.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:models="clr-namespace:TaskManagerPlus.Models"
             d:DataContext="{d:DesignInstance Type=vm:EventsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- #104: visual XPath filter builder - level checkboxes, provider/event-ID/user free-text
             filters, a lookback window, and the generated query shown in an editable box so a
             power user can hand-edit it before Load runs. -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <CheckBox Content="Critical" IsChecked="{Binding LevelCritical}" Margin="0,0,10,0" />
                    <CheckBox Content="Error" IsChecked="{Binding LevelError}" Margin="0,0,10,0" />
                    <CheckBox Content="Warning" IsChecked="{Binding LevelWarning}" Margin="0,0,10,0" />
                    <CheckBox Content="Information" IsChecked="{Binding LevelInformation}" Margin="0,0,10,0" />
                    <CheckBox Content="Verbose" IsChecked="{Binding LevelVerbose}" Margin="0,0,18,0" />

                    <TextBlock Text="Providers:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <TextBox Text="{Binding ProviderFilterText, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,18,0"
                              ToolTip="Comma-separated provider names" />

                    <TextBlock Text="Event IDs:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <TextBox Text="{Binding EventIdsText, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,18,0"
                              ToolTip="e.g. 1000, 4624, 7000-7010" />

                    <TextBlock Text="Lookback (days):" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <TextBox Text="{Binding LookbackDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,18,0" />

                    <TextBlock Text="User SID:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <TextBox Text="{Binding UserSidText, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,18,0" />

                    <TextBlock Text="Keyword:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <TextBox Text="{Binding KeywordText, UpdateSourceTrigger=PropertyChanged}" Width="140"
                              ToolTip="Client-side match against each event's description text" />
                </WrapPanel>

                <!-- #121: known-benign noise suppression - collapses rows the local knowledge base
                     (#117) flags as benign (DCOM 10016 permission errors, Kernel-EventTracing 2/3
                     session-start races, Group Policy 1129 on a non-domain PC, ...) rather than
                     leaving them as ordinary rows. -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Hide known-noise" IsChecked="{Binding HideKnownNoise}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding HiddenNoiseText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                VerticalAlignment="Center" MaxWidth="520"
                                Visibility="{Binding HiddenNoiseText, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RawXPathText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                              FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"
                              ToolTip="The XPath query actually used by Load / Follow - edit directly for power-user queries." />
                    <Button Grid.Column="1" Content="Build query" Command="{Binding BuildXPathCommand}" Padding="10,4" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Load" Command="{Binding LoadCommand}" Padding="14,4" Margin="0,0,8,0" />
                    <ToggleButton Grid.Column="3" Content="Follow" IsChecked="{Binding IsFollowing}" Padding="10,4"
                                   ToolTip="Live-tail the selected channel - new matching events are pushed into the grid as they're written." />
                </Grid>

                <!-- #108: saved filter presets, including the built-in ones (Crash triage / Storage
                     errors / Service failures / Boot problems). -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Saved filters:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                    <ItemsControl ItemsSource="{Binding SavedFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SavedEventFilter}">
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Margin="0,0,6,0" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Name}" FontSize="11.5" Padding="0"
                                                 Background="Transparent" BorderThickness="0"
                                                 Command="{Binding DataContext.ApplyFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" />
                                        <Button Content=" ⇩" FontSize="10.5" Padding="0" Margin="4,0,0,0"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Command="{Binding DataContext.ExportFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" ToolTip="Export as an Event Viewer custom view (#109)" />
                                        <Button Content=" ✕" FontSize="10.5" Padding="0" Margin="4,0,0,0"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Command="{Binding DataContext.DeleteFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" ToolTip="Delete this saved filter" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding NewFilterName, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="10,0,8,0" />
                    <Button Content="Save current as filter" Command="{Binding SaveFilterCommand}" Padding="8,3" />
                </StackPanel>

                <!-- #109-114, #116: everything a power user needs but not every session - import/
                     export, opening external .evtx files, the button-gated cross-channel search,
                     the multi-channel structured query, the provider catalog, "copy current view",
                     and the grid's grouping/correlation-column toggles. Collapsed by default so the
                     always-visible filter bar above stays uncluttered. -->
                <Expander Header="More tools" Margin="0,10,0,0" FontSize="11.5">
                    <StackPanel Margin="0,10,0,0">

                        <!-- #116: grouping + correlation columns -->
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Group by:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Width="100" SelectedValuePath="Content" SelectedValue="{Binding GroupBy}" Margin="0,0,18,0">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Provider" />
                                <ComboBoxItem Content="EventId" />
                            </ComboBox>
                            <CheckBox Content="Show correlation ID columns" IsChecked="{Binding ShowCorrelationColumns}" VerticalAlignment="Center" Margin="0,0,18,0" />
                            <TextBlock Text="{Binding EvidenceBundle.Count, StringFormat='Evidence bundle: {0} item(s)'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </WrapPanel>

                        <!-- #117/#126: knowledge-base coverage - how many built-in/override entries
                             loaded (transparency into the override-merge mechanism), and how many
                             distinct events browsed so far have no KB entry at all, with an export
                             to feed event-kb-overrides.json. -->
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding KbStatusText}" VerticalAlignment="Center" Margin="0,0,18,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding UnknownEventCount, StringFormat='Events with no KB entry seen so far: {0}'}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <Button Content="Export unknown events..." Command="{Binding ExportUnknownEventsCommand}" Padding="8,3" FontSize="11"
                                     ToolTip="Exports the distinct provider / event ID / sample message list for every event browsed so far with no local knowledge-base entry (#126)." />
                        </WrapPanel>

                        <!-- #114: copy the active filter as a reproducible command line -->
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Copy as wevtutil command" Command="{Binding CopyAsWevtutilCommand}" Padding="8,3" Margin="0,0,8,0" />
                            <Button Content="Copy as PowerShell command" Command="{Binding CopyAsPowerShellCommand}" Padding="8,3" />
                        </WrapPanel>

                        <!-- #110: open an external .evtx file / recent archive quick-picks -->
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Open .evtx file..." Command="{Binding OpenEvtxFileCommand}" Padding="8,3" Margin="0,0,8,0" />
                            <Button Content="Refresh recent archives" Command="{Binding RefreshRecentArchivesCommand}" Padding="8,3" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding RecentArchives}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RecentArchiveEntry}">
                                        <Button Content="{Binding FileName}" FontSize="11" Padding="6,2" Margin="0,0,6,0"
                                                 Command="{Binding DataContext.OpenArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" ToolTip="{Binding Path}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <!-- #111: cross-channel full-text search, button-gated with progress + cancel -->
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Search all channels" Command="{Binding SearchAllChannelsCommand}" Padding="8,3" Margin="0,0,8,0"
                                     ToolTip="Uses the Level/Provider/Event IDs/Lookback filters above as bounds, and Keyword as the text to match - can take a while on a busy machine." />
                            <CheckBox Content="Regex" IsChecked="{Binding IsRegexSearch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Cancel" Command="{Binding CancelSearchCommand}" Padding="8,3" Margin="0,0,8,0" />
                            <ProgressBar Width="110" Height="6" IsIndeterminate="{Binding IsSearchingAllChannels}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SearchProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedEvent}"
                                   IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="200" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                                <DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}" Width="140" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*" />
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- #112: one structured query across every checked channel in the tree -->
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Multi-channel query (checked channels)" Command="{Binding RunMultiChannelQueryCommand}" Padding="8,3" Margin="0,0,8,0"
                                     ToolTip="Uses whichever channels are checked in the tree on the left (or every accessible channel if none are checked), with the XPath box above." />
                            <Button Content="Load more" Command="{Binding LoadMoreMultiChannelCommand}" Padding="8,3" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMoreMultiChannel}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding MultiChannelStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding MultiChannelResults}" SelectedItem="{Binding SelectedEvent}"
                                   IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="200" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="130" />
                                <DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}" Width="140" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*" />
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- #113: provider catalog toggle (panel itself overlays the three-pane area below) -->
                        <WrapPanel Margin="0,0,0,10">
                            <ToggleButton Content="Provider catalog" IsChecked="{Binding IsProviderCatalogOpen}" Padding="8,3" />
                        </WrapPanel>

                        <!-- #109: import Event Viewer's own custom views / export a saved filter back to one -->
                        <WrapPanel>
                            <Button Content="Scan Event Viewer custom views" Command="{Binding ScanCustomViewsCommand}" Padding="8,3" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding ImportableCustomViews}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ImportableCustomView}">
                                        <Button FontSize="11" Padding="6,2" Margin="0,0,6,4"
                                                 Command="{Binding DataContext.ImportCustomViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" ToolTip="{Binding SourceFilePath}">
                                            <TextBlock Text="{Binding Name, StringFormat='Import &quot;{0}&quot;'}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- #102: left channel tree, grouped into Windows Logs / Applications and Services /
                 Analytic-Debug, each node annotated with record count + last-write time. -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Channels" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="13" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshChannelsCommand}" Padding="8,3" FontSize="11" />
                    </Grid>
                    <TreeView x:Name="ChannelTreeView" ItemsSource="{Binding ChannelTree}"
                              SelectedItemChanged="ChannelTreeView_SelectedItemChanged"
                              BorderThickness="0" Background="Transparent" Margin="4,0,4,4">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsGroup}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccessible}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <!-- #112: multi-select checkbox feeding "Multi-channel query" -
                                         hidden for group headings and inaccessible leaves. -->
                                    <CheckBox IsChecked="{Binding IsSelectedForMulti, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                               ToolTip="Include in Multi-channel query (#112)">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAccessible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    <TextBlock Text=" (no access)" FontSize="10.5" Foreground="{DynamicResource DangerBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccessible}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RecordCount, StringFormat=' ({0})'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecordCount, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- #103: virtualized, paged event grid - ~500 records per page, appended as the user
                 scrolls/clicks "Load more" rather than reading a whole (possibly 100MB) channel
                 up front. -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="12,6,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Events.Count, StringFormat='{}{0} event(s) in view'}"
                                    VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Content="Load more" Command="{Binding LoadMoreCommand}" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMore}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <DataGrid x:Name="EventsGrid" ItemsSource="{Binding EventsView}" SelectedItem="{Binding SelectedEvent}"
                               Margin="4,10,4,0"
                               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                               EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- #116: optional grouping by provider or event ID, each group header showing
                             a count - collapses e.g. 400 identical DistributedCOM rows into one. -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold" FontSize="11.5" Margin="2,8,0,2"
                                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <!-- #115: row-level actions - Explain (stub, see #117), copy XML/Markdown,
                             quick re-filters, a time-bounded multi-channel lookup, and the evidence
                             bundle. Attached to the DataGrid itself (not per-row) so
                             PlacementTarget.DataContext/SelectedItem resolve cleanly through the
                             detached ContextMenu popup. -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Explain (preview)"
                                           Command="{Binding PlacementTarget.DataContext.ExplainEventCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Copy XML"
                                           Command="{Binding PlacementTarget.DataContext.CopyEventXmlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy as Markdown"
                                           Command="{Binding PlacementTarget.DataContext.CopyEventMarkdownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Filter to this Event ID"
                                           Command="{Binding PlacementTarget.DataContext.FilterToEventIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Filter to this provider"
                                           Command="{Binding PlacementTarget.DataContext.FilterToProviderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Show +/-5 minutes across all channels"
                                           Command="{Binding PlacementTarget.DataContext.ShowAroundTimeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Add to evidence bundle"
                                           Command="{Binding PlacementTarget.DataContext.AddToEvidenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                           CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTemplateColumn Header="Level" Width="80" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="2*" />
                            <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                            <!-- #120: this app's own re-ranked severity, next to (not instead of) Windows'
                                 own Level column above - click to sort so the worst re-ranked events surface
                                 first, since Windows' own level routinely disagrees (DCOM 10016 is an Error
                                 that's cosmetic; disk 153 is a Warning that means a dying drive). Blank for
                                 an event with no KB entry at all, rather than a misleading rank. -->
                            <DataGridTemplateColumn Header="Re-ranked severity" Width="110" SortMemberPath="KbSeverityRank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KbSeverityLabel}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KbSeverityLabel}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding KbSeverityLabel}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding KbSeverityLabel}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Task/Opcode" Width="1.4*">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="Task" />
                                        <Binding Path="Opcode" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}" Width="80" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                            <DataGridTextColumn Header="User" Binding="{Binding UserSid}" Width="1.2*" />
                            <!-- #116: correlation columns - hidden unless explicitly toggled on via
                                 the filter bar's "More tools" expander, since most events don't set
                                 either field and they add little value by default. -->
                            <DataGridTextColumn Header="Activity ID" Binding="{Binding ActivityId}" Width="130"
                                                  Visibility="{Binding DataContext.ShowCorrelationColumns, ElementName=EventsGrid, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <DataGridTextColumn Header="Related Activity ID" Binding="{Binding RelatedActivityId}" Width="130"
                                                  Visibility="{Binding DataContext.ShowCorrelationColumns, ElementName=EventsGrid, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- #105/#106: friendly detail (description + property grid, resolved user account and
                 running-process name) with a toggle to the full raw record XML. -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Event detail" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="13" />
                        <CheckBox Grid.Column="1" Content="Raw XML" IsChecked="{Binding ShowRawXml}" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibilityConverter}}">

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRawXml}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="{Binding SelectedEvent.ProviderName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,10">
                                        <Run Text="Event " /><Run Text="{Binding SelectedEvent.EventId, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding SelectedEvent.TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedEvent.Message}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />
                                    <TextBlock Text="Provider message file not registered - see the raw XML for full detail." TextWrapping="Wrap"
                                                Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,-8,0,12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedEvent.Message}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="Properties" Style="{StaticResource CardTitle}" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding DetailProperties}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:EventPropertyDisplay}">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- #118: "quick flag, not a verdict" - the standard informational
                                         banner, framing everything below as a starting point for
                                         troubleshooting, never a diagnosis (CLAUDE.md's heuristic-feature
                                         convention, applied to the event knowledge base). -->
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="8,6" Margin="0,14,0,8">
                                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                                            <Run Text="the section below is what this event usually means, separate from what Windows literally logged above; treat it as a troubleshooting starting point, not a confirmed diagnosis." />
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="What this usually means" Style="{StaticResource CardTitle}" FontSize="12" />
                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ExplainSourceLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,6,0"
                                                     Visibility="{Binding ExplainConfidenceLabel, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{Binding ExplainConfidenceLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="8" Padding="6,2"
                                                     Visibility="{Binding ExplainIsBenign, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Usually benign / noise" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ExplainMeaning}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                                    Visibility="{Binding ExplainMeaning, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <ItemsControl ItemsSource="{Binding ExplainLikelyCauses}" Margin="0,0,0,8">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExplainLikelyCauses.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                                                        <Run Text="• " /><Run Text="{Binding}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- #125: a real app action button, shown only when the KB entry
                                             maps to one that actually exists (currently: restart the
                                             matching service, for Service Control Manager 7031/7009). -->
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                                                 Visibility="{Binding ExplainNextStep, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Suggested next step" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding ExplainNextStep}" TextWrapping="Wrap" FontSize="11.5" />
                                                <Button Content="{Binding ExplainActionLabel}" Command="{Binding RunKbActionCommand}" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                         Visibility="{Binding ExplainActionLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- #124: status codes detected in the message, resolved via
                                             `certutil -error` - hover for the full resolved text. -->
                                        <ItemsControl ItemsSource="{Binding ExplainStatusCodes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:StatusCodeExplain}">
                                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="6,4" Margin="0,0,0,4" ToolTip="{Binding ResolvedText}">
                                                        <TextBlock FontSize="11" TextWrapping="Wrap">
                                                            <Run Text="{Binding Code}" FontFamily="Consolas" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding ResolvedText}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <TextBox Text="{Binding SelectedEvent.RawXml, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                          FontFamily="Consolas" FontSize="10.5" BorderThickness="0" Background="Transparent"
                                          VerticalScrollBarVisibility="Disabled" AcceptsReturn="True">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRawXml}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>

                            <TextBlock Text="Select an event to see its detail.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEvent, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- #113: provider catalog browser - an overlay panel (not always-visible per the
                 spec) reachable via the "Provider catalog" toggle in the filter bar's "More tools"
                 expander. Spans every column of this Grid so it sits on top of the three panes
                 below rather than squeezing into one of them. -->
            <Border Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProviderCatalogOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Provider catalog" Style="{StaticResource CardTitle}" FontSize="14" Margin="0" />
                            <TextBlock Text="Every event ID a provider's own manifest declares it can emit - read straight from the machine, never a bundled lookup table." Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Content="Close" IsChecked="{Binding IsProviderCatalogOpen}" Padding="10,4" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBox DockPanel.Dock="Top" Text="{Binding ProviderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,6" ToolTip="Filter the provider list by name" />
                            <ListBox ItemsSource="{Binding ProviderNamesView}" SelectedItem="{Binding SelectedProvider}"
                                      BorderThickness="0" Background="Transparent" FontSize="11.5" />
                        </DockPanel>

                        <DataGrid Grid.Column="2" ItemsSource="{Binding ProviderEvents}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                                <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="45" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90" />
                                <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="120" />
                                <DataGridTextColumn Header="Opcode" Binding="{Binding Opcode}" Width="100" />
                                <DataGridTextColumn Header="Keywords" Binding="{Binding Keywords}" Width="160" />
                                <DataGridTextColumn Header="Channels" Binding="{Binding Channels}" Width="180" />
                                <DataGridTextColumn Header="Message template" Binding="{Binding Template}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
