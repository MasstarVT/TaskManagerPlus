<UserControl x:Class="TaskManagerPlus.Views.ResponsivenessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:ResponsivenessViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Sections. 64 cards in one scroll. This tab already had hand-rolled section headers (a
         Separator plus a bold TextBlock) marking four of these groupings - those are now the chips
         themselves, so the separators and duplicate title lines are gone. -->
    <TabControl Style="{StaticResource SectionTabControl}" SelectedIndex="0">
        <TabItem Header="Overview">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #201-203/#207-209/#213-214: hidden with an explanation when logman/tracerpt aren't
                         present on this system, per CLAUDE.md's "degrade to hidden, never fabricate" rule. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DpcToolsAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}"
                                   Text="DPC/ISR latency capture unavailable — logman.exe/tracerpt.exe weren't found on this system." />
                    </Border>
                    <!-- #202/#214: headline meters. -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <views:VfdMeter Title="Worst DPC" Glow="True" Margin="0,0,8,0"
                                        ValueText="{Binding HighestDpcUs, StringFormat={}{0:0.#}}" Unit="µs"
                                        SubText="{Binding HighestDpcDriver, StringFormat=Driver: {0}, TargetNullValue=No driver measured yet}"
                                        AccentBrush="{Binding HighestDpcUs, Converter={StaticResource DpcTimeToBrushConverter}}" />
                        <views:VfdMeter Title="Avg / P99" Glow="False" Margin="8,0,8,0"
                                        ValueText="{Binding RollingAvgUs, StringFormat={}{0:0.#}}" Unit="µs"
                                        SubText="{Binding RollingP99Us, StringFormat=P99: {0:0.#} µs}"
                                        AccentBrush="{DynamicResource TextSecondaryBrush}" />
                        <views:VfdMeter Title="Audio-glitch events" Glow="True" Margin="8,0,0,0"
                                        ValueText="{Binding AudioGlitchCount}"
                                        SubText="{Binding AudioGlitchThresholdUs, StringFormat=DPCs over {0:0} µs — likely dropouts}"
                                        AccentBrush="{DynamicResource DangerBrush}" />
                    </UniformGrid>
                    <TextBlock Text="Quick flag, not a verdict: high DPC/ISR time points at a driver as the most likely cause of stutter, not a confirmed diagnosis."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" Margin="0,0,0,16" TextWrapping="Wrap" />
                    <!-- #204: DPC watchdog headroom. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DPC watchdog headroom" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Watchdog.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Height="10" CornerRadius="6" Background="{DynamicResource BgElevatedBrush}">
                                <Border HorizontalAlignment="Left" Height="10" CornerRadius="6" Background="{DynamicResource DangerBrush}"
                                        Width="{Binding WatchdogHeadroomPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=300}" />
                            </Border>
                            <TextBlock Text="{Binding WatchdogHeadroomPercent, StringFormat={}{0:0.##}% of the DPC_WATCHDOG_VIOLATION threshold — see the Stability tab for any 0x133 bugchecks.}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="DPC &amp; ISR">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #213: measurement session controls. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Measurement session" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <WrapPanel>
                                <Button Content="Start" Command="{Binding StartMeasurementCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,4" />
                                <Button Content="Stop" Command="{Binding StopMeasurementCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4" />
                                <Button Content="Copy summary" Command="{Binding CopySummaryCommand}" Margin="0,0,8,4" />
                                <TextBlock Text="{Binding MeasurementStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBox Text="{Binding SessionSummaryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="{StaticResource FontBody}" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0" Background="Transparent" BorderThickness="0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SessionSummaryText, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Border>
                    <!-- #207/#214: rolling max-DPC-latency chart with the audio-glitch threshold marker. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DPC/ISR latency history" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <lvc:CartesianChart Series="{Binding LatencySeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding LatencyYAxes}"
                                                 Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #201/#208/#211/#212: DPC-by-driver grid. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DPC time by driver" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding DriverDpcRows}" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding IdentityText}" Width="2.2*" />
                                    <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="70" />
                                    <DataGridTextColumn Header="Total (µs)" Binding="{Binding TotalTimeUs, StringFormat={}{0:0}}" Width="90" />
                                    <DataGridTextColumn Header="Avg (µs)" Binding="{Binding AvgTimeUs, StringFormat={}{0:0.#}}" Width="90" />
                                    <DataGridTextColumn Header="Max (µs)" Binding="{Binding MaxTimeUs, StringFormat={}{0:0.#}}" Width="90" />
                                    <DataGridTextColumn Header="Timer / Device" Binding="{Binding TimerVsDeviceText}" Width="1.1*" />
                                    <DataGridTextColumn Header="Outdated?" Binding="{Binding IsOutdated}" Width="80" />
                                    <!-- #216: best-effort driver-file -> device-name join, blank on a miss. -->
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="1.6*" />
                                    <DataGridTextColumn Header="Hint" Binding="{Binding KnownOffenderHint}" Width="2.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #203: ISR-by-driver grid, kept separate from DPC deliberately. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ISR time by driver" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding DriverIsrRows}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="2.2*" />
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" />
                                    <DataGridTextColumn Header="Total (µs)" Binding="{Binding TotalTimeUs, StringFormat={}{0:0}}" Width="90" />
                                    <DataGridTextColumn Header="Avg (µs)" Binding="{Binding AvgTimeUs, StringFormat={}{0:0.#}}" Width="90" />
                                    <DataGridTextColumn Header="Max (µs)" Binding="{Binding MaxTimeUs, StringFormat={}{0:0.#}}" Width="90" />
                                    <!-- #216: best-effort driver-file -> device-name join, blank on a miss. -->
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="1.8*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #209: recent spikes with foreground-app context. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Recent spikes" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding RecentSpikes}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:T}}" Width="90" />
                                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="1.6*" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="60" />
                                    <DataGridTextColumn Header="Duration (µs)" Binding="{Binding DurationUs, StringFormat={}{0:0.#}}" Width="100" />
                                    <DataGridTextColumn Header="Context (foreground app)" Binding="{Binding ForegroundContext}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #205/#206: per-core DPC/interrupt time and queue depth/rate. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Per-core DPC / interrupt time" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding CoreDpcRows}" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Core" Binding="{Binding CoreIndex}" Width="50" />
                                        <DataGridTextColumn Header="DPC %" Binding="{Binding DpcPercent, StringFormat={}{0:0.##}}" Width="*" />
                                        <DataGridTextColumn Header="Interrupt %" Binding="{Binding InterruptPercent, StringFormat={}{0:0.##}}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="DPC queue depth / rate" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding CoreDpcQueueRows}" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Core" Binding="{Binding CoreLabel}" Width="1.4*" />
                                        <DataGridTextColumn Header="Queued/sec" Binding="{Binding DpcsQueuedPerSec, StringFormat={}{0:0.#}}" Width="*" />
                                        <DataGridTextColumn Header="DPC rate" Binding="{Binding DpcRate, StringFormat={}{0:0.#}}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- #215: interrupt-storm detector - a suspiciously high per-core interrupt rate can
                         produce stutter with almost no visible CPU usage in the normal Task Manager, since
                         the work happens in interrupt/DPC context rather than a process's own CPU time. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InterruptStormDetected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Interrupt storm detector" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding InterruptStormStatusText}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InterruptStormDetected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding CoreInterruptRows}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Core" Binding="{Binding CoreIndex}" Width="60" />
                                    <DataGridTextColumn Header="Interrupts/sec" Binding="{Binding InterruptsPerSec, StringFormat={}{0:0.#}}" Width="*" />
                                    <DataGridTextColumn Header="Suspected storm?" Binding="{Binding IsSuspectedStorm}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Quick flag, not a verdict: a core sustaining an interrupt rate far above its siblings (or above an absolute ceiling) points at a possible interrupt storm, not a confirmed diagnosis."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- #217/#219: IRQ sharing map + interrupt affinity policy, side by side since they're
                         both "how is this machine's interrupt hardware wired up" facets. #218: MSI/MSI-X
                         status folded into the same per-device grid as #219, since both live under the same
                         registry subtree/device enumeration. On-demand: device/IRQ topology essentially
                         never changes tick to tick, so these load once at start-up plus a manual refresh. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Device / IRQ topology" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadDeviceTopologyCommand}" Padding="10,4" />
                            </Grid>
                            <TextBlock Text="{Binding DeviceTopologyStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="#217: IRQ sharing map — lines with 3+ sharers are flagged." FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding IrqShareRows}" MaxHeight="180" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IRQ" Binding="{Binding IrqNumber}" Width="60" />
                                    <DataGridTextColumn Header="Sharers" Binding="{Binding SharerCount}" Width="70" />
                                    <DataGridTextColumn Header="Heavily shared?" Binding="{Binding IsHeavilyShared}" Width="120" />
                                    <DataGridTextColumn Header="Devices" Binding="{Binding DevicesText}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="#218/#219: MSI/MSI-X status and interrupt-affinity policy per device — a high-traffic device (GPU/NIC/NVMe/USB controller) still on line-based interrupts is flagged, but this is worth a manual check, not a confirmed misconfiguration." FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding DeviceInterruptRows}" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2*" />
                                    <DataGridTextColumn Header="Class" Binding="{Binding DeviceClass}" Width="80" />
                                    <DataGridTextColumn Header="Interrupt mode" Binding="{Binding MsiStatusText}" Width="140" />
                                    <DataGridTextColumn Header="Line-based (high-traffic)?" Binding="{Binding IsLineBasedHighTraffic}" Width="150" />
                                    <DataGridTextColumn Header="Affinity policy" Binding="{Binding AffinityText}" Width="1.4*" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding DevicePriorityText}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #220/#227/#232: Platform latency settings - a small, generically-named list later
                         chunks in this domain append more rows to; #227 (bcdedit boot-config timer flags)
                         and #232 (powercfg -q latency-relevant processor settings) both land here. Each
                         row's optional Note (informational context / "quick flag, not a verdict" wording)
                         renders as a wrapped subtext line when present. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Platform latency settings" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding PlatformLatencySettings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SettingName}" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Note, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #225/#228/#234: current timer resolution readout, QPC frequency/drift check, and a
                         timer-coalescing inference, all derived from TimerResolutionService. #226 ("who
                         raised it") is listed underneath as its own on-demand button + results list, per
                         the task's own framing. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Timer resolution &amp; QPC" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="Current resolution" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding TimerResolution.CurrentMs, StringFormat={}{0:0.###}}" Unit="ms"
                                                SubText="{Binding TimerResolution.WakeupsPerSec, StringFormat={}{0:0} wake-ups/sec}">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Setter Property="AccentBrush" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TimerResolution.IsRaised}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                                <views:VfdMeter Title="Range" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding TimerResolution.FinestMs, StringFormat={}{0:0.###}}" Unit="ms finest"
                                                SubText="{Binding TimerResolution.CoarsestMs, StringFormat={}up to {0:0.###} ms coarsest}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <TextBlock Text="{Binding TimerResolution.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding TimerResolution.CoalescingInferenceText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="Check QPC" Command="{Binding CheckQpcCommand}" Padding="10,4" Margin="0,0,8,4" />
                                <TextBlock Text="A quick ~1.5s check that the QPC clock this whole tab's microsecond readings are built on isn't drifting against the system clock." VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding QpcDrift.StatusText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QpcDrift.LooksStable}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Separator Margin="0,0,0,10" />

                            <TextBlock Text="#226: who raised it" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <TextBlock Text="Runs a short (~15s) powercfg /energy scan for the &quot;Platform Timer Resolution&quot; finding, plus a best-effort read of the (undocumented, not present on every Windows build) GlobalTimerResolutionRequests registry value."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="Check now (~15s)" Command="{Binding CheckTimerRequestersCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TimerRequestersStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding TimerResolutionRequesters}" MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2.6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Devices &amp; power">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #229: full powercfg /energy Errors/Warnings report - the slow (~60s) diagnostic,
                         always an explicit button per CLAUDE.md's on-demand rule. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Energy &amp; latency report" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Runs powercfg /energy's full system diagnostic and parses its Errors/Warnings rows (USB selective-suspend violations, outstanding power requests, timer resolution, disabled processor idle, device sleep-blockers, and more)."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Run report (~60 seconds)" Command="{Binding RunEnergyReportCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,4" />
                                <Button Content="Open full report" Command="{Binding OpenEnergyReportCommand}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding EnergyReportStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding EnergyReportFindings}" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.6*" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #230: outstanding power requests (powercfg /requests) - fast/cheap, loaded at
                         start-up plus a manual refresh, same tier as the #217-220 device-topology load. An
                         EXECUTION or PERFBOOST request held forever changes scheduling/idle behavior and is
                         otherwise completely invisible. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outstanding power requests" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadPowerRequestsCommand}" Padding="10,4" />
                            </Grid>
                            <TextBlock Text="{Binding PowerRequestsStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding PowerRequestRows}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                                    <DataGridTextColumn Header="Holder" Binding="{Binding Holder}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #231: modern-standby drain / top activators (powercfg /sleepstudy) - on-demand
                         only, and hidden entirely (not just empty) when this machine has no modern-standby
                         support at all. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModernStandbySupported}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Modern-standby drain" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Runs powercfg /sleepstudy (falling back to /systemsleepdiagnostics if unsupported) and lists the top activators — components that kept the system from idling during modern standby, the classic 'feels sluggish after waking a laptop' cause."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Run sleep study" Command="{Binding RunSleepStudyCommand}" Margin="0,0,8,4" />
                                <Button Content="Open full report" Command="{Binding OpenSleepStudyReportCommand}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SleepStudyStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding SleepStudyActivators}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Activator" Binding="{Binding Name}" Width="1.6*" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #224: problem devices - anything Device Manager would show with a yellow bang. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Problem devices" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding ProblemDeviceRows}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Code" Binding="{Binding ConfigManagerErrorCode}" Width="60" />
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding ErrorText}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No problem devices found.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemDeviceRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #222: Wi-Fi background-scan-storm suspected cause - on-demand, not a timer. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Wi-Fi background scan storm" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Checks whether a Wi-Fi adapter is still associated (and therefore still periodically scanning/roaming) while the machine is actually getting its traffic over Ethernet."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="Check now" Command="{Binding CheckWifiScanStormCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding WifiScanStorm.StatusText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WifiScanStorm.Detected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #223: USB/PnP re-enumeration churn - on-demand scan button, not a timer. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="USB re-enumeration churn" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Repeated device arrive/remove cycling from one device is the classic 'the whole PC hitches every few seconds' symptom - scans the last 30 minutes of PnP events."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="Scan now" Command="{Binding ScanUsbChurnCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding UsbChurnStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding UsbChurnRows}" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device instance" Binding="{Binding DeviceInstanceId}" Width="2*" />
                                    <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="70" />
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastEvent, StringFormat={}{0:T}}" Width="100" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding DeviceDescription}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Hangs &amp; stalls">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #235/#236/#242/#243/#244: live hung-window detector - per-window (not per-process),
                         with a graded message-pump round-trip time (#236). Right-click a row to write a
                         full dump (#242); select a row to expand its wait-reason hint (#243) and
                         cross-process chain guess (#244), both explicitly quick flags, not verdicts. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hung windows" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Every top-level window, probed the same way Explorer/Task Manager detect &quot;(Not Responding)&quot; - per window, so a multi-window app with one stuck dialog isn't hidden behind its other, responsive windows."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding HungWindowRows}" SelectedItem="{Binding SelectedHungWindow}"
                                      MaxHeight="260" IsReadOnly="True" AutoGenerateColumns="False"
                                      RowDetailsVisibilityMode="VisibleWhenSelected">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Create dump (.dmp)..." Command="{Binding CreateDumpCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHung}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Window title" Binding="{Binding WindowTitle}" Width="2.4*" />
                                    <DataGridTextColumn Header="Hung?" Binding="{Binding IsHung}" Width="60" />
                                    <DataGridTextColumn Header="Response (ms)" Binding="{Binding ResponseMsText}" Width="100" />
                                    <DataGridTextColumn Header="Hung for" Binding="{Binding HungForText}" Width="80" />
                                </DataGrid.Columns>
                                <!-- #243/#244: inline expander under the selected row - wait-reason hint and
                                     cross-process chain guess, only populated for a currently-hung window. -->
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="24,2,4,6">
                                            <TextBlock Text="{Binding WaitHintText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WaitHintText, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ChainText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChainText, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Not currently hung, or no detail resolved yet." FontSize="{StaticResource FontBody}" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding WaitHintText, Converter={StaticResource StringNotEmptyConverter}}" Value="False" />
                                                                    <Condition Binding="{Binding ChainText, Converter={StaticResource StringNotEmptyConverter}}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- #271: Wait Chain Traversal against this window's own owning
                                                 thread - the same in-box API Resource Monitor's own
                                                 "Analyze Wait Chain" action uses. -->
                                            <Button Content="Analyze wait chain..." HorizontalAlignment="Left" FontSize="{StaticResource FontBody}" Padding="8,3" Margin="0,6,0,0"
                                                    Command="{Binding DataContext.AnalyzeHungWindowWaitChainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBlock Text="{Binding DataContext.HungWindowWaitChainStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.HungWindowWaitChainStatusText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding DataContext.HungWindowWaitChainNodes, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="{Binding IndentLevel, Mode=OneWay, StringFormat=\{0\}: }" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Run Text="{Binding Description, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                            <TextBlock Text="{Binding DumpStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" Margin="0,6,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DumpStatusText, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #238: foreground-window stall recorder - per-app ranked stall table, "what was I
                         using when it froze". -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Foreground stalls by app" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="Stall threshold (ms):" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="{StaticResource FontBody}" />
                                <TextBox Text="{Binding ForegroundStallThresholdMs, StringFormat={}{0:0}}" Width="70" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Text="Only counts a stall while its app was the one in focus - a correlation, not proof that app caused it (quick flag, not a verdict)."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding ForegroundStalls}" MaxHeight="200" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding ProcessName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Stalls" Binding="{Binding StallCount}" Width="70" />
                                    <DataGridTextColumn Header="Max (ms)" Binding="{Binding MaxStallMs, StringFormat={}{0:0}}" Width="90" />
                                    <DataGridTextColumn Header="Avg (ms)" Binding="{Binding AvgStallMs, StringFormat={}{0:0}}" Width="90" />
                                    <DataGridTextColumn Header="Last stall" Binding="{Binding LastStall, StringFormat={}{0:T}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #237: rolling hang log with durations, persisted to hang-log.json so it survives a
                         restart - lower section of the tab per the task's own framing. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hang log" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="Hangs today" Glow="False" Margin="0,0,8,0"
                                                ValueText="{Binding HangsToday}" AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="Longest hang" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding LongestHangText}" AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <DataGrid ItemsSource="{Binding HangLog}" MaxHeight="220" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Window title" Binding="{Binding WindowTitle}" Width="2*" />
                                    <DataGridTextColumn Header="Started" Binding="{Binding StartTime, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, StringFormat={}{0:0.#}}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No hangs recorded yet this session (or ever, on this machine).">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HangLog.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #245: desktop heap size (SharedSection) + session-wide USER/GDI handle totals vs.
                         the documented 10,000/65,536 session limits - desktop-heap exhaustion presents as
                         "windows stop drawing / nothing opens" rather than high CPU. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DesktopHeap.IsNearLimit}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Desktop heap &amp; USER/GDI handles" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DesktopHeap.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,2">
                                <Run Text="USER handles: " /><Run Text="{Binding DesktopHeap.TotalUserHandles, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text=" / 10,000" />
                            </TextBlock>
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource BgElevatedBrush}" Margin="0,0,0,8">
                                <Border HorizontalAlignment="Left" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                        Width="{Binding DesktopHeap.UserHandlePercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=300}" />
                            </Border>

                            <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,2">
                                <Run Text="GDI handles: " /><Run Text="{Binding DesktopHeap.TotalGdiHandles, StringFormat={}{0:N0}, Mode=OneWay}" /><Run Text=" / 65,536" />
                            </TextBlock>
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource BgElevatedBrush}">
                                <Border HorizontalAlignment="Left" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                        Width="{Binding DesktopHeap.GdiHandlePercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=300}" />
                            </Border>
                            <TextBlock Text="Quick flag, not a verdict: Windows exposes no live desktop-heap-usage counter, only the configured size - a near-limit handle total is worth investigating, not a confirmed exhaustion."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #246: shell responsiveness monitor - taskbar/desktop/Explorer-frame message-pump
                         round-trip times, plus a plain-text pointer to the existing shell-extension count
                         (#20), a common cause of shell lag this probe doesn't otherwise measure. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Shell responsiveness" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ShellExtensionNoteText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding ShellResponsivenessRows}" MaxHeight="180" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Window" Binding="{Binding WindowName}" Width="2.4*" />
                                    <DataGridTextColumn Header="Response" Binding="{Binding ResponseMsText}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #210: offline wpr.exe capture, for a user who'd rather not run a live session. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Offline capture (wpr.exe)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Records a 30-second general-purpose WPR trace and converts it to a browsable HTML report — reproduce the stutter while it runs."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WprToolsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="wpr.exe/tracerpt.exe weren't found on this system." Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" />
                            </Border>
                            <WrapPanel>
                                <Button Content="Start 30s capture" Command="{Binding CaptureWprCommand}" Margin="0,0,8,4" />
                                <Button Content="Open trace (.etl)" Command="{Binding OpenCaptureCommand}" Margin="0,0,8,4" />
                                <Button Content="Open report" Command="{Binding OpenReportCommand}" Margin="0,0,8,4" />
                                <TextBlock Text="{Binding WprStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Scheduling">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #260/#265: run-queue pressure meter, with context-switch-storm attribution ranked
                         underneath per the item's own framing. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Run-queue pressure" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="A sustained processor queue length well above the logical processor count means threads are waiting for CPU even when total CPU% looks fine."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <views:VfdMeter Title="Queue length" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding RunQueuePressure.ProcessorQueueLength, StringFormat={}{0:0.#}}"
                                                SubText="{Binding RunQueuePressure.LogicalProcessorCount, StringFormat={}of {0} logical processors}">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunQueuePressure.IsElevated}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                                <views:VfdMeter Title="Ready threads/core (approx)" Glow="False" Margin="8,0,8,0"
                                                ValueText="{Binding RunQueuePressure.ReadyThreadsPerCoreApprox, StringFormat={}{0:0.##}}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                                <views:VfdMeter Title="Context switches/sec" Glow="True" Margin="8,0,0,0"
                                                ValueText="{Binding Performance.ContextSwitchesPerSec, StringFormat={}{0:N0}}"
                                                AccentBrush="{DynamicResource AccentBrush}" />
                            </UniformGrid>
                            <TextBlock Text="&quot;Ready threads/core&quot; is an explicit approximation (queue length ÷ logical processor count) - Windows exposes no true per-core ready-queue counter."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <lvc:CartesianChart Series="{Binding RunQueuePressureSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding RunQueuePressureYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />

                            <Separator Margin="0,14,0,10" />
                            <TextBlock Text="#265: who's driving the context-switch rate" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding ContextSwitchAttribution}" MaxHeight="200" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="Context switches/sec" Binding="{Binding ContextSwitchesPerSec, StringFormat={}{0:N0}}" Width="1.2*" />
                                    <DataGridTextColumn Header="% of total" Binding="{Binding PercentOfTotal, StringFormat={}{0:0.#}%}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #273: optional kernel "Synchronization" perf-counter category - hidden entirely
                         (not shown with zeroed values) unless the machine was deliberately configured for
                         kernel-contention diagnostics, per CLAUDE.md's "degrade to hidden" rule. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SynchronizationCounters.IsAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Kernel synchronization contention" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="The optional &quot;Synchronization&quot; performance-counter category is enabled on this system - spinlock and executive-resource contention, straight from the kernel."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <views:VfdMeter Title="Spinlock acquires/sec" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding SynchronizationCounters.SpinlockAcquiresPerSec, StringFormat={}{0:N0}}"
                                                AccentBrush="{DynamicResource AccentBrush}" />
                                <views:VfdMeter Title="Spinlock contentions/sec" Glow="True" Margin="8,0,8,0"
                                                ValueText="{Binding SynchronizationCounters.SpinlockContentionsPerSec, StringFormat={}{0:N0}}"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="Exec. resource contentions/sec" Glow="True" Margin="8,0,0,0"
                                                ValueText="{Binding SynchronizationCounters.ExecResourceContentionsPerSec, StringFormat={}{0:N0}}"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                            </UniformGrid>
                            <lvc:CartesianChart Series="{Binding SynchronizationSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding SynchronizationYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Bottom" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #262/#263: longest-blocked threads and busiest threads (context-switch rate), from
                         the same shared sweep. #261's per-process breakdown is on the Processes tab. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Thread wait &amp; context-switch analysis" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SchedulerStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="#262: longest-blocked threads" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding LongestBlockedThreads}" MaxHeight="220" IsReadOnly="True" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.3*" />
                                    <DataGridTextColumn Header="TID" Binding="{Binding ThreadId}" Width="70" />
                                    <DataGridTextColumn Header="Wait reason" Binding="{Binding WaitReasonText}" Width="1.2*" />
                                    <DataGridTextColumn Header="Waiting (approx)" Binding="{Binding WaitSecondsApprox, StringFormat={}{0:0.#}s}" Width="120" />
                                    <DataGridTextColumn Header="Start address" Binding="{Binding StartAddressText}" Width="120" />
                                    <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="#263: busiest threads (context-switch rate)" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding BusiestThreads}" MaxHeight="220" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuspectedSpin}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.3*" />
                                    <DataGridTextColumn Header="TID" Binding="{Binding ThreadId}" Width="70" />
                                    <DataGridTextColumn Header="Context switches/sec" Binding="{Binding ContextSwitchesPerSec, StringFormat={}{0:N0}}" Width="1.2*" />
                                    <DataGridTextColumn Header="Spin/livelock?" Binding="{Binding IsSuspectedSpin}" Width="110" />
                                    <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Quick flag, not a verdict: a very high context-switch rate on one thread is the signature of a spin-wait or livelock, not a confirmed diagnosis. Waiting/duration figures use an approximate clock-tick conversion, not a certified measurement."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="#261: per-process thread wait-reason breakdown is on the Processes tab - select a process there to see its breakdown."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #264: priority-inversion hint - explicitly a sampled heuristic, never a verdict. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Possible priority inversion" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="A high-priority thread has been sitting ready-to-run (not running) across several consecutive samples while a lower-priority thread keeps running - a sampled pattern over a few ticks, not a traced/proven verdict."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding PriorityInversionHints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SummaryText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No sustained pattern detected in the most recent sample.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PriorityInversionHints.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #269: MMCSS / multimedia scheduling audit. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MMCSS &amp; multimedia scheduling" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding MmcssAudit.StatusText}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MmcssAudit.ServiceRunning}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="Service status: " FontWeight="SemiBold" /><Run Text="{Binding MmcssAudit.ServiceStatusText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="SystemResponsiveness: " FontWeight="SemiBold" /><Run Text="{Binding MmcssAudit.SystemResponsivenessText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,10">
                                <Run Text="NetworkThrottlingIndex: " FontWeight="SemiBold" /><Run Text="{Binding MmcssAudit.NetworkThrottlingText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="NetworkThrottlingIndex throttles non-multimedia network traffic whenever a registered multimedia task is active - a common, invisible cause of &quot;the network gets slow while gaming/watching video&quot; reports."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding MmcssAudit.TaskProfiles}" MaxHeight="160" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="1*" />
                                    <DataGridTextColumn Header="GPU priority" Binding="{Binding GpuPriority}" Width="1*" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="1*" />
                                    <DataGridTextColumn Header="Scheduling category" Binding="{Binding SchedulingCategory}" Width="1.4*" />
                                    <DataGridTextColumn Header="SFIO priority" Binding="{Binding SfioPriority}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #275: .NET GC pause monitor - aggregate perf-counter figures per managed process,
                         not a real per-pause millisecond duration (that needs the optional ETW deep mode
                         on Microsoft-Windows-DotNETRuntime's GC keyword - not implemented in this build,
                         an honestly-labeled partial per the task's own allowance). Still a strong headline
                         signal: a sustained high %Time-in-GC is a real, visible freeze. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text=".NET GC pause monitor" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Aggregate %Time-in-GC and collection counts per managed process, via the .NET CLR Memory performance counters - not a real per-pause millisecond duration (that would need the optional ETW-based deep mode, which isn't implemented here). A sustained high %Time in GC is still a strong signal of GC-driven stalls."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <views:VfdMeter Title="Worst %Time in GC right now" Glow="True" HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,10"
                                            ValueText="{Binding WorstGcPercentTimeInGc, StringFormat={}{0:0.#}%}" Unit="%"
                                            SubText="{Binding WorstGcProcessName}"
                                            AccentBrush="{DynamicResource WarningBrush}" />
                            <DataGrid ItemsSource="{Binding GcProcessRows}" MaxHeight="220" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.2*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="% Time in GC" Binding="{Binding PercentTimeInGc, StringFormat={}{0:0.#}%}" Width="100" />
                                    <DataGridTextColumn Header="Gen0" Binding="{Binding Gen0Collections}" Width="60" />
                                    <DataGridTextColumn Header="Gen1" Binding="{Binding Gen1Collections}" Width="60" />
                                    <DataGridTextColumn Header="Gen2" Binding="{Binding Gen2Collections}" Width="60" />
                                    <DataGridTextColumn Header="Induced" Binding="{Binding InducedGcCount}" Width="70" />
                                    <DataGridTextColumn Header="Alloc/sec" Binding="{Binding AllocatedBytesPerSec, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No managed (.NET) processes with published performance counters were found - either nothing managed is currently running, or the &quot;.NET CLR Memory&quot; category isn't available on this machine.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GcProcessRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Display &amp; frames">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #247/#248: DWM composition timing readout + dropped/missed-frames chart - an
                         in-box, no-ETW view of whether the compositor is keeping up. Rides the cheap
                         _lightTimer. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DWM composition timing" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DwmComposition.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="Refresh rate" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding DwmComposition.RefreshRateHz, StringFormat={}{0:0.##}}" Unit="Hz"
                                                SubText="{Binding DwmComposition.CompositionFrameTimeMs, StringFormat={}{0:0.###} ms/frame}"
                                                AccentBrush="{DynamicResource AccentBrush}" />
                                <views:VfdMeter Title="Dropped + missed" Glow="True" Margin="8,0,0,0"
                                                ValueText="{Binding DwmComposition.DroppedMissedPerSec, StringFormat={}{0:0.##}}" Unit="/sec"
                                                SubText="{Binding DwmComposition.FramesDisplayed, StringFormat={}{0:N0} frame(s) displayed this session}"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                            </UniformGrid>
                            <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,8">
                                <Run Text="Dropped: " FontWeight="SemiBold" /><Run Text="{Binding DwmComposition.FramesDropped, Mode=OneWay}" />
                                <Run Text="    Missed: " FontWeight="SemiBold" /><Run Text="{Binding DwmComposition.FramesMissed, Mode=OneWay}" />
                                <Run Text="    Late: " FontWeight="SemiBold" /><Run Text="{Binding DwmComposition.FramesLate, Mode=OneWay}" />
                                <Run Text="    Outstanding: " FontWeight="SemiBold" /><Run Text="{Binding DwmComposition.FramesOutstanding, Mode=OneWay}" />
                            </TextBlock>
                            <lvc:CartesianChart Series="{Binding CompositionDropSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding CompositionDropYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #249: vblank jitter probe - Start/Stop-gated (a dedicated background thread
                         blocking on DwmFlush()). p50/p99/max cover the item; a literal histogram is a
                         nice-to-have this app skips for now. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="VBlank jitter probe" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Loops on DwmFlush() and times the interval between vblanks - a healthy system shows a tight distribution around the refresh period; compositor stalls show up as a long tail."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Start" Command="{Binding StartVBlankCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,4" />
                                <Button Content="Stop" Command="{Binding StopVBlankCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <views:VfdMeter Title="p50" Glow="False" Margin="0,0,8,0"
                                                ValueText="{Binding VBlankSnapshot.P50Ms, StringFormat={}{0:0.###}}" Unit="ms"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                                <views:VfdMeter Title="p99" Glow="True" Margin="8,0,8,0"
                                                ValueText="{Binding VBlankSnapshot.P99Ms, StringFormat={}{0:0.###}}" Unit="ms"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="Max" Glow="True" Margin="8,0,0,0"
                                                ValueText="{Binding VBlankSnapshot.MaxMs, StringFormat={}{0:0.###}}" Unit="ms"
                                                AccentBrush="{DynamicResource DangerBrush}" />
                            </UniformGrid>
                            <TextBlock Text="{Binding VBlankSnapshot.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- #250/#251/#252/#258/#259: per-process present monitor ("PresentMon-lite") -
                         ETW-based, Start/Stop-gated like the DPC measurement session above. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Present monitor (per-app frame time)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Real-time ETW capture of Microsoft-Windows-DxgKrnl/Dwm-Core present/flip/vsync/queue-packet events, correlated per process - actual frame times for whatever is rendering, not just an average FPS."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PresentToolsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="logman.exe/tracerpt.exe weren't found on this system." Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" />
                            </Border>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Start" Command="{Binding StartPresentMonitorCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,4" />
                                <Button Content="Stop" Command="{Binding StopPresentMonitorCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4" />
                                <TextBlock Text="{Binding PresentStatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" Margin="0,0,0,4" />
                            </WrapPanel>

                            <!-- #251: headline stutter numbers for the busiest captured app. -->
                            <TextBlock Text="{Binding HeadlinePresentRow.ProcessName, StringFormat=Headline app: {0}, TargetNullValue=No app captured yet - press Start and let it render.}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,6" />
                            <UniformGrid Columns="4" Margin="0,0,0,4">
                                <views:VfdMeter Title="Avg FPS" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding HeadlinePresentRow.AvgFps, StringFormat={}{0:0.#}}"
                                                SubText="{Binding HeadlinePresentRow.AvgFrameTimeMs, StringFormat={}{0:0.##} ms avg}"
                                                AccentBrush="{DynamicResource AccentBrush}" />
                                <views:VfdMeter Title="1% low" Glow="False" Margin="8,0,8,0"
                                                ValueText="{Binding HeadlinePresentRow.Low1PercentFps, StringFormat={}{0:0.#}}" Unit="fps"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="0.1% low" Glow="True" Margin="8,0,8,0"
                                                ValueText="{Binding HeadlinePresentRow.Low01PercentFps, StringFormat={}{0:0.#}}" Unit="fps"
                                                AccentBrush="{DynamicResource DangerBrush}" />
                                <views:VfdMeter Title="Hitches" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding HeadlinePresentRow.HitchCount}"
                                                SubText="{Binding HeadlinePresentRow.FrameTimeStdDevMs, StringFormat={}stddev {0:0.##} ms}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <TextBlock Text="1%-low/0.1%-low/hitch-count are the numbers that actually correspond to felt stutter, unlike a single average-FPS figure."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!-- #258: click-to-photon estimate - hidden whenever the present monitor isn't
                                 currently running, per the item's own framing. -->
                            <StackPanel Visibility="{Binding IsMeasuringPresent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,10">
                                <views:VfdMeter Title="Input-to-present estimate" Glow="True" HorizontalAlignment="Left" MinWidth="220"
                                                ValueText="{Binding InputToPresentMs, StringFormat={}{0:0.#}, TargetNullValue=—}" Unit="ms"
                                                SubText="Click-to-photon estimate, excluding display panel latency"
                                                AccentBrush="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Only available while both this present monitor and the input-latency probe below are running - an estimate, not a certified measurement."
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- #251 (nice-to-have): frame-time-vs-index scatter for the headline app. -->
                            <lvc:CartesianChart Series="{Binding FrameTimeScatterSeries}" XAxes="{Binding FrameTimeScatterXAxes}" YAxes="{Binding FrameTimeScatterYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,10" />

                            <!-- #250/#252: per-app grid with best-effort present-mode classification. -->
                            <DataGrid ItemsSource="{Binding PresentAppRows}" MaxHeight="220" IsReadOnly="True" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding ProcessName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Frames" Binding="{Binding FrameCount}" Width="70" />
                                    <DataGridTextColumn Header="Avg FPS" Binding="{Binding AvgFps, StringFormat={}{0:0.#}}" Width="80" />
                                    <DataGridTextColumn Header="Avg frame (ms)" Binding="{Binding AvgFrameTimeMs, StringFormat={}{0:0.##}}" Width="110" />
                                    <DataGridTextColumn Header="1% low" Binding="{Binding Low1PercentFps, StringFormat={}{0:0.#}}" Width="70" />
                                    <DataGridTextColumn Header="0.1% low" Binding="{Binding Low01PercentFps, StringFormat={}{0:0.#}}" Width="70" />
                                    <DataGridTextColumn Header="Hitches" Binding="{Binding HitchCount}" Width="70" />
                                    <!-- #252: "Unknown" is a legitimate outcome here, not a bug - see
                                         PresentMonitorService.ClassifyPresentMode's remarks. -->
                                    <DataGridTextColumn Header="Present mode" Binding="{Binding PresentModeText}" Width="1.4*" />
                                    <DataGridTextColumn Header="What it means" Binding="{Binding PresentModeNote}" Width="2.4*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- #259: long-running GPU packets / preemption events, named to their owning
                                 process - a plain-text cross-link to the Stability tab's own TDR history
                                 satisfies this item's ask without new cross-tab plumbing. -->
                            <TextBlock Text="GPU packet &amp; preemption stalls" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <DataGrid ItemsSource="{Binding GpuStallRows}" MaxHeight="180" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:T}}" Width="90" />
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Quick flag, not a verdict: a long GPU packet or a preemption event is a near-miss for a TDR (GPU driver reset), not a confirmed one - see the Stability tab's own TDR event history for actual driver-reset counts."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #253/#254/#255: display-mode/refresh-rate audit, hardware-accelerated GPU
                         scheduling + TDR settings, and the Game DVR/fullscreen-optimisation audit - all
                         fast registry/API reads, loaded once at start-up plus this shared Refresh. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Display mode, GPU scheduling &amp; Game DVR audit" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadDisplayAuditCommand}" Padding="10,4" />
                            </Grid>

                            <!-- #253 -->
                            <TextBlock Text="#253: refresh rate &amp; display mode" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,4,0,4" />
                            <TextBlock Text="{Binding DisplayModeAudit.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Multiple monitors are running at different refresh rates." Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisplayModeAudit.MixedRefreshRates}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding DisplayModeAudit.Monitors}" MaxHeight="160" IsReadOnly="True" Margin="0,0,0,14">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnderRunning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Monitor" Binding="{Binding MonitorName}" Width="1.6*" />
                                    <DataGridTextColumn Header="Current" Binding="{Binding SummaryText}" Width="2.2*" />
                                    <DataGridTextColumn Header="Under-running?" Binding="{Binding IsUnderRunning}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- #254 -->
                            <TextBlock Text="#254: hardware-accelerated GPU scheduling" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="HAGS: " FontWeight="SemiBold" /><Run Text="{Binding HardwareScheduling.HwSchModeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="TDR delay: " FontWeight="SemiBold" /><Run Text="{Binding HardwareScheduling.TdrDelayText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,8">
                                <Run Text="TDR level: " FontWeight="SemiBold" /><Run Text="{Binding HardwareScheduling.TdrLevelText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding HardwareScheduling.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- #255 -->
                            <TextBlock Text="#255: Game DVR &amp; fullscreen optimisation" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding GameDvrAudit.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="Game Bar auto-mode: " FontWeight="SemiBold" /><Run Text="{Binding GameDvrAudit.GameBarAutoModeEnabled, Mode=OneWay, TargetNullValue=Unknown}" />
                            </TextBlock>
                            <TextBlock Text="Apps with fullscreen optimizations force-disabled (compatibility layer):" FontSize="{StaticResource FontBody}" Margin="0,4,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameDvrAudit.FullscreenOptForcedOffApps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding GameDvrAudit.FullscreenOptForcedOffApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #256/#257: raw-input queue-delay probe + derived polling-rate readout -
                         Start/Stop-gated (a live hidden window + message pump). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Input latency &amp; polling rate" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Registers for raw mouse/keyboard input on a hidden window and compares each event's arrival against its own OS-queue timestamp - how long input sat in the queue before this app saw it, system-wide."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Start" Command="{Binding StartInputLatencyCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,4" />
                                <Button Content="Stop" Command="{Binding StopInputLatencyCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="Queue delay p99" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding InputLatencySnapshot.P99DelayMs, StringFormat={}{0:0.#}}" Unit="ms"
                                                SubText="{Binding InputLatencySnapshot.MaxDelayMs, StringFormat={}max {0:0.#} ms}"
                                                AccentBrush="{DynamicResource WarningBrush}" />
                                <views:VfdMeter Title="Samples" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding InputLatencySnapshot.SampleCount}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <TextBlock Text="{Binding InputLatencySnapshot.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Separator Margin="0,0,0,10" />
                            <TextBlock Text="#257: polling rate &amp; input queue size" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="Mouse: " FontWeight="SemiBold" />
                                <Run Text="{Binding InputLatencySnapshot.MouseReportHz, StringFormat={}{0:0} Hz, TargetNullValue=Unknown - move the mouse while this is running, Mode=OneWay}" />
                                <Run Text="   (queue size: " /><Run Text="{Binding InputLatencySnapshot.MouseQueueSizeText, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,2">
                                <Run Text="Keyboard: " FontWeight="SemiBold" />
                                <Run Text="{Binding InputLatencySnapshot.KeyboardReportHz, StringFormat={}{0:0} Hz, TargetNullValue=Unknown - type while this is running, Mode=OneWay}" />
                                <Run Text="   (queue size: " /><Run Text="{Binding InputLatencySnapshot.KeyboardQueueSizeText, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock Text="Report rate is derived from the tightest back-to-back intervals actually observed while running, not a direct hardware read - a &quot;1000Hz&quot; mouse genuinely reporting at 125Hz becomes visible here."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Memory hitching">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #278/#279: hard-fault rate plus per-process/per-file attribution. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hard-fault rate" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Hard faults (a page actually read from disk) are what stall a thread and freeze the UI for a moment - this is the number behind &quot;the whole PC freezes for a second when I alt-tab&quot;. Soft faults (resolved straight from RAM) dominate Memory\Page Faults/sec and happen harmlessly by the thousand, so they're excluded here."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="Hard faults (pages read from disk)" Glow="True" Margin="0,0,8,0"
                                                ValueText="{Binding HardFaultRate.PagesInputPerSec, StringFormat={}{0:0}}" Unit="/s"
                                                SubText="Memory\Pages Input/sec"
                                                AccentBrush="{DynamicResource DangerBrush}" />
                                <views:VfdMeter Title="Disk reads to resolve them" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding HardFaultRate.PageReadsPerSec, StringFormat={}{0:0}}" Unit="/s"
                                                SubText="Memory\Page Reads/sec — one read can satisfy several pages"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <lvc:CartesianChart Series="{Binding HardFaultSeries}" XAxes="{Binding HiddenXAxes}" YAxes="{Binding HardFaultYAxes}"
                                                 Height="140" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,10" />
                            <TextBlock Text="Hard-fault performance counters aren't available on this system." Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HardFaultRate.IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Separator Margin="0,0,0,10" />
                            <TextBlock Text="#279: per-process attribution (approximate mode)" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <TextBlock Text="Process(*)\Page Faults/sec — approximate: this is total (soft+hard) faults per process, since Windows exposes no per-process hard-fault-only counter. Press Start below for genuinely hard-fault-only, per-file attribution."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding TopPageFaultProcesses}" MaxHeight="200" IsReadOnly="True" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.4*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="Page faults/sec (approx.)" Binding="{Binding PageFaultsPerSec, StringFormat={}{0:0}}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="#279: per-file attribution (ETW deep mode)" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                            <TextBlock Text="An ETW capture of Microsoft-Windows-Kernel-Memory's hard-fault events, which do carry a faulting file name - genuinely hard-fault-only, unlike the approximate mode above."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HardFaultEtwToolsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}"
                                           Text="Hard-fault ETW capture unavailable — logman.exe/tracerpt.exe weren't found on this system." />
                            </Border>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Start" Command="{Binding StartHardFaultEtwCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,4" />
                                <Button Content="Stop" Command="{Binding StopHardFaultEtwCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding HardFaultEtwStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding HardFaultEtwRows}" MaxHeight="200" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.2*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                                    <DataGridTextColumn Header="Hard faults" Binding="{Binding Count}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #280: standby-list depletion - a collapsed standby list combined with a rising
                         hard-fault rate means the machine is thrashing its cache and will hitch on every
                         file touch. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Standby-list depletion" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding StandbyListInfo.StatusText}" Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StandbyListInfo.IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StandbyThrashingStatusText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StandbyThrashingSuspected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StandbyListInfo.IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <views:VfdMeter Title="Free &amp; zero list" Glow="False" Margin="0,0,6,0"
                                                ValueText="{Binding StandbyListInfo.FreeZeroBytes, Converter={StaticResource BytesToReadableConverter}}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                                <views:VfdMeter Title="Standby list (total)" Glow="True" Margin="6,0,6,0"
                                                ValueText="{Binding StandbyListInfo.StandbyTotalBytes, Converter={StaticResource BytesToReadableConverter}}"
                                                SubText="Core + Normal + Reserve priority">
                                    <views:VfdMeter.Style>
                                        <Style TargetType="views:VfdMeter">
                                            <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StandbyThrashingSuspected}" Value="True">
                                                    <Setter Property="AccentBrush" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:VfdMeter.Style>
                                </views:VfdMeter>
                                <views:VfdMeter Title="Modified page list" Glow="False" Margin="6,0,0,0"
                                                ValueText="{Binding StandbyListInfo.ModifiedPageListBytes, Converter={StaticResource BytesToReadableConverter}}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <TextBlock Text="See the Memory tab's &quot;Standby list&quot; meter (Diagnostics section) for a simpler at-a-glance view of the same reclaimable-cache figure."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #281: page-file placement, current/peak usage, and (per row) fragmentation - a
                         page file on a slow/fragmented drive converts every hard fault into a visible
                         stall. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Page-file placement &amp; latency" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding PageFileVolumesStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="System-wide committed" Glow="False" Margin="0,0,8,0"
                                                Percent="{Binding Performance.CommittedPercent}"
                                                ValueText="{Binding Performance.CommittedPercent, StringFormat={}{0:0.0}}" Unit="%"
                                                SubText="Memory\% Committed Bytes In Use"
                                                AccentBrush="{Binding Performance.CommittedPercent, Converter={StaticResource PercentToBrushConverter}}" />
                                <views:VfdMeter Title="Disk read / write latency" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding Performance.DiskReadLatencyMs, StringFormat={}{0:0.0}}" Unit="ms"
                                                SubText="{Binding Performance.DiskWriteLatencyMs, StringFormat={}write {0:0.0} ms (system-wide — not per-volume)}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <DataGrid ItemsSource="{Binding PageFileVolumes}" MaxHeight="220" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Path" Binding="{Binding ConfiguredPath}" Width="1.6*" />
                                    <DataGridTextColumn Header="Configured size" Binding="{Binding SizeText}" Width="1.2*" />
                                    <DataGridTextColumn Header="Media" Binding="{Binding MediaType}" Width="80" />
                                    <DataGridTextColumn Header="% Usage" Binding="{Binding PercentUsage, StringFormat={}{0:0.0}%}" Width="90" />
                                    <DataGridTextColumn Header="% Usage peak" Binding="{Binding PercentUsagePeak, StringFormat={}{0:0.0}%}" Width="100" />
                                    <DataGridTemplateColumn Header="Fragmentation" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Check" FontSize="{StaticResource FontCaption}" Padding="6,0" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.CheckPageFileFragmentationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" IsEnabled="{Binding IsMechanical}" />
                                                    <TextBlock Text="{Binding FragmentationStatusText}" VerticalAlignment="Center" FontSize="{StaticResource FontBody}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFragmentationWarning}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="&quot;Check&quot; is disabled for an SSD page file - fragmentation isn't meaningful there, matching the Storage tab's own HDD-fragmentation card."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Disk read/write latency above is this app's only disk-latency figure - it's aggregated across every physical disk (PhysicalDisk\_Total), not broken out per volume, so it's shown as system-wide context rather than a number specific to whichever drive a page file happens to sit on."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #282: memory-compression pressure - decompression cost shows up as CPU spikes/
                         micro-stutter, not as a memory number alone. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Memory-compression pressure" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding MemoryCompression.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemoryCompression.IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <views:VfdMeter Title="Compressed-memory working set" Glow="True" Margin="0,0,8,0"
                                                Percent="{Binding MemoryCompression.PercentOfTotalRam}"
                                                ValueText="{Binding MemoryCompression.WorkingSetBytes, Converter={StaticResource BytesToReadableConverter}}"
                                                SubText="{Binding MemoryCompression.PercentOfTotalRam, StringFormat={}{0:0.1}% of total RAM}"
                                                AccentBrush="{Binding MemoryCompression.PercentOfTotalRam, Converter={StaticResource PercentToBrushConverter}}" />
                                <views:VfdMeter Title="Modified page list" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding StandbyListInfo.ModifiedPageListBytes, Converter={StaticResource BytesToReadableConverter}}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <TextBlock Text="A large compressed-memory pool means decompression is happening constantly under the hood - that cost shows up as CPU spikes/micro-stutter, not as a separate memory warning. See the Memory tab for overall RAM pressure."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Background activity">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <TextBlock Text="Known background workloads that commonly cause stutter/hitching - Defender scans, indexing, servicing, cloud sync, and more - summarised as one strip. Green = active, gray = idle, dim = unknown/unavailable."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding BackgroundActivityRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,8,8" MinWidth="190">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Fill="{Binding State, Converter={StaticResource BackgroundActivityStateToBrushConverter}}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource FontBody}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CostText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" MaxWidth="220" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <!-- #285: Defender scan state/schedule - hidden detail (StatusText only) when the WMI
                         namespace itself is unavailable (e.g. a third-party AV owns real-time protection). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows Defender scan state" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DefenderScan.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefenderScan.IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefenderScan.IsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding DefenderScan.ScanActivityText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefenderScan.IsScanLikelyActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <views:VfdMeter Title="CPU cap" Glow="False" Margin="0,0,8,0"
                                                    ValueText="{Binding DefenderScan.ScanAvgCpuLoadFactor, TargetNullValue=Unknown}" Unit="%"
                                                    AccentBrush="{DynamicResource TextSecondaryBrush}" />
                                    <views:VfdMeter Title="Signatures updated" Glow="False" Margin="8,0,0,0"
                                                    ValueText="{Binding DefenderScan.SignatureLastUpdated, StringFormat={}{0:g}, TargetNullValue=Unknown}"
                                                    AccentBrush="{DynamicResource TextSecondaryBrush}" />
                                </UniformGrid>
                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Real-time protection: " /><Run Text="{Binding DefenderScan.RealTimeProtectionEnabled, Mode=OneWay}" />
                                    <Run Text=" · Scan only if idle: " /><Run Text="{Binding DefenderScan.ScanOnlyIfIdleEnabled, Mode=OneWay}" />
                                    <Run Text=" · Schedule: " /><Run Text="{Binding DefenderScan.ScanScheduleTimeText, TargetNullValue=Unknown, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="Quick flag, not a verdict: Windows exposes no documented &quot;a scan is running right now&quot; API - this combines MsMpEng's own CPU usage (already polled on the Processes tab) with the most recent scan start time."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #286: on-demand real-time-scan hot-path scan - advisory only, read-only, no
                         automatic exclusion changes. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Real-time-scan hot paths" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDefenderHotPathsCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Scan (last 24h)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingDefenderHotPaths}" Value="True">
                                                        <Setter Property="Text" Value="Scanning..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding DefenderHotPathsStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding DefenderHotPaths}" MaxHeight="220" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Directory" Binding="{Binding Directory}" Width="2.5*" />
                                    <DataGridTextColumn Header="Events" Binding="{Binding EventCount}" Width="70" />
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridCheckBoxColumn Header="Already excluded" Binding="{Binding IsAlreadyExcluded}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Adding exclusions reduces protection. This is a read-only report - this app makes no automatic changes to Defender exclusions."
                                       Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #287: Search indexer - live process cost (always on) plus on-demand crawl-state scan. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Search indexer crawl state" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CheckSearchCrawlCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Check crawl state" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheckingSearchCrawl}" Value="True">
                                                        <Setter Property="Text" Value="Checking..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <views:VfdMeter Title="Indexer process CPU" Glow="False" Margin="0,0,8,0"
                                                ValueText="{Binding SearchIndexerLive.TotalCpuPercent, StringFormat={}{0:0.#}}" Unit="%"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                                <views:VfdMeter Title="Indexer process disk" Glow="False" Margin="8,0,0,0"
                                                ValueText="{Binding SearchIndexerLive.TotalDiskBytesPerSec, Converter={StaticResource BytesToReadableConverter}}"
                                                AccentBrush="{DynamicResource TextSecondaryBrush}" />
                            </UniformGrid>
                            <TextBlock Text="{Binding SearchIndexerCrawl.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Indexed locations" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding SearchIndexerCrawl.IndexedLocations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #288: SysMain (Superfetch) - simpler of the two allowed options: service state +
                         registry config only, not per-service-inside-svchost I/O attribution (see
                         SysMainInfo's remarks). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SysMain (Superfetch)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SysMain.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Service status: " /><Run Text="{Binding SysMain.ServiceStatusText, Mode=OneWay}" />
                                <Run Text=" · EnablePrefetcher: " /><Run Text="{Binding SysMain.PrefetcherEnabled, TargetNullValue=Unknown, Mode=OneWay}" />
                                <Run Text=" · EnableSuperfetch: " /><Run Text="{Binding SysMain.SuperfetchEnabled, TargetNullValue=Unknown, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #289: Delivery Optimization - cheap service+policy state plus on-demand event volume. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Delivery Optimization" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CheckDeliveryOptimizationActivityCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Check activity (24h)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheckingDeliveryOptimizationActivity}" Value="True">
                                                        <Setter Property="Text" Value="Checking..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding DeliveryOptimization.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding DeliveryOptimizationActivity.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="A live transfer-byte-count isn't cheaply readable without the Delivery Optimization COM/PowerShell API - the check above reports recent event-log volume as a proxy instead."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #290: Windows Update / servicing - cheap worker-process cost plus on-demand events,
                         so a long CBS servicing pass is named rather than an anonymous busy disk. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Windows Update / servicing" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding CheckWindowsUpdateEventsCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Check events (24h)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCheckingWindowsUpdateEvents}" Value="True">
                                                        <Setter Property="Text" Value="Checking..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                <Run Text="wuauserv: " /><Run Text="{Binding WindowsUpdateActivity.ServiceStatusText, Mode=OneWay}" />
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding WindowsUpdateActivity.ActiveProcesses}" MaxHeight="140" IsReadOnly="True" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.5*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.#}}" Width="80" />
                                    <DataGridTextColumn Header="Disk" Binding="{Binding DiskBytesPerSec, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No servicing processes running is the normal case, not an error." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowsUpdateActivity.ActiveProcesses.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding WindowsUpdateEvents.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding WindowsUpdateEvents.RecentEvents}" MaxHeight="180" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="80" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #291: BITS transfer list - on-demand-refreshed-plus-startup-load. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="BITS transfers" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadBitsTransfersCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Refresh" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingBitsTransfers}" Value="True">
                                                        <Setter Property="Text" Value="Loading..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding BitsTransfersStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding BitsTransfers}" MaxHeight="220" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="1.3*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="90" />
                                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="100" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityText}" Width="80" />
                                    <DataGridTextColumn Header="Transferred" Binding="{Binding BytesTransferred, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding BytesTotal, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #292: currently-running scheduled tasks + Automatic Maintenance registry audit -
                         answers "what task fired at the exact second things hitched" (feeds a future
                         flight-recorder timeline, items #296-300, not built yet). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Scheduled tasks running right now" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding LoadScheduledTasksRunningCommand}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Refresh" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingScheduledTasksRunning}" Value="True">
                                                        <Setter Property="Text" Value="Loading..." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding ScheduledTasksRunningStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <DataGrid ItemsSource="{Binding ScheduledTasksRunning}" MaxHeight="200" IsReadOnly="True" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.5*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                    <DataGridTextColumn Header="Last run" Binding="{Binding LastRunTime}" Width="150" />
                                    <DataGridTextColumn Header="Last result" Binding="{Binding LastResult}" Width="90" />
                                    <DataGridTextColumn Header="Task to run" Binding="{Binding TaskToRun}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="Automatic Maintenance" Style="{StaticResource SubStat}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AutomaticMaintenance.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AutomaticMaintenance.Settings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                            <TextBlock FontSize="{StaticResource FontBody}">
                                                <Run Text="{Binding SettingName, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding ValueText, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #293: cloud sync / game-download clients / Storage Sense - the last ribbon cluster. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Cloud sync" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="OneDrive.exe / Dropbox.exe / GoogleDriveFS.exe - presence and CPU/disk cost, matched by process name. Not a definitive &quot;is syncing right now&quot; API - none of these vendors expose one to third-party apps."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding CloudSyncProcesses}" MaxHeight="140" IsReadOnly="True" Margin="0,0,0,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.5*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.#}}" Width="80" />
                                    <DataGridTextColumn Header="Disk" Binding="{Binding DiskBytesPerSec, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No cloud-sync client currently running." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CloudSyncProcesses.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Game downloads (Steam / Epic)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="steamwebhelper.exe / EpicGamesLauncher.exe are loose proxies - presence and cost, not a definitive &quot;downloading right now&quot; state. Exact download-vs-idle detection isn't cheaply available for either client."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding GameClientProcesses}" MaxHeight="140" IsReadOnly="True" Margin="0,0,0,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.5*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.#}}" Width="80" />
                                    <DataGridTextColumn Header="Disk" Binding="{Binding DiskBytesPerSec, Converter={StaticResource BytesToReadableConverter}}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No Steam/Epic helper process currently running." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" FontStyle="Italic" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameClientProcesses.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Disk defrag &amp; System Restore" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Reuses the Scheduled Tasks Running list above (Optimize Drives' &quot;ScheduledDefrag&quot; task and System Restore's &quot;SR&quot; task) rather than a second schtasks query - refresh that list to update this."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <TextBlock Text="Storage Sense" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding StorageSense.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Capture &amp; replay">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- ============================================================================
                         #294-300: Responsiveness scoring capstone - the composite score cards live on
                         the Processes tab (#294, a sortable column) and Summary tab (#295, a headline
                         tile); everything below is the flight recorder (#296) and what's built on it
                         (#297-300).
                         ============================================================================ -->

                    <!-- #296: flight recorder - "always running once armed, costs nothing to keep";
                         armed/disarmed is the only thing persisted, never the buffer's contents. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Flight recorder" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Content="Armed" IsChecked="{Binding FlightRecorderArmed}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="A rolling 60-second, 10Hz buffer of CPU%, max per-core DPC%, run-queue length, hard-fault rate, frame time, input delay, and the foreground/top processes - all already sampled elsewhere on this tab, never resampled independently. The substrate for the trigger rules, ETW capture, and incident export/replay cards below." />
                            <TextBlock Text="{Binding FlightRecorderStatusText}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- #297: user-configurable trigger conditions that dump #296's ring buffer when
                         tripped - plus a manual trigger, either via the button here or Ctrl+Alt+F
                         (extends the existing GlobalHotkeyService plumbing), both calling the exact same
                         HandleTriggerAsync path #298/#299 build on. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Stutter trigger rules" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Trigger now" Command="{Binding TriggerNowCommand}" Margin="0,0,8,0"
                                            ToolTip="Same as pressing Ctrl+Alt+F anywhere - both call the exact same trigger handler." />
                                    <Button Content="Add rule" Command="{Binding AddTriggerRuleCommand}" Margin="0,0,8,0" />
                                    <Button Content="Save rules" Command="{Binding SaveTriggerRulesCommand}" ToolTip="Rule edits (threshold/enabled) aren't auto-saved - click after editing, or Add/Remove which save automatically." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="When an enabled rule trips, this exports an incident bundle (#299) automatically - the ring buffer, hung windows, top DPC drivers, running scheduled tasks, foreground app, and (if armed below) an ETW capture. An 8-second cooldown keeps one sustained condition from exporting repeatedly." />
                            <ItemsControl ItemsSource="{Binding TriggerRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox Grid.Column="1" SelectedItem="{Binding Kind}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                      ItemsSource="{Binding DataContext.TriggerKinds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBox Grid.Column="2" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                     ToolTip="Threshold (ms/µs/faults-per-sec/queue-length depending on the rule kind - ignored for &quot;WindowHung&quot;)." />
                                            <Button Grid.Column="3" Content="Remove" FontSize="{StaticResource FontCaption}" Padding="6,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveTriggerRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LastTriggerStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #298: optional in-memory circular ETW capture, extending WprCaptureService's
                         (#210) existing file-mode capture with a buffer-mode start/stop pair - off by
                         default, its overhead stated plainly, disabled with an explanation if wpr.exe is
                         missing. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ETW circular capture" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Content="Keep running" IsChecked="{Binding EtwCircularCaptureEnabled}" IsEnabled="{Binding WprToolsAvailable}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Off by default - has real background CPU/disk overhead while running. Keeps an in-memory circular wpr.exe trace so a trigger above can save the moment of a stutter to a real .etl for Windows Performance Analyzer, instead of just this app's own approximate numbers. Only one ETW session is allowed system-wide, so this competes with the DPC/present/hard-fault measurement sessions elsewhere on this tab." />
                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="wpr.exe/tracerpt.exe weren't found on this system - ETW circular capture isn't available.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WprToolsAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding EtwCircularCaptureStatusText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- #299: incident bundle export - the exact same handler a #297 trigger uses, also
                         reachable manually any time. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Incident bundle" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Export incident" Command="{Binding ExportIncidentCommand}" Margin="0,0,8,0" />
                                    <Button Content="Reveal in Explorer" Command="{Binding RevealIncidentCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Writes a timestamped folder under %AppData%\TaskManagerPlus\IncidentBundles containing the ring-buffer CSV, a JSON snapshot of hung windows/top DPC drivers/running scheduled tasks/the foreground app, any saved ETW capture, and a Markdown summary. Fires automatically on a trigger above, or click Export incident any time." />
                            <TextBlock Text="{Binding IncidentExportStatusText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- #300: incident timeline replay - built on LogReplayService.ParseFlightRecorderCsv
                         (see that method's remarks for why it's a second parse method rather than reusing
                         Parse() as-is) and charted with the same simple LineSeries idiom LoggingViewModel's
                         own #96 log replay already uses. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Incident timeline replay" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Load incident CSV..." Command="{Binding LoadIncidentReplayCommand}" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Loads a ring-buffer.csv from an exported incident bundle above and lines CPU/DPC/run-queue/hard-fault-rate up on one shared time axis - a past incident re-examined without reproducing it. Drag the scrubber for the foreground app and top processes at that exact point." />
                            <lvc:CartesianChart Series="{Binding IncidentReplaySeries}" XAxes="{Binding IncidentReplayXAxes}" YAxes="{Binding IncidentReplayYAxes}"
                                                 Height="200" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" Margin="0,0,0,8">
                                <lvc:CartesianChart.Style>
                                    <Style TargetType="lvc:CartesianChart">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IncidentReplaySeries}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </lvc:CartesianChart.Style>
                            </lvc:CartesianChart>
                            <Slider Minimum="0" Maximum="{Binding IncidentReplayMaxIndex}" Value="{Binding IncidentReplayScrubberIndex}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding IncidentReplayScrubberText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding IncidentReplayStatusText}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
