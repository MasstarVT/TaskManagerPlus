<UserControl x:Class="TaskManagerPlus.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:SummaryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <views:DashboardTileTemplateSelector x:Key="DashboardTileTemplateSelector" />

        <!-- Round 11, #69: one DataTemplate per dashboard tile, keyed "Tile_<id>" so
             DashboardTileTemplateSelector can look them up by DashboardTileViewModel.Id. Each
             item's DataContext is now the DashboardTileViewModel (for IsVisible/DisplayName), so
             every binding that used to reach SummaryViewModel directly now goes through
             DataContext.X, RelativeSource={RelativeSource AncestorType=UserControl} - the same
             indirection this app's cross-view-model bindings (Settings drawer, log replay card)
             already use. -->
        <DataTemplate x:Key="Tile_cpu">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding DataContext.Performance.CpuColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="CPU Overview" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DataContext.Performance.CpuCurrentPercent, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}%}"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <lvc:CartesianChart Series="{Binding DataContext.Performance.CpuSeries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         XAxes="{Binding DataContext.Performance.HiddenXAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         YAxes="{Binding DataContext.Performance.PercentYAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Height="200" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile_memory">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding DataContext.Performance.RamColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="Memory Utilization" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold">
                            <Run Text="{Binding DataContext.Performance.RamUsedGb, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}, Mode=OneWay}" />
                            <Run Text=" / " FontSize="13" FontWeight="Normal" />
                            <Run Text="{Binding DataContext.Performance.RamTotalGb, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="13" FontWeight="Normal" />
                            <Run Text=" GB" FontSize="13" FontWeight="Normal" />
                        </TextBlock>
                    </Grid>
                    <lvc:CartesianChart Series="{Binding DataContext.Performance.RamSeries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         XAxes="{Binding DataContext.Performance.HiddenXAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         YAxes="{Binding DataContext.Performance.PercentYAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile_topcpu">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Top CPU processes" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DataContext.Processes.ProcessCount, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0} total}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DataContext.TopProcesses, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="330">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}" FontSize="10.5">
                                            <Run Text="PID " /><Run Text="{Binding Pid, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding MemoryMb, StringFormat={}{0:0} MB, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CpuPercent, Converter={StaticResource PercentToBrushConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- #11: "what's actually been eating CPU right now" - a rolling ~10s average, steadier
             than the instantaneous reading above for a bursty process. -->
        <DataTemplate x:Key="Tile_topcpu10s">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Top CPU (10s avg)" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding DataContext.TopProcesses10sAvg, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CpuPercent10sAvg, StringFormat={}{0:0.0}%}"
                                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding CpuPercent10sAvg, Converter={StaticResource PercentToBrushConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile_disk">
            <views:VfdMeter Title="Disk" Percent="{Binding DataContext.Performance.DiskPercent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             ValueText="{Binding DataContext.Performance.DiskPercent, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0}}" Unit="%"
                             SubText="Active time" AccentBrush="{Binding DataContext.Performance.DiskColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}"
                             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,0,0,16" />
        </DataTemplate>

        <DataTemplate x:Key="Tile_network">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                        <Border Style="{StaticResource ColorDot}" Background="{Binding DataContext.Performance.NetworkColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ColorToBrushConverter}}" />
                        <TextBlock Text="Network" Style="{StaticResource CardTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding DataContext.Performance.NetworkReceiveBps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Style="{StaticResource BigStat}" />
                    <TextBlock Text="{Binding DataContext.Performance.NetworkSendBps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate, StringFormat=Up: {0}}" Style="{StaticResource SubStat}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Tile_system">
            <Border Style="{StaticResource CardStyle}" Margin="0" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource CardTitle}" />
                    <UniformGrid Columns="2" Rows="3">
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="Processes" Style="{StaticResource SubStat}" />
                            <TextBlock Text="{Binding DataContext.Performance.ProcessCount, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,10">
                            <TextBlock Text="Threads" Style="{StaticResource SubStat}" />
                            <TextBlock Text="{Binding DataContext.Performance.ThreadCount, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="Handles" Style="{StaticResource SubStat}" />
                            <TextBlock Text="{Binding DataContext.Performance.HandleCount, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,10">
                            <TextBlock Text="Uptime" Style="{StaticResource SubStat}" />
                            <TextBlock Text="{Binding DataContext.Performance.Uptime, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" />
                        </StackPanel>
                        <!-- #67: "time since last crash" headline stat, pulled from the
                             Stability tab's already-computed figure - no new event-log query. -->
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Since last crash" Style="{StaticResource SubStat}" />
                            <TextBlock Text="{Binding DataContext.Stability.TimeSinceLastCrashText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="16" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- #68: single 0-10 stability index - see StabilityViewModel.ComputeStabilityIndex. -->
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Stability index" Style="{StaticResource SubStat}" />
                            <TextBlock FontSize="16" FontWeight="SemiBold"
                                       Text="{Binding DataContext.Stability.StabilityIndex, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:0.0} / 10}"
                                       Foreground="{Binding DataContext.Stability.StabilityIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StabilityIndexToBrushConverter}}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- #928-935: one Health Check finding row - severity chip + confidence word (#928),
             counter-evidence (#931) and impact (#932) sub-lines, a "Why am I seeing this?"
             drill-down with captured condition readings + evidence (#929/#930), and
             snooze/ignore/"not a problem" actions (#924/#935). Shared between a standalone
             finding and a grouped finding's child rows (#934) so both render identically. -->
        <DataTemplate x:Key="FindingRowTemplate">
            <StackPanel Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,8,0">
                        <!-- #928: severity dot + word - RuleSeverityToBrushConverter (not a
                             DataTrigger Value="Low" string match) since Severity is a real enum,
                             the same pattern ServiceStatusToBrushConverter uses for
                             ServiceControllerStatus elsewhere in this app. -->
                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" VerticalAlignment="Center"
                                Background="{Binding Severity, Converter={StaticResource RuleSeverityToBrushConverter}}" />
                        <TextBlock Text="{Binding Severity}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{Binding Severity, Converter={StaticResource RuleSeverityToBrushConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <!-- #928: confidence word - "likely"/"possible"/"uncertain". -->
                            <TextBlock Text="{Binding ConfidenceWord, StringFormat=({0})}" FontSize="10.5" FontStyle="Italic"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- #931: counter-evidence - "what else could explain this". -->
                        <TextBlock FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding CounterEvidence, Converter={StaticResource NullToVisibilityConverter}}">
                            <Run Text="Could also be: " /><Run Text="{Binding CounterEvidence, Mode=OneWay}" />
                        </TextBlock>

                        <!-- #932: honest impact figure, in units the user feels. -->
                        <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="3" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding ImpactText, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>

                        <!-- #929/#930: "why am I seeing this?" drill-down - only a rule-engine
                             finding (RuleId set) has a condition tree to show. -->
                        <Expander Header="Why am I seeing this?" FontSize="11" Margin="0,6,0,0"
                                  Visibility="{Binding RuleId, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Margin="14,4,0,4">
                                <TextBlock FontSize="11" Margin="0,0,0,4">
                                    <Run Text="Rule: " Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <Run Text="{Binding RuleId, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ConditionReadings}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="10.5" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,1">
                                                <Run Text="{Binding Metric, Mode=OneWay}" />
                                                <Run Text=" = " />
                                                <Run Text="{Binding ActualValueText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" (threshold: " Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Run Text="{Binding Op, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Run Text=" " Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Run Text="{Binding ThresholdText, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Run Text=")" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- #930: evidence - for the built-in pack this is the same
                                     metric readings above, restated as label/value pairs. -->
                                <Expander FontSize="10.5">
                                    <Expander.Header>
                                        <TextBlock FontSize="10.5">
                                            <Run Text="Evidence (" /><Run Text="{Binding Evidence.Count, Mode=OneWay}" /><Run Text=" items)" />
                                        </TextBlock>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="14,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="10.5" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,1">
                                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <!-- #924/#935/#967: snooze/ignore/feedback/fix - only a rule-engine finding
                             has a rule id to act on. -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding RuleId, Converter={StaticResource NullToVisibilityConverter}}">
                            <!-- #967: "Fix this" - only rendered when the firing rule declared at
                                 least one applicable RemediationAction id (HealthIssue.HasFixAction).
                                 Opens a review dialog (RemediationReviewWindow), never runs anything
                                 directly from this button. -->
                            <Button Content="Fix this" FontSize="10.5" Padding="6,1" Margin="0,0,4,0"
                                    Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                    Command="{Binding DataContext.FixFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFixAction}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Snooze 7d" FontSize="10.5" Padding="6,1" Margin="0,0,4,0"
                                    Command="{Binding DataContext.SnoozeFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Ignore" FontSize="10.5" Padding="6,1" Margin="0,0,4,0"
                                    Command="{Binding DataContext.IgnoreFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Not a problem" FontSize="10.5" Padding="6,1"
                                    ToolTip="Records your feedback locally on this machine - stored locally, never sent anywhere."
                                    Command="{Binding DataContext.NotAProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- #934: one Health Check list row - a single finding (IsSingle) renders FindingRowTemplate
             directly; a real group (IsGroup, Findings.Count > 1) renders as an expandable
             "N findings about X" parent instead. -->
        <DataTemplate x:Key="FindingGroupTemplate">
            <StackPanel>
                <Expander Header="{Binding HeaderText}" FontSize="12.5" IsExpanded="True" Margin="0,0,0,10"
                          Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingRowTemplate}" Margin="10,8,0,0" />
                </Expander>
                <ContentControl Content="{Binding Representative}" ContentTemplate="{StaticResource FindingRowTemplate}"
                                Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- Health Check (#64): a rule-based, plain-language rollup of issues already
                 detectable elsewhere on other tabs - see SummaryViewModel.RefreshHealthIssues.
                 Green "All clear" when the list is empty, otherwise one line per finding,
                 danger/warning colored by IsCritical. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HealthIssues.Count}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Health Check" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <!-- #73: one-click diagnostic report - bundles specs, recent stability
                             events, a sensor snapshot, and top resource consumers into a single
                             shareable markdown file. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Markdown report" Command="{Binding GenerateReportCommand}" Margin="0,0,8,0" />
                            <!-- #97: same report, as one self-contained HTML file with inline SVG
                                 sparkline charts - opens directly in a browser. -->
                            <Button Content="HTML report" Command="{Binding GenerateHtmlReportCommand}" Margin="0,0,8,0" />
                            <!-- Round 12, #99: a handful of plain-text lines for pasting straight
                                 into a chat message or support ticket - distinct from the full
                                 Markdown/HTML report above. -->
                            <Button Content="Copy summary" Command="{Binding CopySummaryCommand}" Margin="0,0,8,0" />
                            <!-- #976: batches every currently-fired finding whose fix is entirely
                                 low-risk and reversible - anything Medium/High risk or
                                 non-undoable stays one-at-a-time via its own "Fix this" button. -->
                            <Button Content="{Binding SafeFixes.Items.Count, StringFormat='Run safe fixes ({0})'}"
                                    Command="{Binding OpenSafeFixBatchCommand}"
                                    ToolTip="Only low-risk, reversible fixes are batched." />
                        </StackPanel>
                    </Grid>

                    <!-- #978: "restart pending — including from N fix(es) you ran" - a derived
                         rollup over SystemSpecsViewModel's existing RebootPending flag and this
                         app's own remediation history, not a second disconnected reboot flag. -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RebootBannerText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RebootBannerText}" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding CopySummaryStatusText}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CopySummaryStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthIssues.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="All clear — no issues detected." />
                    </TextBlock>
                    <!-- Round 11, #70: silently writes the same Markdown report to
                         %AppData%\TaskManagerPlus\Reports\ every time the app closes, so there's
                         always a "what did things look like right before I closed it" record
                         without remembering to click the button above first. -->
                    <CheckBox Content="Generate report automatically when the app closes" IsChecked="{Binding GenerateReportOnExit}" Margin="0,10,0,0" />

                    <!-- #933: sort order for the finding list below. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthIssues.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Sort by" Style="{StaticResource SubStat}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding FindingSortModes}" SelectedItem="{Binding FindingSortMode}" Width="110" FontSize="11" />
                    </StackPanel>

                    <!-- #934: one row per finding, or per group of findings sharing a GroupKey. -->
                    <ItemsControl ItemsSource="{Binding GroupedHealthIssues}" ItemTemplate="{StaticResource FindingGroupTemplate}" Margin="0,8,0,0" />

                    <!-- #937: rules the engine couldn't meaningfully evaluate this pass (a metric
                         collector timed out/was access-denied/returned Unknown) - visibly distinct
                         from both a fired finding and "checked, clean". -->
                    <ItemsControl ItemsSource="{Binding CouldNotCheckFindings}" Margin="0,4,0,0">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CouldNotCheckFindings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Run Text="Could not check: " />
                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding UnavailableMetrics, Converter={StaticResource StringListJoinConverter}}" />
                                    <Run Text=" unavailable)" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- #935: "not a problem" feedback status + one-click suppress follow-up -
                         see FeedbackService's remarks: purely local, never uploaded anywhere. -->
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FeedbackStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding FeedbackStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                        <Button Content="Suppress this rule for 7 days" FontSize="10.5" Padding="6,1" Margin="0,4,0,0" HorizontalAlignment="Left"
                                Command="{Binding SuppressLastFeedbackRuleCommand}" />
                    </StackPanel>

                    <!-- #936: rules that were firing recently but have since cleared - so "it
                         cleared up" is visible without checking findings-history.jsonl by hand. -->
                    <Expander Header="{Binding RecentlyResolvedFindings.Count, StringFormat={}{0} recently resolved}"
                              Margin="0,10,0,0" FontSize="12">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentlyResolvedFindings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <ItemsControl ItemsSource="{Binding RecentlyResolvedFindings}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,3" TextWrapping="Wrap">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                        <Run Text=" cleared " />
                                        <Run Text="{Binding ResolvedAtLocalText, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- #924: suppressed findings stay listable/reversible rather than just vanishing. -->
                    <Expander Header="{Binding SuppressedFindings.Count, StringFormat={}{0} finding(s) suppressed}"
                              IsExpanded="{Binding IsSuppressedListExpanded}" Margin="0,10,0,0" FontSize="12">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuppressedFindings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <ItemsControl ItemsSource="{Binding SuppressedFindings}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                                        <Button Content="Unsuppress" FontSize="10.5" Padding="6,1" Margin="10,0,0,0"
                                                Command="{Binding DataContext.UnsuppressFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- #72: configurable threshold alerts - a toast fires once when CPU/Memory/CPU-temp
                 crosses above its threshold, reusing the same already-polled data the logging
                 infrastructure and Health Check card read. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Threshold alerts" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Shows a popup the moment a metric crosses its threshold." Style="{StaticResource SubStat}" Margin="0,-6,0,10" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0">
                            <CheckBox Content="CPU %" IsChecked="{Binding CpuAlertEnabled}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CpuAlertThreshold, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CpuAlertEnabled}" Width="70" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="8,0,8,0">
                            <CheckBox Content="Memory %" IsChecked="{Binding MemoryAlertEnabled}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding MemoryAlertThreshold, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding MemoryAlertEnabled}" Width="70" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <CheckBox Content="CPU temp °C" IsChecked="{Binding TempAlertEnabled}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding TempAlertThreshold, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding TempAlertEnabled}" Width="70" HorizontalAlignment="Left" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- #96: log file viewer/replay - loads a previously recorded CSV (manual logging or
                 the rolling buffer) and re-charts its CPU/RAM/Disk figures inline, no external
                 tool needed. Logging isn't its own tab, so this reaches LoggingViewModel via the
                 window's DataContext the same way the Settings drawer's rolling-buffer toggle does. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Log replay" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Load log file..."
                                Command="{Binding DataContext.Logging.LoadLogFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                    <TextBlock Text="Re-charts a previously recorded CSV (Start Logging, or the auto-start rolling buffer) without needing Excel."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DataContext.Logging.ReplayStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding DataContext.Logging.ReplaySeries, RelativeSource={RelativeSource AncestorType=Window}}"
                                         XAxes="{Binding DataContext.Logging.ReplayXAxes, RelativeSource={RelativeSource AncestorType=Window}}"
                                         YAxes="{Binding DataContext.Logging.ReplayYAxes, RelativeSource={RelativeSource AncestorType=Window}}"
                                         Height="180" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent">
                        <lvc:CartesianChart.Style>
                            <Style TargetType="lvc:CartesianChart">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Logging.ReplaySeries, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </lvc:CartesianChart.Style>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- #93/#94: baseline capture + "what changed" diff - one save/compare pair covers
                 both suggestions, since a saved baseline IS the comparison point for a later
                 diff. See SnapshotService's remarks. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="System snapshot" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Save snapshot" Command="{Binding SaveSnapshotCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Compare to snapshot..." Command="{Binding CompareSnapshotCommand}" />
                    </Grid>
                    <TextBlock Text="Captures installed software, services, and startup items - save one now as a baseline, then compare against it later to see what changed."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SnapshotStatusText}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SnapshotStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Round 12, #94: idle-temperature trend vs. this baseline - a rough
                         thermal-paste-age proxy, only shown once both snapshots actually
                         recorded an idle CPU temperature (see SnapshotService.Capture's remarks). -->
                    <TextBlock Text="{Binding IdleTempTrendText}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdleTempTrendText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding SnapshotDiff, Converter={StaticResource NullToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SnapshotDiff.SoftwareAdded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StringFormat=+ software: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotDiff.SoftwareRemoved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding StringFormat=- software: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotDiff.ServicesAdded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StringFormat=+ service: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotDiff.ServicesRemoved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding StringFormat=- service: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotDiff.StartupAdded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StringFormat=+ startup item: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotDiff.StartupRemoved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding StringFormat=- startup item: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 11, #71: baseline-vs-baseline - diff two previously-saved snapshot files
                 against each other (e.g. "before" and "after" a change), rather than always
                 comparing a saved baseline to the live system the way the card above does. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Compare two snapshots" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Diffs two previously-saved snapshot files against each other, instead of a saved baseline against the live system."
                               Style="{StaticResource SubStat}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Load snapshot A..." Command="{Binding LoadSnapshotACommand}" Margin="0,0,8,0" />
                        <Button Content="Load snapshot B..." Command="{Binding LoadSnapshotBCommand}" Margin="0,0,8,0" />
                        <Button Content="Compare A → B" Command="{Binding CompareSnapshotsAbCommand}" />
                    </StackPanel>
                    <TextBlock FontSize="12" Style="{StaticResource SubStat}" Margin="0,0,0,8">
                        <Run Text="A: " /><Run Text="{Binding SnapshotAName, Mode=OneWay}" />
                        <Run Text="   B: " /><Run Text="{Binding SnapshotBName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SnapshotAbStatusText}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SnapshotAbStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Round 12, #94: same idle-temperature trend, for the A/B comparison. -->
                    <TextBlock Text="{Binding IdleTempTrendAbText}" Margin="0,0,0,8" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdleTempTrendAbText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Visibility="{Binding SnapshotAbDiff, Converter={StaticResource NullToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SnapshotAbDiff.SoftwareAdded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StringFormat=+ software: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotAbDiff.SoftwareRemoved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding StringFormat=- software: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotAbDiff.ServicesAdded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StringFormat=+ service: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotAbDiff.ServicesRemoved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding StringFormat=- service: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotAbDiff.StartupAdded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SuccessBrush}" Text="{Binding StringFormat=+ startup item: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SnapshotAbDiff.StartupRemoved}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding StringFormat=- startup item: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 11, #69: hide/reorder the tiles below - see DashboardTileConfig's remarks. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dashboard tiles" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding ToggleTileCustomizerCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Customize..." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTileCustomizerOpen}" Value="True">
                                                <Setter Property="Text" Value="Done" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <StackPanel Visibility="{Binding IsTileCustomizerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Hide a tile, or move it up/down within its column. Changes are remembered."
                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-2,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftTiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsVisible}" />
                                            <Button Grid.Column="1" Content="↑" Padding="6,2" Margin="0,0,4,0" Command="{Binding MoveUpCommand}" />
                                            <Button Grid.Column="2" Content="↓" Padding="6,2" Command="{Binding MoveDownCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding RightTiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsVisible}" />
                                            <Button Grid.Column="1" Content="↑" Padding="6,2" Margin="0,0,4,0" Command="{Binding MoveUpCommand}" />
                                            <Button Grid.Column="2" Content="↓" Padding="6,2" Command="{Binding MoveDownCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left column: CPU + Memory charts. Round 11, #69: now data-driven off LeftTiles
                 (hide/reorder), rendered via DashboardTileTemplateSelector against the Tile_*
                 templates declared in UserControl.Resources above - same visual result as before
                 for the default layout, just no longer hardcoded. -->
            <ItemsControl Grid.Column="0" Margin="0,0,16,0" ItemsSource="{Binding LeftTiles}"
                          ItemTemplateSelector="{StaticResource DashboardTileTemplateSelector}" />

            <!-- Right column: top processes + meter tiles - see LeftTiles' remarks above. -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding RightTiles}"
                          ItemTemplateSelector="{StaticResource DashboardTileTemplateSelector}" />
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
