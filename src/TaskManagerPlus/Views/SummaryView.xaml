<UserControl x:Class="TaskManagerPlus.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:SummaryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- Health Check (#64): a rule-based, plain-language rollup of issues already
                 detectable elsewhere on other tabs - see SummaryViewModel.RefreshHealthIssues.
                 Green "All clear" when the list is empty, otherwise one line per finding,
                 danger/warning colored by IsCritical. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HealthIssues.Count}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Health Check" Style="{StaticResource CardTitle}" />
                    <TextBlock Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HealthIssues.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="All clear — no issues detected." />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding HealthIssues}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding Message}" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left column: CPU + Memory charts -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                                <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.CpuColor, Converter={StaticResource ColorToBrushConverter}}" />
                                <TextBlock Text="CPU Overview" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Performance.CpuCurrentPercent, StringFormat={}{0:0.0}%}"
                                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <lvc:CartesianChart Series="{Binding Performance.CpuSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                             Height="200" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource TitleRow}" Margin="0">
                                <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.RamColor, Converter={StaticResource ColorToBrushConverter}}" />
                                <TextBlock Text="Memory Utilization" Style="{StaticResource CardTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold">
                                <Run Text="{Binding Performance.RamUsedGb, StringFormat={}{0:0.0}, Mode=OneWay}" />
                                <Run Text=" / " FontSize="13" FontWeight="Normal" />
                                <Run Text="{Binding Performance.RamTotalGb, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="13" FontWeight="Normal" />
                                <Run Text=" GB" FontSize="13" FontWeight="Normal" />
                            </TextBlock>
                        </Grid>
                        <lvc:CartesianChart Series="{Binding Performance.RamSeries}" XAxes="{Binding Performance.HiddenXAxes}" YAxes="{Binding Performance.PercentYAxes}"
                                             Height="160" TooltipPosition="Hidden" LegendPosition="Hidden" Background="Transparent" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column: top processes + meter tiles -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Top CPU processes" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Processes.ProcessCount, StringFormat={}{0} total}" Style="{StaticResource SubStat}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopProcesses}" MaxHeight="330">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SubStat}" FontSize="10.5">
                                                <Run Text="PID " /><Run Text="{Binding Pid, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding MemoryMb, StringFormat={}{0:0} MB, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding CpuPercent, Converter={StaticResource PercentToBrushConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <views:VfdMeter Title="Disk" Percent="{Binding Performance.DiskPercent}"
                                ValueText="{Binding Performance.DiskPercent, StringFormat={}{0:0.0}}" Unit="%"
                                SubText="Active time" AccentBrush="{Binding Performance.DiskColor, Converter={StaticResource ColorToBrushConverter}}"
                                Margin="0,0,0,16" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource TitleRow}" Margin="0,0,0,4">
                            <Border Style="{StaticResource ColorDot}" Background="{Binding Performance.NetworkColor, Converter={StaticResource ColorToBrushConverter}}" />
                            <TextBlock Text="Network" Style="{StaticResource CardTitle}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Performance.NetworkReceiveBps, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate}" Style="{StaticResource BigStat}" />
                        <TextBlock Text="{Binding Performance.NetworkSendBps, Converter={StaticResource BytesToReadableConverter}, ConverterParameter=rate, StringFormat=Up: {0}}" Style="{StaticResource SubStat}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="System" Style="{StaticResource CardTitle}" />
                        <UniformGrid Columns="2" Rows="2">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Processes" Style="{StaticResource SubStat}" />
                                <TextBlock Text="{Binding Performance.ProcessCount}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Text="Threads" Style="{StaticResource SubStat}" />
                                <TextBlock Text="{Binding Performance.ThreadCount}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Handles" Style="{StaticResource SubStat}" />
                                <TextBlock Text="{Binding Performance.HandleCount}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Uptime" Style="{StaticResource SubStat}" />
                                <TextBlock Text="{Binding Performance.Uptime}" FontSize="16" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
