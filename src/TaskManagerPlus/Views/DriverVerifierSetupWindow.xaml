<Window x:Class="TaskManagerPlus.Views.DriverVerifierSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Enable Driver Verifier - read this first"
        Width="640" Height="700" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- #498: mandatory warning - not a MessageBox, a real screen the user has to read past. -->
        <Border Grid.Row="0" Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="This will deliberately crash the machine on a misbehaving driver" FontSize="15"
                           FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" LineHeight="19">
                    Driver Verifier subjects every selected driver to intensive runtime checks (special pool
                    allocations, forced IRQL checking, I/O verification, deadlock detection, and more). The FIRST time
                    a selected driver does something Driver Verifier flags as incorrect, Windows deliberately
                    bugchecks (blue-screens) the machine on the spot - by design, not a malfunction of this tool.
                    This is normal, expected behavior for a driver stress-test, not something gone wrong.
                </TextBlock>
                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" FontSize="12.5" Text="Before continuing:" />
                <StackPanel Margin="6,4,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0"
                               Text="• Create a System Restore point first, in case a driver update is needed to recover." />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0"
                               Text="• Know how to boot into Safe Mode (hold Shift while restarting, or interrupt boot 3 times) - Driver Verifier can be reset from there if the machine won't boot normally afterward. See the Recovery section on the Devices &amp; Drivers tab." />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,0"
                               Text="• Do not select Microsoft-signed drivers. This list only shows third-party drivers already; Microsoft's own core drivers are excluded entirely." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Driver selection. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Select third-party driver(s) to verify" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Select all" Padding="8,3" Click="OnSelectAll" Margin="0,0,6,0" />
                        <Button Content="Clear" Padding="8,3" Click="OnClearAll" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CandidatesList" ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,5" Margin="0,0,0,2" Background="{DynamicResource BgElevatedBrush}" CornerRadius="6">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding FileName, Mode=OneWay}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding CompanyName, Mode=OneWay, TargetNullValue=Unknown publisher}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Typed confirmation - the action button stays disabled until this matches exactly. -->
        <StackPanel Grid.Row="2">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,6">
                <Run Text="Type " /><Run Text="ENABLE VERIFIER" FontWeight="Bold" /><Run Text=" below (exact case) to enable the button." />
            </TextBlock>
            <TextBox x:Name="ConfirmTextBox" Margin="0,0,0,12" TextChanged="OnConfirmTextChanged" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Runs: verifier /standard /driver &lt;selected .sys files&gt; - takes effect after the next restart." />
                <Button Grid.Column="1" Content="Cancel" Padding="14,8" Margin="0,0,8,0" Click="OnCancel" />
                <Button x:Name="EnableButton" Grid.Column="2" Content="Enable Driver Verifier"
                        Style="{StaticResource DangerButton}" Padding="14,8" IsEnabled="False" Click="OnEnable" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
