<UserControl x:Class="TaskManagerPlus.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StabilityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- Round 18, item 80: "will this PC capture the next BSOD" - a single pass/fail/
                 uncertain verdict summarising items 71-79's crash dump configuration card below,
                 placed first (ahead of even the unexpected-shutdown banner) since every other
                 crash-forensics feature on this tab is worthless on a machine that isn't
                 configured to capture dumps at all - see CrashDumpConfigService.BuildChecklist. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Fail">
                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Will this PC capture the next BSOD?" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding CrashCaptureVerdictText}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Pass">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Fail">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Uncertain">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding CrashCaptureChecklistItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top" Margin="0,2,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Passed}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #4: the shutdown immediately preceding this boot looks unexpected (Kernel-Power 41
                 / EventLog 6008 within a few minutes of the last boot time) - see
                 EventLogService.Query. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WasLastShutdownUnexpected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5">
                        <Run Text="Last shutdown looks unexpected — " /><Run Text="{Binding LastUnexpectedShutdownText, Mode=OneWay}" />
                        <Run Text=" (Kernel-Power 41 / unclean shutdown near the last boot time)." />
                    </TextBlock>
                    <!-- Round 13, item 3: labelled cause badge instead of just the generic warning
                         above - see EventLogService.ClassifyPowerEvent. "Quick flag, not a
                         verdict" (CLAUDE.md): a heuristic over undocumented event-property layout. -->
                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2"
                            HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="{Binding LastShutdownCauseText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 14, item 27: new-dump watcher alert - a crash dump was written while the
                 app was running (also mirrored as a tray balloon and a tab-header badge - see
                 MainWindow.xaml.cs / MainWindow.xaml). -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNewDumpAlert}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NewDumpAlertText}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissNewDumpAlertCommand}" Padding="10,4" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- =================================================================================
                 Round 20, items 89-95: "Clustering crashes over time and correlating with
                 changes" - a unified layer over EVERY per-source card below (bugchecks, live
                 kernel reports, WER reports, application crashes/hangs, service failures, TDRs,
                 WHEA errors, unexpected shutdowns). Item 89 calls this out as "the new default
                 view of the Stability tab", so it's placed first (right after the top verdict/
                 alert banners, ahead of the still-useful per-source "raw source" cards, which
                 remain below rather than being folded into an expander).
                 ================================================================================= -->

            <!-- Item 90: crash signature clusters - displayed above the timeline per item 90's own
                 instruction, turning "thirty rows" into "three distinct problems". -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Crash signature clusters" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-8,0,10">
                        <Run Text="Kernel faults clustered by bugcheck code + blamed module + parameter shape; user-mode crashes/hangs clustered by WER bucket." />
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding CrashClusters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Cluster.Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Cluster.IsKernelFault}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Cluster.Count}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding Cluster.Description}" />
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,1,0,0">
                                            <Run Text="First seen: " /><Run Text="{Binding Cluster.FirstSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · Last seen: " /><Run Text="{Binding Cluster.LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,1,0,0" Text="{Binding Cluster.CadenceText}" />

                                        <!-- Items 92-94: on-demand "what changed" panel - only computed the moment this
                                             Expander is actually opened (see CrashClusterViewModel.IsWhatChangedExpanded). -->
                                        <Expander Header="What changed before this started (48h lookback)"
                                                  IsExpanded="{Binding IsWhatChangedExpanded, Mode=TwoWay}" Margin="0,8,0,0" FontSize="12">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="Checking driver installs, Windows Updates and application installs…" Style="{StaticResource SubStat}"
                                                           Visibility="{Binding IsLoadingWhatChanged, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WhatChanged.ComputedOk}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Could not check what changed: " /><Run Text="{Binding WhatChanged.ErrorText, Mode=OneWay}" />
                                                </TextBlock>

                                                <ItemsControl ItemsSource="{Binding WhatChanged.Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock FontSize="12" TextWrapping="Wrap">
                                                                        <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                                                        <Run Text=" — " /><Run Text="{Binding Description}" />
                                                                    </TextBlock>
                                                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding Detail}"
                                                                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="No driver, Windows Update or application install found in the 48 hours before this cluster started."
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding WhatChanged.ComputedOk}" Value="True" />
                                                                        <Condition Binding="{Binding WhatChanged.Entries.Count}" Value="0" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No clustered kernel or user-mode faults found in the current lookback window.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CrashClusters.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Item 91: uptime-at-crash histogram + MTBF/longest-streak - boot times reused from
                 item 6's own shutdown timeline pairing walk, no second boot-time query. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Uptime before crashing (MTBF)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding MtbfSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-8,0,10" />
                    <lvc:CartesianChart Series="{Binding UptimeHistogramSeries}" XAxes="{Binding UptimeHistogramXAxes}" YAxes="{Binding UptimeHistogramYAxes}"
                                         Height="140" TooltipPosition="Top" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Item 89: the unified timeline itself - one chronological view merging every
                 source above, with a source filter. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Unified crash timeline" Style="{StaticResource CardTitle}" />

                    <ItemsControl ItemsSource="{Binding TimelineSourceFilters}" Margin="0,-6,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" FontSize="11.5" Margin="0,0,12,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FilteredTimeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,4" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Row.Severity}" Value="Critical">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Row.Severity}" Value="Info">
                                                                <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Row.Timestamp, StringFormat={}{0:g}, Mode=OneWay}"
                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Row.Summary}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="17,6,0,0">
                                        <TextBlock Text="{Binding Row.SourceTypeText}" Style="{StaticResource SubStat}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Row.Detail}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding Row.Detail, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Item 95: on-demand log-telemetry correlation, lazily loaded when this row is
                                             expanded (see CrashTimelineRowViewModel.IsExpanded). -->
                                        <TextBlock Text="Loading logged telemetry around this time…" Style="{StaticResource SubStat}" Margin="0,6,0,0"
                                                   Visibility="{Binding IsLoadingLogCorrelation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Margin="0,6,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogCorrelation.HasCoverage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="System activity in the 2 minutes before this event" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <lvc:CartesianChart Series="{Binding LogSeries}" XAxes="{Binding LogXAxes}" YAxes="{Binding LogYAxes}"
                                                                 Height="110" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                                            <TextBlock Text="{Binding TelemetrySummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding LogCorrelation.StatusText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogCorrelation.HasCoverage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No matching crash/fault events - try enabling more sources above, or Refresh.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredTimeline.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Crash / stability diagnostics — by source" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="15" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" />
            </Grid>

            <!-- Round 13, item 12: "is the 30-day lookback window even trustworthy" line - see
                 EventLogService.ReadLogHealth / StabilityViewModel.BuildLogCoverageText. -->
            <TextBlock Text="{Binding LogCoverageText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- #6/#5/#40/#68: uptime-since-last-crash, TDR (GPU driver timeout/reset) count,
                 low-memory resource-exhaustion events, minidumps, and (Round 10) the 0-10 stability
                 index - see ComputeStabilityIndex for the documented weighted formula. -->
            <UniformGrid Columns="5" Margin="0,0,0,16">
                <views:VfdMeter Title="Since last crash" Glow="False" Margin="0,0,6,0"
                                ValueText="{Binding TimeSinceLastCrashText}"
                                SubText="Unexpected shutdown or BSOD" AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="TDR events" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding TdrEventCount}"
                                SubText="{Binding LastTdrEventText}"
                                AccentBrush="{DynamicResource WarningBrush}" />
                <views:VfdMeter Title="Minidumps" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Minidumps.Count}"
                                SubText="%SystemRoot%\Minidump" AccentBrush="{DynamicResource AccentBrush}" />
                <!-- #40: low-memory resource-exhaustion events (Warning-level, a separate targeted
                     query - see EventLogService.ReadLowMemoryEvents). -->
                <views:VfdMeter Title="Low-memory events" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding LowMemoryEventCount}"
                                SubText="{Binding LastLowMemoryEventText}"
                                AccentBrush="{DynamicResource WarningBrush}" />
                <!-- Round 10, #68: single 0-10 stability index - see StabilityViewModel.ComputeStabilityIndex. -->
                <views:VfdMeter Title="Stability index" Glow="False" Margin="6,0,0,0"
                                ValueText="{Binding StabilityIndex, StringFormat={}{0:0.0}}" Unit="/ 10"
                                SubText="Weighted from recent crash/error density"
                                AccentBrush="{Binding StabilityIndex, Converter={StaticResource StabilityIndexToBrushConverter}}" />
            </UniformGrid>

            <!-- #1: Reliability History - daily Critical/Error counts over the lookback window,
                 the same "crash/failure events over time" chart Windows' own Reliability Monitor
                 shows, bucketed from the same event query as everything else on this tab. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Reliability history" Style="{StaticResource CardTitle}" />
                    <!-- Round 13, item 11: the bars are this app's own computed daily Critical/
                         Error count (left axis); the line is Microsoft's own Reliability Monitor
                         stability index (Win32_ReliabilityStabilityMetrics, right axis, 0-10). -->
                    <TextBlock Text="Critical/Error events per day (bars) vs. Microsoft's own reliability index (line), last 30 days."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding DailyEventSeries}" XAxes="{Binding DailyEventXAxes}" YAxes="{Binding DailyEventYAxes}"
                                         Height="160" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Round 15, item 34: GPU driver timeouts/resets (TDR) - per-event driver/app detail
                 plus the live TdrDelay/TdrDdiDelay/TdrLevel registry settings, beyond the plain
                 count tile in the summary row above. Collapsed entirely when no per-event detail
                 was found (the count tile above still works independently). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TdrEventDetails.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="GPU driver timeouts / resets (TDR)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Each display-driver timeout-detection-and-recovery event, with the driver and (when Windows recorded one) the application whose GPU context was reset."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding TdrEventDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                    <Run Text=" — driver: " /><Run Text="{Binding Driver, TargetNullValue='Unknown'}" />
                                    <Run Text=" · app: " /><Run Text="{Binding Application, TargetNullValue='Unknown'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                            <Run Text="TdrDelay: " /><Run Text="{Binding TdrSettings.TdrDelaySeconds, TargetNullValue='not set', StringFormat={}{0}s, Mode=OneWay}" />
                            <Run Text=" · TdrDdiDelay: " /><Run Text="{Binding TdrSettings.TdrDdiDelaySeconds, TargetNullValue='not set', StringFormat={}{0}s, Mode=OneWay}" />
                            <Run Text=" · TdrLevel: " /><Run Text="{Binding TdrSettings.TdrLevelText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 13, items 1/2/7/8: minidump files, backed by the authoritative BugCheck 1001
                 record when found (falling back to the old nearby-Kernel-Power-41-timestamp guess),
                 an expandable "Full crash record" (joined WER report), and an inline warning when
                 volmgr logged a failed dump write - see EventLogService.ReadMinidumps/
                 ReadBugCheckRecords/ReadDumpFailures. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Minidumps" Style="{StaticResource CardTitle}" />

                    <!-- Item 7: volmgr 161/162 "dump creation failed" - explains "I had a BSOD but
                         there's no dump file". -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DumpFailures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="{Binding DumpFailures.Count, Mode=OneWay}" /><Run Text=" dump-creation failure(s) (volmgr) in the last 30 days — Windows tried to write a crash dump and failed, which explains a BSOD with no matching minidump file." />
                        </TextBlock>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Minidumps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,6" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <!-- #65: bugcheck-code-to-plain-English lookup, instead of a bare hex code. -->
                                                <Run Text=" · " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <!-- Round 15, item 29: per-code labelled parameters (with an inline NTSTATUS
                                             decode, item 30, when this code documents a parameter as a status/
                                             exception code) - replaces the old flat hex "Parameters: ..." row. -->
                                        <ItemsControl ItemsSource="{Binding Decoded.ParameterRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                                            <Run Text="Source: " /><Run Text="{Binding IsAuthoritative, Converter={StaticResource BugcheckSourceToTextConverter}, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Round 15, item 32: DPC_WATCHDOG_VIOLATION (0x133) subtype line - only
                                             present for that one code. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DpcWatchdogSubtypeText}"
                                                   Visibility="{Binding Decoded.DpcWatchdogSubtypeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 33: DRIVER_POWER_STATE_FAILURE (0x9F) subcode + the
                                             sleep/resume cross-reference. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DriverPowerStateSubcodeText}"
                                                   Visibility="{Binding Decoded.DriverPowerStateSubcodeText, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Happened during sleep/resume" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>

                                        <!-- Round 15, item 36: 0x124's joined WHEA-Logger record. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding WheaJoinText, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Matching hardware error (WHEA): " /><Run Text="{Binding WheaJoinText}" />
                                        </TextBlock>

                                        <!-- Round 15, item 35: pool-tag decode for 0xC2/0xC5. -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                                       Text="{Binding Decoded.PoolTagText}"
                                                       Visibility="{Binding Decoded.PoolTagText, Converter={StaticResource NullToVisibilityConverter}}" />
                                            <!-- Round 19, item 88: jump straight to Special Pool for this crash's own tag. -->
                                            <Button Grid.Column="1" Content="Apply Special Pool" Padding="6,2" FontSize="11" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ApplySpecialPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Decoded.PoolTagRaw}"
                                                    Visibility="{Binding Decoded.PoolTagRaw, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>

                                        <!-- Round 19, item 85: Verifier violation subcode decode for 0xC4/0xC9/0xE6. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.VerifierViolationText}"
                                                   Visibility="{Binding Decoded.VerifierViolationText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 37: fault-address classification for 0xA/0xD1/0x50. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.FaultAddressClassification}"
                                                   Visibility="{Binding Decoded.FaultAddressClassification, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 31: curated "what usually causes this" note - explicitly
                                             non-authoritative, per CLAUDE.md's "quick flag, not a verdict". -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding Decoded.Guidance, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="What usually causes this (not a diagnosis): " FontWeight="SemiBold" /><Run Text="{Binding Decoded.Guidance}" />
                                        </TextBlock>

                                        <!-- Item 2: WER "full crash record" - the joined ReportArchive folder. -->
                                        <StackPanel Margin="0,4,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="{Binding WerReport, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Full crash record (WER)" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,2" />
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="OS version: " /><Run Text="{Binding WerReport.OsVersion, Mode=OneWay, TargetNullValue=Unknown}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Secure Boot state: " /><Run Text="{Binding WerReport.SecureBootState, Mode=OneWay, TargetNullValue=Unknown}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Attached files: " /><Run Text="{Binding WerReport.AttachedFiles, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No minidump files found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Minidumps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Round 14, item 26: Minidump folder housekeeping footer strip - total
                         size, oldest/newest, delete-older-than, and the live registry
                         MinidumpsCount value. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                <Run Text="Folder: " /><Run Text="{Binding Housekeeping.FileCount, Mode=OneWay}" /><Run Text=" file(s), " />
                                <Run Text="{Binding Housekeeping.TotalSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                <Run Text=" total. Oldest: " /><Run Text="{Binding Housekeeping.OldestFile, StringFormat={}{0:g}, TargetNullValue='—', Mode=OneWay}" />
                                <Run Text=" · Newest: " /><Run Text="{Binding Housekeeping.NewestFile, StringFormat={}{0:g}, TargetNullValue='—', Mode=OneWay}" />
                            </TextBlock>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Delete older than" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Width="48" Text="{Binding DeleteOlderThanDays, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="days" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,10,0" />
                                <Button Grid.Column="4" Content="Delete" Command="{Binding DeleteOldDumpsCommand}" Padding="10,4" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="5" Text="MinidumpsCount" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="6" Width="48" Text="{Binding MinidumpsCountInput, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Button Content="Save MinidumpsCount" Command="{Binding SaveMinidumpsCountCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding HousekeepingStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 14, items 13-19: binary-parsed dump rows - richer, event-log-independent
                 data straight from each dump's own DUMP_HEADER64/MINIDUMP header, per
                 MinidumpParserService. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dump analysis (binary parse)" Style="{StaticResource CardTitle}" Margin="0" />
                        <!-- Round 16, item 49: multi-select count, for the later support-bundle export chunk (#100). -->
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding SelectedDumpCount, Mode=OneWay}" /><Run Text=" selected" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Read directly from each dump file's own header/streams, independent of the event log above. Blame is address-range matching against the loaded-module list - a quick flag, not a verdict, not a symbolised stack."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding DumpRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,8" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Round 16, item 49: multi-select, for the later support-bundle export chunk (#100). -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      ToolTip="Select for a future support-bundle export"
                                                      PreviewMouseDown="StopExpanderToggle" />
                                            <TextBlock Grid.Column="1" Text="{Binding Parsed.FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parsed.IsIncomplete}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Incomplete — not analysable" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                            <Run Text="Format: " /><Run Text="{Binding Parsed.Format}" />
                                            <Run Text=" · Type: " /><Run Text="{Binding Parsed.DumpTypeText}" />
                                            <Run Text=" · Size: " /><Run Text="{Binding Parsed.SizeBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="{Binding IssueText}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="OS: " /><Run Text="{Binding Parsed.OsVersion, TargetNullValue='Unknown'}" />
                                            <Run Text=" · Machine: " /><Run Text="{Binding Parsed.MachineType, TargetNullValue='Unknown'}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Bugcheck (from binary parse): " /><Run Text="{Binding Parsed.BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, TargetNullValue='not found'}" />
                                        </TextBlock>

                                        <!-- Round 15, item 29: per-code labelled parameters (item 30's NTSTATUS
                                             decode inline where applicable) - replaces the old flat "Parameters: ..."
                                             hex row. -->
                                        <ItemsControl ItemsSource="{Binding Decoded.ParameterRows}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Round 15, item 32: DPC_WATCHDOG_VIOLATION (0x133) subtype line. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DpcWatchdogSubtypeText}"
                                                   Visibility="{Binding Decoded.DpcWatchdogSubtypeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 33: DRIVER_POWER_STATE_FAILURE (0x9F) subcode line. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DriverPowerStateSubcodeText}"
                                                   Visibility="{Binding Decoded.DriverPowerStateSubcodeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 35: pool-tag decode for 0xC2/0xC5. -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                                       Text="{Binding Decoded.PoolTagText}"
                                                       Visibility="{Binding Decoded.PoolTagText, Converter={StaticResource NullToVisibilityConverter}}" />
                                            <!-- Round 19, item 88: jump straight to Special Pool for this crash's own tag. -->
                                            <Button Grid.Column="1" Content="Apply Special Pool" Padding="6,2" FontSize="11" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ApplySpecialPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Decoded.PoolTagRaw}"
                                                    Visibility="{Binding Decoded.PoolTagRaw, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>

                                        <!-- Round 19, item 85: Verifier violation subcode decode for 0xC4/0xC9/0xE6. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.VerifierViolationText}"
                                                   Visibility="{Binding Decoded.VerifierViolationText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 37: fault-address classification for 0xA/0xD1/0x50. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.FaultAddressClassification}"
                                                   Visibility="{Binding Decoded.FaultAddressClassification, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 31: curated "what usually causes this" note - explicitly
                                             non-authoritative, per CLAUDE.md's "quick flag, not a verdict". -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding Decoded.Guidance, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="What usually causes this (not a diagnosis): " FontWeight="SemiBold" /><Run Text="{Binding Decoded.Guidance}" />
                                        </TextBlock>

                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Contents: " /><Run Text="{Binding ContentsText}" />
                                            <Run Text=" (" /><Run Text="{Binding ModuleCountText}" /><Run Text=")" />
                                        </TextBlock>

                                        <!-- Item 17/18: blame + dossier. -->
                                        <StackPanel Margin="0,6,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="{Binding Parsed.BlamedModule, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                <Run Text="Probably blamed: " /><Run Text="{Binding Parsed.BlamedModule}" />
                                            </TextBlock>
                                            <TextBlock Text="Quick flag, not a verdict — this is address-range matching, not a symbolised stack."
                                                       Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Company: " /><Run Text="{Binding Parsed.BlamedModuleDossier.CompanyName, TargetNullValue='Unknown'}" />
                                                <Run Text=" · Product: " /><Run Text="{Binding Parsed.BlamedModuleDossier.ProductName, TargetNullValue='Unknown'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Version: " /><Run Text="{Binding Parsed.BlamedModuleDossier.FileVersion, TargetNullValue='Unknown'}" />
                                                <Run Text=" · Date: " /><Run Text="{Binding Parsed.BlamedModuleDossier.FileDate, StringFormat={}{0:d}, TargetNullValue='Unknown'}" />
                                                <Run Text=" · Signature: " /><Run Text="{Binding Parsed.BlamedModuleDossier.SignatureStatus}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Item 23/24: debugger actions + cached !analyze -v result. -->
                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Analyse (!analyze -v)" Command="{Binding AnalyzeCommand}" Padding="10,4" Margin="0,0,8,0"
                                                        Visibility="{Binding CanUseDebugger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="Open in WinDbg" Command="{Binding OpenInWinDbgCommand}" Padding="10,4" Margin="0,0,8,0"
                                                        Visibility="{Binding CanUseDebugger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <!-- Round 16, item 45: copyable crash signature (bugcheck + params + OS build) + a
                                                     one-click web search for it. -->
                                                <Button Content="Copy crash signature" Command="{Binding CopySignatureCommand}" Padding="10,4" Margin="0,0,8,0" />
                                                <Button Content="Web search" Command="{Binding OpenWebSearchCommand}" Padding="10,4" />
                                                <TextBlock Text="Analysing..." VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}"
                                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ActionStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding DebuggerHintText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanUseDebugger}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AnalyzeError}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                            <StackPanel Margin="0,6,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="{Binding Analysis, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="MODULE_NAME: " /><Run Text="{Binding Analysis.ModuleName, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="IMAGE_NAME: " /><Run Text="{Binding Analysis.ImageName, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="FAILURE_BUCKET_ID: " /><Run Text="{Binding Analysis.FailureBucketId, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="PROCESS_NAME: " /><Run Text="{Binding Analysis.ProcessName, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <Expander Header="STACK_TEXT" IsExpanded="False" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Analysis.StackText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No minidump files to parse.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DumpRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 14, item 19: third-party drivers present in every parseable dump's module
                 list - the strongest cheap cross-dump signal available without a real debugger. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommonDrivers.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Drivers present in every crash" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Non-Microsoft drivers found in the module list of every dump this app could parse. A cheap, strong lead - not proof."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding CommonDrivers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="in " /><Run Text="{Binding DumpCount}" /><Run Text=" dump(s)" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 14, item 20: MEMORY.DMP - the kernel/complete dump, never shown before now. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MEMORY.DMP" Style="{StaticResource CardTitle}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MemoryDump.Exists}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="{Binding MemoryDump.FilePath}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,8">
                            <Run Text="{Binding MemoryDump.SizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding MemoryDump.Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                            <Run Text=" · Bugcheck: " /><Run Text="{Binding MemoryDump.Parsed.BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, TargetNullValue='not found'}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Open folder" Command="{Binding OpenMemoryDumpFolderCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Copy to..." Command="{Binding CopyMemoryDumpCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Delete" Command="{Binding DeleteMemoryDumpCommand}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding MemoryDumpStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="No MEMORY.DMP found - this machine isn't configured for a Complete/Kernel dump (see CrashDumpEnabled in the Minidump folder's housekeeping above, or the crash-analysis settings).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MemoryDump.Exists}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 14, items 21/22: live kernel events (watchdog dumps with no bluescreen). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LiveKernelReports.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Live kernel events (no BSOD)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Watchdog-triggered live kernel dumps (DPCWATCHDOG, USBHUB3, NDIS, video-engine timeouts, ...) that never caused a bluescreen or reboot."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding LiveKernelReports}" Height="180" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.5*" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                            <DataGridTextColumn Header="WER code" Binding="{Binding WerDescription}" Width="2.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 16, item 41: "is Windows even collecting crash data" warning strip - a
                 disabled/blocked WER silently starves this whole card, plus the Minidumps card's
                 WER join, of data, so this is called out up front rather than just an empty list. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WerStatus.LooksDisabled}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"
                               Text="Windows Error Reporting looks disabled or blocked - every WER-based feature on this tab (this card, plus the Minidumps card's Full crash record) is silently starved of data until it's re-enabled." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Re-enable Windows Error Reporting" Command="{Binding EnableWerCommand}" Padding="10,4" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding WerStatusActionText}" VerticalAlignment="Center" Style="{StaticResource SubStat}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Round 16, items 38-40/45-47/49: WER ReportArchive/ReportQueue scan - a crash
                 record source entirely separate from the event log above, machine-wide and
                 per-user, archive and queue - see WerReportService.ScanAll. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Error reports (Windows Error Reporting)" Style="{StaticResource CardTitle}" Margin="0" />
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding SelectedWerReportCount, Mode=OneWay}" /><Run Text=" selected" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Scanned from WER's own ReportArchive/ReportQueue folders (machine and per-user), independent of the event log above and not subject to its 30-day rollover."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- Items 41/44: collection status + consent/prompt read-out - always shown. -->
                    <TextBlock Text="{Binding WerCollectionSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding WerConsentSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <!-- Item 46: crashes/hangs toggle - two buttons, not a nested TabControl (see
                         StabilityViewModel.ShowWerHangs's remarks on why). -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Crashes" Command="{Binding ShowWerCrashesCommand}" Padding="10,4" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowWerHangs}" Value="False">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ShowWerHangsCommand}" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowWerHangs}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock>
                                <Run Text="Application hangs (" /><Run Text="{Binding WerHangReports.Count}" /><Run Text=")" />
                            </TextBlock>
                        </Button>
                    </StackPanel>

                    <!-- Item 39: crash buckets - "this exact crash happened N times" - the
                         primary grouped view, shown when ShowWerHangs is False. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWerHangs}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding WerCrashBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,8" IsExpanded="False">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding AppName}" /><Run Text=" — " /><Run Text="{Binding ModName}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubStat}">
                                                        <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding BucketKindText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Reports}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Item 49: multi-select. -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                                      ToolTip="Select for a future support-bundle export" />
                                                            <StackPanel Grid.Column="1">
                                                                <!-- Item 40: Source column. -->
                                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                    <Run Text="{Binding Report.ReportTimestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                                    <Run Text=" · " /><Run Text="{Binding Report.SourceText}" />
                                                                    <Run Text=" · " /><Run Text="{Binding Report.ExceptionCode, TargetNullValue='Unknown'}" />
                                                                    <Run Text=" @ " /><Run Text="{Binding Report.Offset, TargetNullValue='?'}" />
                                                                </TextBlock>
                                                                <!-- Item 47: joined Application-log event message - the default row shape. -->
                                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                           Visibility="{Binding Report.JoinedEventMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                                                    <Run Text="Application-log event: " /><Run Text="{Binding Report.JoinedEventMessage}" />
                                                                </TextBlock>
                                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                    <Run Text="Attached: " /><Run Text="{Binding Report.AttachedFiles, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <!-- Item 45: copyable crash signature + web search. -->
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Button Content="Copy crash signature" Command="{Binding CopySignatureCommand}" Padding="8,3" Margin="0,0,6,0" FontSize="11" />
                                                                    <Button Content="Web search" Command="{Binding OpenWebSearchCommand}" Padding="8,3" FontSize="11" />
                                                                    <TextBlock Text="{Binding ActionStatusText}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No crash reports found.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WerCrashBuckets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Item 46: application hangs - flat list, shown when ShowWerHangs is True. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWerHangs}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding WerHangReports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                      ToolTip="Select for a future support-bundle export" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Report.AppName, TargetNullValue='Unknown'}" />
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Report.ReportTimestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding Report.SourceText}" />
                                                    <Run Text=" · " /><Run Text="{Binding Report.EventType, TargetNullValue='Unknown'}" />
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="Copy crash signature" Command="{Binding CopySignatureCommand}" Padding="8,3" Margin="0,0,6,0" FontSize="11" />
                                                    <Button Content="Web search" Command="{Binding OpenWebSearchCommand}" Padding="8,3" FontSize="11" />
                                                    <TextBlock Text="{Binding ActionStatusText}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No application hangs found.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WerHangReports.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Item 43: queue/archive size + explicit, warned purge. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                <Run Text="Archive/queue folders: " /><Run Text="{Binding WerQueueSize.FolderCount, Mode=OneWay}" /><Run Text=" report(s), " />
                                <Run Text="{Binding WerQueueSize.TotalSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" /><Run Text=" total." />
                            </TextBlock>
                            <Button Content="Purge all WER reports..." Command="{Binding PurgeWerReportsCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding WerPurgeStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 16, item 48: WER-archive-derived long-horizon crash history - not capped at
                 30 days like Reliability History above, since these report folders aren't subject
                 to event-log rollover. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Crash history (WER archive, 90 days)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Built from WER report-folder timestamps rather than the event log, so it reaches further back than every other chart on this tab."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding WerHistorySeries}" XAxes="{Binding WerHistoryXAxes}" YAxes="{Binding WerHistoryYAxes}"
                                         Height="140" TooltipPosition="Top" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Round 16, item 42: LocalDumps "Capture settings" - one of the highest-value crash
                 tools Windows has, off by default and hidden today. Global by default (blank
                 target), or for one named executable. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Capture settings (per-app crash dumps)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Configures HKLM\...\Windows Error Reporting\LocalDumps so Windows writes a full user-mode dump every time the chosen app (or every app, if left blank) crashes."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="Target executable (blank = every app, global default)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <TextBox Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"
                             Text="{Binding LocalDumpsTargetExe, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Dump folder" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                             Text="{Binding LocalDumpsFolder, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dump count" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Width="48" Text="{Binding LocalDumpsCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="Dump type" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                        <!-- Index 0/1/2 matches LocalDumpsType/DumpType's own Custom/Mini/Full values 1:1 -
                             see StabilityViewModel.LocalDumpsType's remarks. -->
                        <ComboBox Grid.Column="3" Width="140" SelectedIndex="{Binding LocalDumpsType}">
                            <ComboBoxItem Content="Custom dump" />
                            <ComboBoxItem Content="Mini dump" />
                            <ComboBoxItem Content="Full dump" />
                        </ComboBox>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Load current" Command="{Binding LoadLocalDumpsConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Save" Command="{Binding SaveLocalDumpsConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Remove override" Command="{Binding ClearLocalDumpsConfigCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding LocalDumpsStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />

                    <!-- Round 17, item 61: SilentProcessExit - the LocalDumps section above only
                         ever triggers from an actual reported fault; this covers a process that
                         disappears silently (no error raised at all), for the same target
                         executable entered above. -->
                    <Separator Margin="0,12,0,12" Opacity="0.3" />
                    <TextBlock Text="Silent process exit monitoring" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                    <TextBlock Text="Configures HKLM\...\SilentProcessExit\&lt;exe&gt; so Windows captures a dump (or launches a monitor process) when the target executable above disappears without ever raising an error - the gap LocalDumps alone doesn't cover. Needs a target executable (no global default)."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Reporting mode" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" Width="260" SelectedValuePath="Tag" SelectedValue="{Binding SilentExitReportingMode}">
                            <ComboBoxItem Content="1 — capture a dump" Tag="1" />
                            <ComboBoxItem Content="2 — launch a monitor process" Tag="2" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="Local dump folder (used with mode 1)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                             Text="{Binding SilentExitLocalDumpFolder, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Monitor process (used with mode 2, optional)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                             Text="{Binding SilentExitMonitorProcess, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Load current" Command="{Binding LoadSilentExitConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Save" Command="{Binding SaveSilentExitConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Remove" Command="{Binding ClearSilentExitConfigCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding SilentExitStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />

                    <!-- Round 17 chunk 64-70, item 70: forced-crash toggles - for a machine that
                         hard-hangs with no dump at all, turning an undiagnosable freeze into a
                         real one on demand beats never getting a dump. Clearly labelled advanced/
                         destructive, matching PurgeWerReportsCommand's own confirmation pattern. -->
                    <Separator Margin="0,12,0,12" Opacity="0.3" />
                    <TextBlock Text="Advanced: force a crash on demand" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                    <TextBlock Text="For a machine that hard-hangs with no dump at all, Windows offers two keyboard/hardware-initiated ways to deliberately bluescreen it instead, turning an undiagnosable freeze into a real dump the next time it happens."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <TextBlock Text="Enabling either toggle below means Ctrl+ScrollLock×2 (or a hardware NMI signal) will deliberately bluescreen this machine - a real, disruptive crash, not a simulation. Only enable one if you actually intend to reproduce a freeze this way."
                                   Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding ForcedCrashConfigText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBlock Text="Ctrl+ScrollLock×2 crash (CrashOnCtrlScroll)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Enable" Command="{Binding EnableCrashOnCtrlScrollCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Disable" Command="{Binding DisableCrashOnCtrlScrollCommand}" Padding="10,4" />
                    </StackPanel>

                    <TextBlock Text="NMI crash dump (NMICrashDump)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Enable" Command="{Binding EnableNmiCrashDumpCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Disable" Command="{Binding DisableNmiCrashDumpCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Refresh status" Command="{Binding RefreshForcedCrashStatusCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding ForcedCrashStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Round 18, items 71-79: "Crash dump configuration" - a sibling card to "Capture
                 settings" above; that card configures LocalDumps/SilentProcessExit (per-app
                 user-mode dumps), this one covers the system-wide CrashControl configuration that
                 decides whether a kernel bugcheck (BSOD) itself leaves a readable dump at all -
                 see CrashDumpConfigService's own remarks. Item 80's pass/fail summary of
                 everything on this card lives at the top of the tab. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Crash dump configuration" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="HKLM\...\CrashControl decides whether the next BSOD leaves a dump behind at all, and what kind - read out here in plain English, cross-checked against the page file that has to be large enough to actually hold it."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- Item 71: plain-English CrashDumpEnabled/DumpFile/MinidumpDir/Overwrite/
                         AutoReboot/LogEvent/AlwaysKeepMemoryDump/DedicatedDumpFile read-out. -->
                    <ItemsControl ItemsSource="{Binding CrashDumpConfig.Fields}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="270" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Items 72/73: dump type vs. page file. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,0,0,10" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Page file vs. dump type" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" FontWeight="SemiBold" />

                            <!-- Item 73: page file disabled entirely - the "I have 64 GB of RAM so
                                 I turned it off" case, which silently disables crash dumps. -->
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CrashDumpConfig.PageFileDisabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run Text="No page file is configured at all - crash dumps are silently disabled. The configured dump type needs roughly " />
                                    <Run Text="{Binding CrashDumpConfig.RequiredSizeForConfiguredTypeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                    <Run Text=" of page file (or a dedicated dump file below, on a volume with room)." />
                                </TextBlock>
                            </Border>

                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,6">
                                <Run Text="Total RAM: " /><Run Text="{Binding CrashDumpConfig.TotalRamBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                <Run Text=" · Complete dump needs ~" /><Run Text="{Binding CrashDumpConfig.RequiredSizeForCompleteBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                <Run Text=" · Kernel/Automatic dump needs ~" /><Run Text="{Binding CrashDumpConfig.RequiredSizeForKernelBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                <Run Text=" (both approximate - Microsoft doesn't publish an exact formula)." />
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding CrashDumpConfig.PageFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Items 74/75: dedicated dump file setup + free-space health on whichever
                         volume the next crash would actually try to write to. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Dedicated dump file &amp; target free space" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" FontWeight="SemiBold" />
                            <TextBlock Text="DedicatedDumpFile/DumpFileSize point the dump at a different (larger) volume instead of enlarging the system page file - useful when the system volume genuinely doesn't have room."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <!-- Item 75: red/amber/green free-space line. -->
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8">
                                <Run Text="Dump target: " /><Run Text="{Binding CrashDumpConfig.DumpTargetPath, TargetNullValue='Unknown'}" FontFamily="Consolas" />
                                <LineBreak />
                                <Run Text="{Binding CrashDumpConfig.DumpTargetHealthText}" FontWeight="SemiBold">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CrashDumpConfig.DumpTargetHealthLevel}" Value="Green">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CrashDumpConfig.DumpTargetHealthLevel}" Value="Amber">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CrashDumpConfig.DumpTargetHealthLevel}" Value="Red">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>

                            <TextBlock Text="New dedicated dump file path (e.g. D:\MEMORY.DMP, on a volume with room)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding DedicatedDumpFilePath, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max size (MB, 0 = let Windows decide)" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Width="80" Text="{Binding DedicatedDumpFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Set dedicated dump file" Command="{Binding SetDedicatedDumpFileCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Clear" Command="{Binding ClearDedicatedDumpFileCommand}" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Item 76: auto-reboot toggle. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Auto-reboot after a crash" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Text="When on, the machine restarts immediately after a bugcheck, before the stop code (or QR code) can be read. Turning it off is temporary diagnostic practice, not a permanent setting."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Enable" Command="{Binding EnableAutoRebootCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Disable" Command="{Binding DisableAutoRebootCommand}" Style="{StaticResource DangerButton}" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Item 78: Fast Startup / HiberbootEnabled. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Fast Startup" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Text="When on (HiberbootEnabled), a normal &quot;shut down&quot; is really a hibernate - driver state persists across the reboot, so a driver fault can survive a restart that &quot;should&quot; have cleared it, and invalidates most &quot;did rebooting fix it&quot; reasoning."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Enable" Command="{Binding EnableFastStartupCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Disable" Command="{Binding DisableFastStartupCommand}" Style="{StaticResource DangerButton}" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Item 79: hibernation + BitLocker interactions - informational only. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Hibernation &amp; encryption interactions" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CrashDumpConfig.HibernationStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CrashDumpConfig.DumpVolumeBitLockerStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                       Visibility="{Binding CrashDumpConfig.DumpVolumeBitLockerStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Item 77: one-click "make this PC capture crashes properly". -->
                    <TextBlock Text="Recommended fix" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                    <TextBlock Text="Sets the dump type to Automatic memory dump, sets MinidumpsCount to a sane 10, and switches the page file to system-managed so Windows sizes it itself - the same three things a manual walkthrough would ask for."
                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <Button Content="Make this PC capture crashes properly" Command="{Binding ApplyRecommendedCrashDumpConfigCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding CrashDumpConfigStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Round 19, items 81/82/83/84/86: "Driver Verifier" card - live status (81), a
                 prominent "still enabled" warning + one-click reset (82), how long it's been on
                 (86), and a guided multi-step wizard for turning it on safely (83/84). See
                 DriverVerifierService/VerifierEnableHistoryService for the underlying reads/writes. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VerifierStatus.IsRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Driver Verifier" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Verifier makes Windows scrutinize a chosen driver's every pool allocation, IRQL, IRP and DMA call, catching a misbehaving driver at the exact moment it breaks a rule instead of some random time later - the single most effective way to catch a driver bug, at the cost of noticeably slower/heavier operation while it's on."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- Item 81. -->
                    <TextBlock Text="{Binding VerifierStatus.StatusSummaryText}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding VerifierStatus.ErrorText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding VerifierStatus.ErrorText, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,4" />

                    <TextBlock Text="Persistent settings for the next reboot:" Style="{StaticResource SubStat}" Margin="0,0,0,2" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8">
                        <Run Text="Drivers: " /><Run Text="{Binding VerifierStatus.PersistentDriverNames, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                        <LineBreak /><Run Text="Flags: " /><Run Text="{Binding VerifierStatus.PersistentFlagsDescription, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Item 86. -->
                    <TextBlock Text="{Binding VerifierEnabledDurationText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding VerifierEnabledDurationText, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifierNagDue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Item 86: "a configurable number of days or reboots" - the two nag
                         thresholds, editable inline. -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nag after" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Width="40" Text="{Binding NagAfterDaysInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="day(s) or" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,6,0" />
                        <TextBox Grid.Column="3" Width="40" Text="{Binding NagAfterRebootsInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="4" Text="reboot(s)" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,10,0" />
                        <Button Grid.Column="5" Content="Save" Command="{Binding SaveVerifierNagSettingsCommand}" Padding="8,2" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Refresh status" Command="{Binding RefreshVerifierStatusCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Guided setup: enable Verifier safely..." Command="{Binding OpenWizardCommand}" Padding="10,4" />
                    </StackPanel>

                    <!-- Item 82: prominent banner + one-click reset, only while actually running. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifierStatus.IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Driver Verifier is currently enabled and slowing this machine down. Left on after a diagnostic session is done, it's easy to forget about - reset it below once you're finished." />
                            <Button Content="Reset Driver Verifier" Command="{Binding ResetVerifierCommand}" Style="{StaticResource DangerButton}" Padding="10,4" HorizontalAlignment="Left" />
                            <TextBlock Text="A reboot is needed for the reset to fully take effect." Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VerifierResetStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4" />

                    <!-- Items 83/84: the guided wizard itself, expanded in-card. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding WizardOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Guided Verifier setup" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CloseWizardCommand}" Padding="10,4" />
                            </Grid>

                            <!-- Step 1: restore point. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Step 1 of 4 - Create a restore point" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBlock Text="Enabling Driver Verifier is genuinely capable of making the machine unbootable if the driver being checked turns out to be badly broken. A System Restore point gives you a way back before anything changes."
                                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Content="Create restore point" Command="{Binding CreateRestorePointCommand}" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Next: choose drivers &gt;" Command="{Binding GoToDriverStepCommand}" Padding="10,4" />
                                </StackPanel>
                                <TextBlock Text="{Binding RestorePointStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Step 2: driver selection. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Step 2 of 4 - Choose drivers to verify" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBlock Text="Only non-Microsoft, currently loaded drivers are listed - verifying Windows' own in-box drivers is rarely useful and adds a lot of overhead for little benefit."
                                           Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding WizardDriverStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding WizardDriverCandidates}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3,0,3">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="12" />
                                                    <TextBlock Text="{Binding VendorText}" Style="{StaticResource SubStat}" FontSize="10.5" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="&lt; Back" Command="{Binding BackWizardStepCommand}" CommandParameter="1" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Next: Safe Mode recovery &gt;" Command="{Binding GoToSafeModeStepCommand}" Padding="10,4" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 3: Safe Mode recovery guidance - shown BEFORE enabling, per this
                                 chunk's own instruction that the recovery guidance is the point. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="3">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Step 3 of 4 - If this stops the machine from booting" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="Read this before continuing - a badly-behaved driver under Verifier can bugcheck on every boot, before this app is reachable again." FontWeight="SemiBold" />
                                        <LineBreak /><LineBreak />
                                        <Run Text="1. If Windows won't start normally, force it into recovery: hold the power button to interrupt boot 2-3 times in a row, or boot from Windows installation media and choose &quot;Repair your computer&quot;." />
                                        <LineBreak />
                                        <Run Text="2. From the recovery menu: Troubleshoot -&gt; Advanced options -&gt; Startup Settings -&gt; Restart, then press 4 (or F4) for Safe Mode." />
                                        <LineBreak />
                                        <Run Text="3. In Safe Mode (or a recovery Command Prompt), run: verifier /reset  -  this clears every Verifier setting; reboot normally afterward." />
                                        <LineBreak />
                                        <Run Text="4. If even Safe Mode won't start, use the System Restore point from step 1 instead (Troubleshoot -&gt; Advanced options -&gt; System Restore)." />
                                    </TextBlock>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&lt; Back" Command="{Binding BackWizardStepCommand}" CommandParameter="2" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Next: confirm &gt;" Command="{Binding GoToConfirmStepCommand}" Padding="10,4" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 4: confirm + apply. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WizardStep}" Value="4">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Step 4 of 4 - Confirm and apply" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" />
                                <TextBlock Text="Selected drivers:" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding WizardDriverCandidates}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="12"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Item 84: apply-without-restarting option. -->
                                <CheckBox Content="Apply without restarting (volatile - starts verifying immediately, no reboot)" IsChecked="{Binding WizardApplyVolatile}" Margin="0,0,0,8" />

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardApplyVolatile}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Also change one flag immediately (optional - Special Pool itself can't change without a reboot, but these can):"
                                               Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                    <ComboBox ItemsSource="{Binding VolatileFlagOptionLabels}" SelectedIndex="{Binding WizardVolatileFlagIndex}" Width="340" HorizontalAlignment="Left" />
                                </StackPanel>

                                <TextBlock Text="Standard mode applies Special Pool, Force IRQL Checking, Pool Tracking, I/O Verification, Deadlock Detection, DMA Verification and Microsoft's other recommended checks - takes effect after a reboot."
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WizardApplyVolatile}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="&lt; Back" Command="{Binding BackWizardStepCommand}" CommandParameter="3" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Enable Driver Verifier" Command="{Binding ApplyWizardCommand}" Style="{StaticResource DangerButton}" Padding="10,4" />
                                </StackPanel>
                                <TextBlock Text="{Binding WizardApplyStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 19, item 87: on-demand kernel pool-by-tag monitor, with item 88's targeted
                 Special Pool follow-up per row. Never a timer - see PoolTagMonitorService's own
                 remarks on why this is explicit-button-gated. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Kernel pool by tag" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Samples every kernel pool tag's allocation counts on demand and, from the second sample onward, shows how much each tag's usage has grown since the first sample this session - sorted by nonpaged growth, since a nonpaged pool leak is a slow march toward a PFN_LIST_CORRUPT (0x4E) or DRIVER_LEFT_LOCKED_PAGES_IN_PROCESS-style (0xD1) crash. A quick flag, not a verdict - growth alone doesn't prove a leak."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Sample now" Command="{Binding SamplePoolTagsCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Reset baseline" Command="{Binding ResetPoolTagBaselineCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding PoolTagStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <DataGrid ItemsSource="{Binding PoolTagRows}" Height="320" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="70" />
                            <DataGridTextColumn Header="Nonpaged" Binding="{Binding NonPagedUsedText}" Width="90" />
                            <DataGridTextColumn Header="Nonpaged growth" Binding="{Binding NonPagedGrowthText}" Width="120" />
                            <DataGridTextColumn Header="Paged" Binding="{Binding PagedUsedText}" Width="90" />
                            <DataGridTextColumn Header="Paged growth" Binding="{Binding PagedGrowthText}" Width="110" />
                            <DataGridTextColumn Header="Allocations" Binding="{Binding NonPagedAllocs}" Width="90" />
                            <DataGridTemplateColumn Header="" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Apply Special Pool" Padding="6,2" FontSize="11"
                                                Command="{Binding DataContext.ApplySpecialPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Tag}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding SpecialPoolStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Round 13, item 4: every Kernel-Power 41 occurrence in the lookback window, not
                 just the most recent - see EventLogService.ReadUnexpectedShutdowns. Each row's
                 cause comes from item 3's ClassifyPowerEvent heuristic. Collapsed entirely when
                 the window has none. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UnexpectedShutdowns.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unexpected shutdowns" Style="{StaticResource CardTitle}" Margin="0" />
                        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding UnexpectedShutdowns.Count, Mode=OneWay}" /><Run Text=" in last 30 days" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Kernel-Power 41 occurrences, most recent first. Cause is a best-effort classification, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding UnexpectedShutdowns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding Cause, Converter={StaticResource ShutdownCauseToTextConverter}, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Bugcheck: " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               Text="{Binding UptimeBeforeCrash, StringFormat={}{0:d\\.hh\\:mm} up, TargetNullValue='uptime unknown'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 13, items 5/6: merged shutdown/restart/boot timeline - who/what initiated
                 each shutdown or restart (User32 1074), log start/stop markers, and boots flagged
                 dirty when no matching clean-shutdown marker precedes them - see
                 EventLogService.ReadShutdownTimeline. Collapsed entirely when empty. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShutdownTimeline.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Shutdown &amp; restart timeline" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Who/what initiated each shutdown or restart, plus boots not preceded by a clean shutdown marker (flagged Dirty). A dirty boot with no bugcheck and no dump file is further flagged Freeze - select the row for the last events logged before the silence."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding ShutdownTimeline}" Height="220" IsReadOnly="True"
                              RowDetailsVisibilityMode="Collapsed">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirtyBoot}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <!-- Item 68: auto-expand row details for a detected freeze - too
                                         important a finding to require the user to notice and click
                                         a normally-empty row first. -->
                                    <DataTrigger Binding="{Binding FreezeWithoutCrashLabel, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                        <Setter Property="DetailsVisibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="2*" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.5*" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="1.5*" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                            <DataGridTemplateColumn Header="Dirty" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Dirty" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding IsDirtyBoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Item 68 -->
                            <DataGridTemplateColumn Header="Freeze" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Freeze" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding FreezeWithoutCrashLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,2,0,6"
                                        Visibility="{Binding FreezeWithoutCrashLabel, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FreezeWithoutCrashLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="Last events logged before the system went silent:" Style="{StaticResource SubStat}" Margin="0,6,0,2" />
                                        <ItemsControl ItemsSource="{Binding EventsBeforeSilence}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 13, items 9/10: Microsoft-Windows-WHEA-Logger hardware errors (corrected and
                 uncorrectable machine-check/memory/PCIe), often logged for weeks before a 0x124
                 bugcheck - see EventLogService.ReadWheaErrors/DecodeWheaErrorRecord. Corrected
                 counts are framed as an early warning, not a diagnosis ("quick flag, not a
                 verdict" per CLAUDE.md). Collapsed entirely when none found. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WheaSummary.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Hardware errors (WHEA)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Corrected errors are an early warning, not a diagnosis - they can precede a hardware-related bugcheck by weeks."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WheaSummary}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Severity}" /><Run Text=" — " /><Run Text="{Binding Source}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Item 10: best-effort partial decode of each event's raw ErrorRecord, in a
                         detail expander (per-event, not the summary above). -->
                    <Expander Header="Individual events (raw record decode)" IsExpanded="False">
                        <ItemsControl ItemsSource="{Binding WheaErrors}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" (ID " /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="{Binding Decoded}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Round 10, #66: repeated application crashes grouped by faulting module, with a
                 count - see FaultingModuleSummary's remarks. A different lens on the same events
                 the flat grid below shows, purpose-built for "which module keeps crashing" instead
                 of scrolling a dozen near-identical rows. Collapsed entirely when nothing has a
                 faulting module (the common case for a quiet system). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CrashesByModule.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Crashes by faulting module" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding CrashesByModule}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Module}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 17, items 50/51/52/56/57: structured Application Error (1000) crashes -
                 leaderboard first ("which app is actually broken on this PC"), then the raw grid
                 with a plain-English exception reason and the foreign-module/injection-surface
                 flags. Collapsed entirely when nothing was found. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ApplicationCrashes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Application crashes" Style="{StaticResource CardTitle}" Margin="0" />
                        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding ApplicationCrashes.Count, Mode=OneWay}" /><Run Text=" in last 30 days" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Application Error (1000) events, fully parsed - reason is the exception code decoded to plain English; a foreign module (outside the app's own install directory, and not a system DLL) is flagged with its vendor and, when it matches a known injection surface on this machine, why."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="Which app is actually broken" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding AppCrashLeaderboard}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ExecutableName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="First " /><Run Text="{Binding FirstSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · Last " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding DistinctFaultingModules, Mode=OneWay}" /><Run Text=" distinct module(s)" />
                                            <Run Text=" · Mean gap " /><Run Text="{Binding MeanTimeBetweenCrashesText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding ApplicationCrashes}" Height="260" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsForeignModule}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="1.3*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="100" />
                            <DataGridTextColumn Header="Faulting module" Binding="{Binding ModName}" Width="1.3*" />
                            <DataGridTextColumn Header="Reason (exception code)" Binding="{Binding ExceptionCodeText}" Width="1.6*" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="90" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                            <!-- Item 69: generalizes item 33's original 0x9F-only sleep/resume
                                 cross-reference to every crash row. -->
                            <DataGridTemplateColumn Header="Sleep/resume?" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Near sleep/resume" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                                       ToolTip="A Kernel-Power sleep/resume event (42/107/187) was recorded within a few minutes of this crash." />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Foreign module?" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource WarningBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsForeignModule}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding ForeignModuleReason, Mode=OneWay}" />
                                            <Run Text=" (" /><Run Text="{Binding ModuleSignatureStatus, Mode=OneWay}" />
                                            <Run Text=", " /><Run Text="{Binding ModuleVendor, Mode=OneWay, TargetNullValue='vendor unknown'}" /><Run Text=")" />
                                            <LineBreak />
                                            <Run Text="{Binding InjectionSurfaceNote, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 17, item 53: Application Hang (1002) events, paired with the matching WER
                 AppHang report (item 46) for hang type/signature - a separate fault class from a
                 crash, so its own card rather than mixed into the grid above. Round 17 chunk
                 64-70, item 66's persisted hang-history leaderboard also lives here (this card),
                 so the Border only collapses when BOTH are empty. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ApplicationHangs.Count}" Value="0" />
                                    <Condition Binding="{Binding HangHistory.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Application hangs" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Application Hang (1002) events - hang type/signature come from the matching WER AppHang report (a far more reliable source than that event's own undocumented layout)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />

                    <!-- Item 66: all-time hang history per executable, persisted to
                         hang-history.json so it survives across app restarts - the live
                         NotRespondingSeconds this tab already tracks, kept once a hang episode
                         ends instead of discarded every tick. Collapsed when nothing recorded yet. -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HangHistory.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Hang history (all-time, per executable)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding HangHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ExecutableName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SubStat}">
                                                <Run Text="Peak " /><Run Text="{Binding PeakDurationSeconds, Mode=OneWay}" /><Run Text="s" />
                                                <Run Text=" · last " /><Run Text="{Binding LastHangTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                                <Run Text="{Binding HangCount, Mode=OneWay}" /><Run Text="×" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding ApplicationHangs}" Height="200" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.2*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90" />
                            <DataGridTextColumn Header="Hang type" Binding="{Binding HangType, TargetNullValue='Unknown'}" Width="1.4*" />
                            <DataGridTextColumn Header="Hang signature" Binding="{Binding HangSignature, TargetNullValue='Unknown'}" Width="1.4*" />
                            <!-- Item 69 -->
                            <DataGridTemplateColumn Header="Sleep/resume?" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Near sleep/resume" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 17, items 54/55: managed (.NET/CLR) exceptions - clustered by exception type
                 + top stack frame first, raw list below. Collapsed when empty. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ManagedExceptions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Managed exceptions (.NET/CLR)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="&quot;.NET Runtime&quot; events 1026/1023, parsed into exception type, message and top stack frames - dramatically more actionable than an Application Error row that just says the faulting module was clr.dll."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="Clustered by exception type + top frame" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ManagedExceptionClusters}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ExceptionType}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TopFrame}" Style="{StaticResource SubStat}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="{Binding ApplicationName, Mode=OneWay, TargetNullValue='(app unknown)'}" />
                                            <Run Text=" · last " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding ManagedExceptions}" Height="200" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="140" />
                            <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="1.1*" />
                            <DataGridTextColumn Header="Framework" Binding="{Binding FrameworkVersion}" Width="100" />
                            <DataGridTextColumn Header="Exception type" Binding="{Binding ExceptionType}" Width="1.5*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding ExceptionMessage}" Width="1.6*" />
                            <DataGridTextColumn Header="Top frame" Binding="{Binding TopFrameText}" Width="1.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 17, items 58/59: Service Control Manager crash/failure events (7031/7034/
                 7024/7000/7009), the service-side equivalent of an application crash - plus a
                 restart-loop warning strip when a service's own termination events cluster
                 densely enough to look chronic. Collapsed when empty. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ServiceFailures.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Service failures" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Service Control Manager events: terminated unexpectedly (7031/7034), service-specific exit code (7024), failed/timed out to start (7000/7009)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <!-- Item 59: restart-loop warning strip - a service crashing and being
                         auto-restarted several times an hour, a chronic fault that never
                         surfaces as a user-visible crash dialog. -->
                    <ItemsControl ItemsSource="{Binding ServiceRestartLoopWarnings}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap">
                                            <Run Text="Restart loop: " FontWeight="SemiBold" /><Run Text="{Binding ServiceName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" terminated " /><Run Text="{Binding OccurrencesInWindow, Mode=OneWay}" />
                                            <Run Text=" times between " /><Run Text="{Binding WindowStart, StringFormat={}{0:t}, Mode=OneWay}" />
                                            <Run Text=" and " /><Run Text="{Binding WindowEnd, StringFormat={}{0:t}, Mode=OneWay}" />
                                            <Run Text=" - a chronic fault, even though it never showed a crash dialog." />
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="View on Services tab" Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0"
                                                Command="{Binding DataContext.JumpToServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ServiceName}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding ServiceFailures}" Height="220" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1.3*" />
                            <DataGridTextColumn Header="Event" Binding="{Binding EventKindText}" Width="1.6*" />
                            <DataGridTextColumn Header="Count / exit code" Width="1.1*">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Path="RestartCount" TargetNullValue="" StringFormat="{}{0}× " />
                                        <Binding Path="ExitCode" TargetNullValue="" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Recovery action" Binding="{Binding RecoveryAction}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 17, item 62: postmortem (just-in-time) debugger + Image File Execution
                 Options hijack audit - read-only. Collapsed only when the read outright failed to
                 produce anything (Debugger/Auto both null and no hijacks) - otherwise always shown,
                 since "Windows default, nothing to see here" is itself a useful confirmation. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PostmortemDebugger}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Postmortem debugger audit" Style="{StaticResource CardTitle}" Margin="0" />
                        <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PostmortemDebugger.HasNonDefaultEntries}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Non-default entries found" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="HKLM\...\AeDebug names the just-in-time debugger; an Image File Execution Options\&lt;exe&gt;\Debugger value can silently hijack a process launch. Read-only - a non-default finding can be entirely legitimate (e.g. your own JIT debugger setup), it's just worth a manual check."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4">
                        <Run Text="AeDebug: " FontWeight="SemiBold" /><Run Text="{Binding PostmortemDebugger.Debugger, Mode=OneWay, TargetNullValue='Not set'}" />
                        <Run Text=" (Auto=" /><Run Text="{Binding PostmortemDebugger.Auto, Mode=OneWay, TargetNullValue='not set'}" /><Run Text=")" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10">
                        <Run Text="AeDebug (Wow6432Node): " FontWeight="SemiBold" /><Run Text="{Binding PostmortemDebugger.Wow64Debugger, Mode=OneWay, TargetNullValue='Not set'}" />
                        <Run Text=" (Auto=" /><Run Text="{Binding PostmortemDebugger.Wow64Auto, Mode=OneWay, TargetNullValue='not set'}" /><Run Text=")" />
                    </TextBlock>

                    <TextBlock Text="Image File Execution Options hijacks" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ColorRowLabel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PostmortemDebugger.ImageFileExecutionOptionsHijacks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding PostmortemDebugger.ImageFileExecutionOptionsHijacks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11.5" Margin="0,0,0,2">
                                    <Run Text="{Binding ExecutableName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" → " /><Run Text="{Binding DebuggerPath, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No Image File Execution Options Debugger hijacks found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PostmortemDebugger.ImageFileExecutionOptionsHijacks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============================================================================
                 Round 21, items 96-100: "Recovery, escalation and safe operation" - the final
                 chunk of this domain. Every action in this whole section is a genuinely dangerous
                 or slow operation (reboot into Safe Mode, chkdsk /f scheduling a reboot, DISM
                 taking many minutes) - every button below is confirmation-gated in the ViewModel,
                 never automatic. ============================================================ -->
            <TextBlock Text="Recovery" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,4,0,4" />
            <TextBlock Text="Escape hatches and repair tools for when something above has already gone wrong - reboot into Safe Mode or the Recovery Environment, audit the current boot configuration, roll back with System Restore, or run Windows' own repair tools. Every action here restarts the machine, changes system files, or otherwise takes real time - each is its own explicit, confirmed button."
                       Style="{StaticResource SubStat}" Margin="0,-2,0,12" TextWrapping="Wrap" />

            <!-- Item 96: reboot into Safe Mode / WinRE, with the matching revert - essential as
                 the escape hatch for the Driver Verifier wizard above (item 83). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Reboot into Safe Mode or Recovery Environment" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Safe Mode loads only core drivers/services - useful when a driver or startup program is hanging or crashing the machine before you can fix it. Unlike a one-time F8 boot, this keeps booting into Safe Mode on every restart until reverted below."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootConfigAudit.CurrentlyConfiguredForSafeMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                <Run Text="This machine is currently configured to boot into Safe Mode (" /><Run Text="{Binding BootConfigAudit.CurrentSafebootValue, Mode=OneWay}" /><Run Text=") on every restart." />
                            </TextBlock>
                            <Button Content="Revert Safe Mode boot" Command="{Binding RevertSafeModeBootCommand}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <WrapPanel>
                        <Button Content="Reboot into Safe Mode" Command="{Binding RebootToSafeModeMinimalCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,8" />
                        <Button Content="Reboot into Safe Mode with Networking" Command="{Binding RebootToSafeModeNetworkCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,8" />
                        <Button Content="Reboot into Recovery Environment (WinRE)" Command="{Binding RebootToRecoveryEnvironmentCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SafeModeStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Item 97: `bcdedit /enum {current}` decoded into plain English, with warnings for
                 the flags that weaken driver-signature enforcement or hide boot failures. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Boot configuration audit" Style="{StaticResource CardTitle}" Margin="0" />
                        <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BootConfigAudit.HasWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Flags found" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="safeboot, testsigning, nointegritychecks, debug, bootstatuspolicy and hypervisorlaunchtype from this boot entry's own bcdedit configuration - flagged when set to a value that weakens driver-signing enforcement or hides boot failures. Any of these can be a deliberate, legitimate developer/debugging setup - worth a manual check, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding BootConfigAudit.ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootConfigAudit.ReadOk}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding BootConfigAudit.Flags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top" Margin="0,2,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas" />
                                        <TextBlock Text="{Binding PlainEnglish}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Item 98: System Restore points - enumerated via the SystemRestore WMI class,
                 with a "create now" button (reusing item 83's RestorePointService.TryCreate) and
                 rstrui.exe launched for the actual rollback (a full rollback restarts the machine
                 partway through, so it can't run inside this app's own process). -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="System Restore points" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding SystemProtectionStatus.ProtectionStatusText}" Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Create restore point now" Command="{Binding CreateRestorePointFromRecoveryCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Open System Restore..." Command="{Binding LaunchRstruiCommand}" Padding="10,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding RestorePointsStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding SystemProtectionStatus.RestorePoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5" Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="{Binding CreationTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding RestorePointTypeText, Mode=OneWay}" />
                                            <Run Text=" · #" /><Run Text="{Binding SequenceNumber, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No restore points found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SystemProtectionStatus.RestorePoints.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Item 99: guided repair runner - sfc/DISM/chkdsk/mdsched, each its own explicit,
                 confirmed button with a "this takes a while" indicator. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Guided repair runner" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Windows' own built-in repair tools. sfc and DISM can each take several minutes and use noticeable CPU/disk; chkdsk only schedules a check for the next restart; Memory Diagnostic restarts the machine immediately to test RAM before Windows loads."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,12" TextWrapping="Wrap" />

                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Run System File Checker (sfc /scannow)" Command="{Binding RunSfcCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                            <TextBlock Text="Running..." Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsSfcRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SfcResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="120" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Run DISM repair (/RestoreHealth)" Command="{Binding RunDismCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                            <TextBlock Text="Running..." Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsDismRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DismResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <Button Content="Schedule disk check (chkdsk) on system drive" Command="{Binding ScheduleChkdskCommand}" Style="{StaticResource DangerButton}" Padding="10,4" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ChkdskResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Run Windows Memory Diagnostic" Command="{Binding LaunchMemoryDiagnosticCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Check for results" Command="{Binding RefreshMemoryDiagnosticResultsCommand}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding MemoryDiagnosticStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,4" />
                        <ItemsControl ItemsSource="{Binding MemoryDiagnosticResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap">
                                        <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding ResultText, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HadErrors}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Item 100: one-click crash support bundle - zips the selected minidumps/WER
                 reports (item 49's multi-select) with a system-information export, event-log
                 exports, a driver inventory, the crash-dump-configuration read-out and a
                 generated Markdown crash summary. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Crash support bundle" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                        <Run Text="Zips the selected minidumps (" /><Run Text="{Binding SelectedDumpCount, Mode=OneWay}" /><Run Text=") and WER reports (" />
                        <Run Text="{Binding SelectedWerReportCount, Mode=OneWay}" /><Run Text=") - select rows on the Dump analysis / Error reports cards above first - together with a full system-information export, System/Application event-log exports, a verbose driver inventory, the crash-dump configuration read-out, and a generated crash summary. Produces the exact package a support forum or technician asks for." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Build support bundle..." Command="{Binding BuildSupportBundleCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <TextBlock Text="Building..." Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsBuildingSupportBundle, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SupportBundleStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- #1/#8: recent Critical/Error entries from the System and Application logs, last
                 30 days - a faulting-module tooltip is shown when the message matched that shape
                 (typically an Application-log app crash entry). -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent critical / error events" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding RecentEvents}" Height="320" Margin="0,8,0,0" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="90" />
                            <DataGridTemplateColumn Header="Level" Width="80" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding ProviderName}" Width="2*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="60" />
                            <DataGridTextColumn Header="Faulting module" Binding="{Binding FaultingModule}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No Critical/Error events found in the last 30 days." Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
