<UserControl x:Class="TaskManagerPlus.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:models="clr-namespace:TaskManagerPlus.Models"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StabilityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- Sections, not one 5,300-line scroll. This tab had 91 stacked cards in a single ScrollViewer,
         appended a few at a time over many rounds, so related cards (four separate WHEA views, two
         Minidumps cards) ended up thousands of lines apart while unrelated ones sat adjacent. Five
         byte-identical duplicate cards were removed at the same time. Each chip below is one
         ScrollViewer of its own. -->
    <TabControl Style="{StaticResource SectionTabControl}" SelectedIndex="0">
        <TabItem Header="Overview">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- Round 18, item 80: "will this PC capture the next BSOD" - a single pass/fail/
                         uncertain verdict summarising items 71-79's crash dump configuration card below,
                         placed first (ahead of even the unexpected-shutdown banner) since every other
                         crash-forensics feature on this tab is worthless on a machine that isn't
                         configured to capture dumps at all - see CrashDumpConfigService.BuildChecklist. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Fail">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Will this PC capture the next BSOD?" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding CrashCaptureVerdictText}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Margin="0,2,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Pass">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Fail">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CrashCaptureVerdict}" Value="Uncertain">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding CrashCaptureChecklistItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top" Margin="0,2,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #4: the shutdown immediately preceding this boot looks unexpected (Kernel-Power 41
                         / EventLog 6008 within a few minutes of the last boot time) - see
                         EventLogService.Query. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WasLastShutdownUnexpected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}">
                                <Run Text="Last shutdown looks unexpected — " /><Run Text="{Binding LastUnexpectedShutdownText, Mode=OneWay}" />
                                <Run Text=" (Kernel-Power 41 / unclean shutdown near the last boot time)." />
                            </TextBlock>
                            <!-- Round 13, item 3: labelled cause badge instead of just the generic warning
                                 above - see EventLogService.ClassifyPowerEvent. "Quick flag, not a
                                 verdict" (CLAUDE.md): a heuristic over undocumented event-property layout. -->
                            <Border Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2"
                                    HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{Binding LastShutdownCauseText}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <!-- #625: power-draw-at-reboot correlation annotation - a reboot at peak draw
                                 with no bugcheck code is the classic PSU-under-load signature. -->
                            <TextBlock Text="{Binding PowerDrawAtRebootText}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,6,0,0" Opacity="0.9">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerDrawAtRebootText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Round 14, item 27: new-dump watcher alert - a crash dump was written while the
                         app was running (also mirrored as a tray balloon and a tab-header badge - see
                         MainWindow.xaml.cs / MainWindow.xaml). -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNewDumpAlert}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding NewDumpAlertText}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissNewDumpAlertCommand}" Padding="10,4" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <!-- #606: thermal-critical/shutdown event scan - a firmware thermal shutdown is
                         otherwise indistinguishable in this log from a PSU death, so this gets its own
                         explicit red banner rather than being folded into the generic event grid below. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThermalCriticalDetected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}">
                            <Run Text="Thermal-critical event found — a thermal zone exceeded its critical/passive trip point (or an ACPI thermal-shutdown record was logged) within the last 30 days. " />
                            <Run Text="{Binding ThermalCriticalEvents[0].TimeCreated, StringFormat={}Most recent: {0:g}, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <!-- =================================================================================
                         Round 20, items 89-95: "Clustering crashes over time and correlating with
                         changes" - a unified layer over EVERY per-source card below (bugchecks, live
                         kernel reports, WER reports, application crashes/hangs, service failures, TDRs,
                         WHEA errors, unexpected shutdowns). Item 89 calls this out as "the new default
                         view of the Stability tab", so it's placed first (right after the top verdict/
                         alert banners, ahead of the still-useful per-source "raw source" cards, which
                         remain below rather than being folded into an expander).
                         ================================================================================= -->

                    <!-- Item 90: crash signature clusters - displayed above the timeline per item 90's own
                         instruction, turning "thirty rows" into "three distinct problems". -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Crash signature clusters" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-8,0,10">
                                <Run Text="Kernel faults clustered by bugcheck code + blamed module + parameter shape; user-mode crashes/hangs clustered by WER bucket." />
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding CrashClusters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Cluster.Title}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Cluster.IsKernelFault}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Cluster.Count}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding Cluster.Description}" />
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,0">
                                                    <Run Text="First seen: " /><Run Text="{Binding Cluster.FirstSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · Last seen: " /><Run Text="{Binding Cluster.LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,0" Text="{Binding Cluster.CadenceText}" />

                                                <!-- Items 92-94: on-demand "what changed" panel - only computed the moment this
                                                     Expander is actually opened (see CrashClusterViewModel.IsWhatChangedExpanded). -->
                                                <Expander Header="What changed before this started (48h lookback)"
                                                          IsExpanded="{Binding IsWhatChangedExpanded, Mode=TwoWay}" Margin="0,8,0,0" FontSize="{StaticResource FontBody}">
                                                    <StackPanel Margin="0,6,0,0">
                                                        <TextBlock Text="Checking driver installs, Windows Updates and application installs…" Style="{StaticResource SubStat}"
                                                                   Visibility="{Binding IsLoadingWhatChanged, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding WhatChanged.ComputedOk}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="Could not check what changed: " /><Run Text="{Binding WhatChanged.ErrorText, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <ItemsControl ItemsSource="{Binding WhatChanged.Entries}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding Category}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                                                                <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Text="{Binding Detail}"
                                                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="No driver, Windows Update or application install found in the 48 hours before this cluster started."
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding WhatChanged.ComputedOk}" Value="True" />
                                                                                <Condition Binding="{Binding WhatChanged.Entries.Count}" Value="0" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No clustered kernel or user-mode faults found in the current lookback window.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CrashClusters.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Item 91: uptime-at-crash histogram + MTBF/longest-streak - boot times reused from
                         item 6's own shutdown timeline pairing walk, no second boot-time query. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Uptime before crashing (MTBF)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding MtbfSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-8,0,10" />
                            <lvc:CartesianChart Series="{Binding UptimeHistogramSeries}" XAxes="{Binding UptimeHistogramXAxes}" YAxes="{Binding UptimeHistogramYAxes}"
                                                 Height="140" TooltipPosition="Top" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- Item 89: the unified timeline itself - one chronological view merging every
                         source above, with a source filter. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Unified crash timeline" Style="{StaticResource CardTitle}" />

                            <ItemsControl ItemsSource="{Binding TimelineSourceFilters}" Margin="0,-6,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" FontSize="{StaticResource FontBody}" Margin="0,0,12,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding FilteredTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,4" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Row.Severity}" Value="Critical">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Row.Severity}" Value="Info">
                                                                        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Row.Timestamp, StringFormat={}{0:g}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Row.Summary}" FontSize="{StaticResource FontStrong}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="16,6,0,0">
                                                <TextBlock Text="{Binding Row.SourceTypeText}" Style="{StaticResource SubStat}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Row.Detail}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding Row.Detail, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Item 95: on-demand log-telemetry correlation, lazily loaded when this row is
                                                     expanded (see CrashTimelineRowViewModel.IsExpanded). -->
                                                <TextBlock Text="Loading logged telemetry around this time…" Style="{StaticResource SubStat}" Margin="0,6,0,0"
                                                           Visibility="{Binding IsLoadingLogCorrelation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <StackPanel Margin="0,6,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogCorrelation.HasCoverage}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="System activity in the 2 minutes before this event" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <lvc:CartesianChart Series="{Binding LogSeries}" XAxes="{Binding LogXAxes}" YAxes="{Binding LogYAxes}"
                                                                         Height="110" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                                                    <TextBlock Text="{Binding TelemetrySummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LogCorrelation.StatusText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogCorrelation.HasCoverage}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No matching crash/fault events - try enabling more sources above, or Refresh.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilteredTimeline.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #199: a cleared log must be flagged prominently, never silently folded into "no
                         problems found" - shown ahead of the Known-bad-IDs scorecard below, which is exactly
                         the kind of "nothing flagged" card a cleared log could otherwise make look clean. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogClearEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}">
                                <Run Text="Log integrity - a log was cleared in the last 30 days" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,4,0,0">
                                <Run Text="History before the clear is gone from that log - any &quot;no problems found&quot; card elsewhere on this tab only reflects what's still there." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding LogClearEvents}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,2">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" — the " /><Run Text="{Binding ClearedChannelName, Mode=OneWay}" /><Run Text=" log was cleared by " />
                                            <Run Text="{Binding Account, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #633: combined "possible unstable undervolt/overclock" flag - three independent,
                         individually weak signals (WHEA corrected errors, Application-log access-violation/
                         illegal-instruction faults spread across more than one module, and an inferred
                         non-stock-looking Vcore reading) that only add up to this banner once at least two
                         of them line up. Quick flag, not a verdict - its component evidence is itemized
                         beneath it. -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UndervoltInstabilitySuspected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold">
                                <Run Text="Possible unstable undervolt/overclock — multiple independent signals line up. Quick flag, not a verdict." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding UndervoltInstabilityEvidence}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}• {0}}" Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4" Opacity="0.9" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #610: throttle-to-stutter correlation - cross-references #604's persisted throttle
                         episodes against the same recorded-events timestamps below. Hidden until there's
                         both at least one throttle episode and one recorded event to compare. -->
                    <TextBlock Text="{Binding HitchThrottleCorrelationText}"
                               FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HitchThrottleCorrelationText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Crash / stability diagnostics — by source" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="{StaticResource FontSection}" />
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" />
                    </Grid>
                    <!-- Round 13, item 12: "is the 30-day lookback window even trustworthy" line - see
                         EventLogService.ReadLogHealth / StabilityViewModel.BuildLogCoverageText. -->
                    <TextBlock Text="{Binding LogCoverageText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <!-- #6/#5/#40/#68: uptime-since-last-crash, TDR (GPU driver timeout/reset) count,
                         low-memory resource-exhaustion events, minidumps, and (Round 10) the 0-10 stability
                         index - see ComputeStabilityIndex for the documented weighted formula. -->
                    <UniformGrid Columns="5" Margin="0,0,0,16">
                        <views:VfdMeter Title="Since last crash" Glow="False" Margin="0,0,6,0"
                                        ValueText="{Binding TimeSinceLastCrashText}"
                                        SubText="Unexpected shutdown or BSOD" AccentBrush="{DynamicResource AccentBrush}" />
                        <views:VfdMeter Title="TDR events" Glow="False" Margin="3,0,3,0"
                                        ValueText="{Binding TdrEventCount}"
                                        SubText="{Binding LastTdrEventText}"
                                        AccentBrush="{DynamicResource WarningBrush}" />
                        <views:VfdMeter Title="Minidumps" Glow="False" Margin="3,0,3,0"
                                        ValueText="{Binding Minidumps.Count}"
                                        SubText="%SystemRoot%\Minidump" AccentBrush="{DynamicResource AccentBrush}" />
                        <!-- #40: low-memory resource-exhaustion events (Warning-level, a separate targeted
                             query - see EventLogService.ReadLowMemoryEvents). -->
                        <views:VfdMeter Title="Low-memory events" Glow="False" Margin="3,0,3,0"
                                        ValueText="{Binding LowMemoryEventCount}"
                                        SubText="{Binding LastLowMemoryEventText}"
                                        AccentBrush="{DynamicResource WarningBrush}" />
                        <!-- Round 10, #68: single 0-10 stability index - see StabilityViewModel.ComputeStabilityIndex. -->
                        <views:VfdMeter Title="Stability index" Glow="False" Margin="6,0,0,0"
                                        ValueText="{Binding StabilityIndex, StringFormat={}{0:0.0}}" Unit="/ 10"
                                        SubText="Weighted from recent crash/error density"
                                        AccentBrush="{Binding StabilityIndex, Converter={StaticResource StabilityIndexToBrushConverter}}" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Crashes">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #122: "Known-bad IDs present on this PC" - which KB-flagged serious event IDs
                         (#117) actually showed up in the lookback window, with count/last-seen/next-step,
                         worst re-ranked severity first - the "tell me what's wrong" answer the flat grid
                         below otherwise makes the user derive by eye. Collapsed entirely when nothing
                         flagged turned up (the common case on a healthy PC). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KnownBadIdScorecard.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Known-bad IDs present on this PC" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                                <Run Text="event IDs the local knowledge base flags as usually serious, found in the last 30 days across System/Application, worst re-ranked severity first." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding KnownBadIdScorecard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold">
                                                        <Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding SeverityLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Meaning}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                        <Run Text="Next step: " FontWeight="SemiBold" /><Run Text="{Binding NextStep, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                    <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Right">
                                                        <Run Text="Last " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 16, items 38-40/45-47/49: WER ReportArchive/ReportQueue scan - a crash
                         record source entirely separate from the event log above, machine-wide and
                         per-user, archive and queue - see WerReportService.ScanAll. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Error reports (Windows Error Reporting)" Style="{StaticResource CardTitle}" Margin="0" />
                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedWerReportCount, Mode=OneWay}" /><Run Text=" selected" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Scanned from WER's own ReportArchive/ReportQueue folders (machine and per-user), independent of the event log above and not subject to its 30-day rollover."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <!-- Items 41/44: collection status + consent/prompt read-out - always shown. -->
                            <TextBlock Text="{Binding WerCollectionSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding WerConsentSummaryText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!-- Item 46: crashes/hangs toggle - two buttons, not a nested TabControl (see
                                 StabilityViewModel.ShowWerHangs's remarks on why). -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Crashes" Command="{Binding ShowWerCrashesCommand}" Padding="10,4" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowWerHangs}" Value="False">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowWerHangsCommand}" Padding="10,4">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowWerHangs}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock>
                                        <Run Text="Application hangs (" /><Run Text="{Binding WerHangReports.Count, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- Item 39: crash buckets - "this exact crash happened N times" - the
                                 primary grouped view, shown when ShowWerHangs is False. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowWerHangs}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding WerCrashBuckets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="0,0,0,8" IsExpanded="False">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding AppName, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding ModName, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Style="{StaticResource SubStat}">
                                                                <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                                <Run Text=" · " /><Run Text="{Binding BucketKindText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                                <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Reports}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Item 49: multi-select. -->
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                                              ToolTip="Select for a future support-bundle export" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <!-- Item 40: Source column. -->
                                                                        <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                            <Run Text="{Binding Report.ReportTimestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                                            <Run Text=" · " /><Run Text="{Binding Report.SourceText, Mode=OneWay}" />
                                                                            <Run Text=" · " /><Run Text="{Binding Report.ExceptionCode, TargetNullValue='Unknown', Mode=OneWay}" />
                                                                            <Run Text=" @ " /><Run Text="{Binding Report.Offset, TargetNullValue='?', Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <!-- Item 47: joined Application-log event message - the default row shape. -->
                                                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                                   Visibility="{Binding Report.JoinedEventMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                                                            <Run Text="Application-log event: " /><Run Text="{Binding Report.JoinedEventMessage, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                            <Run Text="Attached: " /><Run Text="{Binding Report.AttachedFiles, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <!-- Item 45: copyable crash signature + web search. -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                            <Button Content="Copy crash signature" Command="{Binding CopySignatureCommand}" Padding="8,3" Margin="0,0,6,0" FontSize="{StaticResource FontBody}" />
                                                                            <Button Content="Web search" Command="{Binding OpenWebSearchCommand}" Padding="8,3" FontSize="{StaticResource FontBody}" />
                                                                            <TextBlock Text="{Binding ActionStatusText}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No crash reports found.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WerCrashBuckets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Item 46: application hangs - flat list, shown when ShowWerHangs is True. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowWerHangs}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding WerHangReports}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                              ToolTip="Select for a future support-bundle export" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Report.AppName, TargetNullValue='Unknown', Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding Report.ReportTimestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding Report.SourceText, Mode=OneWay}" />
                                                            <Run Text=" · " /><Run Text="{Binding Report.EventType, TargetNullValue='Unknown', Mode=OneWay}" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Content="Copy crash signature" Command="{Binding CopySignatureCommand}" Padding="8,3" Margin="0,0,6,0" FontSize="{StaticResource FontBody}" />
                                                            <Button Content="Web search" Command="{Binding OpenWebSearchCommand}" Padding="8,3" FontSize="{StaticResource FontBody}" />
                                                            <TextBlock Text="{Binding ActionStatusText}" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No application hangs found.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WerHangReports.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Item 43: queue/archive size + explicit, warned purge. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                        <Run Text="Archive/queue folders: " /><Run Text="{Binding WerQueueSize.FolderCount, Mode=OneWay}" /><Run Text=" report(s), " />
                                        <Run Text="{Binding WerQueueSize.TotalSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" /><Run Text=" total." />
                                    </TextBlock>
                                    <Button Content="Purge all WER reports..." Command="{Binding PurgeWerReportsCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding WerPurgeStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Round 16, item 48: WER-archive-derived long-horizon crash history - not capped at
                         30 days like Reliability History above, since these report folders aren't subject
                         to event-log rollover. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Crash history (WER archive, 90 days)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Built from WER report-folder timestamps rather than the event log, so it reaches further back than every other chart on this tab."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <lvc:CartesianChart Series="{Binding WerHistorySeries}" XAxes="{Binding WerHistoryXAxes}" YAxes="{Binding WerHistoryYAxes}"
                                                 Height="140" TooltipPosition="Top" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- Round 10, #66: repeated application crashes grouped by faulting module, with a
                         count - see FaultingModuleSummary's remarks. A different lens on the same events
                         the flat grid below shows, purpose-built for "which module keeps crashing" instead
                         of scrolling a dozen near-identical rows. Collapsed entirely when nothing has a
                         faulting module (the common case for a quiet system). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CrashesByModule.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Crashes by faulting module" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding CrashesByModule}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Module}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 17, items 50/51/52/56/57: structured Application Error (1000) crashes -
                         leaderboard first ("which app is actually broken on this PC"), then the raw grid
                         with a plain-English exception reason and the foreign-module/injection-surface
                         flags. Collapsed entirely when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ApplicationCrashes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Application crashes" Style="{StaticResource CardTitle}" Margin="0" />
                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontStrong}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                    <Run Text="{Binding ApplicationCrashes.Count, Mode=OneWay}" /><Run Text=" in last 30 days" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Application Error (1000) events, fully parsed - reason is the exception code decoded to plain English; a foreign module (outside the app's own install directory, and not a system DLL) is flagged with its vendor and, when it matches a known injection surface on this machine, why."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                            <TextBlock Text="Which app is actually broken" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding AppCrashLeaderboard}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ExecutableName}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="First " /><Run Text="{Binding FirstSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · Last " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding DistinctFaultingModules, Mode=OneWay}" /><Run Text=" distinct module(s)" />
                                                    <Run Text=" · Mean gap " /><Run Text="{Binding MeanTimeBetweenCrashesText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DataGrid ItemsSource="{Binding ApplicationCrashes}" Height="260" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Message}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsForeignModule}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Application" Binding="{Binding AppName}" Width="1.3*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="100" />
                                    <DataGridTextColumn Header="Faulting module" Binding="{Binding ModName}" Width="1.3*" />
                                    <DataGridTextColumn Header="Reason (exception code)" Binding="{Binding ExceptionCodeText}" Width="1.6*" />
                                    <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="90" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                                    <!-- Item 69: generalizes item 33's original 0x9F-only sleep/resume
                                         cross-reference to every crash row. -->
                                    <DataGridTemplateColumn Header="Sleep/resume?" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Near sleep/resume" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                                               ToolTip="A Kernel-Power sleep/resume event (42/107/187) was recorded within a few minutes of this crash." />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Foreign module?" Width="1.6*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource WarningBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsForeignModule}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding ForeignModuleReason, Mode=OneWay}" />
                                                    <Run Text=" (" /><Run Text="{Binding ModuleSignatureStatus, Mode=OneWay}" />
                                                    <Run Text=", " /><Run Text="{Binding ModuleVendor, Mode=OneWay, TargetNullValue='vendor unknown'}" /><Run Text=")" />
                                                    <LineBreak />
                                                    <Run Text="{Binding InjectionSurfaceNote, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #161/#162: WER crash reports, grouped by bucket signature (BucketId when the report
                         carries one, otherwise app+module+exception-code) so repeat crashes of the same
                         shape read as one row with a count. Collapsed when no reports were found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CrashReportBuckets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Crash reports (Windows Error Reporting)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Parsed from ReportQueue/ReportArchive's Report.wer files, clustered by bucket signature, newest first." Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CrashReportBuckets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WerCrashBucket}">
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding SignatureText}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource SubStat}">
                                                        <Run Text="First " /><Run Text="{Binding FirstSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                        <Run Text=" · Last " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #163: top crashing applications - WER report counts combined with Application-log
                         "Application Error" 1000 entries, ranked by total crash count. Collapsed when empty. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TopCrashingApplications.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Top crashing applications" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="WER reports + Application-log crash entries (event 1000), last 30 days." Style="{StaticResource SubStat}" Margin="0,-4,0,10" />
                            <ItemsControl ItemsSource="{Binding TopCrashingApplications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TopCrashingApplication}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding AppName}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="Most common module: " /><Run Text="{Binding MostCommonModule, TargetNullValue=Unknown, Mode=OneWay}" />
                                                    <Run Text=" · Last " /><Run Text="{Binding LastCrashTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding CrashCount, Mode=OneWay}" /><Run Text="×" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #137: unified incident timeline - event-log records, minidumps, boot/shutdown
                         markers, and (#161) WER crash reports merged into one time-ordered stream,
                         per-source colour coding, a filter chip per source. Driver/update/service-install
                         events (items 169-183) aren't wired into the merge yet - see TimelineSource's remarks. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Unified incident timeline" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap">
                                <Run Text="Event log, minidump, and boot/shutdown data merged into one time-ordered stream. " />
                                <Run Text="Click a crash-flagged entry to drill into a +/-5 minute window across every channel, or see what changed in the 7 days before it." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TimelineFilters}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimelineFilterChip}">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Margin="0,0,14,4" FontSize="{StaticResource FontBody}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Timeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TimelineEntry}">
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="4" Margin="0,3,10,0" VerticalAlignment="Top"
                                                         Background="{Binding Source, Converter={StaticResource TimelineSourceToBrushConverter}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding SourceLabel, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" MaxHeight="34"
                                                                TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCrash}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <!-- #138: crash-window drill-down -->
                                                        <Button Content="+/-5 min, all channels" FontSize="{StaticResource FontCaption}" Padding="6,2" Margin="0,0,6,0"
                                                                 Command="{Binding DataContext.DrillDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}" />
                                                        <!-- #139: what changed before this crash -->
                                                        <Button Content="What changed before this?" FontSize="{StaticResource FontCaption}" Padding="6,2"
                                                                 Command="{Binding DataContext.FindChangesBeforeCrashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 CommandParameter="{Binding}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No timeline entries yet — click Refresh above." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Timeline.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #138: crash-window drill-down results - only shown once a crash entry above has
                         actually been clicked (gated on the status text, not the row count, so a
                         genuinely-empty window still shows "0 events found" instead of vanishing). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                             Visibility="{Binding CrashWindowStatusText, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Crash window (+/- 5 minutes, all levels)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding CrashWindowStatusText}" Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding CrashWindowResults}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}" Width="130" />
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="2*" />
                                    <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #139: attribute a crash to the change that preceded it - same "gated on status
                         text" visibility rule as #138 above. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                             Visibility="{Binding ChangeAttributionStatusText, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Changes shortly before this crash" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap">
                                <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                                <Run Text="driver installs, update installs, and new services found in the 7 days before the crash. Correlation, not proof of cause." />
                            </TextBlock>
                            <TextBlock Text="{Binding ChangeAttributionStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ChangesBeforeCrash}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PreCrashChange}">
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Provider, Mode=OneWay}" />
                                                    <Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" (" /><Run Text="{Binding TimeBeforeCrash.Days, Mode=OneWay}" /><Run Text="d before the crash)" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding SampleMessage}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" MaxHeight="34"
                                                            TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Dumps &amp; capture">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #3: minidump files, timestamp + best-effort bugcheck code correlated from a
                         nearby Kernel-Power 41 event - see EventLogService.ReadMinidumps. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Minidumps" Style="{StaticResource CardTitle}" />

                            <!-- Item 7: volmgr 161/162 "dump creation failed" - explains "I had a BSOD but
                                 there's no dump file". -->
                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DumpFailures.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                    <Run Text="{Binding DumpFailures.Count, Mode=OneWay}" /><Run Text=" dump-creation failure(s) (volmgr) in the last 30 days — Windows tried to write a crash dump and failed, which explains a BSOD with no matching minidump file." />
                                </TextBlock>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Minidumps}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,6" IsExpanded="False">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontSize="{StaticResource FontStrong}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                        <!-- #65: bugcheck-code-to-plain-English lookup, instead of a bare hex code. -->
                                                        <Run Text=" · " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <!-- #191: all four bugcheck parameters + the authoritative dump path, when a
                                                         Microsoft-Windows-WER-SystemErrorReporting 1001 event supplied richer detail
                                                         than the event-41 code alone. -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="{StaticResource FontCaption}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                Visibility="{Binding BugcheckDetail, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <Run Text="Parameters: " /><Run Text="{Binding BugcheckDetail.Parameter1, Mode=OneWay}" /><Run Text=", " />
                                                        <Run Text="{Binding BugcheckDetail.Parameter2, Mode=OneWay}" /><Run Text=", " />
                                                        <Run Text="{Binding BugcheckDetail.Parameter3, Mode=OneWay}" /><Run Text=", " />
                                                        <Run Text="{Binding BugcheckDetail.Parameter4, Mode=OneWay}" />
                                                        <Run Text=" · Dump: " />
                                                        <Run Text="{Binding BugcheckDetail.DumpFilePath, TargetNullValue='(path unknown)', Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="0,6,0,0">
                                                <!-- Round 15, item 29: per-code labelled parameters (with an inline NTSTATUS
                                                     decode, item 30, when this code documents a parameter as a status/
                                                     exception code) - replaces the old flat hex "Parameters: ..." row. -->
                                                <ItemsControl ItemsSource="{Binding Decoded.ParameterRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                                                    <Run Text="Source: " /><Run Text="{Binding IsAuthoritative, Converter={StaticResource BugcheckSourceToTextConverter}, Mode=OneWay}" />
                                                </TextBlock>

                                                <!-- Round 15, item 32: DPC_WATCHDOG_VIOLATION (0x133) subtype line - only
                                                     present for that one code. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.DpcWatchdogSubtypeText}"
                                                           Visibility="{Binding Decoded.DpcWatchdogSubtypeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 33: DRIVER_POWER_STATE_FAILURE (0x9F) subcode + the
                                                     sleep/resume cross-reference. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.DriverPowerStateSubcodeText}"
                                                           Visibility="{Binding Decoded.DriverPowerStateSubcodeText, Converter={StaticResource NullToVisibilityConverter}}" />
                                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="8,2"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Happened during sleep/resume" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                                </Border>

                                                <!-- Round 15, item 36: 0x124's joined WHEA-Logger record. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding WheaJoinText, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="Matching hardware error (WHEA): " /><Run Text="{Binding WheaJoinText, Mode=OneWay}" />
                                                </TextBlock>

                                                <!-- Round 15, item 35: pool-tag decode for 0xC2/0xC5. -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                                               Text="{Binding Decoded.PoolTagText}"
                                                               Visibility="{Binding Decoded.PoolTagText, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <!-- Round 19, item 88: jump straight to Special Pool for this crash's own tag. -->
                                                    <Button Grid.Column="1" Content="Apply Special Pool" Padding="6,2" FontSize="{StaticResource FontBody}" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ApplySpecialPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Decoded.PoolTagRaw}"
                                                            Visibility="{Binding Decoded.PoolTagRaw, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Grid>

                                                <!-- Round 19, item 85: Verifier violation subcode decode for 0xC4/0xC9/0xE6. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.VerifierViolationText}"
                                                           Visibility="{Binding Decoded.VerifierViolationText, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 37: fault-address classification for 0xA/0xD1/0x50. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.FaultAddressClassification}"
                                                           Visibility="{Binding Decoded.FaultAddressClassification, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 31: curated "what usually causes this" note - explicitly
                                                     non-authoritative, per CLAUDE.md's "quick flag, not a verdict". -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Visibility="{Binding Decoded.Guidance, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="What usually causes this (not a diagnosis): " FontWeight="SemiBold" /><Run Text="{Binding Decoded.Guidance, Mode=OneWay}" />
                                                </TextBlock>

                                                <!-- Item 2: WER "full crash record" - the joined ReportArchive folder. -->
                                                <StackPanel Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="{Binding WerReport, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Full crash record (WER)" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Margin="0,4,0,2" />
                                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                        <Run Text="OS version: " /><Run Text="{Binding WerReport.OsVersion, Mode=OneWay, TargetNullValue=Unknown}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                        <Run Text="Secure Boot state: " /><Run Text="{Binding WerReport.SecureBootState, Mode=OneWay, TargetNullValue=Unknown}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                        <Run Text="Attached files: " /><Run Text="{Binding WerReport.AttachedFiles, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No minidump files found.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Minidumps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Round 14, item 26: Minidump folder housekeeping footer strip - total
                                 size, oldest/newest, delete-older-than, and the live registry
                                 MinidumpsCount value. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                        <Run Text="Folder: " /><Run Text="{Binding Housekeeping.FileCount, Mode=OneWay}" /><Run Text=" file(s), " />
                                        <Run Text="{Binding Housekeeping.TotalSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" total. Oldest: " /><Run Text="{Binding Housekeeping.OldestFile, StringFormat={}{0:g}, TargetNullValue='—', Mode=OneWay}" />
                                        <Run Text=" · Newest: " /><Run Text="{Binding Housekeeping.NewestFile, StringFormat={}{0:g}, TargetNullValue='—', Mode=OneWay}" />
                                    </TextBlock>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Delete older than" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Width="48" Text="{Binding DeleteOlderThanDays, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="days" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,10,0" />
                                        <Button Grid.Column="4" Content="Delete" Command="{Binding DeleteOldDumpsCommand}" Padding="10,4" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="5" Text="MinidumpsCount" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="6" Width="48" Text="{Binding MinidumpsCountInput, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Button Content="Save MinidumpsCount" Command="{Binding SaveMinidumpsCountCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding HousekeepingStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Round 14, items 13-19: binary-parsed dump rows - richer, event-log-independent
                         data straight from each dump's own DUMP_HEADER64/MINIDUMP header, per
                         MinidumpParserService. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dump analysis (binary parse)" Style="{StaticResource CardTitle}" Margin="0" />
                                <!-- Round 16, item 49: multi-select count, for the later support-bundle export chunk (#100). -->
                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedDumpCount, Mode=OneWay}" /><Run Text=" selected" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Read directly from each dump file's own header/streams, independent of the event log above. Blame is address-range matching against the loaded-module list - a quick flag, not a verdict, not a symbolised stack."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding DumpRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,8" IsExpanded="False">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Round 16, item 49: multi-select, for the later support-bundle export chunk (#100). -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                              ToolTip="Select for a future support-bundle export"
                                                              PreviewMouseDown="StopExpanderToggle" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Parsed.FileName}" FontSize="{StaticResource FontStrong}" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="2" Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Parsed.IsIncomplete}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Incomplete — not analysable" Foreground="White" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="Format: " /><Run Text="{Binding Parsed.Format, Mode=OneWay}" />
                                                    <Run Text=" · Type: " /><Run Text="{Binding Parsed.DumpTypeText, Mode=OneWay}" />
                                                    <Run Text=" · Size: " /><Run Text="{Binding Parsed.SizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <Run Text="{Binding IssueText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <Run Text="OS: " /><Run Text="{Binding Parsed.OsVersion, TargetNullValue='Unknown', Mode=OneWay}" />
                                                    <Run Text=" · Machine: " /><Run Text="{Binding Parsed.MachineType, TargetNullValue='Unknown', Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <Run Text="Bugcheck (from binary parse): " /><Run Text="{Binding Parsed.BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, TargetNullValue='not found', Mode=OneWay}" />
                                                </TextBlock>

                                                <!-- Round 15, item 29: per-code labelled parameters (item 30's NTSTATUS
                                                     decode inline where applicable) - replaces the old flat "Parameters: ..."
                                                     hex row. -->
                                                <ItemsControl ItemsSource="{Binding Decoded.ParameterRows}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Round 15, item 32: DPC_WATCHDOG_VIOLATION (0x133) subtype line. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.DpcWatchdogSubtypeText}"
                                                           Visibility="{Binding Decoded.DpcWatchdogSubtypeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 33: DRIVER_POWER_STATE_FAILURE (0x9F) subcode line. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.DriverPowerStateSubcodeText}"
                                                           Visibility="{Binding Decoded.DriverPowerStateSubcodeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 35: pool-tag decode for 0xC2/0xC5. -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                                               Text="{Binding Decoded.PoolTagText}"
                                                               Visibility="{Binding Decoded.PoolTagText, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <!-- Round 19, item 88: jump straight to Special Pool for this crash's own tag. -->
                                                    <Button Grid.Column="1" Content="Apply Special Pool" Padding="6,2" FontSize="{StaticResource FontBody}" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.ApplySpecialPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Decoded.PoolTagRaw}"
                                                            Visibility="{Binding Decoded.PoolTagRaw, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Grid>

                                                <!-- Round 19, item 85: Verifier violation subcode decode for 0xC4/0xC9/0xE6. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.VerifierViolationText}"
                                                           Visibility="{Binding Decoded.VerifierViolationText, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 37: fault-address classification for 0xA/0xD1/0x50. -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Text="{Binding Decoded.FaultAddressClassification}"
                                                           Visibility="{Binding Decoded.FaultAddressClassification, Converter={StaticResource NullToVisibilityConverter}}" />

                                                <!-- Round 15, item 31: curated "what usually causes this" note - explicitly
                                                     non-authoritative, per CLAUDE.md's "quick flag, not a verdict". -->
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding Decoded.Guidance, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="What usually causes this (not a diagnosis): " FontWeight="SemiBold" /><Run Text="{Binding Decoded.Guidance, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <Run Text="Contents: " /><Run Text="{Binding ContentsText, Mode=OneWay}" />
                                                    <Run Text=" (" /><Run Text="{Binding ModuleCountText, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>

                                                <!-- Item 17/18: blame + dossier. -->
                                                <StackPanel Margin="0,6,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="{Binding Parsed.BlamedModule, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold">
                                                        <Run Text="Probably blamed: " /><Run Text="{Binding Parsed.BlamedModule, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="Quick flag, not a verdict — this is address-range matching, not a symbolised stack."
                                                               Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                        <Run Text="Company: " /><Run Text="{Binding Parsed.BlamedModuleDossier.CompanyName, TargetNullValue='Unknown', Mode=OneWay}" />
                                                        <Run Text=" · Product: " /><Run Text="{Binding Parsed.BlamedModuleDossier.ProductName, TargetNullValue='Unknown', Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                        <Run Text="Version: " /><Run Text="{Binding Parsed.BlamedModuleDossier.FileVersion, TargetNullValue='Unknown', Mode=OneWay}" />
                                                        <Run Text=" · Date: " /><Run Text="{Binding Parsed.BlamedModuleDossier.FileDate, StringFormat={}{0:d}, TargetNullValue='Unknown', Mode=OneWay}" />
                                                        <Run Text=" · Signature: " /><Run Text="{Binding Parsed.BlamedModuleDossier.SignatureStatus, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Item 23/24: debugger actions + cached !analyze -v result. -->
                                                <StackPanel Margin="0,10,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Analyse (!analyze -v)" Command="{Binding AnalyzeCommand}" Padding="10,4" Margin="0,0,8,0"
                                                                Visibility="{Binding CanUseDebugger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Button Content="Open in WinDbg" Command="{Binding OpenInWinDbgCommand}" Padding="10,4" Margin="0,0,8,0"
                                                                Visibility="{Binding CanUseDebugger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <!-- Round 16, item 45: copyable crash signature (bugcheck + params + OS build) + a
                                                             one-click web search for it. -->
                                                        <Button Content="Copy crash signature" Command="{Binding CopySignatureCommand}" Padding="10,4" Margin="0,0,8,0" />
                                                        <Button Content="Web search" Command="{Binding OpenWebSearchCommand}" Padding="10,4" />
                                                        <TextBlock Text="Analysing..." VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}"
                                                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ActionStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding DebuggerHintText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanUseDebugger}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding AnalyzeError}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                                    <StackPanel Margin="0,6,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="{Binding Analysis, Converter={StaticResource NullToVisibilityConverter}}" />
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                            <Run Text="MODULE_NAME: " /><Run Text="{Binding Analysis.ModuleName, TargetNullValue='(not found)', Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                            <Run Text="IMAGE_NAME: " /><Run Text="{Binding Analysis.ImageName, TargetNullValue='(not found)', Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                            <Run Text="FAILURE_BUCKET_ID: " /><Run Text="{Binding Analysis.FailureBucketId, TargetNullValue='(not found)', Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                            <Run Text="PROCESS_NAME: " /><Run Text="{Binding Analysis.ProcessName, TargetNullValue='(not found)', Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Expander Header="STACK_TEXT" IsExpanded="False" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Analysis.StackText}" FontFamily="Consolas" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </Expander>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No minidump files to parse.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DumpRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Round 14, item 19: third-party drivers present in every parseable dump's module
                         list - the strongest cheap cross-dump signal available without a real debugger. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CommonDrivers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Drivers present in every crash" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Non-Microsoft drivers found in the module list of every dump this app could parse. A cheap, strong lead - not proof."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CommonDrivers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="in " /><Run Text="{Binding DumpCount, Mode=OneWay}" /><Run Text=" dump(s)" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 14, item 20: MEMORY.DMP - the kernel/complete dump, never shown before now. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MEMORY.DMP" Style="{StaticResource CardTitle}" />
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemoryDump.Exists}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="{Binding MemoryDump.FilePath, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,8">
                                    <Run Text="{Binding MemoryDump.SizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding MemoryDump.Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                    <Run Text=" · Bugcheck: " /><Run Text="{Binding MemoryDump.Parsed.BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, TargetNullValue='not found', Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button Content="Open folder" Command="{Binding OpenMemoryDumpFolderCommand}" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Copy to..." Command="{Binding CopyMemoryDumpCommand}" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Delete" Command="{Binding DeleteMemoryDumpCommand}" Padding="10,4" />
                                </StackPanel>
                                <TextBlock Text="{Binding MemoryDumpStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="No MEMORY.DMP found - this machine isn't configured for a Complete/Kernel dump (see CrashDumpEnabled in the Minidump folder's housekeeping above, or the crash-analysis settings).">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Margin" Value="0,4,0,0" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemoryDump.Exists}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Round 14, items 21/22: live kernel events (watchdog dumps with no bluescreen). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveKernelReports.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Live kernel events (no BSOD)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Watchdog-triggered live kernel dumps (DPCWATCHDOG, USBHUB3, NDIS, video-engine timeouts, ...) that never caused a bluescreen or reboot."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding LiveKernelReports}" Height="180" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.5*" />
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                                    <DataGridTextColumn Header="WER code" Binding="{Binding WerDescription}" Width="2.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- Round 16, item 41: "is Windows even collecting crash data" warning strip - a
                         disabled/blocked WER silently starves this whole card, plus the Minidumps card's
                         WER join, of data, so this is called out up front rather than just an empty list. -->
                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WerStatus.LooksDisabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                       Text="Windows Error Reporting looks disabled or blocked - every WER-based feature on this tab (this card, plus the Minidumps card's Full crash record) is silently starved of data until it's re-enabled." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Re-enable Windows Error Reporting" Command="{Binding EnableWerCommand}" Padding="10,4" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding WerStatusActionText}" VerticalAlignment="Center" Style="{StaticResource SubStat}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Round 16, item 42: LocalDumps "Capture settings" - one of the highest-value crash
                         tools Windows has, off by default and hidden today. Global by default (blank
                         target), or for one named executable. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Capture settings (per-app crash dumps)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Configures HKLM\...\Windows Error Reporting\LocalDumps so Windows writes a full user-mode dump every time the chosen app (or every app, if left blank) crashes."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <TextBlock Text="Target executable (blank = every app, global default)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <TextBox Width="220" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding LocalDumpsTargetExe, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Dump folder" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding LocalDumpsFolder, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dump count" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Width="48" Text="{Binding LocalDumpsCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="2" Text="Dump type" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <!-- Index 0/1/2 matches LocalDumpsType/DumpType's own Custom/Mini/Full values 1:1 -
                                     see StabilityViewModel.LocalDumpsType's remarks. -->
                                <ComboBox Grid.Column="3" Width="140" SelectedIndex="{Binding LocalDumpsType}">
                                    <ComboBoxItem Content="Custom dump" />
                                    <ComboBoxItem Content="Mini dump" />
                                    <ComboBoxItem Content="Full dump" />
                                </ComboBox>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Load current" Command="{Binding LoadLocalDumpsConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveLocalDumpsConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Remove override" Command="{Binding ClearLocalDumpsConfigCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding LocalDumpsStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />

                            <!-- Round 17, item 61: SilentProcessExit - the LocalDumps section above only
                                 ever triggers from an actual reported fault; this covers a process that
                                 disappears silently (no error raised at all), for the same target
                                 executable entered above. -->
                            <Separator Margin="0,12,0,12" Opacity="0.3" />
                            <TextBlock Text="Silent process exit monitoring" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Text="Configures HKLM\...\SilentProcessExit\&lt;exe&gt; so Windows captures a dump (or launches a monitor process) when the target executable above disappears without ever raising an error - the gap LocalDumps alone doesn't cover. Needs a target executable (no global default)."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Reporting mode" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="1" Width="260" SelectedValuePath="Tag" SelectedValue="{Binding SilentExitReportingMode}">
                                    <ComboBoxItem Content="1 — capture a dump" Tag="1" />
                                    <ComboBoxItem Content="2 — launch a monitor process" Tag="2" />
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Local dump folder (used with mode 1)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding SilentExitLocalDumpFolder, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Monitor process (used with mode 2, optional)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Text="{Binding SilentExitMonitorProcess, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Load current" Command="{Binding LoadSilentExitConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveSilentExitConfigCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Remove" Command="{Binding ClearSilentExitConfigCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding SilentExitStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />

                            <!-- Round 17 chunk 64-70, item 70: forced-crash toggles - for a machine that
                                 hard-hangs with no dump at all, turning an undiagnosable freeze into a
                                 real one on demand beats never getting a dump. Clearly labelled advanced/
                                 destructive, matching PurgeWerReportsCommand's own confirmation pattern. -->
                            <Separator Margin="0,12,0,12" Opacity="0.3" />
                            <TextBlock Text="Advanced: force a crash on demand" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Text="For a machine that hard-hangs with no dump at all, Windows offers two keyboard/hardware-initiated ways to deliberately bluescreen it instead, turning an undiagnosable freeze into a real dump the next time it happens."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="Enabling either toggle below means Ctrl+ScrollLock×2 (or a hardware NMI signal) will deliberately bluescreen this machine - a real, disruptive crash, not a simulation. Only enable one if you actually intend to reproduce a freeze this way."
                                           Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{Binding ForcedCrashConfigText}" Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                            <TextBlock Text="Ctrl+ScrollLock×2 crash (CrashOnCtrlScroll)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Enable" Command="{Binding EnableCrashOnCtrlScrollCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Disable" Command="{Binding DisableCrashOnCtrlScrollCommand}" Padding="10,4" />
                            </StackPanel>

                            <TextBlock Text="NMI crash dump (NMICrashDump)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Enable" Command="{Binding EnableNmiCrashDumpCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Disable" Command="{Binding DisableNmiCrashDumpCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Refresh status" Command="{Binding RefreshForcedCrashStatusCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding ForcedCrashStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- Round 18, items 71-79: "Crash dump configuration" - a sibling card to "Capture
                         settings" above; that card configures LocalDumps/SilentProcessExit (per-app
                         user-mode dumps), this one covers the system-wide CrashControl configuration that
                         decides whether a kernel bugcheck (BSOD) itself leaves a readable dump at all -
                         see CrashDumpConfigService's own remarks. Item 80's pass/fail summary of
                         everything on this card lives at the top of the tab. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Crash dump configuration" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="HKLM\...\CrashControl decides whether the next BSOD leaves a dump behind at all, and what kind - read out here in plain English, cross-checked against the page file that has to be large enough to actually hold it."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <!-- Item 71: plain-English CrashDumpEnabled/DumpFile/MinidumpDir/Overwrite/
                                 AutoReboot/LogEvent/AlwaysKeepMemoryDump/DedicatedDumpFile read-out. -->
                            <ItemsControl ItemsSource="{Binding CrashDumpConfig.Fields}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="270" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Items 72/73: dump type vs. page file. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,0,0,10" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Page file vs. dump type" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" FontWeight="SemiBold" />

                                    <!-- Item 73: page file disabled entirely - the "I have 64 GB of RAM so
                                         I turned it off" case, which silently disables crash dumps. -->
                                    <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CrashDumpConfig.PageFileDisabled}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="No page file is configured at all - crash dumps are silently disabled. The configured dump type needs roughly " />
                                            <Run Text="{Binding CrashDumpConfig.RequiredSizeForConfiguredTypeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                            <Run Text=" of page file (or a dedicated dump file below, on a volume with room)." />
                                        </TextBlock>
                                    </Border>

                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SubStat}" Margin="0,0,0,6">
                                        <Run Text="Total RAM: " /><Run Text="{Binding CrashDumpConfig.TotalRamBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" · Complete dump needs ~" /><Run Text="{Binding CrashDumpConfig.RequiredSizeForCompleteBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" · Kernel/Automatic dump needs ~" /><Run Text="{Binding CrashDumpConfig.RequiredSizeForKernelBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" (both approximate - Microsoft doesn't publish an exact formula)." />
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding CrashDumpConfig.PageFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Items 74/75: dedicated dump file setup + free-space health on whichever
                                 volume the next crash would actually try to write to. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Dedicated dump file &amp; target free space" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" FontWeight="SemiBold" />
                                    <TextBlock Text="DedicatedDumpFile/DumpFileSize point the dump at a different (larger) volume instead of enlarging the system page file - useful when the system volume genuinely doesn't have room."
                                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                    <!-- Item 75: red/amber/green free-space line. -->
                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontStrong}" Margin="0,0,0,8">
                                        <Run Text="Dump target: " /><Run Text="{Binding CrashDumpConfig.DumpTargetPath, TargetNullValue='Unknown', Mode=OneWay}" FontFamily="Consolas" />
                                        <LineBreak />
                                        <Run Text="{Binding CrashDumpConfig.DumpTargetHealthText, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CrashDumpConfig.DumpTargetHealthLevel}" Value="Green">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CrashDumpConfig.DumpTargetHealthLevel}" Value="Amber">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CrashDumpConfig.DumpTargetHealthLevel}" Value="Red">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>

                                    <TextBlock Text="New dedicated dump file path (e.g. D:\MEMORY.DMP, on a volume with room)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" />
                                    <TextBox Width="340" HorizontalAlignment="Left" Margin="0,0,0,8"
                                             Text="{Binding DedicatedDumpFilePath, UpdateSourceTrigger=PropertyChanged}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Max size (MB, 0 = let Windows decide)" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                        <TextBox Grid.Column="1" Width="80" Text="{Binding DedicatedDumpFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Set dedicated dump file" Command="{Binding SetDedicatedDumpFileCommand}" Padding="10,4" Margin="0,0,8,0" />
                                        <Button Content="Clear" Command="{Binding ClearDedicatedDumpFileCommand}" Padding="10,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Item 76: auto-reboot toggle. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Auto-reboot after a crash" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                                    <TextBlock Text="When on, the machine restarts immediately after a bugcheck, before the stop code (or QR code) can be read. Turning it off is temporary diagnostic practice, not a permanent setting."
                                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Enable" Command="{Binding EnableAutoRebootCommand}" Padding="10,4" Margin="0,0,8,0" />
                                        <Button Content="Disable" Command="{Binding DisableAutoRebootCommand}" Style="{StaticResource DangerButton}" Padding="10,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Item 78: Fast Startup / HiberbootEnabled. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Fast Startup" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                                    <TextBlock Text="When on (HiberbootEnabled), a normal &quot;shut down&quot; is really a hibernate - driver state persists across the reboot, so a driver fault can survive a restart that &quot;should&quot; have cleared it, and invalidates most &quot;did rebooting fix it&quot; reasoning."
                                               Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Enable" Command="{Binding EnableFastStartupCommand}" Padding="10,4" Margin="0,0,8,0" />
                                        <Button Content="Disable" Command="{Binding DisableFastStartupCommand}" Style="{StaticResource DangerButton}" Padding="10,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Item 79: hibernation + BitLocker interactions - informational only. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Hibernation &amp; encryption interactions" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CrashDumpConfig.HibernationStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding CrashDumpConfig.DumpVolumeBitLockerStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap"
                                               Visibility="{Binding CrashDumpConfig.DumpVolumeBitLockerStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- Item 77: one-click "make this PC capture crashes properly". -->
                            <TextBlock Text="Recommended fix" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,4" FontWeight="SemiBold" />
                            <TextBlock Text="Sets the dump type to Automatic memory dump, sets MinidumpsCount to a sane 10, and switches the page file to system-managed so Windows sizes it itself - the same three things a manual walkthrough would ask for."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Button Content="Make this PC capture crashes properly" Command="{Binding ApplyRecommendedCrashDumpConfigCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding CrashDumpConfigStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- Round 19, items 81/82/83/84/86: "Driver Verifier" card - live status (81), a
                         prominent "still enabled" warning + one-click reset (82), how long it's been on
                         (86), and a guided multi-step wizard for turning it on safely (83/84). See
                         DriverVerifierService/VerifierEnableHistoryService for the underlying reads/writes. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifierStatus.IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Driver Verifier" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Verifier makes Windows scrutinize a chosen driver's every pool allocation, IRQL, IRP and DMA call, catching a misbehaving driver at the exact moment it breaks a rule instead of some random time later - the single most effective way to catch a driver bug, at the cost of noticeably slower/heavier operation while it's on."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <!-- Item 81. -->
                            <TextBlock Text="{Binding VerifierStatus.StatusSummaryText}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding VerifierStatus.ErrorText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding VerifierStatus.ErrorText, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,4" />

                            <TextBlock Text="Persistent settings for the next reboot:" Style="{StaticResource SubStat}" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,0,0,8">
                                <Run Text="Drivers: " /><Run Text="{Binding VerifierStatus.PersistentDriverNames, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                                <LineBreak /><Run Text="Flags: " /><Run Text="{Binding VerifierStatus.PersistentFlagsDescription, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                            </TextBlock>

                            <!-- Item 86. -->
                            <TextBlock Text="{Binding VerifierEnabledDurationText}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" Margin="0,0,0,8"
                                       Visibility="{Binding VerifierEnabledDurationText, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VerifierNagDue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Item 86: "a configurable number of days or reboots" - the two nag
                                 thresholds, editable inline. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nag after" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Width="40" Text="{Binding NagAfterDaysInput, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="day(s) or" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,6,0" />
                                <TextBox Grid.Column="3" Width="40" Text="{Binding NagAfterRebootsInput, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="4" Text="reboot(s)" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,10,0" />
                                <Button Grid.Column="5" Content="Save" Command="{Binding SaveVerifierNagSettingsCommand}" Padding="8,2" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Refresh status" Command="{Binding RefreshVerifierStatusCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Guided setup: enable Verifier safely..." Command="{Binding OpenWizardCommand}" Padding="10,4" />
                            </StackPanel>

                            <!-- Item 82: prominent banner + one-click reset, only while actually running. -->
                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VerifierStatus.IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="Driver Verifier is currently enabled and slowing this machine down. Left on after a diagnostic session is done, it's easy to forget about - reset it below once you're finished." />
                                    <Button Content="Reset Driver Verifier" Command="{Binding ResetVerifierCommand}" Style="{StaticResource DangerButton}" Padding="10,4" HorizontalAlignment="Left" />
                                    <TextBlock Text="A reboot is needed for the reset to fully take effect." Style="{StaticResource SubStat}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding VerifierResetStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4" />

                            <!-- Items 83/84: the guided wizard itself, expanded in-card. -->
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12"
                                    Visibility="{Binding WizardOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Guided Verifier setup" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CloseWizardCommand}" Padding="10,4" />
                                    </Grid>

                                    <!-- Step 1: restore point. -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 1 of 4 - Create a restore point" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                                        <TextBlock Text="Enabling Driver Verifier is genuinely capable of making the machine unbootable if the driver being checked turns out to be badly broken. A System Restore point gives you a way back before anything changes."
                                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Content="Create restore point" Command="{Binding CreateRestorePointCommand}" Padding="10,4" Margin="0,0,8,0" />
                                            <Button Content="Next: choose drivers &gt;" Command="{Binding GoToDriverStepCommand}" Padding="10,4" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RestorePointStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Step 2: driver selection. -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 2 of 4 - Choose drivers to verify" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                                        <TextBlock Text="Only non-Microsoft, currently loaded drivers are listed - verifying Windows' own in-box drivers is rarely useful and adds a lot of overhead for little benefit."
                                                   Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding WizardDriverStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding WizardDriverCandidates}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3,0,3">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="{StaticResource FontBody}" />
                                                            <TextBlock Text="{Binding VendorText}" Style="{StaticResource SubStat}" FontSize="{StaticResource FontCaption}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="&lt; Back" Command="{Binding BackWizardStepCommand}" CommandParameter="1" Padding="10,4" Margin="0,0,8,0" />
                                            <Button Content="Next: Safe Mode recovery &gt;" Command="{Binding GoToSafeModeStepCommand}" Padding="10,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Step 3: Safe Mode recovery guidance - shown BEFORE enabling, per this
                                         chunk's own instruction that the recovery guidance is the point. -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 3 of 4 - If this stops the machine from booting" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                                        <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                                <Run Text="Read this before continuing - a badly-behaved driver under Verifier can bugcheck on every boot, before this app is reachable again." FontWeight="SemiBold" />
                                                <LineBreak /><LineBreak />
                                                <Run Text="1. If Windows won't start normally, force it into recovery: hold the power button to interrupt boot 2-3 times in a row, or boot from Windows installation media and choose &quot;Repair your computer&quot;." />
                                                <LineBreak />
                                                <Run Text="2. From the recovery menu: Troubleshoot -&gt; Advanced options -&gt; Startup Settings -&gt; Restart, then press 4 (or F4) for Safe Mode." />
                                                <LineBreak />
                                                <Run Text="3. In Safe Mode (or a recovery Command Prompt), run: verifier /reset  -  this clears every Verifier setting; reboot normally afterward." />
                                                <LineBreak />
                                                <Run Text="4. If even Safe Mode won't start, use the System Restore point from step 1 instead (Troubleshoot -&gt; Advanced options -&gt; System Restore)." />
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&lt; Back" Command="{Binding BackWizardStepCommand}" CommandParameter="2" Padding="10,4" Margin="0,0,8,0" />
                                            <Button Content="Next: confirm &gt;" Command="{Binding GoToConfirmStepCommand}" Padding="10,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Step 4: confirm + apply. -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WizardStep}" Value="4">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 4 of 4 - Confirm and apply" FontWeight="SemiBold" FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" />
                                        <TextBlock Text="Selected drivers:" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,2" />
                                        <ItemsControl ItemsSource="{Binding WizardDriverCandidates}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontSize="{StaticResource FontBody}"
                                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Item 84: apply-without-restarting option. -->
                                        <CheckBox Content="Apply without restarting (volatile - starts verifying immediately, no reboot)" IsChecked="{Binding WizardApplyVolatile}" Margin="0,0,0,8" />

                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WizardApplyVolatile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Also change one flag immediately (optional - Special Pool itself can't change without a reboot, but these can):"
                                                       Style="{StaticResource SubStat}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <ComboBox ItemsSource="{Binding VolatileFlagOptionLabels}" SelectedIndex="{Binding WizardVolatileFlagIndex}" Width="340" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <TextBlock Text="Standard mode applies Special Pool, Force IRQL Checking, Pool Tracking, I/O Verification, Deadlock Detection, DMA Verification and Microsoft's other recommended checks - takes effect after a reboot."
                                                   TextWrapping="Wrap" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WizardApplyVolatile}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="&lt; Back" Command="{Binding BackWizardStepCommand}" CommandParameter="3" Padding="10,4" Margin="0,0,8,0" />
                                            <Button Content="Enable Driver Verifier" Command="{Binding ApplyWizardCommand}" Style="{StaticResource DangerButton}" Padding="10,4" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding WizardApplyStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Round 19, item 87: on-demand kernel pool-by-tag monitor, with item 88's targeted
                         Special Pool follow-up per row. Never a timer - see PoolTagMonitorService's own
                         remarks on why this is explicit-button-gated. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Kernel pool by tag" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Samples every kernel pool tag's allocation counts on demand and, from the second sample onward, shows how much each tag's usage has grown since the first sample this session - sorted by nonpaged growth, since a nonpaged pool leak is a slow march toward a PFN_LIST_CORRUPT (0x4E) or DRIVER_LEFT_LOCKED_PAGES_IN_PROCESS-style (0xD1) crash. A quick flag, not a verdict - growth alone doesn't prove a leak."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Sample now" Command="{Binding SamplePoolTagsCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Reset baseline" Command="{Binding ResetPoolTagBaselineCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding PoolTagStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <DataGrid ItemsSource="{Binding PoolTagRows}" Height="320" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="70" />
                                    <DataGridTextColumn Header="Nonpaged" Binding="{Binding NonPagedUsedText}" Width="90" />
                                    <DataGridTextColumn Header="Nonpaged growth" Binding="{Binding NonPagedGrowthText}" Width="120" />
                                    <DataGridTextColumn Header="Paged" Binding="{Binding PagedUsedText}" Width="90" />
                                    <DataGridTextColumn Header="Paged growth" Binding="{Binding PagedGrowthText}" Width="110" />
                                    <DataGridTextColumn Header="Allocations" Binding="{Binding NonPagedAllocs}" Width="90" />
                                    <DataGridTemplateColumn Header="" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Apply Special Pool" Padding="6,2" FontSize="{StaticResource FontBody}"
                                                        Command="{Binding DataContext.ApplySpecialPoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Tag}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding SpecialPoolStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #167: error reporting configuration check - always shown (not collapsed), warning-
                         styled only when reporting looks turned off. Informational only, per CLAUDE.md's
                         "quick flag, not a verdict" convention - WerSvc merely sitting Stopped is normal
                         (it's a manual/trigger-start service) and is not by itself treated as "off". -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WerConfigStatus.IsReportingEffectivelyOff}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Error reporting status" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding WerConfigStatus.SummaryText}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="Disabled (HKLM): " /><Run Text="{Binding WerConfigStatus.DisabledLabel, Mode=OneWay}" />
                                <Run Text=" · Don't show UI: " /><Run Text="{Binding WerConfigStatus.DontShowUILabel, Mode=OneWay}" />
                                <Run Text=" · Consent: " /><Run Text="{Binding WerConfigStatus.ConsentDescription, TargetNullValue=Unknown, Mode=OneWay}" />
                                <Run Text=" · WerSvc: " /><Run Text="{Binding WerConfigStatus.WerSvcStatus, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding WerConfigStatus.WerSvcStartType, TargetNullValue=Unknown, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #166: WER storage footprint - total size/file count of ReportQueue/ReportArchive,
                         with a reveal-in-Explorer button next to each (reuses EtwTraceService.
                         RevealInExplorer). This app never deletes anything from either folder. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="WER storage footprint" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="No deletion is performed by this app - use the buttons below to review the files yourself in Explorer." Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="ReportQueue (pending upload)" />
                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding WerFootprint.QueueSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" across " /><Run Text="{Binding WerFootprint.QueueFileCount, Mode=OneWay}" /><Run Text=" file(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reveal in Explorer" FontSize="{StaticResource FontCaption}" Padding="8,4" VerticalAlignment="Center"
                                         Command="{Binding RevealWerQueueCommand}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="ReportArchive (already processed)" />
                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding WerFootprint.ArchiveSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                        <Run Text=" across " /><Run Text="{Binding WerFootprint.ArchiveFileCount, Mode=OneWay}" /><Run Text=" file(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reveal in Explorer" FontSize="{StaticResource FontCaption}" Padding="8,4" VerticalAlignment="Center"
                                         Command="{Binding RevealWerArchiveCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- #165: local crash dump capture toggle - explicit confirmation before any registry
                         write (see StabilityViewModel.EnableLocalDumps), states the disk-space implication,
                         and offers a one-click revert that survives an app restart (see
                         WerReportService.SaveBackup/LoadBackup). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Local crash dump capture" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding LocalDumpsSettings.StatusLabel}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,2,0,4" />
                            <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                        Visibility="{Binding LocalDumpsSettings.DumpFolder, Converter={StaticResource NullToVisibilityConverter}}">
                                <Run Text="Folder: " /><Run Text="{Binding LocalDumpsSettings.DumpFolder, Mode=OneWay}" />
                                <Run Text=" · Keeps " /><Run Text="{Binding LocalDumpsSettings.DumpCount, Mode=OneWay}" />
                                <Run Text=" (" /><Run Text="{Binding LocalDumpsSettings.DumpTypeLabel, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <WrapPanel>
                                <Button Content="Enable local dump capture..." FontSize="{StaticResource FontBody}" Padding="8,4" Margin="0,0,8,0" Command="{Binding EnableLocalDumpsCommand}" />
                                <Button Content="Revert to previous..." FontSize="{StaticResource FontBody}" Padding="8,4" Command="{Binding RevertLocalDumpsCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LocalDumpsToggleStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap"
                                        Visibility="{Binding LocalDumpsToggleStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <!-- #3: minidump files, timestamp + best-effort bugcheck code correlated from a
                         nearby Kernel-Power 41 event - see EventLogService.ReadMinidumps. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Minidumps" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Minidumps}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="{StaticResource FontStrong}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <!-- #65: bugcheck-code-to-plain-English lookup, instead of a bare hex code. -->
                                                <Run Text=" · " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No minidump files found.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Minidumps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Hangs &amp; errors">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #239: Windows Error Reporting AppHang reports (Report.wer under ReportArchive/
                         ReportQueue) - richer per-report detail than #240 below, but pruned sooner. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppHangs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="AppHang reports (Windows Error Reporting)" Style="{StaticResource CardTitle}" />
                            <DataGrid ItemsSource="{Binding AppHangs}" MaxHeight="220" Margin="0,8,0,0" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="App" Binding="{Binding AppPath}" Width="1.8*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="100" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="120" />
                                    <DataGridTextColumn Header="Hang signature" Binding="{Binding HangSignature}" Width="1.2*" />
                                    <DataGridTextColumn Header="Faulting module" Binding="{Binding FaultingModule}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- Round 17, item 53: Application Hang (1002) events, paired with the matching WER
                         AppHang report (item 46) for hang type/signature - a separate fault class from a
                         crash, so its own card rather than mixed into the grid above. Round 17 chunk
                         64-70, item 66's persisted hang-history leaderboard also lives here (this card),
                         so the Border only collapses when BOTH are empty. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ApplicationHangs.Count}" Value="0" />
                                            <Condition Binding="{Binding HangHistory.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Application hangs" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Application Hang (1002) events - hang type/signature come from the matching WER AppHang report (a far more reliable source than that event's own undocumented layout)."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />

                            <!-- Item 66: all-time hang history per executable, persisted to
                                 hang-history.json so it survives across app restarts - the live
                                 NotRespondingSeconds this tab already tracks, kept once a hang episode
                                 ends instead of discarded every tick. Collapsed when nothing recorded yet. -->
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HangHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Hang history (all-time, per executable)" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding HangHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ExecutableName}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource SubStat}">
                                                        <Run Text="Peak " /><Run Text="{Binding PeakDurationSeconds, Mode=OneWay}" /><Run Text="s" />
                                                        <Run Text=" · last " /><Run Text="{Binding LastHangTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                        <Run Text="{Binding HangCount, Mode=OneWay}" /><Run Text="×" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding ApplicationHangs}" Height="200" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="1.2*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="90" />
                                    <DataGridTextColumn Header="Hang type" Binding="{Binding HangType, TargetNullValue='Unknown'}" Width="1.4*" />
                                    <DataGridTextColumn Header="Hang signature" Binding="{Binding HangSignature, TargetNullValue='Unknown'}" Width="1.4*" />
                                    <!-- Item 69 -->
                                    <DataGridTemplateColumn Header="Sleep/resume?" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Near sleep/resume" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #240: "top hanging apps in the last 30 days" from the Application-log "Application
                         Hang" (event 1002) source - complements #239's richer per-report detail above. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HangEventHistory.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Top hanging apps (last 30 days)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="From the Application log's &quot;Application Hang&quot; (event 1002) source." Style="{StaticResource SubStat}" Margin="0,-4,0,10" />
                            <ItemsControl ItemsSource="{Binding HangEventHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding AppName}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding HangType, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 17, items 54/55: managed (.NET/CLR) exceptions - clustered by exception type
                         + top stack frame first, raw list below. Collapsed when empty. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ManagedExceptions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Managed exceptions (.NET/CLR)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="&quot;.NET Runtime&quot; events 1026/1023, parsed into exception type, message and top stack frames - dramatically more actionable than an Application Error row that just says the faulting module was clr.dll."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <TextBlock Text="Clustered by exception type + top frame" Style="{StaticResource ColorRowLabel}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ManagedExceptionClusters}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ExceptionType}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TopFrame}" Style="{StaticResource SubStat}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="{Binding ApplicationName, Mode=OneWay, TargetNullValue='(app unknown)'}" />
                                                    <Run Text=" · last " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DataGrid ItemsSource="{Binding ManagedExceptions}" Height="200" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Message}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="1.1*" />
                                    <DataGridTextColumn Header="Framework" Binding="{Binding FrameworkVersion}" Width="100" />
                                    <DataGridTextColumn Header="Exception type" Binding="{Binding ExceptionType}" Width="1.5*" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding ExceptionMessage}" Width="1.6*" />
                                    <DataGridTextColumn Header="Top frame" Binding="{Binding TopFrameText}" Width="1.8*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- Round 17, items 58/59: Service Control Manager crash/failure events (7031/7034/
                         7024/7000/7009), the service-side equivalent of an application crash - plus a
                         restart-loop warning strip when a service's own termination events cluster
                         densely enough to look chronic. Collapsed when empty. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServiceFailures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Service failures" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Service Control Manager events: terminated unexpectedly (7031/7034), service-specific exit code (7024), failed/timed out to start (7000/7009)."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <!-- Item 59: restart-loop warning strip - a service crashing and being
                                 auto-restarted several times an hour, a chronic fault that never
                                 surfaces as a user-visible crash dialog. -->
                            <ItemsControl ItemsSource="{Binding ServiceRestartLoopWarnings}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap">
                                                    <Run Text="Restart loop: " FontWeight="SemiBold" /><Run Text="{Binding ServiceName, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" terminated " /><Run Text="{Binding OccurrencesInWindow, Mode=OneWay}" />
                                                    <Run Text=" times between " /><Run Text="{Binding WindowStart, StringFormat={}{0:t}, Mode=OneWay}" />
                                                    <Run Text=" and " /><Run Text="{Binding WindowEnd, StringFormat={}{0:t}, Mode=OneWay}" />
                                                    <Run Text=" - a chronic fault, even though it never showed a crash dialog." />
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="View on Services tab" Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0"
                                                        Command="{Binding DataContext.JumpToServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding ServiceName}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DataGrid ItemsSource="{Binding ServiceFailures}" Height="220" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Message}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1.3*" />
                                    <DataGridTextColumn Header="Event" Binding="{Binding EventKindText}" Width="1.6*" />
                                    <DataGridTextColumn Header="Count / exit code" Width="1.1*">
                                        <DataGridTextColumn.Binding>
                                            <MultiBinding StringFormat="{}{0}{1}">
                                                <Binding Path="RestartCount" TargetNullValue="" StringFormat="{}{0}× " />
                                                <Binding Path="ExitCode" TargetNullValue="" />
                                            </MultiBinding>
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Recovery action" Binding="{Binding RecoveryAction}" Width="1.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- Round 17, item 62: postmortem (just-in-time) debugger + Image File Execution
                         Options hijack audit - read-only. Collapsed only when the read outright failed to
                         produce anything (Debugger/Auto both null and no hijacks) - otherwise always shown,
                         since "Windows default, nothing to see here" is itself a useful confirmation. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PostmortemDebugger}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Postmortem debugger audit" Style="{StaticResource CardTitle}" Margin="0" />
                                <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PostmortemDebugger.HasNonDefaultEntries}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Non-default entries found" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="HKLM\...\AeDebug names the just-in-time debugger; an Image File Execution Options\&lt;exe&gt;\Debugger value can silently hijack a process launch. Read-only - a non-default finding can be entirely legitimate (e.g. your own JIT debugger setup), it's just worth a manual check."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,4">
                                <Run Text="AeDebug: " FontWeight="SemiBold" /><Run Text="{Binding PostmortemDebugger.Debugger, Mode=OneWay, TargetNullValue='Not set'}" />
                                <Run Text=" (Auto=" /><Run Text="{Binding PostmortemDebugger.Auto, Mode=OneWay, TargetNullValue='not set'}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10">
                                <Run Text="AeDebug (Wow6432Node): " FontWeight="SemiBold" /><Run Text="{Binding PostmortemDebugger.Wow64Debugger, Mode=OneWay, TargetNullValue='Not set'}" />
                                <Run Text=" (Auto=" /><Run Text="{Binding PostmortemDebugger.Wow64Auto, Mode=OneWay, TargetNullValue='not set'}" /><Run Text=")" />
                            </TextBlock>

                            <TextBlock Text="Image File Execution Options hijacks" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ColorRowLabel}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PostmortemDebugger.ImageFileExecutionOptionsHijacks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PostmortemDebugger.ImageFileExecutionOptionsHijacks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" Margin="0,0,0,2">
                                            <Run Text="{Binding ExecutableName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" → " /><Run Text="{Binding DebuggerPath, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No Image File Execution Options Debugger hijacks found.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PostmortemDebugger.ImageFileExecutionOptionsHijacks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #164: hangs - "Application Hang" 1002, kept separate from the crash cards above
                         since "went white and unresponsive" and "disappeared" have different causes.
                         CPU/disk-pressure correlation is not attempted - see WerHangInfo's remarks. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hangs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Application hangs" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="&quot;Application Hang&quot; event 1002, last 30 days. " />
                                <Run Text="CPU/disk pressure at each timestamp isn't shown - this app has no historical performance log to look it up in yet." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Hangs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WerHangInfo}">
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold">
                                                    <Run Text="{Binding ProcessName, TargetNullValue=Unknown, Mode=OneWay}" />
                                                    <Run Text=" (PID " /><Run Text="{Binding ProcessId, TargetNullValue=Unknown, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · Hang type: " /><Run Text="{Binding HangType, TargetNullValue=Unknown, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #1/#8: recent Critical/Error entries from the System and Application logs, last
                         30 days - a faulting-module tooltip is shown when the message matched that shape
                         (typically an Application-log app crash entry). -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent critical / error events" Style="{StaticResource CardTitle}" />
                            <DataGrid ItemsSource="{Binding RecentEvents}" Height="320" Margin="0,8,0,0" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <!-- #168: the fuller, non-truncated parse for .NET Runtime 1026 /
                                             Application Error 1000 when one was found, otherwise the same
                                             truncated Message as before. -->
                                        <Setter Property="ToolTip" Value="{Binding DisplayDetail}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="90" />
                                    <DataGridTemplateColumn Header="Level" Width="80" SortMemberPath="Level">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Level}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Source" Binding="{Binding ProviderName}" Width="2*" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="60" />
                                    <DataGridTextColumn Header="Faulting module" Binding="{Binding FaultingModule}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No Critical/Error events found in the last 30 days." Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #195: Perflib counter-corruption card - directly relevant to this app itself, since
                         a broken counter provider also breaks this app's own PerformanceCounter reads.
                         Collapsed when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PerflibSummary.Failures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Performance counter provider failures (Perflib)" Style="{StaticResource CardTitle}" Margin="0" />
                                <Button Grid.Column="1" Content="Rebuild counters (lodctr /R)" Command="{Binding RunLodctrRebuildCommand}" Padding="8,3" FontSize="{StaticResource FontBody}"
                                         ToolTip="Rebuilds the Windows performance-counter registry from each provider's own .ini files - a real system change, confirmed before it runs." />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap">
                                <Run Text="Perflib 1008/1010/1017/1023/2004 - a performance counter DLL failed to load or returned bad data. A broken provider here can also mean this app's own CPU/Memory/Disk/Network tabs are reading stale or missing data for that provider." />
                            </TextBlock>
                            <TextBlock FontWeight="SemiBold" FontSize="{StaticResource FontBody}" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PerflibSummary.AffectedProviders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="Affected counter providers: " /><Run Text="{Binding PerflibSummary.AffectedProviders, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding PerflibStatusText}" Style="{StaticResource SubStat}" Margin="0,0,0,6"
                                        Visibility="{Binding PerflibStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding PerflibSummary.Failures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · Perflib " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                            <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                            <Run Text=" (" /><Run Text="{Binding CounterProviderName, TargetNullValue='provider unknown', Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #196: rollup of six more high-signal-but-lower-volume families (Schannel/ESENT/
                         GroupPolicy/Time-Service/DNS Client/Tcpip), each with its own drill-down list.
                         Collapsed when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubsystemFamilies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Other subsystem error families" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="TLS, database engine, Group Policy, time sync, DNS, and TCP/IP port-exhaustion failures from the last 30 days, one rolled-up count per family." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SubsystemFamilies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,6" FontSize="{StaticResource FontBody}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding FamilyName}" />
                                                    <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource DangerBrush}">
                                                        <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text="× · last " />
                                                        <Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="16,6,0,0">
                                                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Hits}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" Margin="0,0,0,3">
                                                                <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text=" · " /><Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                                <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Hardware">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #492: crash/TDR/unexpected-shutdown events preceded by a WHEA hardware error
                         within a short window (5 minutes) - see EventLogService.
                         BuildHardwareErrorCorrelations. A correlation, not a claimed cause: a hardware
                         error shortly before a crash is worth a look, not proof the two are related.
                         Collapsed entirely when none are found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HardwareErrorCorrelations.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Hardware error correlation" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                                       Text="Crash/TDR/unexpected-shutdown events that had a WHEA hardware-error record in the 5 minutes beforehand. This is a correlation, not a cause - a hardware error shortly before a crash is worth a look, not proof the two are related; the crash could be unrelated, and a genuinely-related error can also precede its crash by longer than this window." />
                            <ItemsControl ItemsSource="{Binding HardwareErrorCorrelations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,8" Background="{DynamicResource DangerMutedBrush}" CornerRadius="6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"
                                                               Text="{Binding CrashDescription}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CrashTime, StringFormat={}{0:g}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>
                                                <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                    <Run Text="Preceded by: " /><Run Text="{Binding HardwareErrorDescription, Mode=OneWay}" />
                                                    <Run Text=" - " /><Run Text="{Binding GapText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="{Binding HardwareErrorsInWindow, Mode=OneWay}" /><Run Text=" hardware error(s) found in the correlation window." />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #741: resume-from-hibernate entries that look like they failed - a Kernel-Boot
                         event 27 boot type 2 followed by a 41/6008 failure signal before the next boot,
                         see PowerTimelineService.ReadFailedResumes. Collapsed entirely when none are found
                         (the common case). Points back at the Startup tab's hiberfile card. -->
                    <!-- Round 15, item 34: GPU driver timeouts/resets (TDR) - per-event driver/app detail
                         plus the live TdrDelay/TdrDdiDelay/TdrLevel registry settings, beyond the plain
                         count tile in the summary row above. Collapsed entirely when no per-event detail
                         was found (the count tile above still works independently). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TdrEventDetails.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="GPU driver timeouts / resets (TDR)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Each display-driver timeout-detection-and-recovery event, with the driver and (when Windows recorded one) the application whose GPU context was reset."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TdrEventDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" — driver: " /><Run Text="{Binding Driver, TargetNullValue='Unknown', Mode=OneWay}" />
                                            <Run Text=" · app: " /><Run Text="{Binding Application, TargetNullValue='Unknown', Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                    <Run Text="TdrDelay: " /><Run Text="{Binding TdrSettings.TdrDelaySeconds, TargetNullValue='not set', StringFormat={}{0}s, Mode=OneWay}" />
                                    <Run Text=" · TdrDdiDelay: " /><Run Text="{Binding TdrSettings.TdrDdiDelaySeconds, TargetNullValue='not set', StringFormat={}{0}s, Mode=OneWay}" />
                                    <Run Text=" · TdrLevel: " /><Run Text="{Binding TdrSettings.TdrLevelText, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- #488: corrected WHEA errors per day over the same lookback window - the exact same
                         ColumnSeries chart style as Reliability History above. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Corrected hardware error trend" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Corrected-severity WHEA-Logger records per day, last 30 days (any source - memory, PCI Express, machine check, ...)." Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <lvc:CartesianChart Series="{Binding DailyWheaCorrectedSeries}" XAxes="{Binding DailyWheaCorrectedXAxes}" YAxes="{Binding DailyWheaCorrectedYAxes}"
                                                 Height="160" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #487/#489/#490: every WHEA-Logger hardware-error record found, decoded from the
                         record's own binary CPER payload where possible - error source, severity, and (for
                         PCI Express / processor machine-check records) the reporting device and status
                         bits are read directly off the hardware's own report, not guessed from message
                         text. #447's corrected-memory-error card below has its own narrower, dedicated
                         view; those same records will also show up in this broad list. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hardware errors (WHEA)" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                                       Text="Every Microsoft-Windows-WHEA-Logger record found in the last 30 days, decoded from the record's own binary error data (UEFI CPER) where possible - source, severity, and (for PCI Express / processor machine-check records) the reporting device and status bits are read directly off the hardware's own report, presented as what was reported, not an interpretation of it. When a record's binary payload can't be decoded, its severity is estimated from the event's level instead (marked below)." />
                            <ItemsControl ItemsSource="{Binding WheaHardwareErrors}" MaxHeight="420">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0">
                                            <Expander.Style>
                                                <Style TargetType="Expander">
                                                    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <Expander.Header>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Component, Mode=OneWay}" /><Run Text=" · event " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Severity}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Severity}" Value="Corrected">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="4,4,4,8">
                                                <TextBlock Text="Severity estimated from the event's level - the binary error record wasn't available to decode." FontSize="{StaticResource FontCaption}" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StructuredDecodeSucceeded}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RawMessage}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />

                                                <!-- #489: PCI Express AER detail. -->
                                                <StackPanel Margin="0,0,0,6" Visibility="{Binding Pcie, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="PCI Express (AER)" Margin="0,0,0,2" />
                                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                                        <Run Text="{Binding Pcie.BdfText, Mode=OneWay}" FontFamily="Consolas" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Pcie.FriendlyDeviceName, TargetNullValue=device not matched to a currently-present device, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <Run Text="Vendor " /><Run Text="{Binding Pcie.VendorIdText, Mode=OneWay}" />
                                                        <Run Text=" · Device " /><Run Text="{Binding Pcie.DeviceIdText, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding Pcie.SeverityClassText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource DangerBrush}"
                                                               Text="{Binding Pcie.StatusFlags, Converter={StaticResource StringListJoinConverter}}" />
                                                </StackPanel>

                                                <!-- #490: machine-check detail - "the hardware reported this," not an interpretation. -->
                                                <StackPanel Visibility="{Binding MachineCheck, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="Machine check" Margin="0,0,0,2" />
                                                    <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap">
                                                        <Run Text="Bank " /><Run Text="{Binding MachineCheck.BankText, Mode=OneWay}" />
                                                        <Run Text=" · APIC ID " /><Run Text="{Binding MachineCheck.ApicIdText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <Run Text="MCi_STATUS: " /><Run Text="{Binding MachineCheck.RawMciStatusText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <Run Text="Uncorrected: " /><Run Text="{Binding MachineCheck.UncorrectedText, Mode=OneWay}" />
                                                        <Run Text=" · Context corrupt: " /><Run Text="{Binding MachineCheck.ProcessorContextCorruptText, Mode=OneWay}" />
                                                        <Run Text=" · Overflow: " /><Run Text="{Binding MachineCheck.OverflowText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="These flags are what the processor itself reported, read from the error record - not this app's interpretation of a symptom." FontSize="{StaticResource FontCaption}" FontStyle="Italic"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No WHEA hardware-error records found in the last 30 days.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WheaHardwareErrors.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #447: corrected-memory-error events (Microsoft-Windows-WHEA-Logger, event ID 47) -
                         the same figure the System Specs memory section shows (EventLogService.
                         ReadCorrectedMemoryErrors is called independently by each tab). Collapsed entirely
                         when none are found - occasional corrected ECC errors don't always happen, and a
                         clean history is the common, unremarkable case. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CorrectedMemoryErrorCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Corrected memory errors (WHEA)" Style="{StaticResource CardTitle}" Margin="0" />
                                <TextBlock Grid.Column="1" Text="{Binding LastCorrectedMemoryErrorText}" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Windows' own hardware-error log reported these as corrected in hardware - occasional corrected errors happen on healthy ECC systems, but a high or climbing count is worth a closer look. DIMM/address hints are best-effort, parsed from the event's own text."
                                       Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CorrectedMemoryErrors}" MaxHeight="200">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="{StaticResource FontBody}">
                                                <Run Text="{Binding DimmHint, TargetNullValue=Unknown module, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding PhysicalAddressHint, TargetNullValue=address not reported, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}"
                                                       FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #464: boot-start/system-start driver load failures (SCM 7000/7001/7026, kernel PnP
                         event 219) - this tab had no pre-existing distinct "boot section" to fold this
                         into, so it's its own small card. Collapsed entirely when none are found, same
                         pattern as the WHEA card above. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootDriverLoadFailures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Boot-time driver load failures" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Boot-start/system-start drivers the Service Control Manager or kernel PnP manager reported as failed to load, last 30 days."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding BootDriverLoadFailures}" MaxHeight="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding DriverName, TargetNullValue=Unknown, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · event " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding ProviderName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}"
                                                       FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 13, items 9/10: Microsoft-Windows-WHEA-Logger hardware errors (corrected and
                         uncorrectable machine-check/memory/PCIe), often logged for weeks before a 0x124
                         bugcheck - see EventLogService.ReadWheaErrors/DecodeWheaErrorRecord. Corrected
                         counts are framed as an early warning, not a diagnosis ("quick flag, not a
                         verdict" per CLAUDE.md). Collapsed entirely when none found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WheaSummary.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Hardware errors (WHEA)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Corrected errors are an early warning, not a diagnosis - they can precede a hardware-related bugcheck by weeks."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding WheaSummary}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Severity, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Source, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Item 10: best-effort partial decode of each event's raw ErrorRecord, in a
                                 detail expander (per-event, not the summary above). -->
                            <Expander Header="Individual events (raw record decode)" IsExpanded="False">
                                <ItemsControl ItemsSource="{Binding WheaErrors}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" (ID " /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Text="{Binding Decoded}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <!-- #427: the classic pool-starvation event signature (Srv 2019/2020, event 333,
                         Resource-Exhaustion-Detector) with a plain-English explanation per row - the
                         strongest possible evidence of a kernel leak this app can surface. Collapsed
                         entirely when none are found, same pattern as the faulting-module card above. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PoolExhaustionEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Pool-exhaustion event history" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Srv 2019/2020 (nonpaged/paged pool exhausted), event 333 (registry flush failure), and Windows' own resource-exhaustion detector - the strongest evidence available that a driver is leaking kernel memory."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding PoolExhaustionEvents}" Margin="0,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,8" Background="{DynamicResource DangerMutedBrush}" CornerRadius="6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                                        <Run Text="{Binding ProviderName, Mode=OneWay}" /><Run Text=" · event " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Explanation}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #439: out-of-memory incidents (Resource-Exhaustion-Detector event 2004) - each one
                         expandable to the ranked top commit consumers Windows itself recorded at the
                         moment it diagnosed the low-virtual-memory condition. Collapsed entirely when none
                         are found, same pattern as the faulting-module/pool-exhaustion cards above. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutOfMemoryIncidents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Out-of-memory incidents" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Windows' own resource-exhaustion detector, event 2004 - logged when the system diagnosed a low-virtual-memory condition, along with the processes it saw consuming the most committed memory at that moment. Those processes are often just the largest visible consumers at the time, not necessarily the root cause."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding OutOfMemoryIncidents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,8" Background="{DynamicResource DangerMutedBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0">
                                            <Expander.Header>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="Low virtual memory diagnosed" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}"
                                                               FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Margin="4,4,4,8">
                                                <ItemsControl ItemsSource="{Binding TopConsumers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" FontSize="{StaticResource FontBody}">
                                                                    <Run Text="{Binding ProcessName, Mode=OneWay}" /><Run Text=" · PID " /><Run Text="{Binding Pid, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Bytes, Converter={StaticResource BytesToReadableConverter}}"
                                                                           FontSize="{StaticResource FontBody}" FontWeight="SemiBold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding RawMessage}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TopConsumers.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #636-640: "Hardware errors (WHEA)" card - the app's first WHEA (Windows Hardware
                         Error Architecture) surface. Fatal + corrected machine-check/platform/PCIe/memory
                         events, a corrected-error-rate trend chart, and a conditions-at-the-moment-of-
                         each-error table. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hardware errors (WHEA)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Check WHEA events" Command="{Binding LoadWheaEventsCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap"
                                       Text="Windows Hardware Error Architecture events, last 30 days - a rising corrected-error rate is the earliest hardware-failure warning Windows produces, and is entirely invisible in Reliability Monitor. Bank/error-type hints are a quick interpretation, not a verdict." />

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <views:VfdMeter Title="Fatal" Glow="False" Margin="0,0,6,0"
                                                ValueText="{Binding WheaFatalCount}"
                                                SubText="Uncorrected machine checks" AccentBrush="{DynamicResource DangerBrush}" />
                                <views:VfdMeter Title="Corrected" Glow="False" Margin="6,0,0,0"
                                                ValueText="{Binding WheaCorrectedCount}"
                                                SubText="Machine check / platform / PCIe / memory" AccentBrush="{DynamicResource WarningBrush}" />
                            </UniformGrid>

                            <!-- #637: corrected-WHEA-errors-per-day trend. -->
                            <TextBlock Text="Corrected-error rate" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <lvc:CartesianChart Series="{Binding WheaCorrectedSeries}" XAxes="{Binding WheaCorrectedXAxes}" YAxes="{Binding WheaCorrectedYAxes}"
                                                 Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,14" />

                            <!-- #636/#639/#640: event list - category, error source, bank hint, and (for
                                 PCIe events) the resolved device name in place of raw bus/device/function. -->
                            <TextBlock Text="Events" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding WheaEvents}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="10" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFatal}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Text="{Binding CategoryText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFatal}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="{StaticResource FontBody}">
                                                    <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" — " /><Run Text="{Binding ErrorSourceText, Mode=OneWay}" />
                                                </TextBlock>
                                                <!-- #636: raw bank number - machine-check events (1/17) only, null/hidden for
                                                     platform/PCIe/memory events. -->
                                                <TextBlock Style="{StaticResource SubStat}" Visibility="{Binding Bank, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="Bank " /><Run Text="{Binding Bank, Mode=OneWay}" />
                                                </TextBlock>
                                                <!-- #639: resolved PCIe device name in place of raw bus/device/function, when available. -->
                                                <TextBlock TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResolvedDeviceName}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Device: " /><Run Text="{Binding ResolvedDeviceName, Mode=OneWay}" />
                                                </TextBlock>
                                                <!-- #640: plain-English machine-check bank/status hint - quick interpretation, not a verdict. -->
                                                <TextBlock Style="{StaticResource SubStat}" FontStyle="Italic" TextWrapping="Wrap"
                                                           Text="{Binding BankHintText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No WHEA hardware-error events found in the last 30 days.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WheaEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- #638: two-column "conditions at the moment of each error" table, joined
                                 against the persisted power-history log. -->
                            <StackPanel Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WheaConditionRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Conditions at each error" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Errors clustered at high temperature point at cooling; errors at idle point at memory, VRM, or PSU."
                                           Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Error" Style="{StaticResource SubStat}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Temp / power" Style="{StaticResource SubStat}" FontWeight="SemiBold" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WheaConditionRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="{StaticResource FontBody}">
                                                        <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubStat}" Text="{Binding ErrorSummary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding TempCAtEvent, StringFormat={}{0:0.#}°C, TargetNullValue=Unknown temp, Mode=OneWay}" />
                                                    <Run Text=" / " /><Run Text="{Binding PowerWAtEvent, StringFormat={}{0:0}W, TargetNullValue=Unknown power, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- #184: storage-fault event family (disk 7/11/51/153, Ntfs 55/98/137/140,
                         storahci/stornvme/iaStorA 129, volmgr 46) grouped by the physical disk each event
                         named - "which physical disk is throwing errors" instead of a flat count. Collapsed
                         when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StorageErrorGroups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Storage errors by disk" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Disk/NTFS/controller-reset errors from the last 30 days, grouped by the physical disk each event named." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding StorageErrorGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding FriendlyName}" />
                                                    <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource DangerBrush}">
                                                        <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" event(s)" />
                                                    </TextBlock>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Hits}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                                <Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                                <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                                                <Run Text=" (" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×, last " />
                                                                <Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" /><Run Text=")" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #186: WHEA (Machine-Check) 17/18/19/47 rate over time - corrected errors are not
                         fatal by themselves, flagged as worth investigating, not a verdict. Same small
                         column-chart shape as Reliability History above. Collapsed when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WheaRateSummary.TotalCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Hardware-error rate (WHEA)" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                                <Run Text="Microsoft-Windows-WHEA-Logger 17/18/19/47 per day, last 30 days. Corrected errors (17/47) aren't fatal by themselves; frequent recurrence is worth investigating." />
                            </TextBlock>
                            <lvc:CartesianChart Series="{Binding WheaDailySeries}" XAxes="{Binding WheaDailyXAxes}" YAxes="{Binding WheaDailyYAxes}"
                                                 Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                            <TextBlock Margin="0,6,0,0" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding WheaRateSummary.TotalCount, Mode=OneWay}" /><Run Text=" total in the last 30 days · last seen " />
                                <Run Text="{Binding WheaRateSummary.LastSeen, StringFormat={}{0:g}, TargetNullValue='never', Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #187: driver-load failures (Kernel-PnP 219/411/442, UserPnp 20001/20003) joined
                         against `driverquery /v /fo csv` so a failure names a real, currently-installed
                         driver when one matches. Collapsed when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DriverFailures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Driver problems" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Driver load failures and install results from the last 30 days, joined against currently-installed drivers where a name matches." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding DriverFailures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                            Visibility="{Binding DriverInfo, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="Installed driver: " FontWeight="SemiBold" /><Run Text="{Binding DriverInfo.DisplayName, Mode=OneWay}" />
                                                    <Run Text=" (" /><Run Text="{Binding DriverInfo.State, Mode=OneWay}" /><Run Text=", " />
                                                    <Run Text="{Binding DriverInfo.StartMode, Mode=OneWay}" /><Run Text=" start)" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #188: chkdsk/autochk results, parsed from Wininit 1001's full boot-time text report
                         and Chkdsk 26212/26214 - bad sectors, whether it completed cleanly. Wider (180-day)
                         lookback since these only run at boot when scheduled. Collapsed when nothing was
                         found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChkdskResults.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Chkdsk / autochk results" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Boot-time disk check runs from the last 180 days." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ChkdskResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding Source, Mode=OneWay}" />
                                                        <Run Text=" · " /><Run Text="{Binding Volume, TargetNullValue='(volume unknown)', Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Text" Value="Completed cleanly" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CompletedCleanly}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        <Setter Property="Text" Value="Ran (outcome unclear)" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Margin="0,2,0,0"
                                                            Visibility="{Binding BadSectorsFoundKb, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Run Text="{Binding BadSectorsFoundKb, Mode=OneWay}" /><Run Text=" KB in bad sectors" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding RawSummary}" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                            TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #189: last Windows Memory Diagnostic run outcome, or "never run" with a pointer to
                         mdsched.exe - pairs with the WHEA card above (WHEA 18/19 = hardware errors that
                         might be RAM; this is "have you actually tested the RAM"). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Windows Memory Diagnostic" Style="{StaticResource CardTitle}" />
                            <TextBlock FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,2,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding MemoryDiagnosticStatus.Outcome}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemoryDiagnosticStatus.HasEverRun}" Value="False">
                                                <Setter Property="Text" Value="No memory diagnostic run found. Run mdsched.exe to test RAM (schedules a check on next restart)." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                        Visibility="{Binding MemoryDiagnosticStatus.HasEverRun, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="Last run: " /><Run Text="{Binding MemoryDiagnosticStatus.LastRunTime, StringFormat={}{0:g}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Power &amp; boot">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #713: "Power & boot timeline" - correlates EventLog 6005/6006/6008/6013,
                         Kernel-Power 41/109, and User32 1074 into one chronological strip - see
                         PowerTimelineService's remarks. Linked from the Startup tab's boot chart (see
                         StartupView.xaml's "View power & boot timeline" button). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Power &amp; boot timeline" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap"
                                       Text="Boots, shutdowns, and who/what initiated them - last 30 days." />
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PowerTimeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,3,10,0" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding TimeCreated, StringFormat={}{0:g}}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding KindLabel}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                               Text="{Binding Summary}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="No power/boot timeline events found in the last 30 days." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerTimeline.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FailedResumes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Failed resumes" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Hiberfile card (Startup tab)" Padding="8,4" FontSize="{StaticResource FontBody}" Click="ViewHiberfileCard_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Quick flag, not a verdict - a resume from hibernate followed by an unexpected-shutdown signal before the next boot. Could be a genuine failed resume, or an unrelated hard power-off during a slow one." />
                            <ItemsControl ItemsSource="{Binding FailedResumes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding SummaryText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 13, item 4: every Kernel-Power 41 occurrence in the lookback window, not
                         just the most recent - see EventLogService.ReadUnexpectedShutdowns. Each row's
                         cause comes from item 3's ClassifyPowerEvent heuristic. Collapsed entirely when
                         the window has none. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnexpectedShutdowns.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Unexpected shutdowns" Style="{StaticResource CardTitle}" Margin="0" />
                                <TextBlock Grid.Column="1" FontSize="{StaticResource FontStrong}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                    <Run Text="{Binding UnexpectedShutdowns.Count, Mode=OneWay}" /><Run Text=" in last 30 days" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Kernel-Power 41 occurrences, most recent first. Cause is a best-effort classification, not a verdict."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding UnexpectedShutdowns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="{StaticResource FontStrong}">
                                                    <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding Cause, Converter={StaticResource ShutdownCauseToTextConverter}, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="Bugcheck: " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                       Text="{Binding UptimeBeforeCrash, StringFormat={}{0:d\\.hh\\:mm} up, TargetNullValue='uptime unknown'}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Round 13, items 5/6: merged shutdown/restart/boot timeline - who/what initiated
                         each shutdown or restart (User32 1074), log start/stop markers, and boots flagged
                         dirty when no matching clean-shutdown marker precedes them - see
                         EventLogService.ReadShutdownTimeline. Collapsed entirely when empty. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShutdownTimeline.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Shutdown &amp; restart timeline" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Who/what initiated each shutdown or restart, plus boots not preceded by a clean shutdown marker (flagged Dirty). A dirty boot with no bugcheck and no dump file is further flagged Freeze - select the row for the last events logged before the silence."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding ShutdownTimeline}" Height="220" IsReadOnly="True"
                                      RowDetailsVisibilityMode="Collapsed">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirtyBoot}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <!-- Item 68: auto-expand row details for a detected freeze - too
                                                 important a finding to require the user to notice and click
                                                 a normally-empty row first. -->
                                            <DataTrigger Binding="{Binding FreezeWithoutCrashLabel, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="DetailsVisibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                                    <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="2*" />
                                    <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.5*" />
                                    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="1.5*" />
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                                    <DataGridTemplateColumn Header="Dirty" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Dirty" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                                           Visibility="{Binding IsDirtyBoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Item 68 -->
                                    <DataGridTemplateColumn Header="Freeze" Width="65">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Freeze" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding FreezeWithoutCrashLabel, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,2,0,6"
                                                Visibility="{Binding FreezeWithoutCrashLabel, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FreezeWithoutCrashLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="Last events logged before the system went silent:" Style="{StaticResource SubStat}" Margin="0,6,0,2" />
                                                <ItemsControl ItemsSource="{Binding EventsBeforeSilence}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontBody}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #142: sleep/resume incident chain - collapsed when nothing was found (the common
                         case on a desktop that's never slept). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SleepResumeCycles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Sleep / resume chain" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap">
                                <Run Text="Each sleep (Kernel-Power 42) paired with its resume (107/187/507) or an unclean reboot instead (41) — the &quot;wakes up to a black screen&quot; pattern. Last 30 days." />
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding SleepResumeCycles}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sleep" Binding="{Binding SleepTime, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="Resume" Binding="{Binding ResumeTime, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                                    <DataGridTemplateColumn Header="Outcome" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResumedCleanly}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Boot type hint" Binding="{Binding BootTypeHint}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #143: "who rebooted this PC" - collapsed when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RebootAttributions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Who rebooted this PC" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap">
                                <Run Text="Parsed from User32 1074 (which process/user asked for it), Kernel-General 13, and EventLog 6006/6008 — last 30 days." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding RebootAttributions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RebootAttribution}">
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Text="{Binding Timestamp, StringFormat={}{0:g}}" />
                                                <TextBlock Text="{Binding Answer}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WasCleanShutdown}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #144: uptime and session ledger - collapsed only when EventLog 6005 was never
                         found in the lookback window at all (extremely rare). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootLedger.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Uptime and session ledger" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap">
                                <Run Text="One row per boot session (EventLog 6005/6006/6008/6009/6013), with a best-effort Kernel-Boot 27 boot-type read — Fast Startup means &quot;restart&quot; and &quot;shut down&quot; aren't the same reset. Last 30 days." />
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding BootLedger}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                                    <DataGridTextColumn Header="Boot type" Binding="{Binding BootType}" Width="130" />
                                    <DataGridTemplateColumn Header="Ended cleanly?" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EndedCleanly}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EndedCleanly}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="End reason" Binding="{Binding EndReason}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <!-- #190: Kernel-Power 125/126/131 (device power-transition failures) and
                         Kernel-Processor-Power 37/55 (processor power/throttling) - a historical incident
                         record that complements (not merges with) the live thermal-throttle/power-limit
                         flag on the CPU/Energy & Thermals tabs. Collapsed when nothing was found. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PowerTransitionIncidents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Power and throttling incidents" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Device power-transition failures and processor power/throttling events from the last 30 days." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding PowerTransitionIncidents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " /><Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                            <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="History">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- #1/#169: Reliability History - daily Critical/Error counts over the lookback window
                         (this app's own bar series, left axis), the same "crash/failure events over time"
                         chart Windows' own Reliability Monitor shows, bucketed from the same event query as
                         everything else on this tab - overlaid with #169's line series, Windows' own 1-10
                         SystemStabilityIndex from Win32_ReliabilityStabilityMetrics (right axis, blue) so
                         the two independently-derived scores can be read side by side. See
                         StabilityViewModel's constructor remarks for why this is one overlaid chart rather
                         than two separate ones. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Reliability history" Style="{StaticResource CardTitle}" />
                            <!-- Round 13, item 11: the bars are this app's own computed daily Critical/
                                 Error count (left axis); the two overlaid lines are two independently-built
                                 reads of Microsoft's own Reliability Monitor stability index
                                 (Win32_ReliabilityStabilityMetrics, right axis, 0-10) - see
                                 StabilityViewModel's constructor remarks for why both are kept. -->
                            <TextBlock Text="Critical/Error events per day (bars) vs. Microsoft's own reliability index (lines), last 30 days."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,2" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,0,0,10" TextWrapping="Wrap"
                                        Visibility="{Binding IsReliabilityMonitorAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="Windows index (last 7 days, avg): " />
                                <Run Text="{Binding WindowsStabilityIndexRecent, StringFormat={}{0:0.0}/10, TargetNullValue='no data yet', Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <lvc:CartesianChart Series="{Binding DailyEventSeries}" XAxes="{Binding DailyEventXAxes}" YAxes="{Binding DailyEventYAxes}"
                                                 Height="160" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <!-- #781: "did an update break this?" - a KB installed within 48 hours before a
                         faulting module started recurring in the crash timeline below. Collapsed entirely
                         when nothing correlates (the common case). Quick flag, not a verdict - jumps into
                         the Windows Health tab's own update-uninstall list (#780). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateBreakageFlags.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Did an update break this?" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Uninstall an update (Windows Health tab)" Padding="8,4" FontSize="{StaticResource FontBody}" Click="ViewUpdateUninstallInWindowsHealth_Click" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Quick flag, not a verdict - a Windows Update installed within 48 hours before a faulting module below started crashing repeatedly. Worth testing by uninstalling that update, not a confirmed cause." />
                            <ItemsControl ItemsSource="{Binding UpdateBreakageFlags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource DangerMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Text="{Binding SummaryText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- #174: index disagreement flag - only shown when the two independently-derived
                         scores actually diverge by more than StabilityViewModel.IndexDisagreementThreshold;
                         explains the divergence rather than leaving two unexplained numbers on screen
                         (CLAUDE.md's "quick flag, not a verdict"). -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IndicesDisagree, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="{StaticResource FontStrong}"
                                    Text="{Binding IndexDisagreementText}" />
                    </Border>
                    <!-- #172: Reliability Monitor's own WMI data collection status - always shown (not
                         collapsed), warning-styled only when collection is off, mirroring the "Error
                         reporting status" card's shape further down this tab. Offers to re-enable it (with
                         explicit confirmation) and #171's "run the RAC task now" refresh, which is what
                         actually re-aggregates #169/#170's data instead of waiting for it to happen on its
                         own schedule. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReliabilityAnalysisStatus.IsCollectionDisabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Reliability Monitor collection" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding ReliabilityAnalysisStatus.SummaryText}" FontSize="{StaticResource FontStrong}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <WrapPanel>
                                <Button Content="Refresh reliability data" FontSize="{StaticResource FontBody}" Padding="8,4" Margin="0,0,8,0"
                                         Command="{Binding RefreshReliabilityCommand}" />
                                <Button Content="Re-enable collection..." FontSize="{StaticResource FontBody}" Padding="8,4" Margin="0,0,8,0"
                                         Command="{Binding EnableReliabilityAnalysisCommand}"
                                         Visibility="{Binding ReliabilityAnalysisStatus.IsCollectionDisabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Revert to previous..." FontSize="{StaticResource FontBody}" Padding="8,4" Command="{Binding RevertReliabilityAnalysisCommand}"
                                         Visibility="{Binding CanRevertReliabilityAnalysis, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ReliabilityRefreshStatusText}" Style="{StaticResource SubStat}" Margin="0,6,0,0" TextWrapping="Wrap"
                                        Visibility="{Binding ReliabilityRefreshStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ReliabilityAnalysisStatusText}" Style="{StaticResource SubStat}" Margin="0,4,0,0" TextWrapping="Wrap"
                                        Visibility="{Binding ReliabilityAnalysisStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <!-- #170: the full Reliability Monitor feed - application/Windows/miscellaneous
                         failures, warnings, and informational entries (software installs/updates/
                         uninstalls) all from one WMI class, with product name, source, and timestamp. Hidden
                         entirely (not an empty grid) when #172 detects collection is off. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReliabilityMonitorAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Reliability Monitor feed" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Every Win32_ReliabilityRecords entry — failures, warnings, and informational software changes — last 30 days, newest first." />
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding ReliabilityRecords}" IsReadOnly="True" AutoGenerateColumns="False" MaxHeight="300">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Message}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeGenerated, StringFormat={}{0:g}}" Width="140" />
                                    <DataGridTemplateColumn Header="Category" Width="100" SortMemberPath="CategoryLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CategoryLabel}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Category}" Value="Failure">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Category}" Value="Informational">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="1.4*" />
                                    <DataGridTextColumn Header="Event ID" Binding="{Binding EventIdentifier}" Width="70" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No reliability records found in the last 30 days.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReliabilityRecords.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #173: informational reliability records (software installs/updates/uninstalls)
                         presented as a change log, cross-highlighted against crash clusters from the unified
                         timeline (#137) - a concrete "this appeared right before things got worse" list,
                         correlation only. Hidden entirely when #172 detects collection is off. -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReliabilityMonitorAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Software change log" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                                <Run Text="installs, updates, and uninstalls from the feed above. A highlighted entry was followed by a crash cluster within a few days — correlation only, not proof of cause." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SoftwareChangeLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ReliabilityRecordInfo}">
                                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlaggedBeforeCrash}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <Run Text="{Binding ProductName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding TimeGenerated, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding SourceName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding PrecedesCrashClusterNote}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                            Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                                            Visibility="{Binding IsFlaggedBeforeCrash, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No software installs/updates/uninstalls found in the last 30 days.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SoftwareChangeLog.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- #130: day x hour-of-day Critical/Error density grid, sitting directly under the
                         Reliability History chart above - patterns invisible in a daily bar total ("every
                         night at 3 AM", "only after resume") pop out as a vertical/clustered stripe here.
                         Custom UniformGrid/ItemsControl rendering (not LiveChartsCore's HeatSeries) - see
                         StabilityViewModel/EventAnomalyDetectionService's remarks for why. Collapsed when
                         nothing was found (a quiet system in the lookback window). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorDensityHeatmap.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Error density (day x hour of day)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Critical/Error counts bucketed by the hour they were logged, one row per day - a recurring vertical stripe means &quot;every day around this hour&quot;." Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,-4,0,10" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ErrorDensityHeatmap}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="24" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="14" Height="14" Margin="0"
                                                     Background="{Binding Count, Converter={StaticResource HeatCellCountToBrushConverter}}"
                                                     ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <!-- #128: "New error types this week" - signatures present only in the last 7 days of
                         the same 30-day snapshot above, with no older occurrence in it - the single
                         strongest "something changed" signal an event log gives. Collapsed when nothing
                         qualifies (the common case). -->
                    <Border Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewErrorTypesThisWeek.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="New error types this week" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Quick flag, not a verdict — " FontWeight="SemiBold" />
                                <Run Text="event signatures seen in the last 7 days with no earlier occurrence in this snapshot's 30-day window." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding NewErrorTypesThisWeek}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold">
                                                        <Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SampleMessage}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right">
                                                        <Run Text="First seen " /><Run Text="{Binding FirstSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right">
                                                        <Run Text="{Binding OccurrenceCount, Mode=OneWay}" /><Run Text=" occurrence(s)" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Recovery">
            <ScrollViewer Style="{StaticResource SectionBody}">
                <StackPanel>
                    <!-- ============================================================================
                         Round 21, items 96-100: "Recovery, escalation and safe operation" - the final
                         chunk of this domain. Every action in this whole section is a genuinely dangerous
                         or slow operation (reboot into Safe Mode, chkdsk /f scheduling a reboot, DISM
                         taking many minutes) - every button below is confirmation-gated in the ViewModel,
                         never automatic. ============================================================ -->
                    <TextBlock Text="Recovery" Style="{StaticResource CardTitle}" FontSize="{StaticResource FontSection}" Margin="0,4,0,4" />
                    <TextBlock Text="Escape hatches and repair tools for when something above has already gone wrong - reboot into Safe Mode or the Recovery Environment, audit the current boot configuration, roll back with System Restore, or run Windows' own repair tools. Every action here restarts the machine, changes system files, or otherwise takes real time - each is its own explicit, confirmed button."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,12" TextWrapping="Wrap" />
                    <!-- Item 96: reboot into Safe Mode / WinRE, with the matching revert - essential as
                         the escape hatch for the Driver Verifier wizard above (item 83). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Reboot into Safe Mode or Recovery Environment" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Safe Mode loads only core drivers/services - useful when a driver or startup program is hanging or crashing the machine before you can fix it. Unlike a one-time F8 boot, this keeps booting into Safe Mode on every restart until reverted below."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />

                            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BootConfigAudit.CurrentlyConfiguredForSafeMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="This machine is currently configured to boot into Safe Mode (" /><Run Text="{Binding BootConfigAudit.CurrentSafebootValue, Mode=OneWay}" /><Run Text=") on every restart." />
                                    </TextBlock>
                                    <Button Content="Revert Safe Mode boot" Command="{Binding RevertSafeModeBootCommand}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <WrapPanel>
                                <Button Content="Reboot into Safe Mode" Command="{Binding RebootToSafeModeMinimalCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Reboot into Safe Mode with Networking" Command="{Binding RebootToSafeModeNetworkCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,8" />
                                <Button Content="Reboot into Recovery Environment (WinRE)" Command="{Binding RebootToRecoveryEnvironmentCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SafeModeStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Item 97: `bcdedit /enum {current}` decoded into plain English, with warnings for
                         the flags that weaken driver-signature enforcement or hide boot failures. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Boot configuration audit" Style="{StaticResource CardTitle}" Margin="0" />
                                <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BootConfigAudit.HasWarnings}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Flags found" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="safeboot, testsigning, nointegritychecks, debug, bootstatuspolicy and hypervisorlaunchtype from this boot entry's own bcdedit configuration - flagged when set to a value that weakens driver-signing enforcement or hides boot failures. Any of these can be a deliberate, legitimate developer/debugging setup - worth a manual check, not a verdict."
                                       Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                            <TextBlock Text="{Binding BootConfigAudit.ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BootConfigAudit.ReadOk}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding BootConfigAudit.Flags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top" Margin="0,2,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding PlainEnglish}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Item 98: System Restore points - enumerated via the SystemRestore WMI class,
                         with a "create now" button (reusing item 83's RestorePointService.TryCreate) and
                         rstrui.exe launched for the actual rollback (a full rollback restarts the machine
                         partway through, so it can't run inside this app's own process). -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="System Restore points" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding SystemProtectionStatus.ProtectionStatusText}" Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Create restore point now" Command="{Binding CreateRestorePointFromRecoveryCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <Button Content="Open System Restore..." Command="{Binding LaunchRstruiCommand}" Padding="10,4" />
                            </StackPanel>
                            <TextBlock Text="{Binding RestorePointsStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding SystemProtectionStatus.RestorePoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="{StaticResource FontStrong}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SubStat}">
                                                    <Run Text="{Binding CreationTime, StringFormat={}{0:g}, Mode=OneWay}" />
                                                    <Run Text=" · " /><Run Text="{Binding RestorePointTypeText, Mode=OneWay}" />
                                                    <Run Text=" · #" /><Run Text="{Binding SequenceNumber, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No restore points found.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SystemProtectionStatus.RestorePoints.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Item 99: guided repair runner - sfc/DISM/chkdsk/mdsched, each its own explicit,
                         confirmed button with a "this takes a while" indicator. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Guided repair runner" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Windows' own built-in repair tools. sfc and DISM can each take several minutes and use noticeable CPU/disk; chkdsk only schedules a check for the next restart; Memory Diagnostic restarts the machine immediately to test RAM before Windows loads."
                                       Style="{StaticResource SubStat}" Margin="0,-4,0,12" TextWrapping="Wrap" />

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run System File Checker (sfc /scannow)" Command="{Binding RunSfcCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                                    <TextBlock Text="Running..." Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Visibility="{Binding IsSfcRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SfcResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="120" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run DISM repair (/RestoreHealth)" Command="{Binding RunDismCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                                    <TextBlock Text="Running..." Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Visibility="{Binding IsDismRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DismResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <Button Content="Schedule disk check (chkdsk) on system drive" Command="{Binding ScheduleChkdskCommand}" Style="{StaticResource DangerButton}" Padding="10,4" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding ChkdskResultText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Run Windows Memory Diagnostic" Command="{Binding LaunchMemoryDiagnosticCommand}" Style="{StaticResource DangerButton}" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Check for results" Command="{Binding RefreshMemoryDiagnosticResultsCommand}" Padding="10,4" />
                                </StackPanel>
                                <TextBlock Text="{Binding MemoryDiagnosticStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                <ItemsControl ItemsSource="{Binding MemoryDiagnosticResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="{StaticResource FontStrong}" Margin="0,0,0,4" TextWrapping="Wrap">
                                                <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding ResultText, Mode=OneWay}">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HadErrors}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Item 100: one-click crash support bundle - zips the selected minidumps/WER
                         reports (item 49's multi-select) with a system-information export, event-log
                         exports, a driver inventory, the crash-dump-configuration read-out and a
                         generated Markdown crash summary. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Crash support bundle" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Zips the selected minidumps (" /><Run Text="{Binding SelectedDumpCount, Mode=OneWay}" /><Run Text=") and WER reports (" />
                                <Run Text="{Binding SelectedWerReportCount, Mode=OneWay}" /><Run Text=") - select rows on the Dump analysis / Error reports cards above first - together with a full system-information export, System/Application event-log exports, a verbose driver inventory, the crash-dump configuration read-out, and a generated crash summary. Produces the exact package a support forum or technician asks for." />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Build support bundle..." Command="{Binding BuildSupportBundleCommand}" Padding="10,4" Margin="0,0,8,0" />
                                <TextBlock Text="Building..." Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Visibility="{Binding IsBuildingSupportBundle, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SupportBundleStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- #185: shadow-copy (System Restore / File History) family - volsnap/VSS deletion/
                         failure events plus vssadmin's own current storage-allocation snapshot. Always
                         shown (not collapsed on empty) since the storage-allocation table itself is useful
                         even with no recent failures. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Backup and restore points" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap">
                                <Run Text="Shadow copy (System Restore / File History) storage allocation and any deletion/failure events from the last 30 days - a silently deleted shadow copy means these features quietly stopped working." />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ShadowStorageVolumes}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" Text="{Binding ForVolume}" />
                                                <TextBlock FontSize="{StaticResource FontBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Used " /><Run Text="{Binding UsedSpace, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding MaximumSpace, Mode=OneWay}" />
                                                    <Run Text=" max (allocated " /><Run Text="{Binding AllocatedSpace, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ShadowCopyStatusText}" Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                        Visibility="{Binding ShadowCopyStatusText, Converter={StaticResource NullToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding ShadowCopyEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontBody}" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " /><Run Text="{Binding Provider, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding EventId, Mode=OneWay}" />
                                            <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No shadow-copy deletion/failure events found in the last 30 days.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShadowCopyEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
