<UserControl x:Class="TaskManagerPlus.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StabilityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- #4: the shutdown immediately preceding this boot looks unexpected (Kernel-Power 41
                 / EventLog 6008 within a few minutes of the last boot time) - see
                 EventLogService.Query. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WasLastShutdownUnexpected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5">
                        <Run Text="Last shutdown looks unexpected — " /><Run Text="{Binding LastUnexpectedShutdownText, Mode=OneWay}" />
                        <Run Text=" (Kernel-Power 41 / unclean shutdown near the last boot time)." />
                    </TextBlock>
                    <!-- #625: power-draw-at-reboot correlation annotation - a reboot at peak draw
                         with no bugcheck code is the classic PSU-under-load signature. -->
                    <TextBlock Text="{Binding PowerDrawAtRebootText}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0" Opacity="0.9">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PowerDrawAtRebootText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- #606: thermal-critical/shutdown event scan - a firmware thermal shutdown is
                 otherwise indistinguishable in this log from a PSU death, so this gets its own
                 explicit red banner rather than being folded into the generic event grid below. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ThermalCriticalDetected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5">
                    <Run Text="Thermal-critical event found — a thermal zone exceeded its critical/passive trip point (or an ACPI thermal-shutdown record was logged) within the last 30 days. " />
                    <Run Text="{Binding ThermalCriticalEvents[0].TimeCreated, StringFormat={}Most recent: {0:g}, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!-- #610: throttle-to-stutter correlation - cross-references #604's persisted throttle
                 episodes against the same recorded-events timestamps below. Hidden until there's
                 both at least one throttle episode and one recorded event to compare. -->
            <TextBlock Text="{Binding HitchThrottleCorrelationText}"
                       FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HitchThrottleCorrelationText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Crash / stability diagnostics" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="15" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" />
            </Grid>

            <!-- #6/#5/#40/#68: uptime-since-last-crash, TDR (GPU driver timeout/reset) count,
                 low-memory resource-exhaustion events, minidumps, and (Round 10) the 0-10 stability
                 index - see ComputeStabilityIndex for the documented weighted formula. -->
            <UniformGrid Columns="5" Margin="0,0,0,16">
                <views:VfdMeter Title="Since last crash" Glow="False" Margin="0,0,6,0"
                                ValueText="{Binding TimeSinceLastCrashText}"
                                SubText="Unexpected shutdown or BSOD" AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="TDR events" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding TdrEventCount}"
                                SubText="{Binding LastTdrEventText}"
                                AccentBrush="{DynamicResource WarningBrush}" />
                <views:VfdMeter Title="Minidumps" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Minidumps.Count}"
                                SubText="%SystemRoot%\Minidump" AccentBrush="{DynamicResource AccentBrush}" />
                <!-- #40: low-memory resource-exhaustion events (Warning-level, a separate targeted
                     query - see EventLogService.ReadLowMemoryEvents). -->
                <views:VfdMeter Title="Low-memory events" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding LowMemoryEventCount}"
                                SubText="{Binding LastLowMemoryEventText}"
                                AccentBrush="{DynamicResource WarningBrush}" />
                <!-- Round 10, #68: single 0-10 stability index - see StabilityViewModel.ComputeStabilityIndex. -->
                <views:VfdMeter Title="Stability index" Glow="False" Margin="6,0,0,0"
                                ValueText="{Binding StabilityIndex, StringFormat={}{0:0.0}}" Unit="/ 10"
                                SubText="Weighted from recent crash/error density"
                                AccentBrush="{Binding StabilityIndex, Converter={StaticResource StabilityIndexToBrushConverter}}" />
            </UniformGrid>

            <!-- #1: Reliability History - daily Critical/Error counts over the lookback window,
                 the same "crash/failure events over time" chart Windows' own Reliability Monitor
                 shows, bucketed from the same event query as everything else on this tab. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Reliability history" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Critical/Error events per day, last 30 days." Style="{StaticResource SubStat}" Margin="0,-4,0,10" />
                    <lvc:CartesianChart Series="{Binding DailyEventSeries}" XAxes="{Binding DailyEventXAxes}" YAxes="{Binding DailyEventYAxes}"
                                         Height="160" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- #3: minidump files, timestamp + best-effort bugcheck code correlated from a
                 nearby Kernel-Power 41 event - see EventLogService.ReadMinidumps. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Minidumps" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Minidumps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                        <!-- #65: bugcheck-code-to-plain-English lookup, instead of a bare hex code. -->
                                        <Run Text=" · " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No minidump files found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Minidumps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 10, #66: repeated application crashes grouped by faulting module, with a
                 count - see FaultingModuleSummary's remarks. A different lens on the same events
                 the flat grid below shows, purpose-built for "which module keeps crashing" instead
                 of scrolling a dozen near-identical rows. Collapsed entirely when nothing has a
                 faulting module (the common case for a quiet system). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CrashesByModule.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Crashes by faulting module" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding CrashesByModule}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Module}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #636-640: "Hardware errors (WHEA)" card - the app's first WHEA (Windows Hardware
                 Error Architecture) surface. Fatal + corrected machine-check/platform/PCIe/memory
                 events, a corrected-error-rate trend chart, and a conditions-at-the-moment-of-
                 each-error table. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hardware errors (WHEA)" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Check WHEA events" Command="{Binding LoadWheaEventsCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource SubStat}" Margin="0,-2,0,10" TextWrapping="Wrap"
                               Text="Windows Hardware Error Architecture events, last 30 days - a rising corrected-error rate is the earliest hardware-failure warning Windows produces, and is entirely invisible in Reliability Monitor. Bank/error-type hints are a quick interpretation, not a verdict." />

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <views:VfdMeter Title="Fatal" Glow="False" Margin="0,0,6,0"
                                        ValueText="{Binding WheaFatalCount}"
                                        SubText="Uncorrected machine checks" AccentBrush="{DynamicResource DangerBrush}" />
                        <views:VfdMeter Title="Corrected" Glow="False" Margin="6,0,0,0"
                                        ValueText="{Binding WheaCorrectedCount}"
                                        SubText="Machine check / platform / PCIe / memory" AccentBrush="{DynamicResource WarningBrush}" />
                    </UniformGrid>

                    <!-- #637: corrected-WHEA-errors-per-day trend. -->
                    <TextBlock Text="Corrected-error rate" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <lvc:CartesianChart Series="{Binding WheaCorrectedSeries}" XAxes="{Binding WheaCorrectedXAxes}" YAxes="{Binding WheaCorrectedYAxes}"
                                         Height="120" TooltipPosition="Top" LegendPosition="Hidden" Background="Transparent" Margin="0,0,0,14" />

                    <!-- #636/#639/#640: event list - category, error source, bank hint, and (for
                         PCIe events) the resolved device name in place of raw bus/device/function. -->
                    <TextBlock Text="Events" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding WheaEvents}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="10" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFatal}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding CategoryText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFatal}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" — " /><Run Text="{Binding ErrorSourceText}" />
                                        </TextBlock>
                                        <!-- #636: raw bank number - machine-check events (1/17) only, null/hidden for
                                             platform/PCIe/memory events. -->
                                        <TextBlock Style="{StaticResource SubStat}" Visibility="{Binding Bank, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Bank " /><Run Text="{Binding Bank, Mode=OneWay}" />
                                        </TextBlock>
                                        <!-- #639: resolved PCIe device name in place of raw bus/device/function, when available. -->
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResolvedDeviceName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Device: " /><Run Text="{Binding ResolvedDeviceName}" />
                                        </TextBlock>
                                        <!-- #640: plain-English machine-check bank/status hint - quick interpretation, not a verdict. -->
                                        <TextBlock Style="{StaticResource SubStat}" FontStyle="Italic" TextWrapping="Wrap"
                                                   Text="{Binding BankHintText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No WHEA hardware-error events found in the last 30 days.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WheaEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- #638: two-column "conditions at the moment of each error" table, joined
                         against the persisted power-history log. -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WheaConditionRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Conditions at each error" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Errors clustered at high temperature point at cooling; errors at idle point at memory, VRM, or PSU."
                                   Style="{StaticResource SubStat}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Error" Style="{StaticResource SubStat}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Temp / power" Style="{StaticResource SubStat}" FontWeight="SemiBold" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WheaConditionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="11.5">
                                                <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" Text="{Binding ErrorSummary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding TempCAtEvent, StringFormat={}{0:0.#}°C, TargetNullValue=Unknown temp, Mode=OneWay}" />
                                            <Run Text=" / " /><Run Text="{Binding PowerWAtEvent, StringFormat={}{0:0}W, TargetNullValue=Unknown power, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- #1/#8: recent Critical/Error entries from the System and Application logs, last
                 30 days - a faulting-module tooltip is shown when the message matched that shape
                 (typically an Application-log app crash entry). -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent critical / error events" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding RecentEvents}" Height="320" Margin="0,8,0,0" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="90" />
                            <DataGridTemplateColumn Header="Level" Width="80" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding ProviderName}" Width="2*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="60" />
                            <DataGridTextColumn Header="Faulting module" Binding="{Binding FaultingModule}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No Critical/Error events found in the last 30 days." Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
