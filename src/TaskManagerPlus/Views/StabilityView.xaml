<UserControl x:Class="TaskManagerPlus.Views.StabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
             xmlns:views="clr-namespace:TaskManagerPlus.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DataContext="{d:DesignInstance Type=vm:StabilityViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- #4: the shutdown immediately preceding this boot looks unexpected (Kernel-Power 41
                 / EventLog 6008 within a few minutes of the last boot time) - see
                 EventLogService.Query. -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WasLastShutdownUnexpected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12.5">
                        <Run Text="Last shutdown looks unexpected — " /><Run Text="{Binding LastUnexpectedShutdownText, Mode=OneWay}" />
                        <Run Text=" (Kernel-Power 41 / unclean shutdown near the last boot time)." />
                    </TextBlock>
                    <!-- Round 13, item 3: labelled cause badge instead of just the generic warning
                         above - see EventLogService.ClassifyPowerEvent. "Quick flag, not a
                         verdict" (CLAUDE.md): a heuristic over undocumented event-property layout. -->
                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2"
                            HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="{Binding LastShutdownCauseText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 14, item 27: new-dump watcher alert - a crash dump was written while the
                 app was running (also mirrored as a tray balloon and a tab-header badge - see
                 MainWindow.xaml.cs / MainWindow.xaml). -->
            <Border Background="{DynamicResource DangerMutedBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNewDumpAlert}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NewDumpAlertText}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissNewDumpAlertCommand}" Padding="10,4" Margin="10,0,0,0" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Crash / stability diagnostics" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" FontSize="15" />
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,4" />
            </Grid>

            <!-- Round 13, item 12: "is the 30-day lookback window even trustworthy" line - see
                 EventLogService.ReadLogHealth / StabilityViewModel.BuildLogCoverageText. -->
            <TextBlock Text="{Binding LogCoverageText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- #6/#5/#40/#68: uptime-since-last-crash, TDR (GPU driver timeout/reset) count,
                 low-memory resource-exhaustion events, minidumps, and (Round 10) the 0-10 stability
                 index - see ComputeStabilityIndex for the documented weighted formula. -->
            <UniformGrid Columns="5" Margin="0,0,0,16">
                <views:VfdMeter Title="Since last crash" Glow="False" Margin="0,0,6,0"
                                ValueText="{Binding TimeSinceLastCrashText}"
                                SubText="Unexpected shutdown or BSOD" AccentBrush="{DynamicResource AccentBrush}" />
                <views:VfdMeter Title="TDR events" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding TdrEventCount}"
                                SubText="{Binding LastTdrEventText}"
                                AccentBrush="{DynamicResource WarningBrush}" />
                <views:VfdMeter Title="Minidumps" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding Minidumps.Count}"
                                SubText="%SystemRoot%\Minidump" AccentBrush="{DynamicResource AccentBrush}" />
                <!-- #40: low-memory resource-exhaustion events (Warning-level, a separate targeted
                     query - see EventLogService.ReadLowMemoryEvents). -->
                <views:VfdMeter Title="Low-memory events" Glow="False" Margin="3,0,3,0"
                                ValueText="{Binding LowMemoryEventCount}"
                                SubText="{Binding LastLowMemoryEventText}"
                                AccentBrush="{DynamicResource WarningBrush}" />
                <!-- Round 10, #68: single 0-10 stability index - see StabilityViewModel.ComputeStabilityIndex. -->
                <views:VfdMeter Title="Stability index" Glow="False" Margin="6,0,0,0"
                                ValueText="{Binding StabilityIndex, StringFormat={}{0:0.0}}" Unit="/ 10"
                                SubText="Weighted from recent crash/error density"
                                AccentBrush="{Binding StabilityIndex, Converter={StaticResource StabilityIndexToBrushConverter}}" />
            </UniformGrid>

            <!-- #1: Reliability History - daily Critical/Error counts over the lookback window,
                 the same "crash/failure events over time" chart Windows' own Reliability Monitor
                 shows, bucketed from the same event query as everything else on this tab. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Reliability history" Style="{StaticResource CardTitle}" />
                    <!-- Round 13, item 11: the bars are this app's own computed daily Critical/
                         Error count (left axis); the line is Microsoft's own Reliability Monitor
                         stability index (Win32_ReliabilityStabilityMetrics, right axis, 0-10). -->
                    <TextBlock Text="Critical/Error events per day (bars) vs. Microsoft's own reliability index (line), last 30 days."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,10" TextWrapping="Wrap" />
                    <lvc:CartesianChart Series="{Binding DailyEventSeries}" XAxes="{Binding DailyEventXAxes}" YAxes="{Binding DailyEventYAxes}"
                                         Height="160" TooltipPosition="Top" LegendPosition="Bottom" Background="Transparent" />
                </StackPanel>
            </Border>

            <!-- Round 15, item 34: GPU driver timeouts/resets (TDR) - per-event driver/app detail
                 plus the live TdrDelay/TdrDdiDelay/TdrLevel registry settings, beyond the plain
                 count tile in the summary row above. Collapsed entirely when no per-event detail
                 was found (the count tile above still works independently). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TdrEventDetails.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="GPU driver timeouts / resets (TDR)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Each display-driver timeout-detection-and-recovery event, with the driver and (when Windows recorded one) the application whose GPU context was reset."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding TdrEventDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                    <Run Text=" — driver: " /><Run Text="{Binding Driver, TargetNullValue='Unknown'}" />
                                    <Run Text=" · app: " /><Run Text="{Binding Application, TargetNullValue='Unknown'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                            <Run Text="TdrDelay: " /><Run Text="{Binding TdrSettings.TdrDelaySeconds, TargetNullValue='not set', StringFormat={}{0}s, Mode=OneWay}" />
                            <Run Text=" · TdrDdiDelay: " /><Run Text="{Binding TdrSettings.TdrDdiDelaySeconds, TargetNullValue='not set', StringFormat={}{0}s, Mode=OneWay}" />
                            <Run Text=" · TdrLevel: " /><Run Text="{Binding TdrSettings.TdrLevelText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 13, items 1/2/7/8: minidump files, backed by the authoritative BugCheck 1001
                 record when found (falling back to the old nearby-Kernel-Power-41-timestamp guess),
                 an expandable "Full crash record" (joined WER report), and an inline warning when
                 volmgr logged a failed dump write - see EventLogService.ReadMinidumps/
                 ReadBugCheckRecords/ReadDumpFailures. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Minidumps" Style="{StaticResource CardTitle}" />

                    <!-- Item 7: volmgr 161/162 "dump creation failed" - explains "I had a BSOD but
                         there's no dump file". -->
                    <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DumpFailures.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="{Binding DumpFailures.Count, Mode=OneWay}" /><Run Text=" dump-creation failure(s) (volmgr) in the last 30 days — Windows tried to write a crash dump and failed, which explains a BSOD with no matching minidump file." />
                        </TextBlock>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Minidumps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,6" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                                                <!-- #65: bugcheck-code-to-plain-English lookup, instead of a bare hex code. -->
                                                <Run Text=" · " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <!-- Round 15, item 29: per-code labelled parameters (with an inline NTSTATUS
                                             decode, item 30, when this code documents a parameter as a status/
                                             exception code) - replaces the old flat hex "Parameters: ..." row. -->
                                        <ItemsControl ItemsSource="{Binding Decoded.ParameterRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource SubStat}" Margin="0,2,0,0">
                                            <Run Text="Source: " /><Run Text="{Binding IsAuthoritative, Converter={StaticResource BugcheckSourceToTextConverter}, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Round 15, item 32: DPC_WATCHDOG_VIOLATION (0x133) subtype line - only
                                             present for that one code. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DpcWatchdogSubtypeText}"
                                                   Visibility="{Binding Decoded.DpcWatchdogSubtypeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 33: DRIVER_POWER_STATE_FAILURE (0x9F) subcode + the
                                             sleep/resume cross-reference. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DriverPowerStateSubcodeText}"
                                                   Visibility="{Binding Decoded.DriverPowerStateSubcodeText, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HappenedDuringSleepResume}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Happened during sleep/resume" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>

                                        <!-- Round 15, item 36: 0x124's joined WHEA-Logger record. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding WheaJoinText, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Matching hardware error (WHEA): " /><Run Text="{Binding WheaJoinText}" />
                                        </TextBlock>

                                        <!-- Round 15, item 35: pool-tag decode for 0xC2/0xC5. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.PoolTagText}"
                                                   Visibility="{Binding Decoded.PoolTagText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 37: fault-address classification for 0xA/0xD1/0x50. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.FaultAddressClassification}"
                                                   Visibility="{Binding Decoded.FaultAddressClassification, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 31: curated "what usually causes this" note - explicitly
                                             non-authoritative, per CLAUDE.md's "quick flag, not a verdict". -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding Decoded.Guidance, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="What usually causes this (not a diagnosis): " FontWeight="SemiBold" /><Run Text="{Binding Decoded.Guidance}" />
                                        </TextBlock>

                                        <!-- Item 2: WER "full crash record" - the joined ReportArchive folder. -->
                                        <StackPanel Margin="0,4,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="{Binding WerReport, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Full crash record (WER)" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,2" />
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="OS version: " /><Run Text="{Binding WerReport.OsVersion, Mode=OneWay, TargetNullValue=Unknown}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Secure Boot state: " /><Run Text="{Binding WerReport.SecureBootState, Mode=OneWay, TargetNullValue=Unknown}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Attached files: " /><Run Text="{Binding WerReport.AttachedFiles, Converter={StaticResource StringListJoinConverter}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No minidump files found.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Minidumps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Round 14, item 26: Minidump folder housekeeping footer strip - total
                         size, oldest/newest, delete-older-than, and the live registry
                         MinidumpsCount value. -->
                    <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                <Run Text="Folder: " /><Run Text="{Binding Housekeeping.FileCount, Mode=OneWay}" /><Run Text=" file(s), " />
                                <Run Text="{Binding Housekeeping.TotalSizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                                <Run Text=" total. Oldest: " /><Run Text="{Binding Housekeeping.OldestFile, StringFormat={}{0:g}, TargetNullValue='—', Mode=OneWay}" />
                                <Run Text=" · Newest: " /><Run Text="{Binding Housekeeping.NewestFile, StringFormat={}{0:g}, TargetNullValue='—', Mode=OneWay}" />
                            </TextBlock>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Delete older than" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Width="48" Text="{Binding DeleteOlderThanDays, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="days" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="6,0,10,0" />
                                <Button Grid.Column="4" Content="Delete" Command="{Binding DeleteOldDumpsCommand}" Padding="10,4" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="5" Text="MinidumpsCount" VerticalAlignment="Center" Style="{StaticResource SubStat}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="6" Width="48" Text="{Binding MinidumpsCountInput, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Button Content="Save MinidumpsCount" Command="{Binding SaveMinidumpsCountCommand}" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding HousekeepingStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Round 14, items 13-19: binary-parsed dump rows - richer, event-log-independent
                 data straight from each dump's own DUMP_HEADER64/MINIDUMP header, per
                 MinidumpParserService. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dump analysis (binary parse)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Read directly from each dump file's own header/streams, independent of the event log above. Blame is address-range matching against the loaded-module list - a quick flag, not a verdict, not a symbolised stack."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding DumpRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,8" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Parsed.FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Parsed.IsIncomplete}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Incomplete — not analysable" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                            <Run Text="Format: " /><Run Text="{Binding Parsed.Format}" />
                                            <Run Text=" · Type: " /><Run Text="{Binding Parsed.DumpTypeText}" />
                                            <Run Text=" · Size: " /><Run Text="{Binding Parsed.SizeBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="{Binding IssueText}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="OS: " /><Run Text="{Binding Parsed.OsVersion, TargetNullValue='Unknown'}" />
                                            <Run Text=" · Machine: " /><Run Text="{Binding Parsed.MachineType, TargetNullValue='Unknown'}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Bugcheck (from binary parse): " /><Run Text="{Binding Parsed.BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, TargetNullValue='not found'}" />
                                        </TextBlock>

                                        <!-- Round 15, item 29: per-code labelled parameters (item 30's NTSTATUS
                                             decode inline where applicable) - replaces the old flat "Parameters: ..."
                                             hex row. -->
                                        <ItemsControl ItemsSource="{Binding Decoded.ParameterRows}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Round 15, item 32: DPC_WATCHDOG_VIOLATION (0x133) subtype line. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DpcWatchdogSubtypeText}"
                                                   Visibility="{Binding Decoded.DpcWatchdogSubtypeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 33: DRIVER_POWER_STATE_FAILURE (0x9F) subcode line. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.DriverPowerStateSubcodeText}"
                                                   Visibility="{Binding Decoded.DriverPowerStateSubcodeText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 35: pool-tag decode for 0xC2/0xC5. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.PoolTagText}"
                                                   Visibility="{Binding Decoded.PoolTagText, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 37: fault-address classification for 0xA/0xD1/0x50. -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="{Binding Decoded.FaultAddressClassification}"
                                                   Visibility="{Binding Decoded.FaultAddressClassification, Converter={StaticResource NullToVisibilityConverter}}" />

                                        <!-- Round 15, item 31: curated "what usually causes this" note - explicitly
                                             non-authoritative, per CLAUDE.md's "quick flag, not a verdict". -->
                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding Decoded.Guidance, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="What usually causes this (not a diagnosis): " FontWeight="SemiBold" /><Run Text="{Binding Decoded.Guidance}" />
                                        </TextBlock>

                                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="Contents: " /><Run Text="{Binding ContentsText}" />
                                            <Run Text=" (" /><Run Text="{Binding ModuleCountText}" /><Run Text=")" />
                                        </TextBlock>

                                        <!-- Item 17/18: blame + dossier. -->
                                        <StackPanel Margin="0,6,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="{Binding Parsed.BlamedModule, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                                <Run Text="Probably blamed: " /><Run Text="{Binding Parsed.BlamedModule}" />
                                            </TextBlock>
                                            <TextBlock Text="Quick flag, not a verdict — this is address-range matching, not a symbolised stack."
                                                       Style="{StaticResource SubStat}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Company: " /><Run Text="{Binding Parsed.BlamedModuleDossier.CompanyName, TargetNullValue='Unknown'}" />
                                                <Run Text=" · Product: " /><Run Text="{Binding Parsed.BlamedModuleDossier.ProductName, TargetNullValue='Unknown'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                <Run Text="Version: " /><Run Text="{Binding Parsed.BlamedModuleDossier.FileVersion, TargetNullValue='Unknown'}" />
                                                <Run Text=" · Date: " /><Run Text="{Binding Parsed.BlamedModuleDossier.FileDate, StringFormat={}{0:d}, TargetNullValue='Unknown'}" />
                                                <Run Text=" · Signature: " /><Run Text="{Binding Parsed.BlamedModuleDossier.SignatureStatus}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Item 23/24: debugger actions + cached !analyze -v result. -->
                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Analyse (!analyze -v)" Command="{Binding AnalyzeCommand}" Padding="10,4" Margin="0,0,8,0"
                                                        Visibility="{Binding CanUseDebugger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="Open in WinDbg" Command="{Binding OpenInWinDbgCommand}" Padding="10,4"
                                                        Visibility="{Binding CanUseDebugger, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="Analysing..." VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource SubStat}"
                                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DebuggerHintText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanUseDebugger}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AnalyzeError}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                            <StackPanel Margin="0,6,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="{Binding Analysis, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="MODULE_NAME: " /><Run Text="{Binding Analysis.ModuleName, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="IMAGE_NAME: " /><Run Text="{Binding Analysis.ImageName, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="FAILURE_BUCKET_ID: " /><Run Text="{Binding Analysis.FailureBucketId, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap">
                                                    <Run Text="PROCESS_NAME: " /><Run Text="{Binding Analysis.ProcessName, TargetNullValue='(not found)'}" />
                                                </TextBlock>
                                                <Expander Header="STACK_TEXT" IsExpanded="False" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Analysis.StackText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No minidump files to parse.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DumpRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 14, item 19: third-party drivers present in every parseable dump's module
                 list - the strongest cheap cross-dump signal available without a real debugger. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CommonDrivers.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Drivers present in every crash" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Non-Microsoft drivers found in the module list of every dump this app could parse. A cheap, strong lead - not proof."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding CommonDrivers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="in " /><Run Text="{Binding DumpCount}" /><Run Text=" dump(s)" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 14, item 20: MEMORY.DMP - the kernel/complete dump, never shown before now. -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MEMORY.DMP" Style="{StaticResource CardTitle}" />
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MemoryDump.Exists}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="{Binding MemoryDump.FilePath}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,2,0,8">
                            <Run Text="{Binding MemoryDump.SizeBytes, Converter={StaticResource BytesToReadableConverter}, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding MemoryDump.Timestamp, StringFormat={}{0:g}, Mode=OneWay}" />
                            <Run Text=" · Bugcheck: " /><Run Text="{Binding MemoryDump.Parsed.BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, TargetNullValue='not found'}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Open folder" Command="{Binding OpenMemoryDumpFolderCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Copy to..." Command="{Binding CopyMemoryDumpCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Delete" Command="{Binding DeleteMemoryDumpCommand}" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding MemoryDumpStatusText}" Style="{StaticResource SubStat}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="No MEMORY.DMP found - this machine isn't configured for a Complete/Kernel dump (see CrashDumpEnabled in the Minidump folder's housekeeping above, or the crash-analysis settings).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MemoryDump.Exists}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Round 14, items 21/22: live kernel events (watchdog dumps with no bluescreen). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LiveKernelReports.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Live kernel events (no BSOD)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Watchdog-triggered live kernel dumps (DPCWATCHDOG, USBHUB3, NDIS, video-engine timeouts, ...) that never caused a bluescreen or reboot."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding LiveKernelReports}" Height="180" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.5*" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToReadableConverter}}" Width="90" />
                            <DataGridTextColumn Header="WER code" Binding="{Binding WerDescription}" Width="2.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 13, item 4: every Kernel-Power 41 occurrence in the lookback window, not
                 just the most recent - see EventLogService.ReadUnexpectedShutdowns. Each row's
                 cause comes from item 3's ClassifyPowerEvent heuristic. Collapsed entirely when
                 the window has none. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UnexpectedShutdowns.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Unexpected shutdowns" Style="{StaticResource CardTitle}" Margin="0" />
                        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding UnexpectedShutdowns.Count, Mode=OneWay}" /><Run Text=" in last 30 days" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Kernel-Power 41 occurrences, most recent first. Cause is a best-effort classification, not a verdict."
                               Style="{StaticResource SubStat}" Margin="0,-2,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding UnexpectedShutdowns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" · " /><Run Text="{Binding Cause, Converter={StaticResource ShutdownCauseToTextConverter}, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Bugcheck: " /><Run Text="{Binding BugcheckCode, Converter={StaticResource BugcheckCodeToDescriptionConverter}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                               Text="{Binding UptimeBeforeCrash, StringFormat={}{0:d\\.hh\\:mm} up, TargetNullValue='uptime unknown'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Round 13, items 5/6: merged shutdown/restart/boot timeline - who/what initiated
                 each shutdown or restart (User32 1074), log start/stop markers, and boots flagged
                 dirty when no matching clean-shutdown marker precedes them - see
                 EventLogService.ReadShutdownTimeline. Collapsed entirely when empty. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShutdownTimeline.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Shutdown &amp; restart timeline" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Who/what initiated each shutdown or restart, plus boots not preceded by a clean shutdown marker (flagged Dirty)."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding ShutdownTimeline}" Height="220" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirtyBoot}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="2*" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.5*" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="1.5*" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                            <DataGridTemplateColumn Header="Dirty" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Dirty" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                                                   Visibility="{Binding IsDirtyBoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Round 13, items 9/10: Microsoft-Windows-WHEA-Logger hardware errors (corrected and
                 uncorrectable machine-check/memory/PCIe), often logged for weeks before a 0x124
                 bugcheck - see EventLogService.ReadWheaErrors/DecodeWheaErrorRecord. Corrected
                 counts are framed as an early warning, not a diagnosis ("quick flag, not a
                 verdict" per CLAUDE.md). Collapsed entirely when none found. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WheaSummary.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Hardware errors (WHEA)" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Corrected errors are an early warning, not a diagnosis - they can precede a hardware-related bugcheck by weeks."
                               Style="{StaticResource SubStat}" Margin="0,-4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WheaSummary}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Severity}" /><Run Text=" — " /><Run Text="{Binding Source}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Item 10: best-effort partial decode of each event's raw ErrorRecord, in a
                         detail expander (per-event, not the summary above). -->
                    <Expander Header="Individual events (raw record decode)" IsExpanded="False">
                        <ItemsControl ItemsSource="{Binding WheaErrors}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding TimeCreated, StringFormat={}{0:g}, Mode=OneWay}" />
                                            <Run Text=" (ID " /><Run Text="{Binding EventId, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="{Binding Decoded}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Round 10, #66: repeated application crashes grouped by faulting module, with a
                 count - see FaultingModuleSummary's remarks. A different lens on the same events
                 the flat grid below shows, purpose-built for "which module keeps crashing" instead
                 of scrolling a dozen near-identical rows. Collapsed entirely when nothing has a
                 faulting module (the common case for a quiet system). -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CrashesByModule.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Crashes by faulting module" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding CrashesByModule}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Module}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubStat}">
                                            <Run Text="Last seen " /><Run Text="{Binding LastSeen, StringFormat={}{0:g}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource DangerMutedBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- #1/#8: recent Critical/Error entries from the System and Application logs, last
                 30 days - a faulting-module tooltip is shown when the message matched that shape
                 (typically an Application-log app crash entry). -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent critical / error events" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding RecentEvents}" Height="320" Margin="0,8,0,0" IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated, StringFormat={}{0:g}}" Width="150" />
                            <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="90" />
                            <DataGridTemplateColumn Header="Level" Width="80" SortMemberPath="Level">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding ProviderName}" Width="2*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="60" />
                            <DataGridTextColumn Header="Faulting module" Binding="{Binding FaultingModule}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No Critical/Error events found in the last 30 days." Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubStat}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
