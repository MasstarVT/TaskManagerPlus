<Window x:Class="TaskManagerPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagerPlus"
        xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
        xmlns:views="clr-namespace:TaskManagerPlus.Views"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Task Manager Plus" Height="860" Width="1280" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                            Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Task Manager Plus" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Running as administrator" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                    <Setter Property="Text" Value="Not elevated — some actions may be blocked" />
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ToggleButton Grid.Column="3" IsChecked="{Binding IsSettingsOpen, Mode=OneWay}"
                              Command="{Binding ToggleSettingsCommand}"
                              Width="34" Height="34" Cursor="Hand" ToolTip="Colors">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bg" CornerRadius="17" Background="{StaticResource BgElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                                      Data="M12,2 A10,10 0 1 0 12.01,2 Z M12,7 A5,5 0 1 1 11.99,7 Z" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Body: tabs + optional settings drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Margin="8,4,8,8">
                <TabItem Header="Processes">
                    <views:ProcessesView DataContext="{Binding Processes}" />
                </TabItem>
                <TabItem Header="Performance">
                    <views:PerformanceView DataContext="{Binding Performance}" />
                </TabItem>
                <TabItem Header="Services">
                    <views:ServicesView DataContext="{Binding Services}" />
                </TabItem>
                <TabItem Header="Startup">
                    <views:StartupView DataContext="{Binding Startup}" />
                </TabItem>
            </TabControl>

            <views:SettingsPanel Grid.Column="1" DataContext="{Binding Theme}">
                <views:SettingsPanel.Style>
                    <Style TargetType="views:SettingsPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsPanel.Style>
            </views:SettingsPanel>
        </Grid>
    </Grid>
</Window>
