<Window x:Class="TaskManagerPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManagerPlus"
        xmlns:vm="clr-namespace:TaskManagerPlus.ViewModels"
        xmlns:views="clr-namespace:TaskManagerPlus.Views"
        xmlns:res="clr-namespace:TaskManagerPlus.Resources"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.AppTitle}" Height="860" Width="1280" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}">
    <Window.Resources>
        <!-- Shared brush for every nav-rail icon: bound to the ancestor TabItem's Foreground so
             icons recolor automatically with the existing selected/hover triggers. -->
        <Style x:Key="NavIconStroke" TargetType="Shape">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="NavIconFill" TargetType="Shape">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <StackPanel>
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                            Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- #100: cross-tab search - "find anything mentioning 'nvidia'" across
                     Processes, Services, Startup, and the System tab's driver/software/USB lists
                     at once, without hunting through each tab individually. -->
                <Grid x:Name="SearchBoxGrid" Grid.Column="1" HorizontalAlignment="Center" Width="320">
                    <TextBox Text="{Binding Search.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search processes, services, startup items, drivers, software, USB devices" Padding="10,6" />
                    <Popup IsOpen="{Binding Search.HasQuery, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBoxGrid}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True" Width="380">
                        <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Search.Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource AccentMutedBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No matches." Margin="8" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Search.Results.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{x:Static res:Strings.ElevatedStatus}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                    <Setter Property="Text" Value="{x:Static res:Strings.NotElevatedStatus}" />
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Round 12, #88: read-only GitHub Releases update check - notify-only, collapsed
                 whenever no newer release was found (offline, rate-limited, or already current -
                 see MainViewModel.CheckForUpdateAsync/UpdateCheckService's remarks). -->
            <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="20,7"
                    Visibility="{Binding UpdateAvailableText, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UpdateAvailableText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Content="View release" Command="{Binding OpenUpdateUrlCommand}" Cursor="Hand" Margin="12,0,0,0"
                            Padding="8,3" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" />
                </StackPanel>
            </Border>

            <!-- suggestions.md #997: "N unattended scans since you last looked, M new findings" -
                 dismissible, collapsed whenever there's nothing new to report. -->
            <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="20,7"
                    Visibility="{Binding UnattendedScanBannerText, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UnattendedScanBannerText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Content="Dismiss" Command="{Binding DismissUnattendedScanBannerCommand}" Cursor="Hand" Margin="12,0,0,0"
                            Padding="8,3" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"
                            AutomationProperties.Name="Dismiss unattended scan notification" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Border>

        <!-- Body: nav rail + page content + optional settings drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="MainTabControl" Grid.Column="0" TabStripPlacement="Top" SelectedIndex="0">
                <!-- Round 11, #79: independent UI scale, separate from Windows' own display
                     scaling - see ThemeViewModel.FontScale's remarks for why a uniform
                     LayoutTransform (rather than threading a font-size resource through every
                     explicit FontSize setter in this app's XAML) is the pragmatic hook point. -->
                <TabControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Theme.FontScale}" ScaleY="{Binding Theme.FontScale}" />
                </TabControl.LayoutTransform>
                <!-- Footer entry docked to the trailing edge of the top strip (see the
                     TabControl ControlTemplate in Dark.xaml, which docks Tag to the right). -->
                <TabControl.Tag>
                    <Button Command="{Binding ToggleSettingsCommand}" Cursor="Hand"
                            HorizontalContentAlignment="Left" Margin="4,7,14,7" Padding="10,7"
                            Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                                              Data="M12,2 A10,10 0 1 0 12.01,2 Z M12,7 A5,5 0 1 1 11.99,7 Z" />
                                        <TextBlock Text="{x:Static res:Strings.SettingsButton}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </TabControl.Tag>

                <TabItem Header="Summary">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="1" Canvas.Top="1" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="9" Canvas.Top="1" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="1" Canvas.Top="9" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" RadiusX="1.5" RadiusY="1.5" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:SummaryView DataContext="{Binding Summary}" />
                </TabItem>

                <TabItem Header="CPU">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="3" Canvas.Top="3" Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="5.5" Y1="0.5" X2="5.5" Y2="3" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="10.5" Y1="0.5" X2="10.5" Y2="3" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="5.5" Y1="13" X2="5.5" Y2="15.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="10.5" Y1="13" X2="10.5" Y2="15.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="0.5" Y1="5.5" X2="3" Y2="5.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="0.5" Y1="10.5" X2="3" Y2="10.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="13" Y1="5.5" X2="15.5" Y2="5.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="13" Y1="10.5" X2="15.5" Y2="10.5" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:CpuView DataContext="{Binding Cpu}" />
                </TabItem>

                <TabItem Header="Memory">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="1.5" Canvas.Top="4" Width="13" Height="8" RadiusX="1.5" RadiusY="1.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="5" Y1="4" X2="5" Y2="7" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="8" Y1="4" X2="8" Y2="7" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="11" Y1="4" X2="11" Y2="7" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:MemoryView DataContext="{Binding Memory}" />
                </TabItem>

                <TabItem Header="Storage">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="2" Canvas.Top="1.5" Width="12" Height="5" RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="2" Canvas.Top="9.5" Width="12" Height="5" RadiusX="1.5" RadiusY="1.5" />
                                <Ellipse Style="{StaticResource NavIconFill}" Canvas.Left="4" Canvas.Top="3.5" Width="1.5" Height="1.5" />
                                <Ellipse Style="{StaticResource NavIconFill}" Canvas.Left="4" Canvas.Top="11.5" Width="1.5" Height="1.5" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:StorageView DataContext="{Binding Storage}" />
                </TabItem>

                <TabItem Header="Network">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Ellipse Style="{StaticResource NavIconStroke}" Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.2" X1="1" Y1="8" X2="15" Y2="8" />
                                <Path Style="{StaticResource NavIconStroke}" StrokeThickness="1.2" Data="M 6,1.3 A 10,10 0 0 0 6,14.7" />
                                <Path Style="{StaticResource NavIconStroke}" StrokeThickness="1.2" Data="M 10,1.3 A 10,10 0 0 1 10,14.7" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:NetworkView DataContext="{Binding Network}" />
                </TabItem>

                <!-- Round 10: dedicated GPU tab (#53-56) - a small card body with a fan/PCIe-pin
                     glyph, distinct from the CPU tab's chip-with-legs icon above. -->
                <TabItem Header="GPU">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Rectangle Style="{StaticResource NavIconStroke}" Canvas.Left="1.5" Canvas.Top="3" Width="13" Height="9" RadiusX="1.5" RadiusY="1.5" />
                                <Ellipse Style="{StaticResource NavIconStroke}" Canvas.Left="4" Canvas.Top="5.5" Width="4" Height="4" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.2" X1="10.5" Y1="6" X2="13" Y2="6" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.2" X1="10.5" Y1="8.5" X2="13" Y2="8.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="3" Y1="12" X2="3" Y2="14.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="6" Y1="12" X2="6" Y2="14.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="9" Y1="12" X2="9" Y2="14.5" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.4" X1="12" Y1="12" X2="12" Y2="14.5" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:GpuView DataContext="{Binding Gpu}" />
                </TabItem>

                <TabItem Header="Energy &amp; Thermals">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Style="{StaticResource NavIconFill}" Data="M 8.8,0.8 L 3,9 L 7,9 L 6.2,15.2 L 13,6.2 L 8.6,6.2 Z" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:EnergyThermalsView DataContext="{Binding EnergyThermals}" />
                </TabItem>

                <TabItem Header="Processes">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.8" X1="2" Y1="4" X2="14" Y2="4" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.8" X1="2" Y1="8" X2="14" Y2="8" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.8" X1="2" Y1="12" X2="14" Y2="12" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:ProcessesView DataContext="{Binding Processes}" />
                </TabItem>

                <TabItem Header="Services">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Ellipse Style="{StaticResource NavIconStroke}" Canvas.Left="4" Canvas.Top="4" Width="8" Height="8" />
                                <Line Style="{StaticResource NavIconStroke}" X1="8" Y1="0.5" X2="8" Y2="2.5" />
                                <Line Style="{StaticResource NavIconStroke}" X1="8" Y1="13.5" X2="8" Y2="15.5" />
                                <Line Style="{StaticResource NavIconStroke}" X1="0.5" Y1="8" X2="2.5" Y2="8" />
                                <Line Style="{StaticResource NavIconStroke}" X1="13.5" Y1="8" X2="15.5" Y2="8" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:ServicesView DataContext="{Binding Services}" />
                </TabItem>

                <TabItem Header="Startup">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Style="{StaticResource NavIconStroke}" Data="M 11.3,3.6 A 6,6 0 1 1 4.7,3.6" />
                                <Line Style="{StaticResource NavIconStroke}" X1="8" Y1="1" X2="8" Y2="7" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:StartupView DataContext="{Binding Startup}" />
                </TabItem>

                <TabItem Header="System">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Ellipse Style="{StaticResource NavIconStroke}" Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" />
                                <Ellipse Style="{StaticResource NavIconFill}" Canvas.Left="7.25" Canvas.Top="4" Width="1.5" Height="1.5" />
                                <Line Style="{StaticResource NavIconStroke}" X1="8" Y1="7" X2="8" Y2="12" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:SystemSpecsView DataContext="{Binding SystemSpecs}" />
                </TabItem>

                <TabItem Header="Stability">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Style="{StaticResource NavIconStroke}" Data="M 1,8 L 5,8 L 6.5,3 L 9.5,13 L 11,8 L 15,8" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:StabilityView DataContext="{Binding Stability}" />
                </TabItem>

                <TabItem Header="Troubleshoot">
                    <TabItem.Tag>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Ellipse Style="{StaticResource NavIconStroke}" Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" />
                                <Line Style="{StaticResource NavIconStroke}" StrokeThickness="1.8" X1="8" Y1="4.5" X2="8" Y2="9" />
                                <Ellipse Style="{StaticResource NavIconFill}" Canvas.Left="7.25" Canvas.Top="10.5" Width="1.5" Height="1.5" />
                            </Canvas>
                        </Viewbox>
                    </TabItem.Tag>
                    <views:TroubleshootView DataContext="{Binding Troubleshoot}" />
                </TabItem>
            </TabControl>

            <views:SettingsPanel Grid.Column="1" DataContext="{Binding Theme}">
                <views:SettingsPanel.Style>
                    <Style TargetType="views:SettingsPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsPanel.Style>
            </views:SettingsPanel>
        </Grid>

        <!-- #955: persistent "change in progress" banner, visible on every tab (not just the
             Troubleshoot tab's Baselines section where the change window itself is started/
             finished) - a small conditional row here was easy given the existing fixed 3-row
             Grid, so this is the "real, app-wide visibility" option CLAUDE.md's own instructions
             for this feature preferred over confining it to one tab. -->
        <Border Grid.Row="2" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Troubleshoot.Baselines.IsChangeWindowOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="20,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="Change in progress: " FontWeight="SemiBold" />
                    <Run Text="{Binding Troubleshoot.Baselines.ActiveChangeLabel, Mode=OneWay}" />
                    <Run Text=" (started " />
                    <Run Text="{Binding Troubleshoot.Baselines.ChangeStartedAt, StringFormat={}{0:t}, Mode=OneWay}" />
                    <Run Text=")" />
                </TextBlock>
                <Button Grid.Column="1" Content="Finish change" Padding="10,4" Cursor="Hand"
                        Command="{Binding Troubleshoot.Baselines.FinishChangeCommand}" />
            </Grid>
        </Border>

        <!-- Footer status bar -->
        <Border Grid.Row="3" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0">
            <Grid Margin="20,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0" VerticalAlignment="Center" Background="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="{Binding Processes.ProcessCount, StringFormat={}{0} processes}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Start/Stop Logging: writes a CSV of every metric the app shows (CPU total +
                     per-core, memory breakdown, disk, network, all sensors), one row/second, to
                     a file the user picks via a Save dialog when they click Start. -->
                <Button Grid.Column="2" Command="{Binding Logging.ToggleLoggingCommand}" Cursor="Hand"
                        Margin="0,0,16,0" Padding="10,5" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Logging.IsLogging}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{x:Static res:Strings.StartLoggingButton}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Logging.IsLogging}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Logging.LogFileName, StringFormat=Stop Logging ({0})}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- #75: event marker - lets the user tag "this is when it happened" while
                     reproducing an issue, written as a trailing "Marker" column in the CSV. Only
                     shown while actively logging. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logging.IsLogging}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBox Width="140" FontSize="11.5" VerticalContentAlignment="Center"
                             Text="{Binding Logging.MarkerText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Optional marker label" Margin="0,0,6,0" />
                    <Button Content="Add marker" FontSize="11.5" Padding="8,4" Command="{Binding Logging.AddMarkerCommand}" />
                </StackPanel>

                <!-- #98/#99: pin-to-top compact overlay / second-monitor mini dashboard - see
                     MainViewModel.ToggleMiniDashboardCommand. -->
                <Button Grid.Column="4" Command="{Binding ToggleMiniDashboardCommand}" Cursor="Hand"
                        Margin="0,0,16,0" Padding="10,5" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{x:Static res:Strings.MiniDashboardOpenButton}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMiniDashboardOpen}" Value="True">
                                        <Setter Property="Text" Value="{x:Static res:Strings.MiniDashboardCloseButton}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <TextBlock Grid.Column="5" Text="{Binding Performance.Uptime, StringFormat=Uptime {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
