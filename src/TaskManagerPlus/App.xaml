<Application x:Class="TaskManagerPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskManagerPlus"
             xmlns:conv="clr-namespace:TaskManagerPlus.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BytesToReadableConverter x:Key="BytesToReadableConverter" />
            <conv:PercentToBrushConverter x:Key="PercentToBrushConverter" />
            <conv:BoolToEnableDisableTextConverter x:Key="BoolToEnableDisableTextConverter" />
            <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <conv:ColorToHexConverter x:Key="ColorToHexConverter" />
            <conv:ServiceStatusToBrushConverter x:Key="ServiceStatusToBrushConverter" />
            <conv:SegmentedMeterBrushConverter x:Key="SegmentedMeterBrushConverter" />
            <conv:ThemeModeSelectedBrushConverter x:Key="ThemeModeSelectedBrushConverter" />
            <conv:TemperatureToBrushConverter x:Key="TemperatureToBrushConverter" />
            <conv:SensorTypeToUnitConverter x:Key="SensorTypeToUnitConverter" />
            <conv:StringListJoinConverter x:Key="StringListJoinConverter" />
            <conv:BootMsToSecondsConverter x:Key="BootMsToSecondsConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:PercentToWidthConverter x:Key="PercentToWidthConverter" />
            <conv:PercentToStarWidthConverter x:Key="PercentToStarWidthConverter" />
            <conv:BugcheckCodeToDescriptionConverter x:Key="BugcheckCodeToDescriptionConverter" />
            <conv:StabilityIndexToBrushConverter x:Key="StabilityIndexToBrushConverter" />
            <conv:IntEqualsConverter x:Key="IntEqualsConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:ActivePlanSuffixConverter x:Key="ActivePlanSuffixConverter" />
            <conv:BugcheckSourceToTextConverter x:Key="BugcheckSourceToTextConverter" />
            <conv:ShutdownCauseToTextConverter x:Key="ShutdownCauseToTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
