<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Must carry an explicit Windows API version, not the bare `net8.0-windows` (which expands
         to net8.0-windows7.0). SkiaSharp.Views.WPF - pulled in by LiveCharts - ships its assets
         under net462 / net6.0-windows10.0.19041 / net8.0-windows10.0.19041 only. net8.0-windows7.0
         satisfies none of the windows10.0.19041 groups, so NuGet fell all the way back to the
         .NETFramework4.6.2 group and this .NET 8 app silently compiled against the net462
         SkiaSharp.Views.WPF, a net452 GLWpfControl and a .NET 2.0 OpenTK (the source of the 11
         NU1701 warnings). Naming 10.0.19041 selects the real net8.0 assets instead. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 2004 (build 19041) is the floor the TFM above implies. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- #452: MemoryPatternTestService uses NativeMemory.Alloc + pointer-based Span<byte> access
         over an unmanaged allocation (so a multi-gigabyte pattern-test request isn't capped by
         .NET's ~2 GB single managed-object limit) - the only unsafe code in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <!-- Round 12, #85: System tray icon (System.Windows.Forms.NotifyIcon) - WPF has no tray-icon
         API of its own; UseWindowsForms pulls in the WinForms subset of the Windows Desktop
         targeting pack (not a NuGet package) for exactly this one control, the same "known
         built-in escape hatch" tradeoff this project already takes for PerformanceCounter/WMI. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- UseWindowsForms turns EnableUnsafeBinaryFormatterSerialization on by default (WinForms
         clipboard/drag-drop compat). This app never uses BinaryFormatter, and its only clipboard
         calls are Clipboard.SetText - which does not go through it - so leaving the unsafe
         deserialization path enabled is pure attack surface on a process that runs elevated
         (app.manifest -> requireAdministrator). Turned off explicitly; if a future feature needs
         Clipboard.SetData with a custom object or WinForms drag-drop, that is the thing to
         revisit, not this flag. -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <!-- WFAC010 is a WinForms analyzer telling us to move app.manifest's dpiAware/dpiAwareness
         settings to the ApplicationHighDpiMode property + Application.SetHighDpiMode(). That advice
         is for a WinForms-bootstrapped app; this is WPF-first (App.xaml is the entry point and the
         WinForms bootstrap never runs), UseWindowsForms is set only to get NotifyIcon for the tray
         icon, and WPF reads its own per-monitor DPI awareness from exactly these manifest entries.
         Removing them would cost PerMonitorV2 awareness - blurry UI when a window moves between
         monitors at different scale factors - so the manifest stays and the analyzer is silenced.
         Only surfaced once the TFM above named an explicit Windows version, which is what enables
         these WinForms analyzers. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>TaskManagerPlus</AssemblyName>
    <RootNamespace>TaskManagerPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

  <!-- #117: the bundled Event ID knowledge base - embedded into the assembly (rather than a
       CopyToOutputDirectory loose file) so it always ships with the exe and needs no accompanying
       file next to it; EventKnowledgeBaseService reads it back via
       Assembly.GetManifestResourceStream. The user-editable override file
       (event-kb-overrides.json) is a separate, real file under AppPaths.SettingsDirectory, not
       this embedded one. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\EventKnowledgeBase.json" />
  </ItemGroup>

  <!-- Round 12, #85: UseWindowsForms's own implicit global usings (System.Drawing,
       System.Windows.Forms) collide with UseWPF's (System.Windows.Media, System.Windows.Controls,
       ...) - both define Color/Brush/UserControl/Application/KeyEventArgs, so every file in this
       WPF-first codebase would otherwise need an explicit disambiguation. Removed here instead,
       since only MainWindow.xaml.cs actually needs the WinForms tray-icon types, and it already
       reaches them through an explicit `Forms = System.Windows.Forms` alias / fully-qualified
       `System.Drawing.Icon` rather than relying on either implicit using. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- #418: curated pool-tag-to-description dictionary, embedded so PoolTagInspectionService can
       read it with GetManifestResourceStream regardless of working directory (portable mode
       runs from a USB drive, not always the exe's own folder). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\pooltag.txt">
      <LogicalName>pooltag.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- #500: curated known-problem-driver seed list, embedded the same way #418's pooltag.txt is -
       KnownProblemDriverService copies it into AppPaths.SettingsDirectory on first run (only when
       no file exists there yet) so the maintained list can be edited/replaced afterward without a
       rebuild. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\known-problem-drivers.json">
      <LogicalName>known-problem-drivers.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
