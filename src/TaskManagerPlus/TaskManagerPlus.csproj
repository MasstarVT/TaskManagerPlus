<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Round 12, #85: System tray icon (System.Windows.Forms.NotifyIcon) - WPF has no tray-icon
         API of its own; UseWindowsForms pulls in the WinForms subset of the Windows Desktop
         targeting pack (not a NuGet package) for exactly this one control, the same "known
         built-in escape hatch" tradeoff this project already takes for PerformanceCounter/WMI. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TaskManagerPlus</AssemblyName>
    <RootNamespace>TaskManagerPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

  <!-- #117: the bundled Event ID knowledge base - embedded into the assembly (rather than a
       CopyToOutputDirectory loose file) so it always ships with the exe and needs no accompanying
       file next to it; EventKnowledgeBaseService reads it back via
       Assembly.GetManifestResourceStream. The user-editable override file
       (event-kb-overrides.json) is a separate, real file under AppPaths.SettingsDirectory, not
       this embedded one. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\EventKnowledgeBase.json" />
  </ItemGroup>

  <!-- Round 12, #85: UseWindowsForms's own implicit global usings (System.Drawing,
       System.Windows.Forms) collide with UseWPF's (System.Windows.Media, System.Windows.Controls,
       ...) - both define Color/Brush/UserControl/Application/KeyEventArgs, so every file in this
       WPF-first codebase would otherwise need an explicit disambiguation. Removed here instead,
       since only MainWindow.xaml.cs actually needs the WinForms tray-icon types, and it already
       reaches them through an explicit `Forms = System.Windows.Forms` alias / fully-qualified
       `System.Drawing.Icon` rather than relying on either implicit using. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
