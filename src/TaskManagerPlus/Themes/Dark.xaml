<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================= Palette ============================= -->
    <!-- Layered dark surfaces: window < panel < elevated < hover, each one step lighter. -->
    <Color x:Key="BgColor">#17171A</Color>
    <Color x:Key="BgPanelColor">#1E1E22</Color>
    <Color x:Key="BgElevatedColor">#26262B</Color>
    <Color x:Key="BgHoverColor">#303038</Color>
    <Color x:Key="BorderColor">#33333A</Color>
    <Color x:Key="BorderSubtleColor">#26262B</Color>

    <Color x:Key="AccentColor">#3FA7FF</Color>
    <Color x:Key="AccentHoverColor">#61B7FF</Color>
    <Color x:Key="AccentMutedColor">#28496B</Color>

    <!-- Three text steps, each meeting WCAG AA (4.5:1) against all three surfaces above.
         Secondary was #9A9AA2 and tertiary #6B6B72; tertiary in particular sat at 3.14:1 on a
         panel and 2.85:1 on an elevated surface, i.e. below AA on the very surfaces it was most
         used on, and it is what the FontCaption step is coloured with. Both were lifted rather
         than only tertiary, so the primary/secondary/tertiary ramp stays visibly stepped
         (roughly 1.8x then 1.6x between neighbours) instead of collapsing into two shades. -->
    <Color x:Key="TextPrimaryColor">#F2F2F3</Color>
    <Color x:Key="TextSecondaryColor">#A7A7AE</Color>
    <Color x:Key="TextTertiaryColor">#8E8E95</Color>

    <Color x:Key="SuccessColor">#3DD68C</Color>
    <Color x:Key="WarningColor">#F5B942</Color>
    <Color x:Key="DangerColor">#F15A6F</Color>
    <Color x:Key="DangerHoverColor">#FF6E82</Color>
    <Color x:Key="DangerMutedColor">#3D2530</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <!-- Readable text color on top of AccentBrush - flips between dark/light text depending on the chosen accent's luminance. -->
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#10141A" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerMutedBrush" Color="{StaticResource DangerMutedColor}" />

    <!-- Reusable card drop shadow -->
    <DropShadowEffect x:Key="CardShadow" Color="Black" Direction="270" ShadowDepth="3" BlurRadius="16" Opacity="0.28" />

    <!-- Round 11, #78: default (non-compact) DataGrid row height/cell padding - overwritten
         directly in Application.Current.Resources by ThemeViewModel.ApplyRowHeight (the same
         "mutate the resource dictionary entry" trick ApplyPalette already uses for colors) when
         the user turns on compact rows in the Settings drawer. Declared here so a DynamicResource
         lookup always has a value even before ThemeViewModel's constructor runs. -->
    <sys:Double x:Key="DataGridRowHeightValue">34</sys:Double>
    <Thickness x:Key="DataGridCellPaddingValue">10,4</Thickness>

    <!-- ==================== Design tokens: type, spacing, radius ==================== -->
    <!-- Before the UI overhaul this codebase carried 1,889 hardcoded FontSize values spread over
         18 distinct sizes (9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13, 13.5, 14, 14.5, 15, 16, 17,
         18, 20, 34), 179 distinct Margin values and 11 CornerRadius values - accumulated one
         backlog item at a time, each view picking whatever looked right in isolation. The result
         was that nothing lined up across tabs and the most common body size was 11.5px.

         Those are collapsed onto the scale below and the floor is raised: nothing renders under
         12px any more. Use these keys (or the Text* styles below them) for anything new - a
         literal FontSize="11.5" in a view is precisely what this scale exists to stop coming back.

         Note these are StaticResource-consumed doubles, not brushes: unlike the palette they never
         change at runtime, so they don't need the DynamicResource treatment the color keys do. -->
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontStrong">13.5</sys:Double>
    <sys:Double x:Key="FontSection">15</sys:Double>
    <sys:Double x:Key="FontTitle">17</sys:Double>
    <sys:Double x:Key="FontDisplay">22</sys:Double>
    <sys:Double x:Key="FontHero">30</sys:Double>

    <!-- Spacing: a 4px grid. StackGap* is the bottom-margin between stacked siblings (by far the
         most common margin shape in this app); Inline* is the trailing gap between horizontal
         siblings. -->
    <Thickness x:Key="StackGapXs">0,0,0,4</Thickness>
    <Thickness x:Key="StackGapSm">0,0,0,8</Thickness>
    <Thickness x:Key="StackGapMd">0,0,0,12</Thickness>
    <Thickness x:Key="StackGapLg">0,0,0,16</Thickness>
    <Thickness x:Key="StackGapXl">0,0,0,24</Thickness>
    <Thickness x:Key="InlineGapSm">0,0,8,0</Thickness>
    <Thickness x:Key="InlineGapMd">0,0,12,0</Thickness>

    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>

    <!-- ==================== Type scale ==================== -->
    <!-- Six steps, each with a default colour matching its role, so a view can usually say
         Style="{StaticResource TextBody}" and set nothing else. -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextDisplay" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TextHero" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontHero}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ============================= Focus visual (#1000) ============================= -->
    <!-- suggestions.md #1000: a visible focus adorner - this app had none before (grep-confirmed:
         no FocusVisualStyle anywhere in this dictionary). Keying it as the special
         SystemParameters.FocusVisualStyleKey resource applies it to every control by default
         (WPF's own convention for a global override), not just the ones this domain's chunks
         happened to touch - a dashed accent-colored rectangle just outside the focused element's
         bounds, closely matching the dotted-underline visual language #990's glossary terms
         already use elsewhere in this app. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" SnapsToDevicePixels="True" StrokeThickness="1.5"
                               Stroke="{DynamicResource AccentBrush}" StrokeDashArray="1,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Base ============================= -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Shared section/field label used by both the settings drawer (SettingsPanel.xaml, which
         originally declared it privately in its own UserControl.Resources) and StabilityView.xaml.
         It lives here, in the app-wide dictionary, because a StaticResource is resolved against the
         referencing element's own lookup chain: StabilityView could never see a key scoped to a
         sibling UserControl, so its 20 references threw 'Cannot find resource named
         ColorRowLabel' while MainWindow's BAML was loading - which meant MainWindow's
         constructor threw and the app started with an error dialog and no main window at all. -->
    <Style x:Key="ColorRowLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
        <Setter Property="Margin" Value="{StaticResource StackGapSm}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="{StaticResource StackGapLg}" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- 413 cards across the app use this as their heading. It was 13px in TextSecondary grey,
         which made every card title recede into its own body text and left the long scrolling tabs
         with no scannable structure at all - so it now sits on the section step in primary text. -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="{StaticResource StackGapMd}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BigStat" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontHero}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubStat" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Label/value pair for a spec-sheet-style row (name on top, value below). Originally
         scoped to SystemSpecsView's own UserControl.Resources; hoisted here once CpuView (Round 8's
         microcode/cache/mitigation rows) and NetworkView (Round 9's bandwidth-history rows) started
         referencing it too - a StaticResource in one UserControl's local Resources isn't visible to
         another UserControl, so this must live in the shared theme dictionary to be usable app-wide. -->
    <Style x:Key="SpecLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style x:Key="SpecValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Shared by every card's title row (colored dot + label) - previously duplicated
         per-view (SummaryView, PerformanceView); hoisted here once Cpu/Memory/Storage/Network
         views multiplied the duplication further. -->
    <Style x:Key="ColorDot" TargetType="Border">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="CornerRadius" Value="4.5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TitleRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ============================= Buttons ============================= -->
    <!-- Default = quiet outline button, used for neutral actions (Refresh, Restart, ...) -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary = filled accent, for the one main action on a toolbar (Start service, ...) -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Danger = quiet by default, reads as a warning only on hover/press (destructive actions) -->
    <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Success = quiet green outline, e.g. Start service -->
    <Style x:Key="SuccessButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= TextBox (search boxes) ============================= -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentMutedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="16">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= TabControl ============================= -->
    <!-- Custom template: the default Windows theme chrome hardcodes a light background for the
         tab strip and content host and ignores Background/BorderThickness setters, which is why
         the row behind the tab headers rendered as a bright white bar.
         Laid out as a TMOG-style top horizontal tab strip (TabStripPlacement="Top" on the
         TabControl) plus a content pane below it, instead of the old left nav rail. The strip's
         ScrollViewer scrolls horizontally so all 10 tabs stay reachable without wrapping/clipping
         at narrower window widths. TabControl.Tag is presented docked to the right (trailing)
         edge of the strip so the caller can supply a footer entry (the "Colors" button) without
         this template needing to know about app-specific commands. -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" />
                                <ScrollViewer DockPanel.Dock="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <TabPanel x:Name="HeaderPanel" Panel.ZIndex="1"
                                              IsItemsHost="True" Background="Transparent" Margin="14,8,10,8" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}"
                                               Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" x:Name="content" ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Level 2: group sub-tabs ==================== -->
    <!-- The strip at the top of the window is level 1 (icon + label, filled pill). These two
         styles are the second-level row that appears *inside* a group tab - e.g. Hardware -> CPU /
         Memory / Storage / Network / GPU / Energy. They are deliberately a different shape from
         level 1 (underline indicator, no icon, page background rather than the panel-coloured
         strip) so the two rows never read as one continuous ribbon of tabs.

         SectionTabControl below is level 3. Three nav levels only works if a glance tells you
         which one you are looking at, so the shapes go: pill-with-icon, then underline, then
         chip. -->
    <Style x:Key="GroupTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource GroupTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <!-- StackPanel, not TabPanel: TabPanel accounts for a child's Margin when
                                     measuring but not when arranging, so each tab is arranged that much
                                     narrower than it measured and its label is clipped. Level 1 hides this
                                     because its tabs use a 2px margin; at the 20px spacing this row wants,
                                     "Troubleshoot" rendered as "Troubleshc". TabPanel's multi-row wrapping
                                     is not wanted here anyway - the strip scrolls instead. -->
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" Background="Transparent" Margin="18,0,18,0" />
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GroupTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSection}" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" ContentSource="Header"
                                          VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                        <Border Grid.Row="1" x:Name="indicator" Height="2" CornerRadius="1,1,0,0"
                                Background="Transparent" Margin="0,10,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="indicator" Property="Background" Value="{DynamicResource BorderBrush2}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Level 3: in-page section chips ==================== -->
    <!-- Why this exists: tabs in this app grew by appending one card per backlog item to a single
         ScrollViewer > StackPanel, and Stability reached 80 cards in one unbroken scroll (Network
         52, Energy and Thermals 41, Storage 37). Wrapping those cards in a TabControl styled as a
         chip bar splits them into named sections without needing a ViewModel change: no
         IsXxxViewActive bool per section, no new commands - the sections are plain TabItems and
         WPF handles selection, keyboard navigation and automation for free.

         Set Style="{StaticResource SectionTabControl}" on the TabControl only; its
         ItemContainerStyle styles the child TabItems, so individual sections stay a plain
         <TabItem Header="..."> with nothing else on them. -->
    <Style x:Key="SectionTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource SectionTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="16,12,16,4">
                            <!-- StackPanel for the same reason as GroupTabControl above: a chip needs its
                                 gap outside its border, so the spacing has to be Margin, and TabPanel
                                 would clip 8px off every chip's label. -->
                            <StackPanel Orientation="Horizontal" IsItemsHost="True" Background="Transparent" />
                        </ScrollViewer>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="chip" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Devices & Drivers switched sections with plain Buttons and an IsXxxViewActive bool per
         section long before the chip bar existed (see DevicesDriversViewModel). Rather than
         rewrite that into TabItems, this style makes those buttons render as the same chip, so
         the one tab that navigates differently at least does not also look different. The caller
         still supplies its own DataTrigger for the active state - only the resting look is here. -->
    <Style x:Key="SectionChipButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="chip" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="chip" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= DataGrid ============================= -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#0AFFFFFF" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeight" Value="{DynamicResource DataGridRowHeightValue}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                               TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                            <Path x:Name="SortArrow" Grid.Column="1" Width="8" Height="6" Stretch="Fill"
                                  Fill="{DynamicResource AccentBrush}" Margin="6,0,2,0" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 5 L 8 0 Z" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource DataGridCellPaddingValue}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= ProgressBar ============================= -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Slider (saturation control) ============================= -->
    <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}"
                             Stroke="{DynamicResource BgBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource BgElevatedBrush}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" Cursor="Hand" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= ScrollBar ============================= -->
    <Style x:Key="ThinScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource TextTertiaryBrush}" CornerRadius="4" Opacity="0.6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8" HorizontalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThinScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ThinScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinScrollBarThumb}" Width="8" MinHeight="24" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Misc ============================= -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
